+// Copyright (c) 2026 gufo contributors (MIT), #681 vector-load idea.
+// Keep each lane's original BF16 pair and all FMA/reduction instructions.
+static __device__ __forceinline__ uint32_t opus_load8_pair(const uint32_t * x2, int col2) {
+    uint2 pair = make_uint2(0, 0);
+    if ((threadIdx.x & 1) == 0) {
+        pair = *reinterpret_cast<const uint2 *>(x2 + col2);
+    }
+    const unsigned int next = __shfl_xor_sync(0xffffffff, pair.y, 1, 32);
+    return (threadIdx.x & 1) ? next : pair.x;
+}
