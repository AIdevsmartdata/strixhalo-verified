+void llama_context::check_topk_output_ith(int32_t i, const llama_sampling_output_view & out) {
+    if (GGML_OPUS_INT("LLAMA_OPUS_TOPK_CHECK", 0) != 1 || !out.sampled_logits || !out.candidates || out.n_logits == 0) {
+        return;
+    }
