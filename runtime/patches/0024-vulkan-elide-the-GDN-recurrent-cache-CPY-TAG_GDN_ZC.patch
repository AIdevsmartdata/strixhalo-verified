+// [TAG_GDN_ZC] Validate the recurrent-cache write-back pattern:
+//   gdn  = GATED_DELTA_NET(...)
+//   src  = VIEW of gdn at the snapshot tail (contiguous)
+//   cpy  = CPY(src, dst) where dst is a VIEW of the recurrent state cache
+// Returns the cache view the GDN kernel must write, or nullptr when the pattern
+// does not match exactly (anything else keeps the plain CPY path).
+static const ggml_tensor * ggml_vk_gdn_cache_dst(
+        const ggml_tensor * gdn, const ggml_tensor * src, const ggml_tensor * cpy) {
+    if (gdn->type != GGML_TYPE_F32) {
+        return nullptr;
+    }
+    if (cpy->op != GGML_OP_CPY || (cpy->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return nullptr;
+    }
+
+    const ggml_tensor * src_v = gdn->src[2];
+    const int64_t S_v      = src_v->ne[0];
+    const int64_t H        = src_v->ne[1];
+    const int64_t n_tokens = src_v->ne[2];
+    const int64_t n_seqs   = src_v->ne[3];
+    const int64_t D        = S_v * S_v * H;
+    const int64_t K        = ggml_get_op_params_i32(gdn, 0);
+    const int64_t n_written = std::min<int64_t>(n_tokens, K);
+    const size_t tail_off  = ggml_row_size(GGML_TYPE_F32, S_v * H * n_tokens * n_seqs);
+
+    // src must be the contiguous snapshot tail of the GDN output
+    if (src->op != GGML_OP_VIEW || src->view_src != gdn || src->view_offs != tail_off ||
+        !ggml_is_contiguous(src)) {
+        return nullptr;
+    }
+
+    const ggml_tensor * dst = cpy->src[1];
+    if (dst->op != GGML_OP_VIEW || dst->type != GGML_TYPE_F32 || dst->buffer == nullptr) {
+        return nullptr;
+    }
+    // [d, seq, slot] layout: the kernel writes slot*nb[2] + seq*nb[1] + head*S_v*S_v
+    if (dst->ne[0] != D || dst->ne[1] != n_seqs || dst->ne[2] != n_written || dst->ne[3] != 1) {
+        return nullptr;
+    }
+    if (dst->nb[0] != ggml_type_size(GGML_TYPE_F32) ||
+        dst->nb[1] != (size_t)ggml_row_size(GGML_TYPE_F32, D)) {
+        return nullptr;
+    }
+    if (n_written > 1 && dst->nb[2] == 0) {
+        return nullptr; // several slots need a slot stride
+    }
+    return dst;
+}
+
+// [TAG_GDN_ZC] Collect the elidable recurrent-cache CPY nodes of this graph.
+// The scan is dependency based (a CPY whose source views a GDN output), so it does not
+// depend on the node order: the Vulkan backend reorders nodes for parallelism.
+static void ggml_vk_prepare_gdn_cache_fusion(ggml_backend_vk_context * ctx, ggml_cgraph * cgraph) {
+    ctx->gdn_cache_dst.clear();
+    ctx->gdn_cache_skip.clear();
+
+    if (ctx->device->disable_fusion || ctx->device->disable_gdn_cache_fusion) {
+        return;
+    }
+
+    static bool dbg_init = false;
+    static bool dbg = false;
+    if (!dbg_init) {
+        dbg_init = true;
+        dbg = getenv("GGML_VK_DEBUG_GDN_CACHE") != nullptr;
+    }
+
+    std::vector<const ggml_tensor *> candidates;
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        const ggml_tensor * n = cgraph->nodes[i];
+        if (n->op != GGML_OP_CPY || !n->src[0] || n->src[0]->op != GGML_OP_VIEW) {
+            continue;
+        }
+        const ggml_tensor * gdn = n->src[0]->view_src;
+        if (!gdn || gdn->op != GGML_OP_GATED_DELTA_NET) {
+            continue;
+        }
+        const ggml_tensor * dst = ggml_vk_gdn_cache_dst(gdn, n->src[0], n);
+        if (!dst) {
+            continue;
+        }
+        candidates.push_back(n);
+        ctx->gdn_cache_dst[gdn] = dst;
+    }
+    if (candidates.empty()) {
+        return;
+    }
+
+    // Consumers of the CPY result are fine: the graph order is dependency based, so any
+    // consumer of the CPY result necessarily runs after the GDN that now writes it.
+    for (auto cpy : candidates) {
+        ctx->gdn_cache_skip.insert(cpy);
+    }
+    if (dbg) {
+        fprintf(stderr, "[GDN_CACHE] %zu cache CPY elided (graph of %d nodes)\n",
+                ctx->gdn_cache_skip.size(), cgraph->n_nodes);
+    }
+}
