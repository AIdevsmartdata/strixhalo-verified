+// [TAG_PERF_LAYER] etiquette de couche d'un noeud : "blk<N>" si le noeud ou l'un de ses parents porte
+// un nom "blk.<N>.*" (les poids sont nommes par llama.cpp), sinon une classe grossiere
+// (head = tete/lm_head, ple = table n-gram, mtp = draft, graph = reste).
+static std::string vk_perf_layer_tag(const ggml_tensor * node) {
+    auto scan = [](const char * nm) -> int {
+        if (!nm || !nm[0]) return -1;
+        const char * p = strstr(nm, "blk.");
+        if (!p) return -1;
+        p += 4;
+        if (*p < '0' || *p > '9') return -1;
+        int v = 0;
+        while (*p >= '0' && *p <= '9') { v = v * 10 + (*p - '0'); ++p; }
+        return v;
+    };
+    if (node) {
+        const int l = scan(node->name);
+        if (l >= 0) return "blk" + std::to_string(l);
+        for (int i = 0; i < GGML_MAX_SRC; ++i) {
+            if (!node->src[i]) continue;
+            const int ls = scan(node->src[i]->name);
+            if (ls >= 0) return "blk" + std::to_string(ls);
+        }
+        if (node->view_src) {
+            const int lv = scan(node->view_src->name);
+            if (lv >= 0) return "blk" + std::to_string(lv);
+        }
+        if (node->name && node->name[0]) {
+            const std::string n = node->name;
+            if (n.find("output")     != std::string::npos) return "head";
+            if (n.find("per_layer")  != std::string::npos) return "ple";
+            if (n.find("ple")        != std::string::npos) return "ple";
+            if (n.find("mtp")        != std::string::npos) return "mtp";
+            if (n.find("draft")      != std::string::npos) return "mtp";
+        }
+    }
+    return "graph";
+}
