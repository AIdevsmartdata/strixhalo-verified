+// [OPUS-SAMPGPU] k meilleurs logits de chaque ligne du tenseur de logits (f32 contigu, dans un tampon de CE backend) ;
+// ecrit dans des tampons hote (epingles) par copie asynchrone sur le flux du backend. 1 = fait, 0 = rien fait.
+static int ggml_backend_cuda_opus_topk(ggml_backend_t backend, const ggml_tensor * t, int n_rows, int k,
+        float * host_vals, int32_t * host_ids) {
+    if (!ggml_backend_is_cuda(backend) || t == nullptr || t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) ||
+            k <= 0 || k > 128 || n_rows <= 0 || host_vals == nullptr || host_ids == nullptr) {
+        return 0;
+    }
+    const int n = (int) t->ne[0];
+    if (n < k || t->ne[1] < n_rows || t->data == nullptr) {
+        return 0;
+    }
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_backend_buffer_t buf = t->view_src ? t->view_src->buffer : t->buffer;
+    if (buf == nullptr || !ggml_backend_buffer_is_cuda(buf) ||
+            ((ggml_backend_cuda_buffer_context *) buf->context)->device != cuda_ctx->device) {
+        return 0;
+    }
+    ggml_cuda_set_device(cuda_ctx->device);
+    cudaStream_t stream = cuda_ctx->stream();
+
+    ggml_cuda_pool_alloc<float> d_vals(cuda_ctx->pool(), (size_t) n_rows * k);
+    ggml_cuda_pool_alloc<int>   d_ids (cuda_ctx->pool(), (size_t) n_rows * k);
+    ggml_cuda_pool_alloc<float> d_cv  (cuda_ctx->pool(), (size_t) n_rows * OPUS_TOPK_CHUNKS_HOST * k);
+    ggml_cuda_pool_alloc<int>   d_ci  (cuda_ctx->pool(), (size_t) n_rows * OPUS_TOPK_CHUNKS_HOST * k);
+    ggml_cuda_opus_topk_rows((const float *) t->data, n, n, n_rows, k, d_vals.get(), d_ids.get(), d_cv.get(), d_ci.get(), stream);
+    CUDA_CHECK(cudaMemcpyAsync(host_vals, d_vals.get(), (size_t) n_rows * k * sizeof(float), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaMemcpyAsync(host_ids,  d_ids.get(),  (size_t) n_rows * k * sizeof(int),   cudaMemcpyDeviceToHost, stream));
+    return 1;
+}
