+
+// Cache only process configuration. OPUS flags keep their atomic accessors.
+// Each expansion owns its value so the disabled path still calls getenv.
+#define GGML_OPUS_ENV_PRESENT(NAME) ([]() -> bool { \
+    static const bool cache = GGML_OPUS_ON("GGML_OPUS_ENVCACHE"); \
+    if (!cache) { return std::getenv(NAME) != nullptr; } \
+    static const bool present = std::getenv(NAME) != nullptr; \
+    return present; \
+}())
