+            const uint16_t * blk16 = blk_in_bf16 ? blk_in_bf16 + (int64_t) t * n_embd : nullptr;
+            float tmp = 0.0f;
+#pragma unroll
+            for (int k = 0; k < KP; ++k) {
+                const int col = (tid + k * HC_CN_BLOCK2) * 2;
