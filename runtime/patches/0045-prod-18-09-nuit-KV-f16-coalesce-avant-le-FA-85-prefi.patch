+                                     : ggml_fp32_to_fp16((float) (rand() % 1000) / 1000.0f - 0.5f);
+                }
+                ggml_backend_tensor_set(t, data.data(), 0, nel*sizeof(ggml_fp16_t));
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+};
