+void llama_context::opus_flags_sync() {
+    const uint64_t g = ggml_opus_flag_generation();
+    if (opus_flags_gen_seen == 0) {   // premiere reservation, a la construction : rien a abandonner
+        opus_flags_gen_seen = g;
+        return;
+    }
+    if (g == opus_flags_gen_seen) {
+        return;
+    }
+    // V6CHAUD : un commutateur a chaud a change entre deux decodages. Les decisions lues a la construction du graphe, a la
+    // coupe du planificateur et dans graph_optimize (fusions, reordonnancement, marques BF16) doivent etre reprises : le graphe
+    // en cache est abandonne et le planificateur re-reserve (tampons de calcul recalcules sous les nouvelles valeurs).
+    LLAMA_LOG_INFO("%s: commutateurs OPUS modifies (generation %llu -> %llu) : graphe reconstruit, planificateur re-reserve\n",
+            __func__, (unsigned long long) opus_flags_gen_seen, (unsigned long long) g);
+    synchronize();
+    // INTEG7 : les etats du backend indexes par adresse de tenseur (marques BF16 de graph_optimize) sont oublies
+    for (auto & backend : backends) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(backend.get());
+        ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+        typedef void (*reset_fn_t)(ggml_backend_t);
+        auto * fn = reg ? (reset_fn_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_opus_flags_reset") : nullptr;
+        if (fn) {
+            fn(backend.get());
+        }
+    }
+    opus_flags_gen_seen = g;
+    sched_need_reserve  = true;
+    gf_res_prev_active  = nullptr;
+}
