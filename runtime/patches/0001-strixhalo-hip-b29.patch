+// llama-ckpt-test : proof that an in-batch snapshot (LLAMA_CKPT_INBATCH=1) is the state of a separate pass.
+//   llama-ckpt-test -m model.gguf [-N 6000] [-p1 2500] [-p2 5990] [-rs 0]
+// A : one batch of N tokens, snapshots requested after p1 and p2 tokens -> planes 0 / 1, and the final state
+// B : the same N tokens WITHOUT request -> final state (must equal A's byte for byte: the snapshot code does not disturb the pass)
+// C_p : separate pass of the first p tokens from an empty cache -> the state a cut would have checkpointed (legacy)
+// Then: (1) A planes vs C_p bytes / NMSE per tensor class (conv r, PLE p, recurrent s)
+//       (2) restore A's plane then C_p's state, teacher-force the next 48 tokens, compare the logits (argmax, max |dlogit|)
+#include "llama.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+#include <random>
+
+static std::vector<llama_token> make_tokens(const llama_vocab * vocab, int n) {
+    static const char * W[] = {"alpha","beta","gamma","delta","kernel","cache","buffer","tensor","matrix","vector","thread","queue","socket","parser","token","router","expert","layer"};
+    std::mt19937 rng(5);
+    std::string txt;
+    std::vector<llama_token> out;
+    while ((int) out.size() < n) {
+        txt.clear();
+        for (int i = 0; i < 400; ++i) { txt += W[rng() % 18]; txt += std::to_string(rng() % 1000); txt += ' '; }
+        int k = -llama_tokenize(vocab, txt.c_str(), txt.size(), NULL, 0, false, false);
+        std::vector<llama_token> t(k);
+        llama_tokenize(vocab, txt.c_str(), txt.size(), t.data(), t.size(), false, false);
+        out.insert(out.end(), t.begin(), t.end());
+    }
+    out.resize(n);
+    return out;
+}
+
+struct ckpt { std::vector<uint8_t> d; };
+
+static ckpt get_state(llama_context * ctx, uint32_t extra) {
+    ckpt c;
+    llama_synchronize(ctx);
+    const uint32_t fl = LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY | extra;
+    c.d.resize(llama_state_seq_get_size_ext(ctx, 0, fl));
+    size_t n = llama_state_seq_get_data_ext(ctx, c.d.data(), c.d.size(), 0, fl);
+    if (n != c.d.size()) { fprintf(stderr, "state size mismatch\n"); exit(1); }
+    return c;
+}
+
+// split a checkpoint into float arrays: conv r (122880 B rows), PLE p (368640 B), s (the rest)
+struct parsed { int pos = -1; std::vector<std::vector<float>> R, P, S; };
+static parsed parse(const std::vector<uint8_t> & b) {
+    parsed p; size_t off = 0;
+    auto rd = [&](auto & v) { memcpy(&v, b.data() + off, sizeof(v)); off += sizeof(v); };
+    uint32_t u; int32_t i; uint64_t sz;
+    rd(u); rd(i); rd(u); rd(p.pos); rd(u); rd(u); rd(u);
+    while (true) {
+        size_t save = off; int32_t t; uint64_t s;
+        rd(t); rd(s);
+        if (t == 0 && s == 122880) {
+            std::vector<float> v(s / 4); memcpy(v.data(), b.data() + off, s); off += s; p.R.push_back(v);
+            uint64_t nx; memcpy(&nx, b.data() + off, 8);
+            if (nx == 368640) { off += 8; std::vector<float> q(nx / 4); memcpy(q.data(), b.data() + off, nx); off += nx; p.P.push_back(q); }
+        } else { off = save; break; }
+    }
+    while (off < b.size()) {
+        int32_t t; rd(t); rd(sz);
+        std::vector<float> v(sz / 4); memcpy(v.data(), b.data() + off, sz); off += sz; p.S.push_back(v);
+    }
+    return p;
+}
+static double nmse(const std::vector<float> & a, const std::vector<float> & b) {
+    double n = 0, d = 0;
+    for (size_t i = 0; i < a.size(); ++i) { double x = a[i], y = b[i]; n += (x - y) * (x - y); d += x * x; }
+    return n / std::max(d, 1e-300);
+}
+static void report(const char * name, const ckpt & a, const ckpt & b) {
+    size_t diff = 0; if (a.d.size() != b.d.size()) { printf("%s: size %zu vs %zu\n", name, a.d.size(), b.d.size()); return; }
+    for (size_t i = 0; i < a.d.size(); ++i) diff += a.d[i] != b.d[i];
+    parsed pa = parse(a.d), pb = parse(b.d);
+    auto cls = [&](const char * c, const std::vector<std::vector<float>> & x, const std::vector<std::vector<float>> & y) {
+        double mx = 0, sum = 0; size_t nz = 0;
+        for (size_t l = 0; l < x.size(); ++l) { double e = nmse(x[l], y[l]); mx = std::max(mx, e); sum += e; for (size_t k = 0; k < x[l].size(); ++k) nz += x[l][k] != y[l][k]; }
+        printf("   %s: layers=%zu  NMSE max %.3e mean %.3e  differing floats %zu\n", c, x.size(), mx, sum / std::max<size_t>(1, x.size()), nz);
+    };
+    printf("%s: pos %d vs %d, size %zu, differing bytes %zu %s\n", name, pa.pos, pb.pos, a.d.size(), diff, diff == 0 ? "=> IDENTICAL" : "");
+    cls("conv r", pa.R, pb.R); cls("PLE p ", pa.P, pb.P); cls("state s", pa.S, pb.S);
+}
+
+// positions (absolute) asked for the next decode; the request is issued for the chunk that contains each of them,
+// exactly like the server does (one llama_process per server batch, <= n_batch tokens)
+static std::vector<int> g_ps;
+static std::vector<int> g_done;
+
+static int decode(llama_context * ctx, std::vector<llama_token> & t, int from, int to, bool logits_last) {
+    (void) logits_last;
+    // llama_decode refuses more than n_batch tokens: split exactly as the server does
+    const int n_batch = (int) llama_n_batch(ctx);
+    for (int i = from; i < to; i += n_batch) {
+        const int n = std::min(n_batch, to - i);
+        // request the snapshots that fall inside this chunk (offsets relative to the chunk start)
+        std::vector<int32_t> offs; std::vector<llama_pos> pos;
+        for (size_t k = 0; k < g_ps.size(); ++k) {
+            if (std::find(g_done.begin(), g_done.end(), k) != g_done.end()) continue;
+            const int rel = g_ps[k] - i;
+            if (rel > 0 && rel < n) { offs.push_back(rel); pos.push_back(g_ps[k] - 1); g_done.push_back((int) k); }
+        }
+        if (!offs.empty()) {
+            printf("   [chunk %d +%d] request %zu snapshot(s), first rel %d\n", i, n, offs.size(), offs[0]);
+            llama_ckpt_inbatch_request(ctx, 0, (int32_t) offs.size(), offs.data(), pos.data());
+        }
+        llama_batch b = llama_batch_get_one(t.data() + i, n);
+        int r = llama_decode(ctx, b);
+        llama_synchronize(ctx);
+        if (r != 0) {
+            return r;
+        }
+    }
+    return 0;
+}
+
+int main(int argc, char ** argv) {
+    std::string model; int N = 6200, rs = 0; std::vector<int> ps = {2496, 2500, 5984, 5990, 5996};
+    for (int i = 1; i < argc; ++i) {
+        if (!strcmp(argv[i], "-m")) model = argv[++i];
+        else if (!strcmp(argv[i], "-N")) N = atoi(argv[++i]);
+        else if (!strcmp(argv[i], "-rs")) rs = atoi(argv[++i]);
+        else if (!strcmp(argv[i], "-ps")) { ps.clear(); char * s = strdup(argv[++i]); for (char * t = strtok(s, ","); t; t = strtok(NULL, ",")) ps.push_back(atoi(t)); }
+    }
+    llama_backend_init();
+    llama_model_params mp = llama_model_default_params(); mp.n_gpu_layers = 999;
+    mp.load_mode = LLAMA_LOAD_MODE_DIRECT_IO; mp.lazy_mode = LLAMA_LAZY_MODE_DIRECT; // -lm dio -lzm on-direct, as in prod
+    llama_model * m = llama_model_load_from_file(model.c_str(), mp);
+    if (!m) return 1;
+    const llama_vocab * vocab = llama_model_get_vocab(m);
+    llama_context_params cp = llama_context_default_params();
+    cp.n_ctx = std::max(16384, N + 4096); cp.n_batch = 8192; cp.n_ubatch = 8192; cp.n_seq_max = 1; cp.n_rs_seq = rs;
+    llama_context * ctx = llama_init_from_model(m, cp);
+    if (!ctx) return 1;
+    printf("planes = %d, n_rs_seq = %u, N = %d\n", llama_ckpt_inbatch_planes(ctx), llama_n_rs_seq(ctx), N);
+    if (llama_ckpt_inbatch_planes(ctx) < 1) { printf("run with LLAMA_CKPT_INBATCH=1\n"); return 2; }
+    auto tok = make_tokens(vocab, N + 64);
+    llama_memory_t mem = llama_get_memory(ctx);
+    const int NV = llama_vocab_n_tokens(vocab);
+
+    // invariance: the snapshot kernel must not change the final state
+    llama_memory_clear(mem, true);
+    { g_ps.clear(); g_done.clear();
+      g_ps.push_back(ps[0]); if (ps.size() > 1) g_ps.push_back(ps[1]); }
+    if (decode(ctx, tok, 0, N, false)) return 1;
+    ckpt Aend = get_state(ctx, 0);
+    printf("snapshots ecrits (passe A) : %d %d\n", llama_ckpt_inbatch_result(ctx, 0), llama_ckpt_inbatch_result(ctx, 1));
+    llama_memory_clear(mem, true);
+    if (decode(ctx, tok, 0, N, false)) return 1;
+    ckpt Bend = get_state(ctx, 0);
+    report("final state: snapshot kernel vs plain kernel", Aend, Bend);
+
+    // the logits of the last token of the pass: the sharpest test of "the snapshot machinery does not perturb the pass"
+    {
+        auto last_logits = [&](std::vector<float> & out) {
+            const float * l = llama_get_logits_ith(ctx, -1);
+            out.assign(l, l + llama_vocab_n_tokens(vocab));
+        };
+        std::vector<float> lA, lB;
+        llama_memory_clear(mem, true);
+        g_ps.clear(); g_done.clear(); g_ps.push_back(ps[0]); if (ps.size() > 1) g_ps.push_back(ps[1]);
+        if (decode(ctx, tok, 0, N, false)) return 1;
+        last_logits(lA);
+        llama_memory_clear(mem, true);
+        g_ps.clear(); g_done.clear();
+        if (decode(ctx, tok, 0, N, false)) return 1;
+        last_logits(lB);
+        int ia = 0, ib = 0; double mx = 0;
+        for (size_t i = 0; i < lA.size(); ++i) { if (lA[i] > lA[ia]) ia = (int) i; if (lB[i] > lB[ib]) ib = (int) i; mx = std::max(mx, (double) std::fabs(lA[i] - lB[i])); }
+        printf("LOGITS du dernier jeton : avec snapshots vs sans : max|d| %.3e (argmax %d vs %d)%s\n", mx, ia, ib,
+               mx == 0 ? " => IDENTIQUES" : " => DIFFERENTS");
+    }
+
+    auto cont = [&](const ckpt & c, int p, std::vector<float> & lg) {
+        llama_memory_clear(mem, true);
+        // the attention KV is not in a PARTIAL_ONLY state: rebuild it by a pass over [0,p), then overwrite the recurrent state
+        if (decode(ctx, tok, 0, p, false)) exit(1);
+        llama_state_seq_set_data_ext(ctx, c.d.data(), c.d.size(), 0, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+        if (decode(ctx, tok, p, p + 48, false)) exit(1);
+        const float * l = llama_get_logits_ith(ctx, -1);
+        lg.assign(l, l + NV);
+    };
+    auto dmax = [&](const std::vector<float> & a, const std::vector<float> & b, int & ia, int & ib) {
+        ia = ib = 0; double mx = 0;
+        for (size_t i = 0; i < a.size(); ++i) { if (a[i] > a[ia]) ia = i; if (b[i] > b[ib]) ib = i; mx = std::max(mx, (double) std::fabs(a[i] - b[i])); }
+        return mx;
+    };
+    for (int p : ps) {
+        printf("\n===== p = %d (p mod 32 = %d), N = %d =====\n", p, p % 32, N);
+        llama_memory_clear(mem, true);
+        g_ps.clear(); g_done.clear(); g_ps.push_back(p);
+        if (decode(ctx, tok, 0, N, false)) return 1;
+        printf("snapshot written: %d\n", llama_ckpt_inbatch_result(ctx, 0));
+        ckpt A = get_state(ctx, LLAMA_STATE_SEQ_FLAGS_CKPT_SLOT(0));
+        llama_memory_clear(mem, true);
+        if (decode(ctx, tok, 0, p, false)) return 1;
+        ckpt C = get_state(ctx, 0);
+        report("snapshot vs separate pass [0,p)", A, C);
+        std::vector<float> la, lc, ld;
+        cont(A, p, la); cont(C, p, lc);
+        llama_memory_clear(mem, true);
+        if (decode(ctx, tok, 0, p + 48, false)) return 1;
+        { const float * l = llama_get_logits_ith(ctx, -1); ld.assign(l, l + NV); }
+        int i1, i2;
+        double e_ac = dmax(la, lc, i1, i2); printf("logits after 48 forced tokens: snapshot-restore vs separate-pass-restore: max|d| %.3e (argmax %d vs %d)\n", e_ac, i1, i2);
+        double e_ad = dmax(la, ld, i1, i2); printf("   snapshot-restore vs one uninterrupted pass [0,p+48): max|d| %.3e (argmax %d vs %d)\n", e_ad, i1, i2);
+        double e_cd = dmax(lc, ld, i1, i2); printf("   separate-pass-restore vs one uninterrupted pass       : max|d| %.3e (argmax %d vs %d)\n", e_cd, i1, i2);
+    }
+    llama_free(ctx); llama_model_free(m);
+    return 0;
+}
