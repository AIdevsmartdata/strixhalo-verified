+            double ck_tot = 0;
+            size_t ck_n = 0;
+            std::string per;
+            for (auto & slot : slots) {
+                double sz = 0;
+                for (const auto & ck : slot.prompt.checkpoints) {
+                    sz += ck.size() * MiB;
+                }
+                ck_tot += sz;
+                ck_n   += slot.prompt.checkpoints.size();
+                snprintf(b, sizeof(b), "%s%zu:%.0f", per.empty() ? "" : ",", slot.prompt.checkpoints.size(), sz);
+                per += b;
+            }
+            snprintf(b, sizeof(b), " ckpt[%zu = %.0f MiB; per slot n:MiB %s]", ck_n, ck_tot, per.c_str());
+            out += b;
+        }
+        if (prompt_cache) {
+            snprintf(b, sizeof(b), " pcache[%zu states, %.0f MiB]", prompt_cache->states.size(), prompt_cache->size() * MiB);
+            out += b;
+        }
+        snprintf(b, sizeof(b), " sys[MemAvail %.2f GiB, GTT %.2f GiB, RSS %.2f GiB, RssAnon %.2f, RssFile %.2f, RssShmem %.2f, Shmem %.2f]",
+                 memstat_kv("/proc/meminfo", "MemAvailable"), memstat_gtt_gib(), memstat_kv("/proc/self/status", "VmRSS"),
+                 memstat_kv("/proc/self/status", "RssAnon"), memstat_kv("/proc/self/status", "RssFile"),
+                 memstat_kv("/proc/self/status", "RssShmem"), memstat_kv("/proc/meminfo", "Shmem"));
+        out += b;
+        SRV_WRN("[MEMSTAT] #%llu %s:%s\n", (unsigned long long) mstat.n, why, out.c_str());
+    }
