+void llama_sampler_chain_apply_cpu(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    // [TAG_GRAMMAR_BACKEND] like llama_sampler_chain_apply, but backend-initialized stages are
+    // applied on the CPU too (the caller must pass raw, pre-backend logits so that the
+    // backend graph and this CPU pass each apply the stages exactly once)
+    auto * chain = (llama_sampler_chain *) smpl->ctx;
