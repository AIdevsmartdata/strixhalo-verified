From 2814a75ba385fd23c40b90525d94bfed016217fb Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?K=C3=A9vin=20R=C3=A9mondi=C3=A8re?= <kevin@localhost>
Date: Sat, 19 Sep 2026 02:29:04 +0200
Subject: [PATCH 46/57] vulkan FA: correction de is_dense_kv_cache (nb[3] vs
 ne[3]) - le chemin q8_0 dequant_transpose ne s'activait jamais non plus

La garde amont exigeait nb[3] == nb[1]*ne[1], faux pour une vue du cache prealloue
(ne[1] = longueur utilisee, nb[3] = stride du cache complet) alors que ne[3] == 1 :
ce stride n'est jamais indexe. Meme semantique que is_dense_kv_view du correctif
f16-contig. Verifie indirectement (SHA + RETR 14k 4/4 sur la prod).
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 26 ++++++++++----------------
 1 file changed, 10 insertions(+), 16 deletions(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 93f5e77d141..cd97be04232 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -12048,11 +12048,15 @@ static void ggml_vk_flash_attn(ggml_backend_vk_context * ctx, vk_context& subctx
     const bool f32acc = !ctx->device->fp16 || dst->op_params[3] == GGML_PREC_F32 || k->type == GGML_TYPE_BF16;
 
     // dequant K/V once into an f16 scratch, reordered KV layout so FA can read without a stride
+    // [TAG_FA_F16_CONTIG] upstream demanded nb[3] == nb[1]*ne[1] here, which is FALSE for a
+    // view of the preallocated cache (ne[1] = used length, nb[3] = full cache stride) while
+    // ne[3] == 1 means that stride is never indexed. This silently disabled the q8_0
+    // dequant_transpose path too. Test the properties that actually matter instead.
     auto is_dense_kv_cache = [](const ggml_tensor * t) {
         return t->nb[0] == ggml_type_size(t->type) &&
                t->nb[2] == ggml_row_size(t->type, t->ne[0]) &&
                t->nb[1] == t->nb[2] * t->ne[2] &&
-               t->nb[3] == t->nb[1] * t->ne[1];
+               t->ne[3] == 1;
     };
     const bool k_quant = k->type != GGML_TYPE_F16 && k->type != GGML_TYPE_BF16 && k->type != GGML_TYPE_F32;
     const bool v_quant = v->type != GGML_TYPE_F16 && v->type != GGML_TYPE_BF16 && v->type != GGML_TYPE_F32;
@@ -12080,21 +12084,11 @@ static void ggml_vk_flash_attn(ggml_backend_vk_context * ctx, vk_context& subctx
         const char * e = getenv("GGML_VK_FA_KV_CONTIG");
         return e != nullptr && atoi(e) != 0;
     }();
-    // NB : is_dense_kv_cache() exige en plus nb[3] == nb[1]*ne[1]. C'est faux pour une VUE
-    // du cache prealloue (ne[1] = longueur utilisee, nb[3] = stride du cache complet), et
-    // comme ne[3] == 1 ce stride n'est JAMAIS utilise pour l'indexation. On teste donc
-    // directement les seules proprietes qui comptent : nb[0] element, nb[2] une tete,
-    // nb[1] = NH tetes par token (layout entrelace), et ne[3] == 1 (la copie n'indexe pas
-    // de dimension sequence).
-    auto is_dense_kv_view = [](const ggml_tensor * t) {
-        return t->nb[0] == ggml_type_size(t->type) &&
-               t->nb[2] == ggml_row_size(t->type, t->ne[0]) &&
-               t->nb[1] == t->nb[2] * t->ne[2] &&
-               t->ne[3] == 1;
-    };
+    // (is_dense_kv_cache teste nb[0] element, nb[2] une tete, nb[1] = NH tetes par token
+    //  -- le layout entrelace -- et ne[3] == 1 : la copie n'indexe pas de dimension sequence.)
     const bool use_f16_contig = fa_kv_contig_env && !k_quant && !v_quant &&
                                 k->type == GGML_TYPE_F16 && v->type == GGML_TYPE_F16 &&
-                                neq1 >= 64 && is_dense_kv_view(k) && is_dense_kv_view(v) &&
+                                neq1 >= 64 && is_dense_kv_cache(k) && is_dense_kv_cache(v) &&
                                 (uint64_t)ggml_nelements(k) * sizeof(ggml_fp16_t) <= ctx->device->properties.limits.maxStorageBufferRange &&
                                 (uint64_t)ggml_nelements(v) * sizeof(ggml_fp16_t) <= ctx->device->properties.limits.maxStorageBufferRange &&
                                 ctx->device->pipeline_fa_kv_contig_f16 != nullptr &&
@@ -12105,12 +12099,12 @@ static void ggml_vk_flash_attn(ggml_backend_vk_context * ctx, vk_context& subctx
         static int dbg_n = 0;
         if (dbg_n++ < 6) {
             fprintf(stderr, "[FA_CONTIG] neq1=%u KV=%u k_type=%d nb=[%zu %zu %zu %zu] ne=[%lld %lld %lld] "
-                            "densek=%d densev=%d kq=%d vq=%d cm2=%d pipe=%d nel=%lld -> use=%d\n",
+                            "densek=%d densev=%d kq=%d vq=%d cm2=%d pipe=%d nel=%lld -> use=%d dqkv=%d vt=%d\n",
                     neq1, nek1, (int)k->type, (size_t)k->nb[0], (size_t)k->nb[1], (size_t)k->nb[2], (size_t)k->nb[3],
                     (long long)k->ne[0], (long long)k->ne[1], (long long)k->ne[2],
                     (int)is_dense_kv_cache(k), (int)is_dense_kv_cache(v), (int)k_quant, (int)v_quant,
                     (int)ctx->device->coopmat2, (int)(ctx->device->pipeline_fa_kv_contig_f16 != nullptr),
-                    (long long)ggml_nelements(k), (int)use_f16_contig);
+                    (long long)ggml_nelements(k), (int)use_f16_contig, (int)use_dequant_kv, (int)v->type);
         }
     }
 
