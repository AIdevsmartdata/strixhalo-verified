+    // ---- stockage de la periode ----
+    std::vector<float> smp;             // NCLS * P_N * CAP
+    uint32_t  cnt[NCLS];                // echantillons stockes
+    uint64_t  ntot[NCLS];               // cycles de la periode
+    uint64_t  dropped = 0;
