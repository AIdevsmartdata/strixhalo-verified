+        }
 
         if (need_sync) {
             if (vk_enable_sync_logger) {
@@ -18200,6 +18448,191 @@ static void ggml_vk_prepare_hc_combine_fusion(ggml_backend_vk_context * ctx, ggm
     }
 }
 
+static void ggml_vk_prepare_moe_weighted_fusion(ggml_backend_vk_context * ctx, ggml_cgraph * cgraph) {
+    ctx->moe_weighted_fused.clear();
+    ctx->moe_weighted_skip.clear();
+
+#if defined(GGML_VULKAN_CHECK_RESULTS)
+    // Le checker recalculerait chaque nœud contre le CPU : des nœuds élidés
+    // produiraient des faux mismatches.
+    return;
+#endif
+    if (!ctx->device->multi_add || ctx->device->disable_fusion) {
+        return;
+    }
+    static bool mw_init = false;
+    static bool mw_disabled = false;
+    static bool mw_dbg = false;
+    if (!mw_init) {
+        mw_init = true;
+        mw_disabled = getenv("GGML_VK_DISABLE_MOE_WEIGHTED") != nullptr;
+        mw_dbg = getenv("GGML_VK_DEBUG_MOE_WEIGHTED") != nullptr;
+    }
+    if (mw_disabled) {
+        return;
+    }
