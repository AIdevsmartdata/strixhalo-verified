+static void test_user_sequence() {
+    SECTION("task sequence: one 2.4 GB entry then 0.35 GB entries with a common prefix, limit 4096 MiB");
+    const llama_tokens tM = seq(9, 2800, 21, 55171);
+    Entry M = mk(tM, 2448.0, {2048, 30000, 57971}, 113.0);
+    std::vector<Entry> sub;
+    for (int i = 0; i < 6; ++i) sub.push_back(mk(seq(70, 8000, 200 + i, 300), 350.0, {2048, 8000, 8300}, 60.0));   // 8000 common header tokens
+    for (const char * spec : {"", "DEDUP=1", "COST=1", "DEDUP=1,COST=1"}) {
+        // 4 sub-agents: all fit with LRU too (2448 + 1400 = 3848 < 4096)
+        { auto * c = mkcache(64, 131072, spec);
+          save(*c, M); c->update(); NOW(*c, 5);
+          for (int i = 0; i < 4; ++i) { save(*c, sub[i]); c->update(); NOW(*c, 10 + i * 5); }
+          CHECK(has_prompt(*c, tM));
+          CHECK(c->size() <= c->limit_size);
+          delete c; }
+        // 6 sub-agents: 2448 + 2100 = 4548 > 4096, the origin removes M, with EVIC the big session stays
+        { auto * c = mkcache(64, 131072, spec);
+          save(*c, M); c->update(); NOW(*c, 5);
+          for (int i = 0; i < 6; ++i) { save(*c, sub[i]); c->update(); NOW(*c, 10 + i * 5); CHECK(c->size() <= c->limit_size); }
+          const bool kept = has_prompt(*c, tM);
+          if (!spec[0]) CHECK(!kept); else CHECK(kept);
+          if (std::strstr(spec, "DEDUP")) CHECK(c->evic_n_dedup >= 1);
+          delete c; }
+    }
+}
