diff --git a/common/ngram-cache.cpp b/common/ngram-cache.cpp
index f28d88b2c87..6987806b75e 100644
--- a/common/ngram-cache.cpp
+++ b/common/ngram-cache.cpp
@@ -285,17 +285,19 @@ void common_ngram_cache_merge(common_ngram_cache & ngram_cache_target, common_ng
     }
 }
 
-void common_ngram_cache_bias_logits(
-    common_ngram_cache & cache, const llama_token * tokens, int n_tokens,
-    int ngram_min, int ngram_max, float alpha, llama_token_data * data, size_t n_data) {
+size_t common_ngram_cache_lookup_bias(
+    const common_ngram_cache & cache, const llama_token * tokens, int n_tokens,
+    int ngram_min, int ngram_max, float alpha,
+    std::vector<std::pair<llama_token, float>> & out) {
+    out.clear();
     if (alpha <= 0.0f || n_tokens < ngram_min) {
-        return;
+        return 0;
     }
     // stupid backoff : essayer le plus long n-gram en premier
     const int n_start = std::min(ngram_max, n_tokens);
     for (int n = n_start; n >= ngram_min; --n) {
         common_ngram ngram(tokens + n_tokens - n, n);
-        common_ngram_cache::iterator it = cache.find(ngram);
+        common_ngram_cache::const_iterator it = cache.find(ngram);
         if (it == cache.end()) {
             continue;
         }
@@ -307,22 +309,34 @@ void common_ngram_cache_bias_logits(
         if (total <= 0) {
             continue;
         }
+        out.reserve(part.size());
         for (const auto & kv : part) {
             const float p = (float) kv.second / (float) total;
-            const float bias = alpha * std::log(p);
-            const llama_token token = kv.first;
-            // chemin rapide : les donnees sont en ordre de vocabulaire (idx == id)
-            if (token >= 0 && n_data > (size_t) token && data[token].id == token) {
-                data[token].logit += bias;
-            } else {
-                for (size_t i = 0; i < n_data; ++i) {
-                    if (data[i].id == token) {
-                        data[i].logit += bias;
-                        break;
-                    }
+            out.emplace_back(kv.first, alpha * std::log(p));
+        }
+        return out.size(); // stupid backoff : premier match (plus long) suffit
+    }
+    return 0;
+}
+
+void common_ngram_cache_bias_logits(
+    common_ngram_cache & cache, const llama_token * tokens, int n_tokens,
+    int ngram_min, int ngram_max, float alpha, llama_token_data * data, size_t n_data) {
+    std::vector<std::pair<llama_token, float>> pairs;
+    common_ngram_cache_lookup_bias(cache, tokens, n_tokens, ngram_min, ngram_max, alpha, pairs);
+    for (const auto & kv : pairs) {
+        const llama_token token = kv.first;
+        const float bias = kv.second;
+        // chemin rapide : les donnees sont en ordre de vocabulaire (idx == id)
+        if (token >= 0 && n_data > (size_t) token && data[token].id == token) {
+            data[token].logit += bias;
+        } else {
+            for (size_t i = 0; i < n_data; ++i) {
+                if (data[i].id == token) {
+                    data[i].logit += bias;
+                    break;
                 }
             }
         }
-        return; // stupid backoff : premier match (plus long) suffit
     }
 }
