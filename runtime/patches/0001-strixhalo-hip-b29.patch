+// ---------------------------------------------------------------------------------------------------------------
+// MTPCU (LLAMA_OPUS_MTPCU=1, set by the speculative MTP driver): the target's per-token hidden state (h_nextn,
+// 40 KB/token for qwen4exp) goes to the draft's catch-up without a host round trip.
+//  - target side (set_nextn_dev): a decode of >= min_tokens tokens copies every ubatch's h_nextn device -> device
+//    (same stream as the compute) into nextn_dev_t, and skips the device -> host copy. A host row is fetched on
+//    demand (get_embeddings_nextn_ith: the last row of each sequence is all the driver needs after a prompt chunk).
+//  - draft side (set_nextn_dev_src): the next decode(s) fill the `mtp_h_input` tensor from the target's device
+//    buffer (device -> device, event-ordered between the two streams) instead of from a host batch.
+// Same numbers, other placement: bit-exact by construction. Anything unusual falls back to the host path.
+// ---------------------------------------------------------------------------------------------------------------
+bool llama_context::set_nextn_dev(int32_t min_tokens) {
+    if (min_tokens <= 0) {
+        nextn_dev_min = 0;
+        nextn_dev_ok  = false;
+        return true;
+    }
+    if (model.arch != LLM_ARCH_QWEN4EXP) {
+        return false;
+    }
+    nextn_dev_min = min_tokens;
+    return true;
+}
+
+bool llama_context::nextn_dev_valid(int32_t n_tokens) const {
+    return nextn_dev_ok && nextn_dev_rows == n_tokens;
+}
+
+void llama_context::nextn_dev_materialize(int64_t row0, int64_t n) {
+    GGML_ASSERT(nextn_dev_t && embd_nextn.data && n >= 0);
+    const size_t n_embd_out = model.hparams.n_embd_out();
+    const size_t row_bytes  = n_embd_out * sizeof(float);
+    GGML_ASSERT((size_t) (row0 + n) * n_embd_out <= embd_nextn.size);
+    // the rows were written by the compute stream: wait for it (idempotent when already synchronized)
+    ggml_backend_synchronize(nextn_dev_backend);
+    ggml_backend_tensor_get(nextn_dev_t, embd_nextn.data + (size_t) row0 * n_embd_out, (size_t) row0 * row_bytes, (size_t) n * row_bytes);
+}
+
+bool llama_context::set_nextn_dev_src(llama_context * tgt, const float * head, int64_t src_row0, int64_t total) {
