+// channel is owned by one thread, which reads all its values before its first store.
+template <int T>
+static __global__ void __launch_bounds__(256) gdn_gather_concat_f32(
+        const float * cache, const int32_t * ids, const float * x, float * dst,
+        const int C, const int64_t cache_stride, const int64_t x_stride,
+        const ggml_cuda_concat_tail_cpys cpys) {
