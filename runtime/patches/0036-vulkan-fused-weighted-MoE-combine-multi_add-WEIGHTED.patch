+        uint32_t ne = ggml_nelements(dst);
+        if (ne > 262144) {
+            elements = { 512, 512, CEIL_DIV(ne, 262144) };
+        } else if (ne > 512) {
+            elements = { 512, CEIL_DIV(ne, 512), 1 };
+        } else {
