+    ggml_vk_prepare_gdn_state_fusion(ctx, cgraph);
 
     for (int i = 0; i < cgraph->n_nodes; i++) {
         if (first_node_in_batch) {
@@ -18106,6 +18302,10 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
         if (ctx->gdn_cache_skip.count(cgraph->nodes[i])) {
             continue;
         }
