+#pragma once
+
+#include "draft-policy.h"
+#include "draft-policy-a3.h"
+#include "ggml-opus-flags.h"
+#include "log.h"
+#include <nlohmann/json.hpp>
+#include <cstdlib>
+#include <fstream>
+#include <iterator>
+#include <utility>
+#include <map>
+#include <stdexcept>
+#include <string>
+
+namespace opus_draft_policy {
+
+struct cost_table {
+    // concurrency -> depth -> width-1-indexed costs
+    std::map<int, std::map<int, std::vector<double>>> cells;
+
+    static cost_table load(const std::string & path) {
+        std::ifstream stream(path);
+        if (!stream) { throw std::runtime_error("cannot open cost JSON"); }
+        nlohmann::json j;
+        j = nlohmann::json::parse(stream);
+        if (j.at("version") != 1 || !j.at("rows").is_array() || j.at("rows").empty()) {
+            throw std::runtime_error("invalid cost table version/rows");
+        }
+        cost_table out;
+        for (const auto & row : j.at("rows")) {
+            if (!row.at("concurrency").is_number_integer() || !row.at("depth").is_number_integer()) {
+                throw std::runtime_error("non-integer concurrency/depth");
+            }
+            const auto c64 = row.at("concurrency").get<int64_t>();
+            const auto d64 = row.at("depth").get<int64_t>();
+            if (c64 < 1 || c64 > 64 || d64 < 0 || d64 > std::numeric_limits<int>::max()) {
+                throw std::runtime_error("out-of-range concurrency/depth");
+            }
+            const int c = (int) c64;
+            const int d = (int) d64;
+            const auto & ms = row.at("milliseconds");
+            if (c < 1 || c > 64 || d < 0 || !ms.is_array() || ms.empty() || ms.size() > 1024 || out.cells[c].count(d)) {
+                throw std::runtime_error("invalid/duplicate cost row");
+            }
+            std::vector<double> values;
+            double prev = 0;
+            for (const auto & v : ms) {
+                if (v.is_null()) {
+                    values.push_back(std::numeric_limits<double>::quiet_NaN());
+                } else {
+                    if (!v.is_number()) { throw std::runtime_error("non-numeric cost"); }
+                    const double x = v.get<double>();
+                    if (!std::isfinite(x) || x <= 0 || x < prev) {
+                        throw std::runtime_error("non-positive/non-monotonic cost");
+                    }
+                    values.push_back(x);
+                    prev = x;
+                }
+            }
+            // Interior width interpolation only. No invented AR baseline.
+            int left = -1;
+            for (int k = 0; k < (int) values.size(); ++k) {
+                if (!std::isfinite(values[k])) { continue; }
+                if (left >= 0) {
+                    for (int i = left + 1; i < k; ++i) {
+                        values[i] = values[left] + (values[k] - values[left]) * (i - left) / (k - left);
+                    }
+                }
+                left = k;
+            }
+            out.cells[c][d] = std::move(values);
+        }
+        return out;
+    }
+
+    std::vector<double> at(int concurrency, int depth, bool & depth_clamped) const {
+        depth_clamped = false;
+        const auto c = cells.find(concurrency);
+        if (c == cells.end()) { return {}; }
+        const auto & depths = c->second;
+        auto hi = depths.lower_bound(depth);
+        if (hi == depths.end()) {
+            depth_clamped = true;
+            return depths.rbegin()->second;
+        }
+        if (hi->first == depth) { return hi->second; }
+        if (hi == depths.begin()) {
+            depth_clamped = true;
+            return hi->second;
+        }
+        const auto lo = std::prev(hi);
+        std::vector<double> result(std::min(lo->second.size(), hi->second.size()));
+        const double fraction = double(depth - lo->first) / (hi->first - lo->first);
+        for (size_t i = 0; i < result.size(); ++i) {
+            result[i] = lo->second[i] + fraction * (hi->second[i] - lo->second[i]);
+        }
+        return result;
+    }
+};
+
+struct config {
+    bool enabled = false;
+    bool a3 = false;
+    bool per_slot = false;
+    double restore_ms = 0;
+    std::map<int, std::map<int, cycle_cell>> cycle_costs;
+    cost_table costs;
+
+    bool cycle_at(int c, int depth, cycle_cell & out) const {
+        const auto it = cycle_costs.find(c);
+        if (it == cycle_costs.end() || it->second.empty()) { return false; }
+        const auto & ds = it->second;
+        auto hi = ds.lower_bound(depth);
+        // No extrapolation to unmeasured long contexts.
+        if (hi == ds.end() || (hi == ds.begin() && hi->first != depth)) { return false; }
+        if (hi->first == depth) { out = hi->second; return true; }
+        const auto lo = std::prev(hi);
+        const double f = double(depth-lo->first)/(hi->first-lo->first);
+        out = lo->second;
+        for (int n = 0; n < 8; ++n) {
+            out.target[n] += f*(hi->second.target[n]-out.target[n]);
+            out.catchup[n] += f*(hi->second.catchup[n]-out.catchup[n]);
+            out.proposal[n] += f*(hi->second.proposal[n]-out.proposal[n]);
+            out.verify[n] += f*(hi->second.verify[n]-out.verify[n]);
+            out.checkpoint[n] += f*(hi->second.checkpoint[n]-out.checkpoint[n]);
+        }
+        return true;
+    }
+};
+
+// Process-latched policy and file; registry category d documents server scope.
+// Changing the JSON or the switch requires a fresh process for a measured arm.
+inline const config & settings() {
+    static const config cfg = [] {
+        config r;
+        if (GGML_OPUS_INT("LLAMA_OPUS_DRAFTPOL", 0) != 1) { return r; }
+        const char * replay = std::getenv("LLAMA_OPUS_REPLAY_RNG");
+        const char * path = std::getenv("LLAMA_OPUS_DRAFTPOL_COSTS");
+        if (!replay || std::atoi(replay) == 0 || !path || !*path) {
+            LOG_WRN("%s", "[DRAFTPOL] disabled: REPLAY_RNG=1 and DRAFTPOL_COSTS required\n");
+            return r;
+        }
+        try {
+            r.a3 = GGML_OPUS_INT("LLAMA_OPUS_DRAFTPOL_A3", 0) == 1;
+            if (!r.a3) {
+                r.costs = cost_table::load(path);
+            } else {
+                std::ifstream stream(path);
+                const auto j = nlohmann::json::parse(stream);
+                if (j.at("version") != 2 || j.at("cost_scope") != "cycle_components" || j.at("rollback_depth") != 2) {
+                    throw std::runtime_error("A3 requires version 2 cycle components");
+                }
+                r.restore_ms = j.at("restore_ms").get<double>();
+                if (!std::isfinite(r.restore_ms) || r.restore_ms < 0) { throw std::runtime_error("bad restore cost"); }
+                for (const auto & row : j.at("rows")) {
+                    const int c = row.at("concurrency").get<int>();
+                    const int d = row.at("depth").get<int>();
+                    if (c < 1 || c > 8 || d < 0 || r.cycle_costs[c].count(d)) { throw std::runtime_error("bad/duplicate cycle cell"); }
+                    cycle_cell cell;
+                    auto read = [&](const char * name, std::array<double, 8> & dst, bool positive) {
+                        const auto & a = row.at(name);
+                        if (!a.is_array() || a.size() != 8) { throw std::runtime_error("cycle component needs 8 widths"); }
+                        for (int n = 0; n < 8; ++n) {
+                            dst[n] = a[n].get<double>();
+                            if (!std::isfinite(dst[n]) || dst[n] < 0 || (positive && dst[n] == 0)) {
+                                throw std::runtime_error("invalid cycle component");
+                            }
+                        }
+                    };
+                    read("target_ms", cell.target, true); read("catchup_ms", cell.catchup, false);
+                    read("proposal_ms", cell.proposal, false); read("verify_ms", cell.verify, false);
+                    read("checkpoint_ms", cell.checkpoint, false);
+                    if (cell.proposal[0] != 0) { throw std::runtime_error("AR has no proposal"); }
+                    for (int n = 1; n < 8; ++n) {
+                        if (cell.proposal[n] < cell.proposal[n-1]) { throw std::runtime_error("nonmonotonic cumulative proposals"); }
+                    }
+                    r.cycle_costs[c][d] = cell;
+                }
+                if (r.cycle_costs.empty()) { throw std::runtime_error("empty cycle table"); }
+                r.per_slot = GGML_OPUS_INT("LLAMA_OPUS_DRAFTPOL_SLOTS", 0) == 1;
+            }
+            r.enabled = true;
+            LOG_INF("%s", "[DRAFTPOL] enabled (request-local EMA, cohort cost JSON, process-latched)\n");
+        } catch (const std::exception & e) {
+            LOG_WRN("[DRAFTPOL] disabled: %s\n", e.what());
+        }
+        return r;
+    }();
+    return cfg;
+}
+
+} // namespace opus_draft_policy
