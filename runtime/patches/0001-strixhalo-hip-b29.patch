+    const int64_t vs  = std::max(v0, head);       // first virtual row served by the device
+    const int64_t cnt = v0 + n - vs;
+    if (cnt > 0) {
+        if (!nextn_view_ctx) {
+            ggml_init_params ip = { /*.mem_size =*/ 16 * ggml_tensor_overhead(), /*.mem_buffer =*/ nullptr, /*.no_alloc =*/ true };
+            nextn_view_ctx.reset(ggml_init(ip));
+        }
+        ggml_reset(nextn_view_ctx.get());
+        ggml_tensor * dev = nextn_req_tgt->nextn_dev_t;
+        const int64_t src_row = nextn_req_row0 + (vs - head);
+        GGML_ASSERT(src_row >= 0 && src_row + cnt <= dev->ne[1]);
