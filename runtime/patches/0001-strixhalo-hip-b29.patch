+#define FFN_TAIL_LAUNCH(KP_) \
+    ggml_cuda_kernel_launch(full ? hc_ffn_tail_f32_b256<KP_, true> : hc_ffn_tail_f32_b256<KP_, false>, lp, \
+        (const float *) a.experts->data, a.expert_scale ? (const float *) a.expert_scale->data : nullptr, \
+        (const float *) a.weights->data, (int) a.experts->ne[1], \
+        (const float *) a.gate_w->data, (const float *) a.gate_y->data, (int) (a.gate_w->ne[0] / 2), (const float *) a.shexp->data, \
+        (const float *) a.cn.inject->data, (const float *) a.cn.residual->data, (const float *) a.cn.gamma->data, \
+        (float *) a.cn.out_res->data, (float *) a.cn.out_xn->data, a.cn.out_xn_bf16, a.cn.store_xn_f32, \
+        (int) n_embd, a.cn.s1, a.cn.b1, a.cn.s2, a.cn.b2, a.cn.eps)
+    switch (kp) {
+        case 2: FFN_TAIL_LAUNCH(2); break;
+        case 3: FFN_TAIL_LAUNCH(3); break;
+        case 4: FFN_TAIL_LAUNCH(4); break;
+        case 5: FFN_TAIL_LAUNCH(5); break;
+        case 6: FFN_TAIL_LAUNCH(6); break;
+        default: GGML_ABORT("ffn_tail: unsupported n_embd %d", (int) n_embd);
+    }
+#undef FFN_TAIL_LAUNCH
+}
