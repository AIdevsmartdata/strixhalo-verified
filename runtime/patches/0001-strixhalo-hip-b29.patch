+// [PPFLOOR] bit 2 (CKPOOL): pool of resident checkpoint buffers (see common.h)
+namespace {
+struct ckpt_pool_t {
+    std::mutex mu;
+    std::vector<std::vector<uint8_t>> spare;   // each entry has size() == its payload size (never cleared, so no re-zeroing)
+    int  n_refill_running = 0;                 // background fills in flight
+    uint64_t n_give = 0, n_take_hit = 0, n_take_miss = 0, n_refill = 0;
+    uint64_t n_keep_res = 0, n_keep_extra = 0, n_reaped = 0, n_left = 0;   // [CKFREE] (counted only when LLAMA_OPUS_CKFREE != 0)
+};
+ckpt_pool_t & ckpt_pool() {
+    static ckpt_pool_t * p = new ckpt_pool_t();   // leaked on purpose: a detached refill thread may outlive main()
+    return *p;
+}
+size_t ckpt_pool_cap() {
+    return (size_t) std::max<int32_t>(1, std::min<int32_t>(4, GGML_OPUS_INT("LLAMA_OPUS_PPFLOOR_SPARES", 2)));
+}
+constexpr size_t CKPT_POOL_MIN = (size_t) 4 << 20;   // below 4 MiB a fresh vector is cheap: not worth pooling
+
+// [CKFREE] LLAMA_OPUS_CKFREE (absent or 0 = original code ; read once from the environment) :
+//   bit 1 : the surplus buffer of a full pool is freed by a dedicated thread, not by erase() on the server thread ;
+//   bit 2 : give keeps up to ckpt_pool_cap() + LLAMA_OPUS_CKFREE_EXTRA (default 2, 0..4) buffers, take and refill keep ckpt_pool_cap()
+//           (asymmetric margin: the buffers erased by the 1st checkpoint of a turn are kept, and they replace the background refills).
+// Only the lifetime of host buffers changes: every byte of a pooled buffer is rewritten before it is read (update_tgt: n == ckpt_size).
+int32_t ckfree_env(const char * name, int32_t def, int32_t lo, int32_t hi) {
+    const char * s = std::getenv(name);
+    return std::max(lo, std::min(hi, s ? (int32_t) std::atoi(s) : def));
+}
+int32_t ckfree_bits() {
+    static const int32_t b = ckfree_env("LLAMA_OPUS_CKFREE", 0, 0, INT32_MAX) & 3;
+    return b;
+}
+size_t ckpt_pool_cap_give() {
+    static const size_t extra = (ckfree_bits() & 2) ? (size_t) ckfree_env("LLAMA_OPUS_CKFREE_EXTRA", 2, 0, 4) : 0;
+    return ckpt_pool_cap() + extra;
+}
+struct ckpt_reaper_t {
+    std::mutex mu;
+    std::condition_variable cv;
+    std::deque<std::vector<uint8_t>> q;
+    bool started = false;
+};
+ckpt_reaper_t & ckpt_reaper() {
+    static ckpt_reaper_t * r = new ckpt_reaper_t();   // leaked on purpose (same pattern as ckpt_pool)
+    return *r;
+}
+void ckpt_reaper_loop() {
+    auto & r = ckpt_reaper();
+    std::unique_lock<std::mutex> lk(r.mu);
+    for (;;) {
+        r.cv.wait(lk, [&r] { return !r.q.empty(); });
+        {
+            std::vector<uint8_t> v = std::move(r.q.front());
+            r.q.pop_front();
+            lk.unlock();
+        }   // v (~112 MiB) is freed here, off the server thread
+        lk.lock();
+    }
+}
+// moves v to the reaper thread (started once) ; false = no thread: v is left untouched (the caller frees it, as before)
+bool ckpt_reap(std::vector<uint8_t> & v) {
+    auto & r = ckpt_reaper();
+    {
+        std::lock_guard<std::mutex> lk(r.mu);
+        if (!r.started) {
+            try {
+                std::thread(ckpt_reaper_loop).detach();
+            } catch (...) {
+                return false;
+            }
+            r.started = true;
+        }
+        r.q.push_back(std::move(v));
+    }
+    r.cv.notify_one();
+    return true;
+}
+}
+
+bool common_ckpt_pool_on() {
+    static const bool on = [] {
+        int32_t m = GGML_OPUS_INT("LLAMA_OPUS_PPFLOOR", 0);
+        if (m == 0) {
+            m = GGML_OPUS_INT("GGML_OPUS_PPFLOOR", 0);
+        }
+        return (m & 2) != 0;
+    }();
+    return on;
+}
+
+void common_ckpt_pool_give(std::vector<uint8_t> && v) {
+    if (!common_ckpt_pool_on() || v.size() < CKPT_POOL_MIN) {
+        return;
+    }
+    auto & p = ckpt_pool();
+    const int32_t bits = ckfree_bits();
+    if (bits == 0) {   // LLAMA_OPUS_CKFREE absent or 0: original code
+        std::lock_guard<std::mutex> lk(p.mu);
+        p.n_give++;
+        if (p.spare.size() < ckpt_pool_cap()) {
+            p.spare.push_back(std::move(v));
+        }   // else: v stays in the erased checkpoint and is freed by erase() on the caller's (server) thread
+        return;
+    }
+    // [CKFREE] act : 0 = pool below its cap (original), 1 = kept in the margin (bit 2), 2 = freed off-thread (bit 1), 3 = left to erase()
+    int act = 3;
+    {
+        std::lock_guard<std::mutex> lk(p.mu);
+        if (p.spare.size() < ckpt_pool_cap_give()) {
+            act = p.spare.size() < ckpt_pool_cap() ? 0 : 1;
+            p.spare.push_back(std::move(v));
+        } else if (bits & 1) {
+            act = 2;
+        }
+    }
+    if (act == 2 && !ckpt_reap(v)) {
+        act = 3;
+    }
+    static const uint64_t log_every = (uint64_t) ckfree_env("LLAMA_OPUS_CKFREE_LOG", 64, 1, 1 << 20);
+    uint64_t c[8];
+    {
+        std::lock_guard<std::mutex> lk(p.mu);
+        p.n_give++;
+        (act == 0 ? p.n_keep_res : act == 1 ? p.n_keep_extra : act == 2 ? p.n_reaped : p.n_left)++;
+        c[0] = p.n_give; c[1] = p.n_keep_res; c[2] = p.n_keep_extra; c[3] = p.n_reaped; c[4] = p.n_left;
+        c[5] = p.spare.size(); c[6] = p.n_take_hit; c[7] = p.n_refill;
+    }
+    if (c[0] == 1) {
+        COM_INF("[CKFREE] actif bits=%d cap=%zu cap_give=%zu log=%" PRIu64 "\n", bits, ckpt_pool_cap(), ckpt_pool_cap_give(), log_every);
+    }
+    if (c[0] % log_every == 0) {
+        COM_INF("[CKFREE] gives=%" PRIu64 " reserve=%" PRIu64 " marge=%" PRIu64 " hors_fil=%" PRIu64 " laisses=%" PRIu64 " spare=%" PRIu64
+                " take_hit=%" PRIu64 " refill=%" PRIu64 "\n", c[0], c[1], c[2], c[3], c[4], c[5], c[6], c[7]);
+    }
+}
+
+bool common_ckpt_pool_take(std::vector<uint8_t> & v, size_t n) {
+    if (!common_ckpt_pool_on() || n < CKPT_POOL_MIN) {
+        return false;
+    }
+    auto & p = ckpt_pool();
+    std::lock_guard<std::mutex> lk(p.mu);
+    for (size_t i = 0; i < p.spare.size(); ++i) {
+        if (p.spare[i].size() == n) {
+            v = std::move(p.spare[i]);
+            p.spare.erase(p.spare.begin() + i);
+            p.n_take_hit++;
+            return true;
+        }
+    }
+    p.n_take_miss++;
+    return false;
+}
+
+void common_ckpt_pool_refill(size_t n) {
+    if (!common_ckpt_pool_on() || n < CKPT_POOL_MIN) {
+        return;
+    }
+    auto & p = ckpt_pool();
+    {
+        std::lock_guard<std::mutex> lk(p.mu);
+        if (p.spare.size() + (size_t) p.n_refill_running >= ckpt_pool_cap()) {
+            return;
+        }
+        p.n_refill_running++;
+    }
+    // the page faults (~15 ms for 118 MB) happen on this thread, not on the server loop
+    std::thread([n]() {
+        std::vector<uint8_t> v;
+        try {
+            v.resize(n);
+        } catch (...) {
+            v.clear();
+        }
+        auto & p = ckpt_pool();
+        std::lock_guard<std::mutex> lk(p.mu);
+        p.n_refill_running--;
+        if (v.size() == n && p.spare.size() < ckpt_pool_cap()) {
+            p.n_refill++;
+            p.spare.push_back(std::move(v));
+        }
+    }).detach();
+}
