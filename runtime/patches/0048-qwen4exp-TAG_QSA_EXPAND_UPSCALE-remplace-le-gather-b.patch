From 40129aa8e66e57a4936dc0a25158a0c82d755783 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?K=C3=A9vin=20R=C3=A9mondi=C3=A8re?= <kevin@localhost>
Date: Sat, 19 Sep 2026 12:23:47 +0200
Subject: [PATCH 48/54] qwen4exp: TAG_QSA_EXPAND_UPSCALE - remplace le gather
 bloc->cellule par un upscale NEAREST (valeurs identiques)

---
 src/models/qwen4exp.cpp | 27 ++++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 8767790690e..96b31cd90ff 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -598,6 +598,7 @@ llama_model_qwen4exp::graph_mtp::graph_mtp(const llama_model & model, const llm_
     ggml_set_name(inp->h, "mtp_h_input");
 
     ggml_tensor * tok_embd = ggml_get_rows(ctx0, model.tok_embd, inp->tokens);
+    cb(tok_embd, "tok_embd", 0);
     cb(tok_embd, "mtp_tok_embd", il);
 
     ggml_tensor * h = inp->h;
@@ -660,6 +661,7 @@ llama_model_qwen4exp::graph_mtp::graph_mtp(const llama_model & model, const llm_
 
     if (inp_out_ids) {
         flat = ggml_get_rows(ctx0, flat, inp_out_ids);
+        cb(flat, "out_ids_filter", 0);
         inpL = ggml_reshape_3d(ctx0, flat, n_embd, hc, n_outputs);
     }
 
@@ -1204,6 +1206,7 @@ ggml_tensor * llama_model_qwen4exp::graph::build_qsa_top_k(
         const int64_t n_wr = inp->wr_n;
 
         ggml_tensor * bm = ggml_get_rows(ctx0, k_all, inp->wr_members);
+        cb(bm, "qsa_blk_members", il);
         bm = ggml_reshape_3d(ctx0, bm, idx_dim, r, n_wr);
 
         ggml_tensor * bsum = nullptr;
@@ -1328,7 +1331,27 @@ ggml_tensor * llama_model_qwen4exp::graph::build_qsa_top_k(
     if (!qsa_no_cont) {
         score_p = ggml_cont(ctx0, score_p);
     }
-    ggml_tensor * expanded = ggml_get_rows(ctx0, score_p, inp->cell_blk);
+    // [TAG_QSA_EXPAND_UPSCALE] cell_blk[c] = c/r (cellule = position : l'assert du fork "qsa: cell
+    // position runs past the cell window" le garantit, et la construction cote hote ne pose
+    // dead_bid que pour les cellules non ecrites, qui sont masquees). L'expansion bloc -> cellule
+    // est donc une SIMPLE REPETITION de chaque colonne r fois, pas un gather : au decode elle
+    // relisait jusqu'a 262144 indices par couche et par pas (mesure : 92 us a 32k, 180 us a 64k,
+    // 12 couches -> 1,1 a 2,2 ms/pas = 4-8 % du decodage).
+    // ggml_upscale_ext avec NEAREST produit exactement la meme valeur au meme rang.
+    // Valeurs identiques pour toute cellule ecrite => SHA attendu invariant.
+    static const bool qsa_expand_up = [] {
+        const char * e = getenv("LLAMA_QSA_EXPAND_UPSCALE");
+        return e != nullptr && atoll(e) != 0;
+    }();
+
+    ggml_tensor * expanded;
+    if (qsa_expand_up) {
+        // score_p est [n_tps, n_blocks] : on etend la dimension 1 (les blocs) a n_kv cellules.
+        expanded = ggml_upscale_ext(ctx0, score_p, (int) score_p->ne[0], (int) n_kv, 1, 1,
+                                    GGML_SCALE_MODE_NEAREST);
+    } else {
+        expanded = ggml_get_rows(ctx0, score_p, inp->cell_blk);
+    }
     expanded = ggml_permute(ctx0, expanded, 1, 0, 2, 3);
     if (!qsa_no_cont) {
         expanded = ggml_cont(ctx0, expanded);
@@ -2180,10 +2203,12 @@ ggml_tensor * llama_model_qwen4exp::graph::build_ple(
                 ggml_tensor * idx_h = ggml_view_2d(ctx0, rows2d, 1, n_tokens, rows2d->nb[1], h * rows2d->nb[0]);
                 idx_h = ggml_reshape_1d(ctx0, ggml_cont(ctx0, idx_h), n_tokens);
                 ggml_tensor * emb_h = ggml_get_rows(ctx0, qmodel.ple_ngram_embd[h], idx_h);
+                cb(emb_h, "ple_ngram", il);
                 emb = emb ? ggml_concat(ctx0, emb, emb_h, 0) : emb_h;
             }
         } else {
             emb = ggml_get_rows(ctx0, model.per_layer_tok_embd, rows);
+            cb(emb, "ple_tok", il);
         }
     }
     emb = ggml_reshape_2d(ctx0, emb, hparams.ple_head_dim * n_heads, n_tokens);
-- 
