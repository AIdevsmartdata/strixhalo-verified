+        (const float *) cache->data, (const int32_t *) ids->data, (const float *) x->data, \
+        (float *) concat->data, C, cache->nb[1] / sizeof(float), x->nb[0] / sizeof(float), cpys)
+    switch (x->ne[0]) {
+        case 1: GDN_GATHER_LAUNCH(1); break;
+        case 2: GDN_GATHER_LAUNCH(2); break;
+        case 3: GDN_GATHER_LAUNCH(3); break;
+        case 4: GDN_GATHER_LAUNCH(4); break;
+        case 5: GDN_GATHER_LAUNCH(5); break;
+        case 6: GDN_GATHER_LAUNCH(6); break;
+        case 7: GDN_GATHER_LAUNCH(7); break;
+        case 8: GDN_GATHER_LAUNCH(8); break;
