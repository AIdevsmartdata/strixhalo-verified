+// tampon de morceaux, un par (peripherique, flux), alloue au premier usage hors capture de graphe ; nullptr => lancement d'origine
+struct opus_moevec_buf {
+    int          dev;
+    cudaStream_t stream;
+    int32_t *    desc;
+};
+
+template <int max_pairs>
+static int32_t * opus_moevec_desc_buffer(cudaStream_t stream) {
+    static std::mutex mu;
+    static std::vector<opus_moevec_buf> bufs;
+    const int dev = ggml_cuda_get_device();
+    std::lock_guard<std::mutex> lk(mu);
+    for (const opus_moevec_buf & b : bufs) {
+        if (b.dev == dev && b.stream == stream) {
+            return b.desc;
+        }
+    }
+    cudaStreamCaptureStatus capture = cudaStreamCaptureStatusNone;
+    if (cudaStreamIsCapturing(stream, &capture) != cudaSuccess || capture != cudaStreamCaptureStatusNone) {
+        (void) cudaGetLastError();
+        return nullptr;
+    }
+    int32_t * p = nullptr;
+    if (cudaMalloc(&p, (2 + max_pairs*OPUS_MOEVEC_DSTRIDE)*sizeof(int32_t)) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return nullptr;
+    }
+    bufs.push_back({dev, stream, p});
+    return p;
+}
