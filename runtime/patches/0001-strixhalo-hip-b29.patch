+                var += (char) toupper((unsigned char) *c);
+            }
+            t.per[k] = opus_mmid_maxb_parse(getenv(var.c_str()));
+            t.any = t.any || t.per[k] > 0;
+        }
+        t.all = t.all < 0 ? 0 : t.all;
