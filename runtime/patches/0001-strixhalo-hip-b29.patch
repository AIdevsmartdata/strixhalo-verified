+static int g_burst_limit = 64;                                          // scaled MiB (64 = 4096 MiB); --replay-burst LIMIT changes it
+static void test_burst_replay() {
+    SECTION("burst scenario (M, 2 rounds of 5 sub-agents sharing an 8000 token header, limit 4096 MiB, real server order): M must come back at M3 and M4");
+    // sub-agent state after 2 turns: 8330 tokens, 710 vMiB with 3 checkpoints; M: 2449 vMiB, M3: 2459 vMiB
+    // Order: the state of a finished request is saved at the NEXT launch, after that launch took from the cache. So M3 finds only 4 sub-agents of round 1
+    // (the 5th is saved right after), M3's own state is saved at the first launch of round 2, and M4 finds 4 of the 5 sub-agents of round 2.
+    const llama_tokens tM = seq(70, 8000, 21, 49971);                      // 57971 tokens, same 8000 token header as the sub-agents
+    const llama_tokens tM3 = seq(70, 8000, 21, 49971 + 831), tM4 = seq(70, 8000, 21, 49971 + 831 + 852);
+    for (const char * spec : {"", "DEDUP=1", "COST=1", "DEDUP=1,COST=1"}) {
+        auto * c = mkcache(g_burst_limit, 131072, spec);
+        const size_t lim = c->limit_size;
+        Entry M = mk(tM, 2448.553, {2048, 10240, 18432, 26624, 34816, 43008, 51200, 57971}, 113.0);
+        save(*c, M); c->update();
+        double t = 30;
+        auto sub = [&](int rnd, int i) { t += 15; NOW(*c, t); Entry sa = mk(seq(70, 8000, 100 * rnd + i, 330), 710.0, {2048, 8000, 8330}, 113.0); save(*c, sa); c->update(); CHECK(c->size() <= lim); };
+        for (int i = 0; i < 4; ++i) sub(2, i);                                 // round 1: 4 states saved before the M3 launch
+        t += 15; NOW(*c, t);
+        const bool m3 = take_best(*c, tM3) == 57971;
+        sub(2, 4);                                                             // the 5th sub-agent of round 1, saved at the M3 launch
+        Entry M3 = mk(tM3, 2459.0, {2048, 10240, 18432, 26624, 34816, 43008, 51200, 58802}, 113.0);
+        t += 15; NOW(*c, t); save(*c, M3); c->update();                        // first launch of round 2
+        for (int i = 0; i < 4; ++i) sub(3, i);
+        t += 15; NOW(*c, t);
+        const bool m4 = take_best(*c, tM4) == 58802;
+        sub(3, 4);
+        if (g_verbose) printf("%-16s M3 %s, M4 %s, dedup %d cost %d protect %d reject %d\n", spec[0] ? spec : "OFF", m3 ? "HIT" : "miss", m4 ? "HIT" : "miss", c->evic_n_dedup, c->evic_n_cost, c->evic_n_protect, c->evic_n_reject);
+        if (g_burst_limit == 64) { if (!spec[0]) { CHECK(!m3); CHECK(!m4); } else { CHECK(m3); CHECK(m4); } }   // the origin loses M twice; dedup alone, cost alone and both keep it
+        if (g_burst_limit == 64 && std::strstr(spec, "DEDUP")) CHECK(c->evic_n_dedup >= 1);
+        delete c;
+    }
+}
