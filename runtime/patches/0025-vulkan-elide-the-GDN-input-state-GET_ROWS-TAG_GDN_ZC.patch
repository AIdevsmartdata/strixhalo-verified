+// [TAG_GDN_ZC] Input-side fusion: elide the GET_ROWS that gathers the GDN input
+// state from the recurrent ring, and have the kernel read the ring row directly
+// (row index taken from the runtime I32 vector).
+//
+// Restricted to single-sequence decode (n_seq_tokens == 1 && n_seqs == 1): the
+// kernel writes only ring row "head" (slot 0), and it reads row
+// "idx*mem_size + src0". Either the rows differ, or they are the same row of the
+// one and only sequence, in which case the reads and writes belong to the same
+// workgroup and are ordered sequentially inside it. No cross-workgroup hazard.
+static void ggml_vk_prepare_gdn_state_fusion(ggml_backend_vk_context * ctx, ggml_cgraph * cgraph) {
+    ctx->gdn_state_fused.clear();
+    ctx->gdn_state_skip.clear();
+
+#if defined(GGML_VULKAN_CHECK_RESULTS)
+    // The checker recomputes every node against the CPU; an elided gather would
+    // leave the GDN's state input never computed and produce false mismatches.
+    return;
+#endif
+    if (ctx->device->disable_fusion || ctx->device->disable_gdn_cache_fusion) {
+        return;
+    }
+
+    static bool dbg_init = false;
+    static bool dbg = false;
+    if (!dbg_init) {
+        dbg_init = true;
+        dbg = getenv("GGML_VK_DEBUG_GDN_CACHE") != nullptr;
+    }
+
+    struct chain_t {
+        const ggml_tensor * gdn;
+        const ggml_tensor * getrows;
+        std::vector<const ggml_tensor *> views; // chain nodes between gather and GDN
+    };
+    std::vector<chain_t> chains;
+
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        const ggml_tensor * gdn = cgraph->nodes[i];
+        if (gdn->op != GGML_OP_GATED_DELTA_NET) {
+            continue;
+        }
+        const ggml_tensor * src_v = gdn->src[2];
+        if (!src_v || src_v->ne[2] != 1 || src_v->ne[3] != 1) {
+            continue; // decode, single sequence only
+        }
+
+        // walk back through view/reshape ops to the state producer
+        chain_t chain { gdn, nullptr, {} };
+        const ggml_tensor * t = gdn->src[5];
+        while (t && (t->op == GGML_OP_RESHAPE || t->op == GGML_OP_VIEW ||
+                    t->op == GGML_OP_PERMUTE || t->op == GGML_OP_TRANSPOSE)) {
+            chain.views.push_back(t);
+            t = t->view_src;
+        }
+        if (!t || t->op != GGML_OP_GET_ROWS) {
+            continue;
+        }
+        chain.getrows = t;
+
+        const ggml_tensor * ring = chain.getrows->src[0];
+        const ggml_tensor * idx  = chain.getrows->src[1];
+        if (!ring || !idx) {
+            continue;
+        }
+        // ring: contiguous 2D F32 [D, n_rows]
+        if (ring->type != GGML_TYPE_F32 || ring->ne[2] != 1 || ring->ne[3] != 1 ||
+            ring->nb[1] != (size_t)ggml_row_size(GGML_TYPE_F32, ring->ne[0])) {
+            continue;
+        }
+        // index vector: I32 with a single entry (n_seqs == 1)
+        if (idx->type != GGML_TYPE_I32 || idx->ne[0] != 1 ||
+            idx->ne[1] != 1 || idx->ne[2] != 1 || idx->ne[3] != 1) {
+            continue;
+        }
+        // gathered output: contiguous 2D F32 [D, 1]
+        if (chain.getrows->type != GGML_TYPE_F32 ||
+            chain.getrows->ne[1] != 1 || chain.getrows->ne[2] != 1 || chain.getrows->ne[3] != 1 ||
+            chain.getrows->nb[1] != (size_t)ggml_row_size(GGML_TYPE_F32, chain.getrows->ne[0])) {
+            continue;
+        }
+        if (ring->ne[0] != chain.getrows->ne[0]) {
+            continue;
+        }
+        // GDN state geometry must match [S_v, S_v, H, 1]
+        const int64_t S_v = src_v->ne[0];
+        const int64_t H   = src_v->ne[1];
+        if (gdn->src[5]->ne[0] != S_v || gdn->src[5]->ne[1] != S_v ||
+            gdn->src[5]->ne[2] != H   || gdn->src[5]->ne[3] != 1) {
+            continue;
+        }
+
+        chains.push_back(chain);
+    }
+    if (chains.empty()) {
+        return;
+    }
+
+    // The gathered state (and its view chain) must feed this GDN and nothing else.
+    auto const &is_chain_link = [&](const ggml_tensor * t, const chain_t *& owner) -> bool {
+        for (const auto & c : chains) {
+            if (t == c.getrows || std::find(c.views.begin(), c.views.end(), t) != c.views.end()) {
+                owner = &c;
+                return true;
+            }
+        }
+        return false;
+    };
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        const ggml_tensor * n = cgraph->nodes[i];
+        for (uint32_t j = 0; j < GGML_MAX_SRC; j++) {
+            const ggml_tensor * src = n->src[j];
+            if (!src) {
+                continue;
+            }
+            const chain_t * owner = nullptr;
+            if (!is_chain_link(src, owner)) {
+                continue;
+            }
+            // allowed: the chain itself (view -> its view_src) and the GDN head
+            const bool chain_edge =
+                (n->op == GGML_OP_RESHAPE || n->op == GGML_OP_VIEW ||
+                 n->op == GGML_OP_PERMUTE || n->op == GGML_OP_TRANSPOSE) &&
+                std::find(owner->views.begin(), owner->views.end(), n) != owner->views.end();
+            const bool gdn_edge = n == owner->gdn && j == 5;
+            if (!chain_edge && !gdn_edge) {
+                if (dbg) {
+                    fprintf(stderr, "[GDN_CACHE] state gather has an extra consumer, fusion disabled\n");
+                }
+                ctx->gdn_state_fused.clear();
+                ctx->gdn_state_skip.clear();
+                return;
+            }
+        }
+    }
+
+    for (const auto & c : chains) {
+        ctx->gdn_state_fused[c.gdn] = { c.getrows->src[0], c.getrows->src[1] };
+        ctx->gdn_state_skip.insert(c.getrows);
+    }
+    if (dbg) {
+        fprintf(stderr, "[GDN_CACHE] %zu state GET_ROWS elided (graph of %d nodes)\n",
+                ctx->gdn_state_skip.size(), cgraph->n_nodes);
+    }
+}
