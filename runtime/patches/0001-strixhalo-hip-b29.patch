             n_accepted, curr_value.n_accepted);
     curr_value.n_accepted = n_accepted;
 }
+
+namespace {
+struct copie24_sink {
+    common_sampler * target_sampler;
+    std::vector<common_leviathan::proposal> * proposals;
+    bool sampled;
+};
+
+std::unordered_map<const std::vector<llama_token> *, copie24_sink> & copie24_sinks() {
+    static thread_local std::unordered_map<const std::vector<llama_token> *, copie24_sink> sinks;
+    return sinks;
+}
+}
+
+void common_copie24_bind(std::vector<llama_token> * result, common_sampler * target_sampler,
+        std::vector<common_leviathan::proposal> * proposals, bool sampled) {
+    copie24_sinks()[result] = {target_sampler, proposals, sampled};
+}
+
+int common_copie24_sampled(const std::vector<llama_token> * result) {
+    const auto it = copie24_sinks().find(result);
+    if (it == copie24_sinks().end()) {
+        return -1;
+    }
+    return it->second.sampled ? 1 : 0;
+}
+
+void common_copie24_resize_proposals(std::vector<llama_token> * result, size_t size) {
+#ifdef COMMON_COPIE24_LEVIATHAN
+    const auto it = copie24_sinks().find(result);
+    if (it != copie24_sinks().end() && it->second.proposals && it->second.proposals->size() > size) {
+        it->second.proposals->resize(size);
+    }
+#else
+    (void) result;
+    (void) size;
+#endif
+}
+
+void common_copie24_append_proposals(std::vector<llama_token> * result, size_t first) {
+#ifdef COMMON_COPIE24_LEVIATHAN
+    const auto it = copie24_sinks().find(result);
+    if (it == copie24_sinks().end() || !it->second.proposals || !common_sampler_leviathan_eligible(it->second.target_sampler)) {
+        return;
+    }
+    auto & proposals = *it->second.proposals;
+    if (proposals.size() != first) {
+        return;
+    }
+    for (size_t i = first; i < result->size(); ++i) {
+        common_leviathan::proposal q;
+        q.masses.push_back({(*result)[i], common_leviathan::units});
+        q.token = (*result)[i];
+        q.s12_copy = true;
+        proposals.push_back(std::move(q));
+    }
+#else
+    (void) result;
+    (void) first;
+#endif
+}
+
+void common_copie24_replace_proposals(std::vector<llama_token> * result, size_t first) {
+    common_copie24_resize_proposals(result, first);
+    common_copie24_append_proposals(result, first);
+}
+
+void common_copie24_unbind() {
+    copie24_sinks().clear();
+}
