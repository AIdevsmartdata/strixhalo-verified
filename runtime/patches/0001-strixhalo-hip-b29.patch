+static void test_limits() {
+    SECTION("limits: entry above the limit, nearly full cache, exact fit");
+    for (const char * spec : {"", "DEDUP=1", "COST=1", "DEDUP=1,COST=1"}) {
+        // above the limit: refused as in the origin, cache untouched
+        { auto * c = mkcache(10, 0, spec);
+          Entry a = mk(seq(1, 500, 1, 500), 4.0 * 64);                     // 4 MiB
+          save(*c, a);
+          Entry big = mk(seq(2, 500, 2, 500), 11.0 * 64);                  // 11 MiB > 10
+          CHECK(save(*c, big) == nullptr);
+          CHECK(c->states.size() == 1);
+          CHECK(c->evic_n_reject == 0);
+          delete c; }
+        // exact fit: size + new == limit, nothing leaves
+        { auto * c = mkcache(10, 0, spec);
+          Entry a = mk(seq(1, 500, 1, 500), 4.0 * 64), b = mk(seq(2, 500, 2, 500), 6.0 * 64);
+          CHECK(save(*c, a) != nullptr); CHECK(save(*c, b) != nullptr);
+          CHECK(c->states.size() == 2); CHECK(c->size() == c->limit_size);
+          delete c; }
+        // a little over: one entry leaves and the limit holds
+        { auto * c = mkcache(10, 0, spec);
+          Entry a = mk(seq(1, 500, 1, 500), 4.0 * 64), b = mk(seq(2, 500, 2, 500), 6.0 * 64), d = mk(seq(3, 500, 3, 500), 1.0 / 64.0);
+          save(*c, a); NOW(*c, 1); save(*c, b); NOW(*c, 2);
+          save(*c, d);
+          CHECK(c->size() <= c->limit_size);
+          CHECK(c->states.size() == 2 || c->states.size() == 3 || c->states.empty() == false);
+          delete c; }
+        // already contained in the cache: skipped as in the origin
+        { auto * c = mkcache(10, 0, spec);
+          llama_tokens t = seq(1, 500, 1, 500);
+          Entry a = mk(t, 2.0 * 64);
+          save(*c, a);
+          llama_tokens shorter(t.begin(), t.begin() + 600);
+          Entry b = mk(shorter, 2.0 * 64);
+          CHECK(save(*c, b) == nullptr);
+          CHECK(c->states.size() == 1);
+          delete c; }
+        // an entry fully contained in the new one is removed (origin rule, before any eviction)
+        { auto * c = mkcache(10, 0, spec);
+          llama_tokens t = seq(1, 500, 1, 500);
+          llama_tokens shorter(t.begin(), t.begin() + 600);
+          Entry b = mk(shorter, 2.0 * 64);
+          save(*c, b);
+          Entry a = mk(t, 3.0 * 64);
+          CHECK(save(*c, a) != nullptr);
+          CHECK(c->states.size() == 1);
+          CHECK(c->states.front().prompt.tokens.size() == t.size());
+          delete c; }
+        // no byte limit: no effect
+        { auto * c = mkcache(0, 0, spec);
+          Entry a = mk(seq(1, 500, 1, 500), 40.0 * 64);
+          CHECK(save(*c, a) != nullptr);
+          delete c; }
+    }
+}
