+        d[P_POST_OTHER] = std::max<int64_t>(0, d[P_POST] - d[P_POST_SAMPLE] - d[P_POST_EMIT]);
+        d[P_ROUND] = t1 - t0;
+        d[P_WALL]  = d[P_ROUND] + (gap_valid ? d[P_GAP] : 0);
+        // appels d'horloge de ce tour : ggml (2 par portee) + serveur (comptes dans nclk)
+        int64_t nacc = 0;
+        for (int i = 0; i < GOC_N; ++i) { nacc += ge_n[i] - g0_n[i]; }
+        n_acc_period += (uint64_t) nacc;
+        n_round_period++;
+
+        const int c = cls();
+        for (int p = 0; p < P_N; ++p) {
+            sum[c][p] += (double) d[p];
+        }
+        if (cnt[c] < (uint32_t) CAP) {
+            float * base = smp.data() + ((size_t) c * P_N) * CAP + cnt[c];
+            for (int p = 0; p < P_N; ++p) {
+                base[(size_t) p * CAP] = (float) ((double) d[p] * 1e-6);   // ms
+            }
+            cnt[c]++;
+        } else {
+            dropped++;
+        }
+        ntot[c]++;
+        s_act[c] += act; s_gen[c] += gen; s_ver[c] += ver; s_acc[c] += acc; s_pf[c] += pf; s_emit[c] += emit;
+        round_id++;
+        if (level >= 2) {
+            line_round(c);
+        }
+        t_prev_end  = t1;
+        tm_prev_end = ge_ns[GOC_TASK_MAIN];
+        prev_valid  = true;
+        last_end_cost = now() - t1;              // enregistrement de ce tour : compte dans P_SELF du tour suivant
+        const int64_t t_fl = now();
+        if (flush(t1, false)) {
+            t_prev_end = now();                  // l'ecriture du resume (tri, journal) n'est pas du « gap » du serveur
+            last_flush_ns = t_prev_end - t_fl;   // (revue) mais elle est un cout reel de la sonde : publie au resume suivant
+        }
+    }
+
+    // ---- sorties ----
+    static const char * cls_name(int c, char * buf) {
+        snprintf(buf, 8, "L%d%s", c / 2 + 1, (c & 1) ? "p" : "d");
+        return buf;
+    }
+
+    void line_round(int c) {
+        char cn[8]; cls_name(c, cn);
+        char line[2048];
+        int off = snprintf(line, sizeof(line), "[CYCLE] c=%llu cls=%s act=%d gen=%d ver=%d acc=%d pf=%d emit=%d |",
+                           (unsigned long long) round_id, cn, act, gen, ver, acc, pf, emit);
+        for (int p = 0; p < P_N && off < (int) sizeof(line) - 40; ++p) {
+            off += snprintf(line + off, sizeof(line) - off, " %s=%.3f", k_names[p], (double) d[p] * 1e-6);
+        }
+        LOG_INF("%s\n", line);
+    }
+
+    // resume de la periode (un [CYCLE] par classe active et par slot) ; force = vider meme avant l'echeance (inactivite)
+    bool flush(int64_t t_now, bool force) {
+        if (!ready) {
+            return false;
+        }
+        uint64_t any = 0;
+        for (int c = 0; c < NCLS; ++c) { any += ntot[c]; }
+        if (any == 0) {
+            t_report = t_now;
+            return false;
+        }
+        if (!force && t_now - t_report < (int64_t) period_s * 1000000000LL) {
+            return false;
+        }
+        const double t_s = (double) (t_now - t_origin) * 1e-9;
+        for (int c = 0; c < NCLS; ++c) {
+            if (ntot[c] == 0) {
+                continue;
+            }
+            char cn[8]; cls_name(c, cn);
+            const double n = (double) ntot[c];
+            const double wall_ms = sum[c][P_WALL] * 1e-6;
+            char line[4096];
+            int off = snprintf(line, sizeof(line), "[CYCLE] t=%.1f cls=%s n=%llu wall_ms=%.1f act=%.2f gen=%.2f ver=%.2f acc=%.2f pf=%.1f emit=%.2f |",
+                               t_s, cn, (unsigned long long) ntot[c], wall_ms, s_act[c] / n, s_gen[c] / n, s_ver[c] / n, s_acc[c] / n, s_pf[c] / n, s_emit[c] / n);
+            for (int p = 0; p < P_N && off < (int) sizeof(line) - 120; ++p) {
+                if (sum[c][p] <= 0.0) {
+                    continue;
+                }
+                float * a = smp.data() + ((size_t) c * P_N + p) * CAP;
+                const int m = (int) cnt[c];
+                std::sort(a, a + m);
+                auto q = [&](double f) { return m > 0 ? (double) a[std::min(m - 1, (int) (f * m))] : 0.0; };
+                const double mean = sum[c][p] * 1e-6 / n;
+                const double share = wall_ms > 0 ? 100.0 * sum[c][p] * 1e-6 / wall_ms : 0.0;
+                off += snprintf(line + off, sizeof(line) - off, " %s=%.3f/%.3f/%.3f/%.3f/%.1f%%", k_names[p], mean, q(0.50), q(0.90), q(0.99), share);
+            }
+            LOG_INF("%s\n", line);
+        }
+        for (int s = 0; s < MAXS; ++s) {
+            auto & x = ss[s];
+            if (x.rounds == 0) {
+                continue;
+            }
+            const double r = (double) x.rounds;
+            LOG_INF("[CYCLE] slot=%d rounds=%llu ver/round=%.2f acc/round=%.2f emit/round=%.2f draft/round=%.2f sample_ms/round=%.3f emit_ms/round=%.3f\n",
+                    s, (unsigned long long) x.rounds, (double) x.ver / r, (double) x.acc / r, (double) x.emit / r, (double) x.dtok / r,
+                    (double) x.sample_ns * 1e-6 / r, (double) x.emit_ns * 1e-6 / r);
+            x = slot_stat();
+        }
+        // cout de la sonde sur la periode
+        {
+            double self_ms = 0, wall_all = 0;
+            for (int c = 0; c < NCLS; ++c) { self_ms += sum[c][P_SELF] * 1e-6; wall_all += sum[c][P_WALL] * 1e-6; }
+            const double rr = (double) std::max<uint64_t>(1, n_round_period);
+            const double clk_round = (double) n_acc_period * 2.0 / rr + (double) nclk / rr;
+            LOG_INF("[CYCLE] cout_sonde: tours=%llu echantillons_perdus=%llu horloge=%.1f ns/appel appels_horloge/tour=%.1f (ggml %.1f + serveur %.1f) "
+                    "bornes+enregistrement=%.4f ms/tour ; cout total estime=%.4f ms/tour = %.4f %% du mur ; ecriture_resume_precedent=%.3f ms = %.4f %% de la periode\n",
+                    (unsigned long long) n_round_period, (unsigned long long) dropped, clock_ns, clk_round,
+                    (double) n_acc_period * 2.0 / rr, (double) nclk / rr, self_ms / rr,
+                    self_ms / rr + clk_round * clock_ns * 1e-6,
+                    wall_all > 0 ? 100.0 * (self_ms + clk_round * rr * clock_ns * 1e-6) / wall_all : 0.0,
+                    (double) last_flush_ns * 1e-6, 100.0 * (double) last_flush_ns / ((double) period_s * 1e9));
+        }
+        memset(cnt, 0, sizeof(cnt)); memset(ntot, 0, sizeof(ntot)); memset(sum, 0, sizeof(sum));
+        memset(s_act, 0, sizeof(s_act)); memset(s_gen, 0, sizeof(s_gen)); memset(s_ver, 0, sizeof(s_ver));
+        memset(s_acc, 0, sizeof(s_acc)); memset(s_pf, 0, sizeof(s_pf)); memset(s_emit, 0, sizeof(s_emit));
+        dropped = 0; n_acc_period = 0; n_round_period = 0; nclk = 0;
+        t_report = t_now;
+        return true;
+    }
+
+    // ---- requetes ----
+    void req_end(int slot_id, int n_gen, int64_t t_end) {
+        if (!on || slot_id < 0 || slot_id >= (int) req.size() || !req[slot_id].active) {
+            return;
+        }
+        req_t & r = req[slot_id];
+        auto dm = [&](int64_t a, int64_t b) { return (a > 0 && b > 0) ? (double) (b - a) * 1e-6 : -1.0; };
+        const int64_t t_start = r.t_recv > 0 ? r.t_recv : r.t_post;
+        char pfs[512]; int off = 0; pfs[0] = 0;
+        for (int i = 0; i < std::min(r.n_pass, NPASS); ++i) {
+            off += snprintf(pfs + off, sizeof(pfs) - off, "%s%d/%d:%.1f+%.1f", i ? " " : "", r.pass[i].tok, r.pass[i].batch, r.pass[i].proc_ms, r.pass[i].sync_ms);
+        }
+        if (r.n_pass > NPASS) {
+            snprintf(pfs + off, sizeof(pfs) - off, " +%d", r.n_pass - NPASS);
+        }
+        const double gen_ms = dm(r.t_first, t_end);
+        LOG_INF("[REQ] task=%d slot=%d prompt=%d gen=%d body=%dB | http json=%.1f tpl=%.1f tok=%.1f post=%.1f front=%.1f | queue=%.1f select=%.1f (pcache=%.1f) launch=%.1f "
+                "wait_round=%.1f | ck_save=%dx%.1f ck_rest=%dx%.1f | prefill %d passes tok=%d ms=%.1f [tok/batch:proc+sync] %s | "
+                "ttft_srv=%.1f first_after_decode=%.1f total=%.1f gen_ms=%.1f gen_tps=%.1f\n",
+                r.task, r.slot, r.n_prompt, n_gen, r.body,
+                dm(r.t_recv, r.t_json), dm(r.t_json, r.t_tpl), dm(r.t_tpl, r.t_tok), dm(r.t_tok, r.t_post), dm(t_start, r.t_post),
+                dm(r.t_post, r.t_deq), dm(r.t_deq, r.t_sel), (double) r.ns_pcache * 1e-6, dm(r.t_sel, r.t_launched),
+                dm(r.t_launched, r.t_first_dec),
+                r.n_ck_save, (double) r.ns_ck_save * 1e-6, r.n_ck_rest, (double) r.ns_ck_rest * 1e-6,
+                r.n_pass, r.n_pass_tok, r.ms_pass, pfs,
+                dm(t_start, r.t_first), dm(r.t_first_dec, r.t_first), dm(t_start, t_end), gen_ms,
+                (gen_ms > 0 && n_gen > 1) ? 1000.0 * (n_gen - 1) / gen_ms : 0.0);
+        r.active = false;
+    }
+};
+
+// chronometre de portee pour un poste du tour (lit l'horloge seulement si la sonde est active)
+struct scope {
+    engine & e; int p; int64_t t;
+    scope(engine & e_, int p_) : e(e_), p(p_), t(e_.on ? (e_.nclk++, engine::now()) : 0) {}
+    ~scope() { if (t) { e.nclk++; e.d[p] += engine::now() - t; } }
+    scope(const scope &) = delete;
+    scope & operator=(const scope &) = delete;
+};
+
+// garde de tour : begin au constructeur, end au destructeur (couvre tous les retours anticipes de update_slots)
+struct round_guard {
+    engine & e; bool act;
+    round_guard(engine & e_, size_t n_slots) : e(e_), act(e_.begin_round(n_slots)) {}
+    ~round_guard() { if (act) { e.end_round(); } }
+    round_guard(const round_guard &) = delete;
+    round_guard & operator=(const round_guard &) = delete;
+};
+
+} // namespace cyc
