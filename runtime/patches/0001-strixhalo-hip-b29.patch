+// Retourne true si le levier a pris en charge le matvec (le noyau d'origine n'est alors pas lance).
+static bool opus_preq_try(
+        ggml_backend_cuda_context & ctx, const ggml_type type, const void * vx, const float * y, const int32_t * ids,
