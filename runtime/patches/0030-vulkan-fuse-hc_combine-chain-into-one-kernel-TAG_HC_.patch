+// [TAG_HC_COMBINE_FUSED] Exécute le kernel unique hc_combine pour le nœud ADD terminal
+// d'une chaîne hc_combine marquée. dst = res + b * (4*sigmoid(inject)). Copie du pattern
+// multi_add (buffers/uma/dispatch) avec 4 tenseurs : res, b_reshape, inject, dst.
+static void ggml_vk_hc_combine(ggml_backend_vk_context * ctx, vk_context& subctx,
+                               const ggml_tensor * res, const ggml_tensor * b,
+                               const ggml_tensor * sig, ggml_tensor * dst) {
+    vk_pipeline pipeline = ctx->device->pipeline_hc_combine;
+    if (pipeline == nullptr) {
+        std::cerr << "ggml_vulkan: Error: Missing hc_combine";
+        GGML_ABORT("fatal error");
+    }
+
+    // v5 : grid (n_i, hc, nt), 4 scalaires par thread, indexation directe (i=t*4+l, j=wg.y, k=wg.z)
+    vk_op_hc_combine_push_constants pc {};
+    pc.n_i = (uint32_t)(dst->ne[0] / 4);
+    pc.r_j = (uint32_t)(res->nb[1] / 4);
+    pc.r_k = (uint32_t)(res->nb[2] / 4);
+    pc.b_k = (uint32_t)(b->nb[2] / 4);
+    pc.s_j = (uint32_t)(sig->nb[0] / 4);
+    pc.s_k = (uint32_t)(sig->nb[1] / 4);
+    pc.d_j = (uint32_t)(dst->nb[1] / 4);
+    pc.d_k = (uint32_t)(dst->nb[2] / 4);
+
+    const ggml_tensor * tensors[4] = { res, b, sig, dst };
+
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    vk_subbuffer sbuf[4];
+    for (uint32_t i = 0; i < 4; ++i) {
+        vk_buffer buf = nullptr;
+        size_t offset = 0;
+        bool uma = false;
+        if (ctx->device->uma) {
+            ggml_vk_host_get(ctx->device, tensors[i]->data, buf, offset);
+            uma = buf != nullptr;
+        }
+        if (!uma) {
+            ggml_backend_vk_buffer_context * buf_ctx = (ggml_backend_vk_buffer_context *) tensors[i]->buffer->context;
+            GGML_ASSERT(buf_ctx != nullptr);
+            buf = buf_ctx->dev_buffer;
+            offset = vk_tensor_offset(tensors[i]) + tensors[i]->view_offs;
+        }
+        GGML_ASSERT(buf != nullptr && offset % 4 == 0); // scalaires f32 — garanti par le matcher (misalign==0)
+        sbuf[i] = ggml_vk_subbuffer(ctx, buf, offset);
+    }
+
+    // elements en unités de wg_denoms {64,1,1}: (n_i threads, hc, nt)
+    const std::array<uint32_t, 3> elements = { pc.n_i, (uint32_t)dst->ne[1], (uint32_t)dst->ne[2] };
+
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline,
+        { sbuf[0], sbuf[1], sbuf[2], sbuf[3] }, pc, elements);
+}
