 struct common_ngram_hash_function {
     size_t operator()(const common_ngram & ngram) const {
-        size_t hash = common_token_hash_function{}(ngram.tokens[0]);
-        for (int i = 1; i < LLAMA_NGRAM_MAX; ++i) {
-            hash ^= common_token_hash_function{}(ngram.tokens[i]);
+        // FNV-1a séquentiel 64-bit : respecte l'ordre des tokens (AB != BA), contrairement
+        // à l'ancien XOR (commutatif) qui faisait collider les permutations. Le operator==
+        // exact gère les rares collisions résiduelles ; on gagne ici en distribution des buckets.
+        uint64_t hash = 1469598103934665603ull; // FNV offset basis 64
+        for (int i = 0; i < LLAMA_NGRAM_MAX; ++i) {
+            hash ^= (uint64_t) (uint32_t) ngram.tokens[i];
+            hash *= 1099511628211ull; // FNV prime 64
         }
-        return hash;
+        return (size_t) hash;
     }
 };
 
@@ -90,6 +95,17 @@ void common_ngram_cache_draft(
 // filename:    the path under which to save the ngram cache.
 void common_ngram_cache_save(common_ngram_cache & ngram_cache, const std::string & filename);
 
+// Lookup the stupid-backoff n-gram match and fill out with (token, bias) pairs.
+// Steering (not speculation): bias = alpha * ln(p_engram[token]) for each token in the
+// empirical distribution of the matching n-gram. Separates the CPU lookup from the
+// logit application so the bias can be applied on the GPU backend.
+// tokens: the recent token history (last n_tokens tokens, oldest first).
+// Returns the number of pairs written (0 if no match or alpha <= 0).
+size_t common_ngram_cache_lookup_bias(
+    const common_ngram_cache & cache, const llama_token * tokens, int n_tokens,
+    int ngram_min, int ngram_max, float alpha,
+    std::vector<std::pair<llama_token, float>> & out);
+
 // Bias logits toward the empirical next-token distribution of the matching n-gram.
 // Steering (not speculation): adds alpha * ln(p) to the logits of the predicted tokens.
 // tokens: the recent token history (last n_tokens tokens, oldest first).
diff --git a/common/sampling.cpp b/common/sampling.cpp
index 388755c18f3..90a0c874e09 100644
--- a/common/sampling.cpp
+++ b/common/sampling.cpp
@@ -197,6 +197,19 @@ static void ngram_bias_cb(void * ctx, float alpha, const llama_token * tokens, i
                                    ngram_min, ngram_max, alpha, data, n_data);
 }
 
+static int ngram_bias_lookup_cb(void * ctx, float alpha, const llama_token * tokens, int n_tokens,
+                                int ngram_min, int ngram_max, int32_t * out_tokens, float * out_biases, int max_n) {
+    std::vector<std::pair<llama_token, float>> pairs;
+    common_ngram_cache_lookup_bias(*(const common_ngram_cache *) ctx, tokens, n_tokens,
+                                   ngram_min, ngram_max, alpha, pairs);
+    const int n = (int) std::min(pairs.size(), (size_t) max_n);
+    for (int i = 0; i < n; ++i) {
+        out_tokens[i] = pairs[i].first;
+        out_biases[i] = pairs[i].second;
+    }
+    return n;
+}
+
 struct common_sampler * common_sampler_init(
         const struct llama_model * model,
         struct common_params_sampling & params) {
@@ -354,7 +367,7 @@ struct common_sampler * common_sampler_init(
         // loaded once, reused across slots (MVP: no hot reload of the steering table)
         static common_ngram_cache ngram_bias_cache = common_ngram_cache_load(params.ngram_bias_cache);
         samplers.push_back(llama_sampler_init_ngram_bias(
-            (void *) &ngram_bias_cache, ngram_bias_cb, params.ngram_bias_alpha, 2, 4, 8));
+            (void *) &ngram_bias_cache, ngram_bias_cb, ngram_bias_lookup_cb, params.ngram_bias_alpha, 2, 4, 8));
     }
 
     if (params.mirostat == 0) {
