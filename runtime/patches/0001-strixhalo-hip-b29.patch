+    const int NW = GGML_OPUS_INT("GGML_OPUS_PREQ_RNW", 16);
+    static bool announced_b = false;
+    if (!announced_b) {
+        announced_b = true;
+        fprintf(stderr, "OPUS_PREQ (b) actif : rows=%d K=%d y_op=%d R=%d nw=%d\n", nrows_x, ncols_x, y_op, R, NW);
+    }
+    const int nbytes_shared = nby * sizeof(block_q8_1);
+    auto launch_rr = [&](auto kernel, const int rr, const int nwarps) {
+        const dim3 grid((nrows_x + nwarps*rr - 1) / (nwarps*rr), 1, 1);
