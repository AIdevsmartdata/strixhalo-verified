+// selection les ecartait. NON byte-exact : la somme inter-sous-groupes est un ordre different.
+static uint32_t dmmv_splitk_amd_cols() {
+    static const uint32_t v = [] {
+        const char * e = getenv("GGML_VK_DMMV_SPLITK_AMD_COLS");
+        int n = e ? atoi(e) : 1;
+        if (n < 1)  n = 1;
+        if (n > (int) mul_mat_vec_max_cols) n = (int) mul_mat_vec_max_cols;
+        return (uint32_t) n;
+    }();
+    return v;
