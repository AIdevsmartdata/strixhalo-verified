+// [TAG_QSA_SEL_BLOCK] Remplissage hote de la table (bloc, rang) -> cellule utilisee par le chemin de
+// selection au niveau bloc. Elle ne depend que de (ratio, n_kv) : c'est une progression arithmetique,
+// pas le scan du cache. Le dernier bloc (incomplet) pointe ses rangs invalides sur n_kv-1 : ces slots
+// portent un score -inf cote graphe, ils ne sont donc jamais selectionnes, et leurs indices restent
+// dans les bornes (aucune lecture de masque hors bornes).
+static void qsa_fill_cell_lut(int32_t * lut, int64_t r, int64_t n_kv, int64_t n_blocks, int64_t n_tps) {
+    const int64_t n_blocks_f = n_kv/r;
+    const int64_t tail_len   = n_kv - r*n_blocks_f;
+
+    for (int64_t b = 0; b < n_blocks; ++b) {
+        for (int64_t j = 0; j < r; ++j) {
+            lut[j + r*b] = (b == n_blocks_f && j >= tail_len) ? (int32_t) (n_kv - 1)
+                                                              : (int32_t) (r*b + j);
+        }
+    }
+
+    // une seule tranche est calculee : les jetons partagent la meme table
+    for (int64_t t = 1; t < n_tps; ++t) {
+        memcpy(lut + r*n_blocks*t, lut, (size_t) r*n_blocks*sizeof(int32_t));
+    }
+}
+
+// [TAG_QSA_SEL_DUMP] Verification d'exactitude : les `width` indices de cellules selectionnes par
+// jeton et par couche sont recopies dans un tenseur sink, relu par l'hote au pas SUIVANT puis ecrits
+// tries dans le fichier pointe par LLAMA_QSA_SEL_DUMP. Le sink est un tenseur de graphe marque OUTPUT
+// (ggml-alloc ne recycle pas sa memoire) et lu via ggml_backend_tensor_get : aucun passage par l'hote
+// au milieu du graphe, aucun noeud CPU.
+static const char * qsa_sel_dump_path() {
+    static const char * p = getenv("LLAMA_QSA_SEL_DUMP");
+    return (p != nullptr && *p != '\0') ? p : nullptr;
+}
+
+// [TAG_QSA_SEL_BLOCK] Le chemin bloc remplace la table cellule -> bloc du chemin historique
+// (cell_blk, remplie par l'hote pendant son scan du cache) par une table (bloc, rang) -> cellule
+// deduite de « cellule = position ». Les deux coincident SSI le cache est REGULIER :
+//  - une seule sequence dans l'ubatch ET dans le cache : une cellule etrangere creerait un groupe
+//    de bloc melange entre sequences, que l'hote ne peut pas resumer en un seul bloc ;
+//  - pas d'ubatch 2D : une image repete les positions et l'hote reclasse alors les cellules par
+//    rang mrope (le rang ne suit plus la position) ;
+//  - toutes les cellules [0, n_kv) occupees : un trou rend son bloc incomplet, ses cellules sont
+//    renvoyees au bloc « mort » avec le biais 1e9, et la numerotation des blocs se decale.
+// Sans ces trois conditions le bloc de queue incomplet n'est plus le seul bloc non resolu et la
+// table (bloc, rang) -> cellule serait FAUSSE : on retombe sur le chemin historique (selection
+// identique par construction, gain perdu pour ce pas).
+static bool qsa_cache_block_uniform(const llama_kv_cache * kv, const llama_ubatch & ubatch, int64_t n_kv) {
+    static const bool dbg = getenv("LLAMA_QSA_DEBUG") != nullptr;
+
+    if (kv == nullptr || ubatch.n_seqs != 1) {
+        if (dbg) {
+            fprintf(stderr, "[QSA_SB] refus kv=%p n_seqs=%d\n", (const void *) kv, (int) ubatch.n_seqs);
+        }
+        return false;
+    }
+
+    const llama_seq_id seq = ubatch.seq_id[0][0];
+    const llama_kv_cells & cells = kv->get_cells(seq);
+
+    for (int sq = 0; sq < LLAMA_MAX_SEQ; ++sq) {
+        if (sq != (int) seq && cells.seq_pos_min(sq) >= 0) {
+            if (dbg) {
+                fprintf(stderr, "[QSA_SB] refus : sequence %d aussi presente dans le cache (seq=%d)\n", sq, (int) seq);
+            }
+            return false;
+        }
+    }
+
+    // « cellule = position » : c'est l'invariant du fork QSA (noyau d'indexeur + assert « cell
+    // position runs past the cell window »). Il exclut exactement les cas ou le classement des
+    // cellules par bloc s'ecarte de cellule/r : image/m-rope (positions repetees, l'hote reclasse
+    // par rang mrope), cache decale, cache avec trous ou cellules etrangeres.
+    // NB : ubatch.is_pos_2d() n'est PAS utilisable ici : il vaut n_pos >= 3, donc toujours vrai sur
+    // ce modele m-rope, texte compris (constate au smoke test).
+    //
+    // Les cellules VIDES de queue sont normales : n_kv du cache d'indexeur est arrondi au-dela des
+    // cellules ecrites (3072 pour 2935 cellules au smoke). Une cellule vide est toujours masquee
+    // (-inf) donc jamais selectionnee par la reference : la seule contrainte est qu'aucune cellule
+    // OCCUPEE ne suive le premier trou, sinon la numerotation des blocs se decale.
+    int64_t used = 0;
+
+    while (used < n_kv && !cells.is_empty((uint32_t) used)) {
+        if (!cells.seq_has((uint32_t) used, seq) || cells.pos_get((uint32_t) used) != (llama_pos) used) {
+            if (dbg) {
+                fprintf(stderr, "[QSA_SB] refus : cellule %lld has=%d pos=%d (n_kv=%lld seq=%d)\n",
+                        (long long) used, (int) cells.seq_has((uint32_t) used, seq),
+                        (int) cells.pos_get((uint32_t) used), (long long) n_kv, (int) seq);
+            }
+            return false;
+        }
+        used++;
+    }
+
+    for (int64_t j = used; j < n_kv; ++j) {
+        if (!cells.is_empty((uint32_t) j)) {
+            if (dbg) {
+                fprintf(stderr, "[QSA_SB] refus : cellule %lld occupee apres le trou %lld\n",
+                        (long long) j, (long long) used);
+            }
+            return false;
+        }
+    }
+
+    if (dbg) {
+        fprintf(stderr, "[QSA_SB] OK n_kv=%lld used=%lld seq=%d\n", (long long) n_kv, (long long) used, (int) seq);
+    }
+
+    return true;
+}
