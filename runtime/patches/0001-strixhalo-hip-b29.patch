+static void test_backend_sampler_reattach(const test_params & params) {
+    std::vector<llama_sampler_ptr> chains;
+    for (int seq = 0; seq < 2; ++seq) {
+        for (int k : {10, 64}) {
+            chains.emplace_back(llama_sampler_chain_init(llama_sampler_chain_default_params()));
+            llama_sampler_chain_add(chains.back().get(), llama_sampler_init_top_k(k));
+        }
+    }
+    std::vector<llama_sampler_seq_config> configs = {{0, chains[0].get()}, {1, chains[2].get()}};
+    test_context test_ctx(params, configs, 2);
+
+    // Alternate eligible/ineligible MTP states, then clear and reuse both slots.
+    for (int step = 0; step < 8; ++step) {
+        for (int seq = 0; seq < 2; ++seq) {
+            const int state = (step + seq) % 2;
+            GGML_ASSERT(llama_set_sampler(test_ctx.ctx.get(), seq, chains[2*seq + state].get()));
+            GGML_ASSERT(llama_set_sampler(test_ctx.ctx.get(), seq, chains[2*seq + state].get()));
+        }
+        GGML_ASSERT(test_ctx.decode({{0, "Hello"}, {1, "Some"}}));
+        for (int seq = 0; seq < 2; ++seq) {
+            const int state = (step + seq) % 2;
+            const int idx = test_ctx.idx_for_seq(seq);
+            GGML_ASSERT(llama_get_sampled_logits_count_ith(test_ctx.ctx.get(), idx) == (state ? 64u : 10u));
+            GGML_ASSERT(llama_get_sampled_candidates_ith(test_ctx.ctx.get(), idx) != nullptr);
+            GGML_ASSERT(llama_get_sampled_token_ith(test_ctx.ctx.get(), idx) == LLAMA_TOKEN_NULL);
+        }
+        if (step == 3) {
+            for (int seq = 0; seq < 2; ++seq) {
+                GGML_ASSERT(llama_set_sampler(test_ctx.ctx.get(), seq, nullptr));
+                GGML_ASSERT(llama_set_sampler(test_ctx.ctx.get(), seq, nullptr));
+                GGML_ASSERT(llama_memory_seq_rm(llama_get_memory(test_ctx.ctx.get()), seq, -1, -1));
+            }
+            test_ctx.seq_positions.clear();
+        }
+    }
+    for (int seq = 0; seq < 2; ++seq) {
+        GGML_ASSERT(llama_set_sampler(test_ctx.ctx.get(), seq, nullptr));
+    }
+    printf("backend sampler reattach test PASSED\n");
+}
+
+static void test_backend_mixed_top_k(const test_params & params) {
+    llama_sampler_ptr chain_64(llama_sampler_chain_init(llama_sampler_chain_default_params()));
+    llama_sampler_ptr chain_10(llama_sampler_chain_init(llama_sampler_chain_default_params()));
+    llama_sampler_chain_add(chain_64.get(), llama_sampler_init_top_k(64));
+    llama_sampler_chain_add(chain_10.get(), llama_sampler_init_top_k(10));
+
+    std::vector<llama_sampler_seq_config> configs = {{0, chain_64.get()}, {1, chain_10.get()}};
+    std::vector<llama_sampler_seq_config> reference_configs;
+    test_context test_ctx(params, configs, 2, 4, 4, 2);
+    test_context reference_ctx(params, reference_configs, 2, 4, 4, 2);
+
+    llama_batch batch = llama_batch_init(4, 0, 2);
+    for (int seq = 0; seq < 2; ++seq) {
+        for (int i = 0; i < 2; ++i) {
+            common_batch_add(batch, llama_vocab_bos(test_ctx.vocab), i, {seq}, true);
+        }
+    }
+    GGML_ASSERT(llama_decode(test_ctx.ctx.get(), batch) == 0);
+    GGML_ASSERT(llama_decode(reference_ctx.ctx.get(), batch) == 0);
+
+    for (int i = 0; i < 4; ++i) {
+        const int k = i < 2 ? 64 : 10;
+        const float * reference = llama_get_logits_ith(reference_ctx.ctx.get(), i);
+        const float * values = llama_get_sampled_logits_ith(test_ctx.ctx.get(), i);
+        const llama_token * ids = llama_get_sampled_candidates_ith(test_ctx.ctx.get(), i);
+        GGML_ASSERT(llama_get_sampled_logits_count_ith(test_ctx.ctx.get(), i) == (uint32_t) k);
+        GGML_ASSERT(llama_get_sampled_candidates_count_ith(test_ctx.ctx.get(), i) == (uint32_t) k);
+
+        std::vector<llama_token> expected(test_ctx.n_vocab);
+        for (int j = 0; j < test_ctx.n_vocab; ++j) {
+            expected[j] = j;
+        }
+        const auto better = [reference](llama_token a, llama_token b) {
+            return reference[a] > reference[b] || (reference[a] == reference[b] && a < b);
+        };
+        std::partial_sort(expected.begin(), expected.begin() + k, expected.end(), better);
+        std::vector<llama_token> actual(ids, ids + k);
+        std::sort(expected.begin(), expected.begin() + k);
+        std::sort(actual.begin(), actual.end());
+        GGML_ASSERT(actual == std::vector<llama_token>(expected.begin(), expected.begin() + k));
+        for (int j = 0; j < k; ++j) {
+            GGML_ASSERT(ids[j] >= 0 && ids[j] < test_ctx.n_vocab);
+            GGML_ASSERT(values[j] == reference[ids[j]]);
+        }
+    }
+
+    llama_batch_free(batch);
+    printf("backend mixed top-k test PASSED\n");
+}
