diff --git a/src/llama-memory-hybrid-idx.h b/src/llama-memory-hybrid-idx.h
index 7aafb3deb7b..a2f83e1284e 100644
--- a/src/llama-memory-hybrid-idx.h
+++ b/src/llama-memory-hybrid-idx.h
@@ -5,6 +5,56 @@
 #include <memory>
 #include <vector>
 
+//
+// [TAG_DRAFT_QSA] Indexeur QSA de la tete MTP du draft (qwen4exp)
+//
+// Le draft MTP est un llama_context separe : lui donner un indexeur demande (a) de charger les 4
+// tenseurs `blk.<n_layer>.indexer.*` du GGUF MTP, (b) d'instancier pour son seul contexte un
+// llama_memory_hybrid_idx (cache d'attention + cache d'indexeur), (c) de passer ce cache d'indexeur
+// au graphe du draft. Le tout derriere UN interrupteur, OFF par defaut : sans `LLAMA_DRAFT_QSA`,
+// rien de tout cela n'existe et le comportement est bit a bit celui d'avant.
+//
+// La valeur est lue a trois moments et jamais mise en cache dans un `static const` :
+//  - au chargement du modele (charger ou non les tenseurs d'indexeur, forcer ou non le ratio r),
+//  - a la creation de la memoire du context MTP (creer ou non le 3e cache),
+//  - a la construction de CHAQUE graphe (le bras de l'A/B).
+// C'est cette derniere lecture qui rend l'A/B entrelacable dans le meme process (modele :
+// LLAMA_MTP_HEAD_CTL, qwen4exp.cpp:685-790) : la reference derive de +10 % dans un meme banc, donc
+// des bras separes par un redemarrage ne sont pas interpretables.
+//
+// `LLAMA_DRAFT_QSA` accepte :
+//  - absent / vide / "0" / "off"   -> OFF, et la memoire MTP reste un llama_kv_cache simple ;
+//  - "on" / "1"                    -> ON (constant) ;  "sel" -> SEL (constant) ;
+//  - n'importe quoi d'autre          -> CHEMIN D'UN FICHIER DE CONTROLE, relu a chaque appel :
+//                                       "off"/"keys" -> OFF, "sel" -> SEL, sinon ON.
+//
+// Les trois bras mesures sont :
+//  - OFF : attention dense. Avec la memoire armee, les cles d'indexeur et les resumes de blocs
+//          sont ECRITS mais aucune selection n'est calculee (chemin KEEPKEYS existant,
+//          qwen4exp.cpp:1461-1532). Sans ces ecritures, les positions couvertes par l'arm OFF
+//          resteraient des cellules d'indexeur vides et l'arm suivant scorerait du vide (KO
+//          `pi+read` du 14/09). C'est donc la reference A correcte d'un process arme.
+//  - SEL : la chaine de selection complete est calculee ET dumpee (LLAMA_QSA_SEL_DUMP requis),
+//          mais l'attention reste dense. Isole le cout propre de la chaine et fournit les
+//          ensembles d'indices a comparer avec l'arm ON (meme code, meme selection).
+//  - ON  : selection + attention sparse (gather au decode, masque top-k sinon).
+
+enum llama_draft_qsa_arm {
+    LLAMA_DRAFT_QSA_OFF = 0,
+    LLAMA_DRAFT_QSA_SEL = 1,
+    LLAMA_DRAFT_QSA_ON  = 2,
+};
+
+// Re-lit l'interrupteur (fichier de controle si `LLAMA_DRAFT_QSA` en nomme un). Aucun cache.
+llama_draft_qsa_arm llama_draft_qsa_read();
+
+// Vrai si la memoire du context MTP a ete creee avec un cache d'indexeur. Lu UNE fois : le type de
+// memoire est decide par create_memory et ne peut plus changer ensuite. C'est le seul `static` de
+// la famille, et il ne porte que le type de memoire, jamais le bras de l'A/B.
+bool llama_draft_qsa_mem();
+
+const char * llama_draft_qsa_arm_name(llama_draft_qsa_arm arm);
+
