+        ((uintptr_t) a.gate_w->data % 8) == 0 && ((uintptr_t) a.gate_y->data % 8) == 0 &&
+        ((uintptr_t) a.cn.residual->data % 8) == 0 && ((uintptr_t) a.cn.out_res->data % 8) == 0 &&
+        ((uintptr_t) a.cn.out_xn->data % 8) == 0 && ((uintptr_t) a.cn.gamma->data % 8) == 0;
+}
