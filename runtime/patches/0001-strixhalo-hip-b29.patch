+static void test_cost() {
+    SECTION("(b) cost weighted eviction, bounded protection, admission, age discount");
+    // limit 10 MiB = 640 vMiB
+    const llama_tokens tBig = seq(1, 1000, 1, 19000);                     // 20000 tokens
+    // 1. the cheapest to recompute leaves, not the oldest
+    {
+        auto * c = mkcache(10, 0, "COST=1,PROT_S=0");
+        Entry big = mk(tBig, 300.0), small1 = mk(seq(2, 300, 2, 300), 150.0), small2 = mk(seq(3, 300, 3, 300), 150.0);
+        save(*c, big); NOW(*c, 1); save(*c, small1); NOW(*c, 2); save(*c, small2); NOW(*c, 3);   // 600
+        Entry mid = mk(seq(4, 300, 4, 5000), 180.0);                        // 140 needed: small1 (600 tokens) goes, not big (the oldest)
+        CHECK(save(*c, mid) != nullptr);
+        CHECK(has_prompt(*c, tBig));
+        CHECK(!has_prompt(*c, seq(2, 300, 2, 300)));
+        CHECK(c->evic_n_cost == 1);
+        delete c;
+    }
+    // 2. origin (no COST): the oldest goes
+    {
+        auto * c = mkcache(10, 0, "");
+        Entry big = mk(tBig, 300.0), small1 = mk(seq(2, 300, 2, 300), 150.0), small2 = mk(seq(3, 300, 3, 300), 150.0), mid = mk(seq(4, 300, 4, 5000), 180.0);
+        save(*c, big); save(*c, small1); save(*c, small2); save(*c, mid);
+        CHECK(!has_prompt(*c, tBig));
+        delete c;
+    }
+    // 3. tokens shared with another entry are free: of two near-identical big entries the older one is the cheaper
+    {
+        auto * c = mkcache(10, 0, "COST=1,PROT_S=0");
+        Entry v1 = mk(seq(7, 9000, 11, 100), 250.0, {2048, 4096, 8192}, 30.0), v2 = mk(seq(7, 9000, 12, 100), 250.0, {2048, 4096, 8192}, 30.0);
+        Entry lone = mk(seq(8, 9100, 13, 0), 100.0);
+        save(*c, v1); NOW(*c, 1); save(*c, lone); NOW(*c, 2); save(*c, v2); NOW(*c, 3);   // 600
+        Entry nw = mk(seq(9, 500, 14, 500), 200.0);                          // 160 needed: v1 costs ~1000 (8192 given back by v2), lone costs 9100
+        save(*c, nw);
+        CHECK(!has_prompt(*c, seq(7, 9000, 11, 100)));
+        CHECK(has_prompt(*c, seq(8, 9100, 13, 0)));
+        CHECK(has_prompt(*c, seq(7, 9000, 12, 100)));
+        delete c;
+    }
+    // 4. the biggest recent session stays, the smaller new entry is refused when nothing else can leave
+    {
+        auto * c = mkcache(10, 0, "COST=1");
+        Entry M = mk(seq(1, 1000, 1, 30000), 400.0);                          // 31000 tokens, 400 vMiB (62 % of the limit)
+        Entry A = mk(seq(2, 1000, 2, 20000), 350.0);                          // 21000 tokens
+        save(*c, M); NOW(*c, 10);
+        CHECK(save(*c, A) == nullptr);                                        // 750 > 640 and only M could leave: A is refused
+        CHECK(c->evic_n_reject == 1);
+        CHECK(c->states.size() == 1 && has_prompt(*c, seq(1, 1000, 1, 30000)));
+        CHECK(c->size() <= c->limit_size);
+        delete c;
+    }
+    // 5. the protection is bounded in time and size
+    {
+        auto * c = mkcache(10, 0, "COST=1");
+        Entry M = mk(seq(1, 1000, 1, 30000), 400.0), A = mk(seq(2, 1000, 2, 40000), 350.0);   // A is longer than M
+        save(*c, M); NOW(*c, 10);
+        // A (41000 tokens) is bigger than M (31000): M is not protected against it, and M costs 31000 <= 41000 so A is admitted
+        CHECK(save(*c, A) != nullptr);
+        CHECK(!has_prompt(*c, seq(1, 1000, 1, 30000)));
+        delete c;
+    }
+    {
+        auto * c = mkcache(10, 0, "COST=1");
+        Entry M = mk(seq(1, 1000, 1, 30000), 400.0), A = mk(seq(2, 1000, 2, 20000), 350.0);
+        save(*c, M);
+        NOW(*c, 899);                                                         // under 900 s: still protected
+        CHECK(save(*c, A) == nullptr);
+        NOW(*c, 901);                                                         // over 900 s: M is not protected, A (21000) may push M (31000, discounted) out: 31000 * 0.71 <= 2 x 21000
+        CHECK(save(*c, A) != nullptr);
+        CHECK(!has_prompt(*c, seq(1, 1000, 1, 30000)));
+        delete c;
+    }
+    {
+        // an entry above 75 % of the limit is not protected, the admission test decides
+        auto * c = mkcache(10, 0, "COST=1");
+        Entry M = mk(seq(1, 1000, 1, 30000), 500.0);                          // 78 % of 640
+        Entry A = mk(seq(2, 1000, 2, 29000), 300.0);                          // 30000 tokens
+        save(*c, M); NOW(*c, 5);
+        CHECK(save(*c, A) != nullptr);                                        // not protected, and A (30000) brings at least half of what M costs (31000)
+        CHECK(!has_prompt(*c, seq(1, 1000, 1, 30000)));
+        delete c;
+        c = mkcache(10, 0, "COST=1");
+        Entry Asmall = mk(seq(2, 1000, 2, 11000), 300.0);                     // 12000 tokens: M (31000) would push out more than 2 x 12000
+        save(*c, M); NOW(*c, 5);
+        CHECK(save(*c, Asmall) == nullptr);
+        CHECK(has_prompt(*c, seq(1, 1000, 1, 30000)));
+        delete c;
+        c = mkcache(10, 0, "COST=1");
+        Entry A2 = mk(seq(2, 1000, 2, 33000), 300.0);                         // 34000 tokens > M: M goes
+        save(*c, M); NOW(*c, 5);
+        CHECK(save(*c, A2) != nullptr);
+        CHECK(!has_prompt(*c, seq(1, 1000, 1, 30000)));
+        delete c;
+    }
+    // 6. admission: a tiny entry does not push out an expensive one
+    {
+        auto * c = mkcache(10, 0, "COST=1,PROT_S=0");
+        Entry e1 = mk(seq(1, 300, 1, 12000), 300.0), e2 = mk(seq(2, 300, 2, 12000), 300.0);
+        save(*c, e1); NOW(*c, 1); save(*c, e2); NOW(*c, 2);                  // 600
+        Entry tiny = mk(seq(3, 100, 3, 200), 100.0);                          // 300 tokens, 100 vMiB: 60 needed, the victim costs 12300 > 300
+        CHECK(save(*c, tiny) == nullptr);
+        CHECK(c->states.size() == 2);
+        CHECK(c->evic_n_reject == 1);
+        // ADMIT=0: always admitted
+        delete c;
+        c = mkcache(10, 0, "COST=1,PROT_S=0,ADMIT=0");
+        save(*c, e1); NOW(*c, 1); save(*c, e2); NOW(*c, 2);
+        CHECK(save(*c, tiny) != nullptr);
+        CHECK(c->states.size() == 2);
+        delete c;
+        // evic_transport (PFX READY): the admission test is skipped, the tiny entry is admitted
+        c = mkcache(10, 0, "COST=1,PROT_S=0");
+        save(*c, e1); NOW(*c, 1); save(*c, e2); NOW(*c, 2);
+        c->evic_transport = true;
+        CHECK(save(*c, tiny) != nullptr);
+        c->evic_transport = false;
+        delete c;
+    }
+    // 7. evic_transport keeps the protection: if only the protected session could leave, the transport state is REFUSED (the caller prefills),
+    //    also when the donor is longer than the protected session (it is not "the biggest session" for long: load() erases it at once)
+    {
+        auto * c = mkcache(10, 0, "COST=1");
+        Entry M = mk(seq(1, 1000, 1, 30000), 400.0), A = mk(seq(2, 1000, 2, 20000), 350.0), Abig = mk(seq(3, 1000, 3, 40000), 350.0);
+        save(*c, M); NOW(*c, 10);
+        c->evic_transport = true;
+        CHECK(save(*c, A) == nullptr);
+        CHECK(c->states.size() == 1 && has_prompt(*c, seq(1, 1000, 1, 30000)));
+        CHECK(save(*c, Abig) == nullptr);                                      // 41000 tokens > M (31000): without transport M would leave
+        CHECK(c->states.size() == 1 && has_prompt(*c, seq(1, 1000, 1, 30000)));
+        c->evic_transport = false;
+        CHECK(c->evic_n_reject == 2);
+        CHECK(c->size() <= c->limit_size);
+        delete c;
+        // when something else can leave, the transport state is saved and the protected session stays
+        c = mkcache(10, 0, "COST=1");
+        Entry small = mk(seq(4, 300, 4, 300), 200.0), A150 = mk(seq(2, 1000, 2, 20000), 150.0);
+        save(*c, M); NOW(*c, 10); save(*c, small); NOW(*c, 20);                // 600 of 640, 110 needed: small leaves
+        c->evic_transport = true;
+        CHECK(save(*c, A150) != nullptr);
+        c->evic_transport = false;
+        CHECK(has_prompt(*c, seq(1, 1000, 1, 30000)));
+        CHECK(!has_prompt(*c, seq(4, 300, 4, 300)));
+        delete c;
+    }
+    // 7b. transport state: no dedup and no coverage credit. Y is cheap (2000 tokens), a0 is a near-duplicate of the donor a2 (8300 tokens).
+    //     Normal save: a0 is covered by a2, so it is the cheapest and leaves. Transport: a2 is gone at once, so Y leaves and a0 stays.
+    {
+        auto mkagent = [&](int i, size_t tail) { return mk(seq(70, 8000, 300 + i, tail), 200.0, {2048, 8000}, 40.0); };
+        for (int transport = 0; transport < 2; ++transport) {
+            auto * c = mkcache(10, 0, "DEDUP=1,COST=1,PROT_S=0");
+            Entry Y = mk(seq(5, 1000, 5, 1000), 200.0), Z = mk(seq(6, 1500, 6, 1500), 200.0), a0 = mkagent(0, 300), a2 = mkagent(2, 300);
+            save(*c, Y); NOW(*c, 1); save(*c, a0); NOW(*c, 2); save(*c, Z); NOW(*c, 3);   // 600
+            c->evic_transport = transport != 0;
+            CHECK(save(*c, a2) != nullptr);
+            c->evic_transport = false;
+            if (transport) { CHECK(has_prompt(*c, seq(70, 8000, 300, 300))); CHECK(!has_prompt(*c, seq(5, 1000, 5, 1000))); CHECK(c->evic_n_dedup == 0); }
+            else           { CHECK(!has_prompt(*c, seq(70, 8000, 300, 300))); CHECK(has_prompt(*c, seq(5, 1000, 5, 1000))); }
+            delete c;
+        }
+    }
+    // 8. age discount: an old big entry leaves before a fresh medium one
+    {
+        auto * c = mkcache(10, 0, "COST=1,PROT_S=0,HALF_S=600");
+        Entry old_big = mk(seq(1, 300, 1, 20000), 300.0), fresh = mk(seq(2, 300, 2, 8000), 300.0);
+        save(*c, old_big); NOW(*c, 6000);                                    // 10 half-lives: discount 1/16 (floor), about 1300 < 8300
+        save(*c, fresh); NOW(*c, 6001);
+        Entry nw = mk(seq(3, 300, 3, 8000), 300.0);
+        CHECK(save(*c, nw) != nullptr);
+        CHECK(!has_prompt(*c, seq(1, 300, 1, 20000)));
+        CHECK(has_prompt(*c, seq(2, 300, 2, 8000)));
+        delete c;
+        // no aging (HALF_S=0): the big one stays
+        c = mkcache(10, 0, "COST=1,PROT_S=0,HALF_S=0");
+        save(*c, old_big); NOW(*c, 6000); save(*c, fresh); NOW(*c, 6001);
+        CHECK(save(*c, nw) != nullptr);
+        CHECK(has_prompt(*c, seq(1, 300, 1, 20000)));
+        CHECK(!has_prompt(*c, seq(2, 300, 2, 8000)));
+        delete c;
+    }
+    // 9. on equal cost the oldest goes
+    {
+        auto * c = mkcache(10, 0, "COST=1,PROT_S=0");
+        Entry a = mk(seq(1, 300, 1, 700), 200.0), b = mk(seq(2, 300, 2, 700), 200.0), d = mk(seq(3, 300, 3, 700), 200.0);
+        save(*c, a); save(*c, b); save(*c, d);                               // 600, each costs 1000 at the same date
+        Entry nw = mk(seq(4, 300, 4, 700), 200.0);
+        CHECK(save(*c, nw) != nullptr);
+        CHECK(!has_prompt(*c, seq(1, 300, 1, 700)));
+        delete c;
+    }
+}
+
+static void test_update() {
+    SECTION("update(): token limit (only reachable without a byte limit: with one, limit_tokens_cur >= n_tokens whenever size <= limit)");
+    {
+        auto * c = mkcache(0, 30000, "COST=1");
+        Entry M = mk(seq(1, 1000, 1, 19000), 100.0), A = mk(seq(2, 500, 2, 4500), 50.0), B = mk(seq(3, 500, 3, 4500), 50.0), C2 = mk(seq(4, 500, 4, 4500), 50.0);
+        save(*c, M); c->update(); NOW(*c, 5); save(*c, A); c->update(); NOW(*c, 10); save(*c, B); c->update(); NOW(*c, 15);
+        CHECK(c->states.size() == 3);                                          // 20000 + 5000 + 5000 = 30000: at the limit
+        save(*c, C2); c->update();                                             // 35000 > 30000: the oldest (M) would go, with COST it is A
+        CHECK(has_prompt(*c, seq(1, 1000, 1, 19000)));
+        CHECK(!has_prompt(*c, seq(2, 500, 2, 4500)));
+        CHECK(c->n_tokens() <= 30000);
+        delete c;
+    }
+    {
+        auto * c = mkcache(0, 30000, "");
+        Entry M = mk(seq(1, 1000, 1, 19000), 100.0), A = mk(seq(2, 500, 2, 4500), 50.0), B = mk(seq(3, 500, 3, 4500), 50.0), C2 = mk(seq(4, 500, 4, 4500), 50.0);
+        save(*c, M); c->update(); save(*c, A); c->update(); save(*c, B); c->update(); save(*c, C2); c->update();
+        CHECK(!has_prompt(*c, seq(1, 1000, 1, 19000)));                      // origin: M goes
+        delete c;
+    }
+    // only M (protected) and the newest are left and too big: the newest goes
+    {
+        auto * c = mkcache(0, 30000, "COST=1");
+        Entry M = mk(seq(1, 1000, 1, 24000), 100.0), A = mk(seq(2, 500, 2, 9000), 50.0);
+        save(*c, M); c->update(); NOW(*c, 5); save(*c, A); c->update();       // 25000 + 9500 = 34500 > 30000
+        CHECK(c->states.size() == 1);
+        CHECK(has_prompt(*c, seq(1, 1000, 1, 24000)));
+        delete c;
+    }
+}
+
+// invariants on random operations in every mode
+static void test_fuzz_invariants() {
+    SECTION("fuzz: invariants (size <= limit, accounting, no entry contained in another)");
+    for (const char * spec : {"", "DEDUP=1", "COST=1", "DEDUP=1,COST=1", "DEDUP=1,COST=1,DEDUP_MAX=3,PROT_S=30,HALF_S=20,ADMIT=0", "COST=1,PROT_PCT=30"}) {
+        for (unsigned seed = 1; seed <= 6; ++seed) {
+            auto * c = mkcache(10, 40000, spec);
+            std::mt19937_64 rng(seed * 7919u);
+            for (int op = 0; op < 400; ++op) {
+                NOW(*c, op * 3);
+                const unsigned k = (unsigned) (rng() % 10);
+                if (k < 7) {
+                    llama_tokens t;
+                    if (!c->states.empty() && rng() % 4 == 0) {
+                        auto it = c->states.begin(); std::advance(it, (long) (rng() % c->states.size()));
+                        t = it->prompt.tokens.get_text_tokens();
+                        const auto extra = seq(1 + (unsigned) (rng() % 6), 0, (unsigned) (rng() % 50), 50 + rng() % 400);
+                        t.insert(t.end(), extra.begin(), extra.end());
+                    } else {
+                        t = seq(1 + (unsigned) (rng() % 6), 200 + rng() % 3000, (unsigned) (rng() % 1000), 20 + rng() % 8000);
+                    }
+                    std::vector<int64_t> ck;
+                    for (int64_t pos = 512; pos < (int64_t) t.size(); pos += 1024 + (int64_t) (rng() % 1024)) if (rng() % 2) ck.push_back(pos);
+                    Entry e = mk(t, (double) (30 + rng() % 400), ck, 4.0 + (double) (rng() % 12));
+                    if (rng() % 17 == 0) c->evic_transport = true;
+                    save(*c, e);
+                    c->evic_transport = false;
+                    c->update();
+                } else if (k < 9) {
+                    if (!c->states.empty()) { auto it = c->states.begin(); std::advance(it, (long) (rng() % c->states.size())); c->states.erase(it); }
+                } else {
+                    c->update();
+                }
+                CHECK(c->size() <= c->limit_size);
+                CHECK(sum_size(*c) == c->size());
+                // no entry is a strict prefix of another (origin rule)
+                for (auto a = c->states.begin(); a != c->states.end(); ++a)
+                    for (auto b = c->states.begin(); b != c->states.end(); ++b)
+                        if (a != b && a->prompt.tokens.size() < b->prompt.tokens.size())
+                            CHECK(a->prompt.tokens.get_common_prefix(b->prompt.tokens) != a->prompt.tokens.size());
+            }
+            delete c;
+        }
+    }
+    env_clear();
+}
+
+static void test_cost_equals_origin_with_room() {
+    SECTION("with room left every mode = origin");
+    for (const char * spec : {"DEDUP=1", "COST=1", "DEDUP=1,COST=1"}) {
+        auto * a = mkcache(1000, 0, "");
+        auto * b = mkcache(1000, 0, spec);
+        std::mt19937_64 rng(5);
+        for (int op = 0; op < 120; ++op) {                                    // 120 x ~230 vMiB stays under the 64000 vMiB limit
+            llama_tokens t = seq(1 + (unsigned) (rng() % 6), 200 + rng() % 3000, (unsigned) (rng() % 1000), 20 + rng() % 4000);
+            Entry e = mk(t, (double) (30 + rng() % 400), {512}, 5.0);
+            auto * ra = save(*a, e); auto * rb = save(*b, e);
+            CHECK((ra == nullptr) == (rb == nullptr));
+            CHECK(a->states.size() == b->states.size());
+            CHECK(a->size() == b->size());
+            if (op % 25 == 0 && !a->states.empty()) { a->states.pop_front(); b->states.pop_front(); }
+        }
+        delete a; delete b;
+    }
+    env_clear();
+}
+#endif
+
+int main(int argc, char ** argv) {
+    // server log (SRV_WRN) goes to stderr, traces to stdout
+    if (argc >= 3 && !strcmp(argv[1], "--trace")) {
+        const int n = atoi(argv[2]);
+        unsigned seed = 42; int limit = 10; size_t limit_tok = 0;
+        for (int i = 3; i < argc; ++i) {
+            if (!strcmp(argv[i], "--env") && i + 1 < argc) {
+                const std::string kv = argv[++i];
+                const size_t e = kv.find('=');
+                if (e != std::string::npos) setenv(kv.substr(0, e).c_str(), kv.substr(e + 1).c_str(), 1);
+            } else if (!strcmp(argv[i], "--seed") && i + 1 < argc) seed = (unsigned) atoi(argv[++i]);
+            else if (!strcmp(argv[i], "--limit") && i + 1 < argc) limit = atoi(argv[++i]);
+            else if (!strcmp(argv[i], "--limit-tok") && i + 1 < argc) limit_tok = (size_t) atoll(argv[++i]);
+        }
+        run_trace(n, seed, limit, limit_tok);
+        return 0;
+    }
+#ifdef EVIC_API
+    if (argc >= 2 && !strcmp(argv[1], "--replay-burst")) {   // --replay-burst [LIMIT_MIB_SCALED] : prints M3/M4 hit or miss per mode (64 = 4096 MiB)
+        g_verbose = true;
+        if (argc >= 3) g_burst_limit = atoi(argv[2]);
+        test_burst_replay();
+        return n_fail ? 1 : 0;
+    }
+    if (argc >= 4 && !strcmp(argv[1], "--replay")) {   // --replay SPEC LIMIT_MIB_SCALED : prints the cache after each step of the SLOTS replay, e.g. --replay COST=1,DEDUP=1 64
+        g_verbose = true;
+        replay_slots(!strcmp(argv[2], "-") ? "" : argv[2], atoi(argv[3]));
+        return n_fail ? 1 : 0;
+    }
+    test_env();
+    test_limits();
+    test_dedup();
+    test_cost();
+    test_update();
+    test_user_sequence();
+    test_slots_replay();
+    test_burst_replay();
+    test_cost_equals_origin_with_room();
+    test_fuzz_invariants();
+    fprintf(stderr, "== %d verifications, %d echec(s)\n", n_ok + n_fail, n_fail);
+    printf("%d verifications, %d echec(s)\n", n_ok + n_fail, n_fail);
+    return n_fail ? 1 : 0;
+#else
+    fprintf(stderr, "compile sans EVIC_API : seul --trace est disponible\n");
+    return 2;
+#endif
+}
diff --git a/tests/test_copie24_cohorte.cpp b/tests/test_copie24_cohorte.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..10412e5a4f13de059ca2081023344f19c6825c80
--- /dev/null
+++ b/tests/test_copie24_cohorte.cpp
@@ -0,0 +1,157 @@
+#include "copie24.h"
+#include "leviathan.h"
+
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <random>
+#include <vector>
+
+namespace {
+
+using common_leviathan::proposal;
+using common_leviathan::weight;
+
+void require(bool ok, const char * message) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", message);
+        std::exit(1);
+    }
+}
+
+void unit_tests() {
+    require(!common_copie24_cohort_active(0, 8, 2), "default OFF");
+    require(!common_copie24_cohort_active(1, 1, 2), "single slot is not a cohort");
+    require(!common_copie24_cohort_active(1, 8, 0), "strict grammar outside uniform cohort");
+    require(common_copie24_cohort_active(1, 8, 2), "lazy tool grammar in uniform cohort");
+
+    std::vector<llama_token> neural{40, 41};
+    std::vector<llama_token> original = neural;
+    require(common_copie24_cohort_replace(neural, {50, 51}, 0, 2), "replace from first position");
+    require(neural == std::vector<llama_token>({50, 51}), "replacement tokens");
+
+    neural = original;
+    require(common_copie24_cohort_replace(neural, {51}, 1, 2), "replace after MTP0");
+    require(neural == std::vector<llama_token>({40, 51}), "MTP0 preservation");
+
+    neural = original;
+    require(!common_copie24_cohort_replace(neural, {}, 0, 2), "missing copy must not alter draft");
+    require(neural == original, "slot without copy");
+
+    require(!common_copie24_cohort_replace(neural, {50}, 0, 2), "short EOG copy must not leave stale MTP suffix");
+    require(neural == original, "end of sequence rollback");
+
+    require(common_copie24_cohort_replace(neural, {50, 51, 52}, 0, 3), "augmented rectangular width");
+    require(neural == std::vector<llama_token>({50, 51, 52}), "augmented tokens");
+
+    const double threshold = common_copie24_cohort_cost_threshold(8, 2, 0);
+    require(std::fabs(threshold - 8.0 * 9.8 / 81.8) < 1e-12, "C8 pre-draw cost criterion");
+    require(common_copie24_cohort_cost_threshold(3, 2, 0) < 0.0, "unsupported cohort size");
+    require(common_copie24_cohort_cost_threshold(8, 1, 0) < 0.0, "unsupported width");
+    require(std::fabs(common_copie24_cohort_cost_threshold(8, 2, 32768) - 8.0 * 9.8 / 82.8) < 1e-12, "deep-context cost criterion");
+
+    std::vector<llama_token> replay{50, 51};
+    const size_t accepted = 1;
+    const llama_token residual = 60;
+    std::vector<llama_token> head_kv{50, 51};
+    head_kv.resize(accepted);
+    head_kv.push_back(residual);
+    require(replay[0] == head_kv[0] && head_kv[1] == residual, "RS2 replay uses accepted copy and residual");
+    require(std::find(head_kv.begin(), head_kv.end(), 51) == head_kv.end(), "rejected neural token removed from head state");
+}
+
+proposal quantized(const std::vector<weight> & p) {
+    return common_leviathan::quantize(p);
+}
+
+proposal dirac(int32_t token) {
+    proposal q;
+    q.masses.push_back({token, common_leviathan::units});
+    q.token = token;
+    return q;
+}
+
+void check_counts(const std::array<uint64_t, 4> & counts, const std::vector<weight> & p, uint64_t n, const char * name) {
+    for (size_t i = 0; i < counts.size(); ++i) {
+        const double expected = n * p[i].p;
+        const double variance = std::max(1.0, n * p[i].p * (1.0 - p[i].p));
+        const double z = ((double) counts[i] - expected) / std::sqrt(variance);
+        if (std::fabs(z) >= 6.5) {
+            std::fprintf(stderr, "FAIL: %s token=%zu z=%.3f\n", name, i, z);
+            std::exit(1);
+        }
+    }
+}
+
+void check_acceptance(uint64_t accepted, uint64_t n, double expected, const char * name) {
+    const double observed = (double) accepted / n;
+    const double z = (observed - expected) / std::sqrt(expected * (1.0 - expected) / n);
+    if (std::fabs(z) >= 6.5) {
+        std::fprintf(stderr, "FAIL: %s acceptance observed=%.6f expected=%.6f z=%.3f\n", name, observed, expected, z);
+        std::exit(1);
+    }
+}
+
+void law_copy_only(uint64_t n) {
+    const std::vector<weight> p{{0, 0.1}, {1, 0.2}, {2, 0.3}, {3, 0.4}};
+    std::mt19937 rng(261001);
+    std::array<uint64_t, 4> counts{};
+    uint64_t accepted = 0;
+    for (uint64_t i = 0; i < n; ++i) {
+        proposal q = dirac(2);
+        const auto decision = common_leviathan::verify(p, q, rng);
+        ++counts[decision.token];
+        accepted += decision.accepted;
+    }
+    check_counts(counts, p, n, "copy-only law");
+    check_acceptance(accepted, n, 0.3, "copy-only");
+    std::printf("copy-only: n=%llu law=PASS acceptance=PASS\n", (unsigned long long) n);
+}
+
+void law_mixed(uint64_t n) {
+    const std::vector<weight> p0{{0, 0.1}, {1, 0.2}, {2, 0.3}, {3, 0.4}};
+    const std::vector<weight> p1{{0, 0.4}, {1, 0.3}, {2, 0.2}, {3, 0.1}};
+    const std::vector<weight> raw_q{{0, 0.55}, {1, 0.15}, {2, 0.2}, {3, 0.1}};
+    std::mt19937 rng(261002);
+    std::array<uint64_t, 4> first{};
+    std::array<uint64_t, 4> second{};
+    uint64_t accepted0 = 0;
+    uint64_t accepted1 = 0;
+    for (uint64_t i = 0; i < n; ++i) {
+        proposal q0 = quantized(raw_q);
+        common_leviathan::draw(q0, rng);
+        const auto d0 = common_leviathan::verify(p0, q0, rng);
+        ++first[d0.token];
+        accepted0 += d0.accepted;
+        if (!d0.accepted) {
+            continue;
+        }
+        proposal q1 = dirac(2);
+        const auto d1 = common_leviathan::verify(p1, q1, rng);
+        ++second[d1.token];
+        accepted1 += d1.accepted;
+    }
+    check_counts(first, p0, n, "mixed first-position law");
+    check_counts(second, p1, accepted0, "mixed copy-position law");
+    double expected0 = 0.0;
+    for (size_t i = 0; i < p0.size(); ++i) {
+        expected0 += std::min(p0[i].p, raw_q[i].p);
+    }
+    check_acceptance(accepted0, n, expected0, "mixed neural");
+    check_acceptance(accepted1, accepted0, 0.2, "mixed copy");
+    std::printf("mixed: n=%llu law=PASS residual=PASS acceptance=PASS\n", (unsigned long long) n);
+}
+
+} // namespace
+
+int main(int argc, char ** argv) {
+    const uint64_t n = argc == 2 ? std::strtoull(argv[1], nullptr, 10) : 1000000;
+    require(n >= 1000000, "law tests require at least 1e6 draws");
+    unit_tests();
+    std::puts("cohort units: replace/keep/missing/EOG/width/cost/RS2=PASS");
+    law_copy_only(n);
+    law_mixed(n);
+    std::puts("TARGET PASS");
+    return 0;
+}
