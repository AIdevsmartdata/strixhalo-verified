+// [TAG_SPEC_CHECKPOINT_ON_DEVICE] Experimental, default-off transport switch.
+// Only the single live speculative checkpoint uses device storage. Historical
+// prompt checkpoints must remain host-backed: device storage is per sequence,
+// not per checkpoint. Keep save/restore flags identical for the whole process.
+// Reference: https://github.com/JayToltTech/llama.cpp/pull/1
+static llama_state_seq_flags speculative_checkpoint_flags() {
+    static const llama_state_seq_flags flags = []() -> llama_state_seq_flags {
+        const char * value = std::getenv("LLAMA_SPEC_CHECKPOINT_ON_DEVICE");
+        const bool on_device = value && value[0] == '1' && value[1] == '\0';
+        const llama_state_seq_flags result = LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY |
+                (on_device ? LLAMA_STATE_SEQ_FLAGS_ON_DEVICE : 0);
+        LOG_INF("speculative checkpoint transport: ON_DEVICE=%d (flags=%u)\n",
+                int(on_device), unsigned(result));
+        return result;
+    }();
+    return flags;
+}
