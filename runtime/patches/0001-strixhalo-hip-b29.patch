diff --git a/common/copie24.h b/common/copie24.h
new file mode 100644
index 0000000000000000000000000000000000000000..645160702b5b390cd301ca708ce40ff18ccac7b9
--- /dev/null
+++ b/common/copie24.h
@@ -0,0 +1,196 @@
+#pragma once
+
+// Adapted from Gufo's MIT PromptLookup.
+// Copyright (c) 2026 gufo contributors.
+
+#include "llama.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <unordered_map>
+#include <vector>
+
+struct common_sampler;
+namespace common_leviathan { struct proposal; }
+
+class common_copie24_lookup {
+public:
+    static constexpr size_t key_tokens = 3;
+    static constexpr size_t min_match = 12;
+    static constexpr size_t sampled_min_match = 24;
+    static constexpr size_t max_match = 64;
+    static constexpr size_t max_candidates = 16;
+    static constexpr size_t resume_min_match = 5;
+    static constexpr size_t resume_window = 512;
+    static constexpr size_t resume_back = 8;
+
+    struct match {
+        size_t start = 0;
+        size_t length = 0;
+    };
+
+    void begin(const std::vector<llama_token> & prompt) {
+        source.clear();
+        prev.clear();
+        head.clear();
+        request_tokens = prompt;
+        request_start = prompt.size();
+        resume = no_state;
+        first = true;
+    }
+
+    match find(const std::vector<llama_token> & committed, const std::vector<llama_token> & tail, bool sampled) {
+        extend(committed, sampled);
+        if (first) {
+            first = false;
+            return {};
+        }
+
+        const size_t context = committed.size() + tail.size();
+        const size_t available = context - std::min(context, request_start);
+        const size_t longest = std::min(max_match, available);
+        const size_t minimum = sampled ? sampled_min_match : min_match;
+        if (longest < key_tokens) {
+            return {};
+        }
+
+        const auto at = [&](size_t i) {
+            return i < committed.size() ? committed[i] : tail[i - committed.size()];
+        };
+        llama_token key[key_tokens];
+        for (size_t i = 0; i < key_tokens; ++i) {
+            key[i] = at(context - key_tokens + i);
+        }
+
+        match best;
+        auto it = head.find(make_key(key));
+        uint32_t end = it == head.end() ? none : it->second;
+        for (size_t n = 0; n < max_candidates && end != none; ++n) {
+            size_t length = key_tokens;
+            while (length < longest && end > length && source[end - length - 1] == at(context - length - 1)) {
+                ++length;
+            }
+            const bool resumes = resume != no_state && end + resume_back >= resume && end <= resume + resume_window;
+            const bool allowed = length >= minimum || (resumes && length >= resume_min_match);
+            if (end < source.size() && length > best.length && allowed) {
+                best = {end, length};
+            }
+            end = prev[end];
+        }
+        return best;
+    }
+
+    template<typename IsEog>
+    std::vector<llama_token> copy(const match & m, size_t cap, IsEog is_eog) const {
+        std::vector<llama_token> result;
+        if (m.length == 0) {
+            return result;
+        }
+        const size_t count = std::min(cap, source.size() - m.start);
+        result.reserve(count);
+        for (size_t i = 0; i < count; ++i) {
+            const llama_token token = source[m.start + i];
+            result.push_back(token);
+            if (is_eog(token)) {
+                break;
+            }
+        }
+        return result;
+    }
+
+    void observe(size_t start, size_t proposed, size_t accepted) {
+        resume = 2 * accepted < proposed ? no_state : start + accepted;
+    }
+
+private:
+    static constexpr uint32_t none = std::numeric_limits<uint32_t>::max();
+    static constexpr size_t no_state = std::numeric_limits<size_t>::max();
+
+    static uint64_t make_key(const llama_token * tokens) {
+        uint64_t key = 0;
+        for (size_t i = 0; i < key_tokens; ++i) {
+            key = (key << 21) | (static_cast<uint64_t>(static_cast<uint32_t>(tokens[i])) & 0x1fffff);
+        }
+        return key;
+    }
+
+    void extend(const std::vector<llama_token> & committed, bool sampled) {
+        const auto & tokens = sampled ? request_tokens : committed;
+        const size_t bound = tokens.size();
+        if (source.size() > bound || (!source.empty() &&
+                (bound == 0 || source.front() != tokens.front() || source.back() != tokens[source.size() - 1]))) {
+            source.clear();
+            prev.clear();
+            head.clear();
+            resume = no_state;
+        }
+        for (size_t end = source.size(); end < bound; ++end) {
+            uint32_t previous = none;
+            if (end >= key_tokens) {
+                const uint64_t key = make_key(tokens.data() + end - key_tokens);
+                auto inserted = head.emplace(key, static_cast<uint32_t>(end));
+                if (!inserted.second) {
+                    previous = inserted.first->second;
+                    inserted.first->second = static_cast<uint32_t>(end);
+                }
+            }
+            prev.push_back(previous);
+            source.push_back(tokens[end]);
+        }
+    }
+
+    std::vector<llama_token> source;
+    std::vector<llama_token> request_tokens;
+    std::unordered_map<uint64_t, uint32_t> head;
+    std::vector<uint32_t> prev;
+    size_t request_start = 0;
+    size_t resume = no_state;
+    bool first = true;
+};
+
+// Cohort lookup and cost-gated width adapted from Gufo's MIT PromptLookup/MtpBatchController.
+// Copyright (c) 2026 gufo contributors.
+inline bool common_copie24_cohort_active(int mode, size_t n_seq_pass, int32_t uniform_n) {
+    return mode > 0 && n_seq_pass >= 2 && uniform_n > 0;
+}
+
+inline bool common_copie24_cohort_replace(std::vector<llama_token> & result,
+        const std::vector<llama_token> & copied, size_t first, size_t width) {
+    if (first > width || copied.size() != width - first ||
+            (result.size() != width && result.size() + 1 != width)) {
+        return false;
+    }
+    result.resize(width);
+    std::copy(copied.begin(), copied.end(), result.begin() + first);
+    return true;
+}
+
+inline double common_copie24_cohort_cost_threshold(size_t cohort, size_t width, size_t depth) {
+    static constexpr size_t cohorts[] = {2, 4, 6, 8};
+    static constexpr double costs[3][4][3] = {
+        {{21.2, 27.6, 30.8}, {41.4, 52.2, 57.6}, {61.6, 76.8, 84.4}, {81.8, 101.4, 111.2}},
+        {{21.325, 30.925, 33.625}, {41.525, 56.325, 61.125}, {61.725, 81.525, 86.925}, {81.925, 101.525, 111.325}},
+        {{22.1, 31.8, 36.0}, {42.4, 58.6, 64.0}, {62.6, 85.4, 93.0}, {82.8, 102.4, 112.2}},
+    };
+    if (width != 2) {
+        return -1.0;
+    }
+    const size_t d = depth < 2048 ? 0 : depth < 16384 ? 1 : 2;
+    for (size_t c = 0; c < 4; ++c) {
+        if (cohorts[c] == cohort) {
+            const double delta = costs[d][c][2] - costs[d][c][1];
+            return delta > 0.0 ? (double) cohort * delta / costs[d][c][0] : -1.0;
+        }
+    }
+    return -1.0;
+}
+
+void common_copie24_bind(std::vector<llama_token> * result, common_sampler * target_sampler,
+        std::vector<common_leviathan::proposal> * proposals, bool sampled);
+int common_copie24_sampled(const std::vector<llama_token> * result);
+void common_copie24_resize_proposals(std::vector<llama_token> * result, size_t size);
+void common_copie24_append_proposals(std::vector<llama_token> * result, size_t first);
+void common_copie24_replace_proposals(std::vector<llama_token> * result, size_t first);
+void common_copie24_unbind();
diff --git a/common/draft-policy-a3.h b/common/draft-policy-a3.h
new file mode 100644
index 0000000000000000000000000000000000000000..8aa35d8f873df8ead7a4d467d6eff79830d4db89
--- /dev/null
+++ b/common/draft-policy-a3.h
@@ -0,0 +1,165 @@
+#pragma once
+// A3: independent physical-cost policy. No sampler/RNG calls in this file.
+// Gufo policy inspiration: Copyright (c) 2026 gufo contributors (MIT).
+#include "draft-policy.h"
+#include <array>
+#include <functional>
+#include <numeric>
+#include <utility>
+
+namespace opus_draft_policy {
+struct cycle_cell {
+    std::array<double, 8> target{}, catchup{}, proposal{}, verify{}, checkpoint{};
+};
+using cycle_lookup = std::function<bool(int, cycle_cell &)>;
+struct batch_choice {
+    std::vector<int> n;
+    double rate = 0;
+    bool probe = false;
+};
+
+// Mirror split_equal's n_keep_tail rule for private sequences, sufficient
+// ubatch capacity, no prefill. Sequence ORDER matters; do not sort by width.
+inline std::vector<std::pair<int, int>> physical_passes(std::vector<int> left, int keep_tail) {
+    std::vector<std::pair<int, int>> out;
+    while (!left.empty()) {
+        const int width = *std::min_element(left.begin(), left.end());
+        int count = 0;
+        while (count < (int) left.size()) {
+            const int rest = left[count] - width;
+            if (rest > 0 && rest < keep_tail) { break; }
+            ++count;
+        }
+        int take = width;
+        if (!count) { count = 1; take = left[0]; }
+        out.emplace_back(count, take);
+        for (int i = 0; i < count; ++i) { left[i] -= take; }
+        left.erase(std::remove(left.begin(), left.end(), 0), left.end());
+    }
+    return out;
+}
+
+struct cycle_score { double tokens = 0, ms = 0; };
+inline cycle_score score_cycle(const std::vector<const state *> & rows, const std::vector<int> & ns,
+                              const cycle_lookup & lookup, int rs, double restore_ms,
+                              const std::vector<int> & previous) {
+    cycle_score score;
+    const int c = (int) rows.size();
+    if (!c || ns.size() != rows.size() || previous.size() != rows.size()) { return {}; }
+    std::vector<int> widths;
+    int largest = 0, old_largest = 0;
+    for (int i = 0; i < c; ++i) {
+        if (!rows[i] || ns[i] < 0 || ns[i] > 7 || ns[i] > (int) rows[i]->p.size() || previous[i] < 0 || previous[i] > 7) { return {}; }
+        widths.push_back(ns[i]+1);
+        largest = std::max(largest, ns[i]);
+        old_largest = std::max(old_largest, previous[i]);
+        score.tokens += rows[i]->expected(ns[i]);
+    }
+    cycle_cell cell;
+    if (!lookup(c, cell)) { return {}; }
+    // Catchup belongs to PREVIOUS chain, not the width being selected.
+    score.ms += cell.catchup[old_largest];
+    for (const auto & pass : physical_passes(widths, rs+1)) {
+        if (!lookup(pass.first, cell) || pass.second < 1 || pass.second > 8) { return {}; }
+        score.ms += cell.target[pass.second-1] + cell.verify[pass.second-1];
+    }
+    // Each MTP position is a real head call, at its active occupancy.
+    for (int j = 1; j <= largest; ++j) {
+        int active = 0;
+        for (int n : ns) { active += n >= j; }
+        if (!lookup(active, cell)) { return {}; }
+        score.ms += std::max(0.0, cell.proposal[j] - cell.proposal[j-1]);
+    }
+    // RS2: n-a > 2 restores a checkpoint; replay also emits a fresh bonus
+    // token. Price replay per slot conservatively (no assumed coalescing).
+    if (!lookup(1, cell)) { return {}; }
+    for (int i = 0; i < c; ++i) {
+        score.ms += cell.checkpoint[ns[i]];
+        double survival = 1;
+        for (int a = 0; a < ns[i]; ++a) {
+            const double reject = survival*(1-rows[i]->p[a]);
+            if (ns[i]-a > rs) {
+                score.tokens += reject;
+                score.ms += reject*(restore_ms + cell.target[a+1] + cell.verify[a+1] + cell.catchup[a+1]);
+            }
+            survival *= rows[i]->p[a];
+        }
+    }
+    if (!std::isfinite(score.ms) || score.ms <= 0) { return {}; }
+    return score;
+}
+
+// Exact finite search for a common width, followed (opt-in) by bounded
+// coordinate ascent from that incumbent. A heuristic, NOT a global solver.
+// It can never replace the common incumbent with a worse estimated rate.
+inline batch_choice choose_cycle(const std::vector<const state *> & rows, std::vector<int> caps,
+                                 const cycle_lookup & lookup, int rs, double restore_ms,
+                                 const std::vector<int> & previous, bool per_slot) {
+    batch_choice out;
+    if (rows.empty() || rows.size() > 8 || caps.size() != rows.size() || rs != 2) { return out; }
+    for (size_t i = 0; i < rows.size(); ++i) {
+        if (!rows[i] || caps[i] < 0) { return out; }
+        caps[i] = std::min({caps[i], 7, (int) rows[i]->p.size()});
+        if (rows[i]->cycles < 8) { caps[i] = std::min(caps[i], 2); }
+    }
+    auto rate = [&](const std::vector<int> & ns) {
+        const auto s = score_cycle(rows, ns, lookup, rs, restore_ms, previous);
+        return s.ms > 0 ? s.tokens/s.ms : -1.0;
+    };
+    const int common_cap = *std::min_element(caps.begin(), caps.end());
+    for (int n = 0; n <= common_cap; ++n) {
+        std::vector<int> trial(rows.size(), n);
+        const double r = rate(trial);
+        if ((out.n.empty() && r > 0) || r > out.rate*1.01) { out.n = trial; out.rate = r; }
+    }
+    if (out.n.empty()) { return out; }
+    if (per_slot) {
+        // A second seed escapes barriers where moving only one row from a
+        // rectangular incumbent is unprofitable. Always reprice jointly.
+        std::vector<int> independent(rows.size(), 0);
+        for (size_t i = 0; i < rows.size(); ++i) {
+            double best = 0;
+            for (int n = 0; n <= caps[i]; ++n) {
+                const auto s = score_cycle({rows[i]}, {n}, lookup, rs, restore_ms, {previous[i]});
+                const double r = s.ms > 0 ? s.tokens/s.ms : -1;
+                if (r > best*1.01) { best = r; independent[i] = n; }
+            }
+        }
+        const double independent_rate = rate(independent);
+        if (independent_rate > out.rate*1.01) { out.n = independent; out.rate = independent_rate; }
+        for (int sweep = 0; sweep < 2; ++sweep) {
+            bool changed = false;
+            for (size_t i = 0; i < rows.size(); ++i) {
+                auto best = out;
+                for (int n = 0; n <= caps[i]; ++n) {
+                    auto trial = out.n; trial[i] = n;
+                    const double r = rate(trial);
+                    if (r > best.rate*1.01) { best.n = trial; best.rate = r; }
+                }
+                changed |= best.n != out.n;
+                out = best;
+            }
+            if (!changed) { break; }
+        }
+    }
+    auto trial = out.n;
+    uint64_t phase = rows.front()->cycles;
+    for (const auto * row : rows) { phase = std::min(phase, row->cycles); }
+    const bool rectangular = std::all_of(trial.begin(), trial.end(), [&](int n) { return n == trial[0]; });
+    const bool common_probe = rectangular && trial[0] < common_cap &&
+            ((trial[0] == 0 && phase%16 == 15) || (trial[0] > 0 && phase%32 == 31));
+    if (common_probe) {
+        // Learn all rows without creating extra physical target passes.
+        for (auto & n : trial) { ++n; }
+    } else if (per_slot && phase%16 == 15) {
+        // At most one heterogeneous probe per 16 cycles, rotating ownership.
+        // Recovery is bounded by 16*C cycles for an all-AR eligible row.
+        const size_t i = (phase/16)%rows.size();
+        const bool tail_round = (phase/(16*rows.size()))%2 == 1;
+        if (trial[i] < caps[i] && (trial[i] == 0 || tail_round)) { ++trial[i]; }
+    }
+    const double probed_rate = rate(trial);
+    if (trial != out.n && probed_rate > 0) { out.n = trial; out.rate = probed_rate; out.probe = true; }
+    return out;
+}
+} // namespace opus_draft_policy
diff --git a/common/draft-policy.h b/common/draft-policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..7287fd3ab4cac7e4562c518161a2e5cd9ebd26fd
--- /dev/null
+++ b/common/draft-policy.h
@@ -0,0 +1,100 @@
+#pragma once
+
+// Independent implementation of the Gufo policy idea (MIT).
+// Attribution: Copyright (c) 2026 gufo contributors.
+// No sampling or wall-clock dependency: observations are request-local.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <vector>
+
+namespace opus_draft_policy {
+
+struct state {
+    std::vector<double> p;
+    uint64_t cycles = 0;
+
+    void reset(int limit) {
+        p.assign(std::max(0, limit), 0.75);
+        cycles = 0;
+    }
+
+    double expected(int n) const {
+        double sum = 1.0, survival = 1.0;
+        for (int i = 0; i < n && i < (int) p.size(); ++i) {
+            survival *= p[i];
+            sum += survival;
+        }
+        return sum;
+    }
+
+    void observe(int drafted, int accepted, double alpha = 0.25) {
+        if (drafted <= 0 || accepted < 0 || accepted > drafted) {
+            return;
+        }
+        // Only accepted positions and the FIRST mismatch are observed.
+        // A truncated/fully accepted tail is censored, never a failure.
+        const int observed = std::min<int>((int) p.size(), accepted + (accepted < drafted));
+        for (int i = 0; i < observed; ++i) {
+            p[i] = (1-alpha) * p[i] + alpha * (i < accepted ? 1.0 : 0.0);
+        }
+        ++cycles;
+    }
+
+    void ar_token() { ++cycles; }
+};
+
+struct decision {
+    int n = -1; // -1: unsupported cost cell, keep original dispatch
+    double tokens_per_ms = 0;
+    bool probe = false;
+};
+
+// costs[n] prices the WHOLE cohort at verification width n+1.
+// NaN denotes an unknown cell; missing AR cost disables the policy.
+inline decision choose(const std::vector<const state *> & rows,
+                       const std::vector<double> & costs, int cap) {
+    decision out;
+    if (rows.empty() || costs.empty() || !std::isfinite(costs[0]) || costs[0] <= 0) {
+        return out;
+    }
+    cap = std::min<int>(cap, (int) costs.size() - 1);
+    for (const auto * s : rows) {
+        if (!s) { return out; }
+        cap = std::min<int>(cap, (int) s->p.size());
+    }
+    if (cap < 1) { return out; }
+    out.n = 0;
+    out.tokens_per_ms = rows.size() / costs[0];
+    bool priced_draft = false;
+    for (int n = 1; n <= cap; ++n) {
+        if (!std::isfinite(costs[n]) || costs[n] <= 0) { continue; }
+        priced_draft = true;
+        double tokens = 0;
+        for (const auto * s : rows) { tokens += s->expected(n); }
+        const double score = tokens / costs[n];
+        // Strict comparison: ties keep the shorter chain / AR.
+        if (score > out.tokens_per_ms) {
+            out.n = n;
+            out.tokens_per_ms = score;
+        }
+    }
+    if (!priced_draft) { return decision{}; }
+    uint64_t phase = rows.front()->cycles;
+    for (const auto * s : rows) { phase = std::min(phase, s->cycles); }
+    // Bounded AR interval and deterministic exploration of censored tails.
+    // These explicitly labelled probes are exceptions to economic maximization.
+    int probe = out.n == 0 && phase % 16 == 15 ? 1 :
+                out.n > 0 && phase % 32 == 31 ? std::min(cap, out.n + 1) : out.n;
+    if (probe != out.n && std::isfinite(costs[probe]) && costs[probe] > 0) {
+        out.n = probe;
+        out.probe = true;
+        double tokens = 0;
+        for (const auto * s : rows) { tokens += s->expected(probe); }
+        out.tokens_per_ms = tokens / costs[probe];
+    }
+    return out;
+}
+
