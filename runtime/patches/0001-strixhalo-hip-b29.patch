+        const size_t A   = std::max(st->align, a);
+        const size_t W   = std::max<size_t>(64u * 1024, A);   // sample window (a multiple of A: both are powers of two)
+        const size_t hdr = std::min<size_t>((gguf_get_data_offset(meta) + A - 1) / A * A, 64u * 1024 * 1024);
+        std::vector<double> la, lb;
+        const double t0 = opus_lm_now();
+        // 1) the whole header: metadata and tensor infos (a different model or another export differs here)
+        std::string why = opus_lm_compare(st->src[0].fd, fd, 0, hdr, st->fsize, A, vcap, ba, bb, false, la, lb);
+        // 2) the last window, then windows at fixed pseudo-random places of the tensor data (splitmix64, fixed seed)
+        int n_win = 0;
+        uint64_t sm = 0x9E3779B97F4A7C15ull;
+        const size_t n_slots = st->fsize > hdr + W ? (st->fsize - hdr) / W : 0;
+        for (int k = 0; why.empty() && k < n_verify; ++k) {
+            if (k >= 16 && opus_lm_now() - t0 > 2.0) {
+                break;   // slow disk: the minimum (header + 16 windows) is done
+            }
+            size_t off;
+            if (k == 0 || n_slots == 0) {
+                off = (st->fsize - 1) / W * W;
+            } else {
+                uint64_t z = (sm += 0x9E3779B97F4A7C15ull);
+                z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+                z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+                z ^= z >> 31;
+                off = hdr + (size_t) (z % (uint64_t) n_slots) * W;
+            }
+            why = opus_lm_compare(st->src[0].fd, fd, off, W, st->fsize, A, vcap, ba, bb, (k & 1) != 0, la, lb);
+            n_win++;
+        }
+        const double dt = opus_lm_now() - t0;
+        if (!why.empty()) {
+            LLAMA_LOG_ERROR("LOAD_MULTI: REFUSE %s : %s ; copie ignoree\n", path.c_str(), why.c_str());
+            continue;
+        }
+        llama_opus_load_multi::source sc;
+        sc.path  = path;
+        sc.disk  = disk;
+        sc.fd    = fd;
+        sc.owned = true;
+        st->src.push_back(sc);
+        closer.fd = -1;   // owned by the state from now on (closed by its destructor)
+        st->align = A;
+        seen.emplace_back(sa.st_dev, sa.st_ino);
+        LLAMA_LOG_WARN("LOAD_MULTI: copie %zu : %s (disque %s) : en-tete %.1f Mio + %d fenetres de %zu Kio identiques au GGUF "
+                       "(%.2f s ; lectures GGUF p50 %.2f max %.1f ms | copie p50 %.2f max %.1f ms)\n", st->src.size() - 1, path.c_str(),
+                       disk.empty() ? "?" : disk.c_str(), hdr / 1048576.0, n_win, W / 1024, dt, opus_lm_pct(la, 0.5), opus_lm_pct(la, 1.0), opus_lm_pct(lb, 0.5),
+                       opus_lm_pct(lb, 1.0));
+    }
+    if (st->src.size() < 2) {
+        LLAMA_LOG_WARN("LOAD_MULTI: aucune copie retenue : chargement d'origine de %s\n", fnames[0].c_str());
+        return nullptr;
+    }
+    std::string disks;
+    for (size_t s = 0; s < st->src.size(); ++s) {
+        disks += format("%sc%zu %s", s ? ", " : "", s, st->src[s].disk.empty() ? "?" : st->src[s].disk.c_str());
+    }
+    LLAMA_LOG_WARN("LOAD_MULTI: actif : %zu copie(s) en plus de %s (%s) ; %d lecteur(s) par fichier, morceaux de %zu Mio au plus, "
+                   "partage dynamique\n", st->src.size() - 1, fnames[0].c_str(), disks.c_str(), st->readers, OPUS_LM_PIECE >> 20);
+    return st;
+}
+
+// One load_all_data call: reader threads (one or more per file) fill staging buffers; the calling thread alone talks to
+// the backend (uploads, events) and writes the tensors, in the order the pieces complete.
+struct opus_lm_engine {
+    enum sink_t : uint8_t { SINK_ASYNC, SINK_SET, SINK_HOST };
+    struct span {                 // bytes [fbeg, fend) of the file, for t at offset toff
+        ggml_tensor * t;
+        size_t fbeg, fend, toff;
+        sink_t sink;
+    };
+    struct piece {                // window [wbeg, wbeg+wlen) read into buffer buf; useful bytes [skip, skip+n) go to t at toff
+        ggml_tensor * t;
+        size_t wbeg, wlen, skip, n, toff;
+        sink_t sink;
+        int buf, src;
+    };
+    struct cnt {
+        double   bytes  = 0;
+        double   busy   = 0;
+        uint64_t pieces = 0;
+        uint64_t errors = 0;
+        uint64_t shrunk = 0;      // pieces cut short by the end-of-load rule
+        int      threads = 0;
+    };
+
+    llama_opus_load_multi & st;
+    ggml_backend_t up = nullptr;              // upload backend (SINK_ASYNC)
+    std::vector<uint8_t *> bptr;              // aligned staging buffers
+    std::vector<ggml_backend_event_t> bev;    // one event per buffer (SINK_ASYNC)
+    std::vector<void *> owned;                // buffers allocated here
+    size_t cap = OPUS_LM_PIECE;
+    size_t A   = 4096;
+    size_t window = 0;                        // bytes queued ahead of the readers at most (submit blocks beyond)
+
+    std::mutex mu;
+    std::condition_variable cv_r, cv_m;
+    std::deque<span>  q;
+    std::deque<piece> done;
+    std::vector<int>  free_b;
+    size_t q_bytes = 0, left = 0, in_flight = 0;
+    bool   stop = false;
+    std::string fatal;
+    std::vector<cnt> c;
+    std::vector<std::thread> th;
+    double t_start = 0, t_handed = 0;
+    std::string label;
+
+    opus_lm_engine(llama_opus_load_multi & state, size_t total) : st(state), A(state.align), left(total) {}
+
+    ~opus_lm_engine() {
+        {
+            std::lock_guard<std::mutex> g(mu);
+            stop = true;
+        }
+        cv_r.notify_all();
+        for (auto & x : th) {
+            if (x.joinable()) {
+                x.join();   // a pread in flight cannot be cancelled: wait for it before the buffers go away
+            }
+        }
+        for (void * p : owned) {
+            free(p);
+        }
+    }
+
+    int n_threads() const {
+        int n = 0;
+        for (const auto & s : st.src) {
+            n += s.alive ? st.readers : 0;
+        }
+        return n;
+    }
+
+    // borrowed pinned buffers of `size` bytes (SINK_ASYNC) ; returns false if one is too small for a useful piece
+    bool use_buffers(const std::vector<void *> & base, const std::vector<ggml_backend_event_t> & ev, size_t size) {
+        cap = OPUS_LM_PIECE;
+        for (size_t i = 0; i < base.size() && i < ev.size(); ++i) {
+            const uintptr_t b = (uintptr_t) base[i];
+            const uintptr_t p = (b + A - 1) & ~(uintptr_t) (A - 1);
+            if (p - b >= size) {
+                return false;
+            }
+            cap = std::min(cap, (size - (size_t) (p - b)) / A * A);
+            bptr.push_back((uint8_t *) p);
+            bev.push_back(ev[i]);
+        }
+        return cap >= OPUS_LM_MIN_PIECE && (int) bptr.size() >= n_threads() + 1;
+    }
+
+    // buffers allocated here (SINK_SET / SINK_HOST: no upload backend)
+    bool own_buffers(int n) {
+        cap = OPUS_LM_PIECE;
+        for (int i = 0; i < n; ++i) {
+            void * p = nullptr;
+            if (posix_memalign(&p, A, cap) != 0 || p == nullptr) {
+                return false;
+            }
+            owned.push_back(p);
+            bptr.push_back((uint8_t *) p);
+            bev.push_back(nullptr);
+        }
+        return true;
+    }
+
+    void start(ggml_backend_t upload, const char * name) {
+        up      = upload;
+        label   = name ? name : "?";
+        window  = 2 * bptr.size() * cap;
+        t_start = opus_lm_now();
+        c.resize(st.src.size());
+        for (int i = (int) bptr.size() - 1; i >= 0; --i) {
+            free_b.push_back(i);
+        }
+        // every count is set before the first reader starts (allowance() reads them under mu)
+        for (size_t s = 0; s < st.src.size(); ++s) {
+            c[s].threads = st.src[s].alive ? st.readers : 0;
+        }
+        for (size_t s = 0; s < st.src.size(); ++s) {
+            for (int r = 0; r < c[s].threads; ++r) {
+                th.emplace_back([this, s] { run((int) s); });
+            }
+        }
+    }
+
+    // ---- reader side (mu held) ----
+
+    // useful bytes reader s may take from the head of the queue now; 0 = leave it to the others
+    size_t allowance(int s) const {
+        const span & sp = q.front();
+        const double rs = st.src[s].rate;
+        if (rs <= 0) {
+            return cap;                       // throughput not measured yet: read, and measure it
+        }
+        double ro = 0, best = 0;
+        int fbest = -1;
+        for (size_t j = 0; j < st.src.size(); ++j) {
+            if (!st.src[j].alive || st.src[j].rate <= 0) {
+                continue;
+            }
+            if (st.src[j].rate > best) {
+                best  = st.src[j].rate;
+                fbest = (int) j;
+            }
+            if ((int) j != s) {
+                ro += st.src[j].rate * c[j].threads;
+            }
+        }
+        if (fbest == s || ro <= 0) {
+            return cap;                       // the fastest file never declines: something always progresses
+        }
+        // taking n bytes ends in n/rs ; leaving them, the other files end all that is left in left/ro
+        const double n_c = (double) std::min(sp.fend - sp.fbeg, cap);
+        if (n_c * ro <= (double) left * rs) {
+            return cap;
+        }
+        const size_t n_s = (size_t) ((double) left * rs / ro) / A * A;
+        return n_s >= OPUS_LM_MIN_PIECE ? n_s : 0;
+    }
+
+    piece take(int s, size_t want) {
+        span & sp = q.front();
+        piece p;
+        p.t    = sp.t;
+        p.sink = sp.sink;
+        p.src  = s;
+        p.toff = sp.toff;
+        p.wbeg = sp.fbeg / A * A;
+        p.skip = sp.fbeg - p.wbeg;
+        const size_t lim = std::min(cap, (p.skip + std::max<size_t>(want, 1) + A - 1) / A * A);   // > skip, multiple of A
+        if (p.wbeg + lim >= sp.fend) {
+            p.n    = sp.fend - sp.fbeg;
+            p.wlen = (sp.fend + A - 1) / A * A - p.wbeg;   // <= lim
+            q.pop_front();
+        } else {
+            p.n     = p.wbeg + lim - sp.fbeg;
+            p.wlen  = lim;
+            sp.fbeg += p.n;                                 // the rest of the span starts on an alignment boundary
+            sp.toff += p.n;
+            if (want < cap) {
+                c[s].shrunk++;
+            }
+        }
+        p.buf = free_b.back();
+        free_b.pop_back();
+        q_bytes -= p.n;
+        left    -= p.n;
+        in_flight++;
+        if (left == 0) {
+            t_handed = opus_lm_now();
+        }
+        return p;
+    }
+
+    void drop(int s, const piece & p, const std::string & why) {
+        if (st.src[s].alive) {
+            st.src[s].alive = false;
+            LLAMA_LOG_ERROR("LOAD_MULTI: %s ECARTE (%s, fenetre a l'octet %zu) ; ses morceaux passent aux autres fichiers\n",
+                            st.src[s].path.c_str(), why.c_str(), p.wbeg);
+        }
+        c[s].errors++;
+        q.push_front({ p.t, p.wbeg + p.skip, p.wbeg + p.skip + p.n, p.toff, p.sink });
+        q_bytes += p.n;
+        left    += p.n;
+        free_b.push_back(p.buf);
+        bool any = false;
+        for (const auto & x : st.src) {
+            any = any || x.alive;
+        }
+        if (!any && fatal.empty()) {
+            fatal = format("LOAD_MULTI: plus aucun fichier lisible (%s : %s)", st.src[s].path.c_str(), why.c_str());
+        }
+    }
+
+    void run(int s) {
+        std::unique_lock<std::mutex> lk(mu);
+        try {
+            const int fd = st.src[s].fd;
+            for (;;) {
+                size_t want = 0;
+                cv_r.wait(lk, [&] {
+                    if (stop || !st.src[s].alive || !fatal.empty()) {
+                        return true;
+                    }
+                    if (q.empty() || free_b.empty()) {
+                        return false;
+                    }
+                    want = allowance(s);
+                    return want > 0;
+                });
+                if (stop || !st.src[s].alive || !fatal.empty()) {
+                    return;
+                }
+                const piece p = take(s, want);
+                cv_m.notify_one();
+                lk.unlock();
+                const double  t0  = opus_lm_now();
+                const ssize_t got = opus_lm_pread(fd, bptr[p.buf], p.wlen, p.wbeg, st.fsize);
+                const int     err = errno;
+                const double  dt  = opus_lm_now() - t0;
+                lk.lock();
+                in_flight--;
+                if (got >= 0 && (size_t) got >= p.skip + p.n) {
+                    c[s].bytes += (double) p.n;
+                    c[s].busy  += dt;
+                    c[s].pieces++;
+                    if (p.wlen >= OPUS_LM_RATE_MIN && dt > 0) {
+                        const double x = (double) p.wlen / dt;
+                        st.src[s].rate = st.src[s].rate > 0 ? 0.7 * st.src[s].rate + 0.3 * x : x;
+                    }
+                    done.push_back(p);
+                } else {
+                    drop(s, p, got < 0 ? std::string(strerror(err)) : format("lecture courte : %zd octets sur %zu", got, p.skip + p.n));
+                }
+                cv_m.notify_one();
+                cv_r.notify_all();    // rates, buffers or files changed: the others look again
+            }
+        } catch (const std::exception & e) {
+            if (!lk.owns_lock()) {
+                lk.lock();
+            }
+            if (fatal.empty()) {
+                fatal = format("LOAD_MULTI: lecteur de %s : %s", st.src[s].path.c_str(), e.what());
+            }
+            cv_m.notify_one();
+            cv_r.notify_all();
+        }
+    }
+
+    // ---- calling thread ----
+
+    void deliver(const piece & p) {
+        const uint8_t * data = bptr[p.buf] + p.skip;
+        switch (p.sink) {
+            case SINK_HOST:
+                memcpy((uint8_t *) p.t->data + p.toff, data, p.n);   // the original code reads host tensors into t->data
+                break;
+            case SINK_SET:
+                ggml_backend_tensor_set(p.t, data, p.toff, p.n);
+                break;
+            case SINK_ASYNC:
+                ggml_backend_tensor_set_async(up, p.t, data, p.toff, p.n);
+                ggml_backend_event_record(bev[p.buf], up);
+                ggml_backend_event_synchronize(bev[p.buf]);   // the buffer is reused only once its copy is done
+                break;
+        }
+    }
+
+    // writes the completed pieces until cond() holds (evaluated with mu held); throws on a fatal error
+    template <typename F>
+    void pump(F cond) {
+        std::unique_lock<std::mutex> lk(mu);
+        for (;;) {
+            if (!fatal.empty()) {
+                const std::string f = fatal;
+                lk.unlock();
+                throw std::runtime_error(f);
+            }
+            if (!done.empty()) {
+                const piece p = done.front();
+                done.pop_front();
+                lk.unlock();
+                deliver(p);
+                lk.lock();
+                free_b.push_back(p.buf);
+                cv_r.notify_all();
+                continue;
+            }
+            if (cond()) {
+                return;
+            }
+            cv_m.wait(lk);
+        }
+    }
+
+    // hands the bytes [foff, foff+n) of t to the readers, in the order of the original loop
+    void submit(ggml_tensor * t, size_t foff, size_t n, sink_t sink) {
+        if (n == 0) {
+            return;   // nothing to read (counted as 0 in `left`)
+        }
+        pump([&] { return q.empty() || q_bytes + n <= window; });
+        std::lock_guard<std::mutex> g(mu);
+        q.push_back({ t, foff, foff + n, 0, sink });
+        q_bytes += n;
+        cv_r.notify_all();
+    }
+
+    // every piece read and written (uploads synchronised), readers joined, counters logged
+    void finish() {
+        // every submission is in: nothing queued and nothing in flight means everything was read (the second test only
+        // turns a byte-count mismatch, which would be a bug, into an error instead of a wait without end)
+        pump([&] { return in_flight == 0 && (left == 0 || q.empty()); });
+        if (left != 0) {
+            throw std::runtime_error(format("LOAD_MULTI: %zu octets annonces jamais soumis (incoherence interne)", left));
+        }
+        {
+            std::lock_guard<std::mutex> g(mu);
+            stop = true;
+        }
+        cv_r.notify_all();
+        for (auto & x : th) {
+            if (x.joinable()) {
+                x.join();
+            }
+        }
+        const double t_end = opus_lm_now();
+        const double wall  = t_end - t_start;
+        double total = 0;
+        for (const auto & x : c) {
+            total += x.bytes;
+        }
+        std::string per;
+        for (size_t s = 0; s < c.size(); ++s) {
+            const double gib = c[s].bytes / 1073741824.0;
+            per += format(" | c%zu %s %.2f Gio (%.0f %%) %.2f Gio/s, %llu morceaux (%llu raccourcis), %llu err%s", s,
+                          st.src[s].disk.empty() ? "?" : st.src[s].disk.c_str(), gib,
+                          total > 0 ? 100.0 * c[s].bytes / total : 0.0, c[s].busy > 0 ? gib / c[s].busy : 0.0,
+                          (unsigned long long) c[s].pieces, (unsigned long long) c[s].shrunk, (unsigned long long) c[s].errors,
+                          st.src[s].alive ? "" : " ECARTE");
+            st.src[s].bytes  += c[s].bytes;
+            st.src[s].busy   += c[s].busy;
+            st.src[s].pieces += c[s].pieces;
+            st.src[s].errors += c[s].errors;
+        }
+        st.t_total += wall;
+        st.b_total += total;
+        st.n_calls++;
+        LLAMA_LOG_WARN("LOAD_MULTI: [%s] %.2f Gio en %.2f s (%.2f Gio/s ; fin de file %.3f s ; %zu tampons de %zu Mio)%s\n",
+                       label.c_str(), total / 1073741824.0, wall, wall > 0 ? total / 1073741824.0 / wall : 0.0,
+                       t_handed > 0 ? t_end - t_handed : 0.0, bptr.size(), cap >> 20, per.c_str());
+    }
+};
+
+// nullptr = original code for this call (OFF, nothing to read, or no copy usable)
+std::unique_ptr<opus_lm_engine> opus_lm_start(llama_model_loader & ml, const std::vector<ggml_tensor *> & tensors,
+                                              ggml_backend_t upload_backend, std::vector<ggml_backend_buffer_t> & host_buffers,
+                                              std::vector<void *> & host_ptrs, std::vector<ggml_backend_event_t> & events,
+                                              size_t buffer_size) {
+    const char * env = getenv("LLAMA_OPUS_LOAD_MULTI");
+    if (env == nullptr || env[0] == '\0') {
+        return nullptr;   // OFF
+    }
+    if (ml.use_mmap || ml.check_tensors) {
+        if (!ml.opus_lm_tried) {
+            ml.opus_lm_tried = true;
+            LLAMA_LOG_WARN("LOAD_MULTI: ignore avec mmap ou --check-tensors (-lm dio requis) : chargement d'origine\n");
+        }
+        return nullptr;
+    }
+    if (!ml.opus_lm_tried) {
+        ml.opus_lm_tried = true;
+        try {
+            ml.opus_lm = opus_lm_setup(env, ml.files, ml.fnames, ml.metadata);
+        } catch (const std::exception & ex) {
+            LLAMA_LOG_WARN("LOAD_MULTI: verification des copies impossible (%s) : chargement d'origine\n", ex.what());
+            ml.opus_lm.reset();
+        }
+    }
+    if (!ml.opus_lm) {
+        return nullptr;
+    }
+    llama_opus_load_multi & st = *ml.opus_lm;
+    int n_alive = 0;
+    for (const auto & s : st.src) {
+        n_alive += s.alive ? 1 : 0;
+    }
+    if (n_alive < 2) {
+        return nullptr;   // a copy failed in an earlier call: the GGUF alone, original code
+    }
+    size_t total = 0;
+    const char * name = nullptr;
+    for (ggml_tensor * t : tensors) {
+        if (ml.get_weight(ggml_get_name(t)) == nullptr || ml.lazy.has(t)) {
+            continue;
+        }
+        total += ggml_nbytes(t);
+        if (name == nullptr && t->buffer != nullptr) {
+            name = ggml_backend_buffer_name(t->buffer);
+        }
+    }
+    if (total == 0) {
+        return nullptr;
+    }
+    try {
+        auto e = std::make_unique<opus_lm_engine>(st, total);
+        const int n_buf = std::max(4, e->n_threads() + 2);
+        if (upload_backend) {
+            // the pinned buffers of the original code (4), plus one per reader beyond 2 (freed with them at the end)
+            ggml_backend_dev_t dev = ggml_backend_get_device(upload_backend);
+            ggml_backend_buffer_type_t hbt = dev ? ggml_backend_dev_host_buffer_type(dev) : nullptr;
+            while (hbt != nullptr && (int) host_ptrs.size() < n_buf && host_ptrs.size() == events.size()) {
+                ggml_backend_buffer_t b = ggml_backend_buft_alloc_buffer(hbt, buffer_size);
+                if (b == nullptr) {
+                    break;
+                }
+                ggml_backend_event_t ev = ggml_backend_event_new(dev);
+                if (ev == nullptr) {
+                    ggml_backend_buffer_free(b);
+                    break;
+                }
+                host_buffers.push_back(b);
+                host_ptrs.push_back(ggml_backend_buffer_get_base(b));
+                events.push_back(ev);
+            }
+            if (!e->use_buffers(host_ptrs, events, buffer_size)) {
+                LLAMA_LOG_WARN("LOAD_MULTI: tampons d'envoi inutilisables : chargement d'origine pour cet appel\n");
+                return nullptr;
+            }
+        } else if (!e->own_buffers(n_buf)) {
+            LLAMA_LOG_WARN("LOAD_MULTI: %d tampons de %zu Mio impossibles : chargement d'origine pour cet appel\n", n_buf, OPUS_LM_PIECE >> 20);
+            return nullptr;
+        }
+        e->start(upload_backend, name);
+        return e;
+    } catch (const std::exception & ex) {
+        LLAMA_LOG_WARN("LOAD_MULTI: demarrage impossible (%s) : chargement d'origine pour cet appel\n", ex.what());
+        return nullptr;
+    }
