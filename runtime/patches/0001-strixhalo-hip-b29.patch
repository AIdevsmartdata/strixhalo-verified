+static int opus_mmid_maxb_parse(const char * s) {
+    if (s == nullptr || *s == '\0') {
+        return -1;
+    }
+    const int n = atoi(s);
+    return n < 2 ? 0 : (n > OPUS_MMID_LEGACY_MAX ? OPUS_MMID_LEGACY_MAX : n);
