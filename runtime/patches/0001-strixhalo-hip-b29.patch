+
+bool common_sampler_leviathan_eligible(const common_sampler * gsmpl) {
+    return common_sampler_leviathan_enabled(gsmpl) &&
+        (!grammar_should_apply(gsmpl) || llama_sampler_grammar_is_idle(gsmpl->grmr));
+}
+
+// The dist sampler draws from expf(logit - max), summed in double. Its exported
+// F32 probabilities are rounded; use its transformed logits to recover the same law.
+static std::vector<common_leviathan::weight> leviathan_distribution(common_sampler * gsmpl) {
+    auto & cur = gsmpl->cur_p;
+    llama_sampler_apply(gsmpl->rbudget, &cur);
+    const int n = llama_sampler_chain_n(gsmpl->chain);
+    GGML_ASSERT(n > 0 && std::strcmp(llama_sampler_name(llama_sampler_chain_get(gsmpl->chain, n - 1)), "dist") == 0);
+    for (int i = 0; i + 1 < n; ++i) { llama_sampler_apply(llama_sampler_chain_get(gsmpl->chain, i), &cur); }
+    if (!cur.size) { throw std::runtime_error("empty Leviathan sampler chain"); }
+    float max_logit = -INFINITY;
+    for (size_t i = 0; i < cur.size; ++i) { max_logit = std::max(max_logit, cur.data[i].logit); }
+    std::vector<common_leviathan::weight> p;
+    p.reserve(cur.size);
+    for (size_t i = 0; i < cur.size; ++i) {
+        p.push_back({cur.data[i].id, cur.size == 1 ? 1.0 : double(expf(cur.data[i].logit - max_logit))});
+    }
+    p = common_leviathan::normalize(std::move(p));
+    for (size_t i = 0; i < cur.size; ++i) { cur.data[i].p = float(p[i].p); }
+    return p;
+}
+
+llama_token common_sampler_mtp_propose(common_sampler * draft, common_sampler * target, llama_context * ctx, int idx, common_leviathan::proposal & q) {
+    llama_synchronize(ctx);
+    const auto tm = draft->tm();
+    draft->set_logits(ctx, idx);
+    if (draft->nonfinite) { throw std::runtime_error("nonfinite MTP proposal logits"); }
+    auto & cur = draft->cur_p;
+    // Bounded support is a draft policy, independent of the complete target law.
+    if (cur.size > common_leviathan::max_candidates) {
+        std::partial_sort(cur.data, cur.data + common_leviathan::max_candidates, cur.data + cur.size,
+                [](const llama_token_data & a, const llama_token_data & b) { return a.logit > b.logit; });
+        cur.size = common_leviathan::max_candidates;
+        cur.sorted = true;
+    }
+    q = common_leviathan::quantize(leviathan_distribution(draft));
+    const auto id = common_leviathan::draw(q, target->proposal_rng);
+    cur.selected = -1;
+    for (size_t i = 0; i < cur.size; ++i) {
+        cur.data[i].p = float(q.masses[i].n) / common_leviathan::units;
+        if (cur.data[i].id == id) { cur.selected = i; }
+    }
+    GGML_ASSERT(cur.selected >= 0);
+    common_sampler_accept(draft, id, true);
+    return id;
+}
+
+std::vector<llama_token> common_sampler_sample_and_accept_leviathan_n(common_sampler * gsmpl, llama_context * ctx, const std::vector<int> & idxs, const llama_tokens & draft, const std::vector<common_leviathan::proposal> & proposals) {
+    GGML_ASSERT(idxs.size() == draft.size() + 1 && proposals.size() >= draft.size());
+    if (GGML_OPUS_INT("LLAMA_OPUS_S12_AUDIT", 0) & 1) { s12_audit::cycle(proposals, draft.size()); }
+    std::vector<llama_token> result;
+    for (size_t i = 0; i < draft.size(); ++i) {
+        llama_token id;
+        bool accepted;
+        if (common_sampler_leviathan_eligible(gsmpl)) {
+            llama_synchronize(ctx);
+            const auto tm = gsmpl->tm();
+            if (GGML_OPUS_INT("LLAMA_OPUS_S12_AUDIT", 0) & 2) { s12_audit::logits(ctx, idxs[i], gsmpl->s12_position); }
+            gsmpl->set_logits(ctx, idxs[i]);
+            if (gsmpl->nonfinite) { return {0}; }
+            GGML_ASSERT(proposals[i].token == draft[i]);
+            const auto p = leviathan_distribution(gsmpl);
+            const auto d = common_leviathan::verify(p, proposals[i], gsmpl->verify_rng);
+            if (GGML_OPUS_INT("LLAMA_OPUS_S12_AUDIT", 0) & 1) {
+                s12_audit::distribution(p, proposals[i], d.token, i, d.accepted);
+            }
+            id = d.token;
+            accepted = d.accepted;
+            for (size_t j = 0; j < gsmpl->cur_p.size; ++j) {
+                if (gsmpl->cur_p.data[j].id == id) { gsmpl->cur_p.selected = j; break; }
+            }
+        } else {
+            // An accept can activate a lazy tool grammar. Its next position uses the old path.
+            id = common_sampler_sample(gsmpl, ctx, idxs[i]);
+            accepted = id == draft[i];
+        }
+        common_sampler_accept(gsmpl, id, true);
+        result.push_back(id);
+        if (gsmpl->nonfinite || !accepted) { return result; }
+    }
+    const auto id = common_sampler_sample(gsmpl, ctx, idxs.back());
+    common_sampler_accept(gsmpl, id, true);
+    result.push_back(id);
+    return result;
+}
