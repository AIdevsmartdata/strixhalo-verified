+// OPUS SMALLFUS bit 1: puts the k ids written by top_k_wg_kernel in the order of a stable descending full sort
+// (key descending, equal keys by increasing column), i.e. exactly what the hipCUB argsort fallback returns.
+#define TOPK_SORT_MAX_K 256
+static __global__ void __launch_bounds__(TOPK_SORT_MAX_K) top_k_sort_small_kernel(
+        const float * __restrict__ src, int * __restrict__ dst, const int k) {
+    __shared__ uint32_t skey[TOPK_SORT_MAX_K];
+    __shared__ int      scol[TOPK_SORT_MAX_K];
+    const int tid = threadIdx.x;
+    if (tid < k) { const int c = dst[tid]; scol[tid] = c; skey[tid] = top_k_float_to_ordered(src[c]); }
+    __syncthreads();
+    if (tid < k) {
+        const uint32_t ki = skey[tid]; const int ci = scol[tid];
+        int rank = 0;
+        for (int j = 0; j < k; ++j) rank += (skey[j] > ki) || (skey[j] == ki && scol[j] < ci);
+        dst[rank] = ci;
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// [OPUS-QSATOPK] (GGML_OPUS_QSATOPK, defaut 0 = OFF = code d'origine ; registre a chaud, categorie 'a')
+// Cible : le TOP_K de l'indexeur QSA marque op_params[0] == 1 (qwen4exp_select_complete_blocks : l'ordre des ids ne compte
+// pas, ils sont re-tries par ordre croissant juste apres) qui tombe aujourd'hui sur le tri segmente hipCUB complet parce
+// qu'il a plusieurs lignes (verification MTP n=3 a U=1) et moins de 8192 colonnes (profondeur < 32K), ou une seule ligne
+// sous le seuil GGML_OPUS_LONG_MIN_KV. Bits : 1 = plusieurs lignes, 2 = une ligne.
+// Ensemble rendu = celui du tri radix STABLE descendant de rocPRIM (hipCUB DeviceSegmentedSort / DeviceRadixSort) :
+//   - cle canonique : -0 replie sur +0 (le codec radix de hipCUB fait de +0 et -0 une seule cle ; sonde gfx1151 du 17/10 :
+//     motif alterne +0/-0 => ids 0..9 dans l'ordre des colonnes) ; le reste = top_k_float_to_ordered ;
+//   - toutes les cles strictement au-dessus de la k-ieme, puis les colonnes les PLUS BASSES egales a elle.
+// Difference avec top_k_wg_kernel (inchange) : la cle canonique, et le ramassage des cles egales au seuil se fait TOUJOURS
+// par __ballot sur la ligne dans l'ordre des colonnes (ncols/1024 pas), au lieu du comptage O(ne^2) en LDS de la branche
+// « fits » (ne peut atteindre ~4000 quand le seuil tombe sur +0 apres relu : 16 000 iterations par fil).
+// Controle : GGML_OPUS_QSATOPK_CHECK=1 refait le chemin hipCUB d'origine dans un tampon et compare les ENSEMBLES par ligne
+// (synchrone, lent, pour le banc d'exactitude seulement) ; « [OPUS-QSATOPK] check n=.. lignes_fausses=.. ».
+static __device__ __forceinline__ uint32_t opus_qsatopk_key(float value) {
+    uint32_t bits = __float_as_uint(value);
+    bits = bits == 0x80000000U ? 0U : bits;   // -0 -> +0
+    const uint32_t mask = (uint32_t) (-(int32_t) (bits >> 31)) | 0x80000000U;
+    return bits ^ mask;
+}
+
+static __global__ void __launch_bounds__(TOPK_WG_THREADS) opus_qsatopk_kernel(
+        const float * __restrict__ src, int * __restrict__ dst, const int ncols, const int k) {
+    const int row = blockIdx.x, tid = threadIdx.x;
+    const float * x = src + (size_t) row * ncols;
+    int * out = dst + (size_t) row * k;
+
+    __shared__ int hist[4096];
+    __shared__ int red[TOPK_WG_THREADS];
+    __shared__ uint32_t ckey[TOPK_WG_CAP];
+    __shared__ int      ccol[TOPK_WG_CAP];
+    __shared__ int n_out, n_cand;
+
+    for (int i = tid; i < 4096; i += TOPK_WG_THREADS) hist[i] = 0;
+    if (tid == 0) { n_out = 0; n_cand = 0; }
+    __syncthreads();
+
+    // pass 1: top 12 bits of the canonical key
+    {
+        int c = tid;
+        for (; c + 3 * TOPK_WG_THREADS < ncols; c += 4 * TOPK_WG_THREADS) {
+            const float v0 = x[c], v1 = x[c + TOPK_WG_THREADS], v2 = x[c + 2 * TOPK_WG_THREADS], v3 = x[c + 3 * TOPK_WG_THREADS];
+            atomicAdd(&hist[opus_qsatopk_key(v0) >> 20], 1);
+            atomicAdd(&hist[opus_qsatopk_key(v1) >> 20], 1);
+            atomicAdd(&hist[opus_qsatopk_key(v2) >> 20], 1);
+            atomicAdd(&hist[opus_qsatopk_key(v3) >> 20], 1);
+        }
+        for (; c < ncols; c += TOPK_WG_THREADS) {
+            atomicAdd(&hist[opus_qsatopk_key(x[c]) >> 20], 1);
+        }
+    }
+    __syncthreads();
+    int b12, rank;
+    top_k_wg_find<4096>(hist, k, red, b12, rank);
+    const int bucket = hist[b12];
+    uint32_t prefix = (uint32_t) b12 << 20, pmask = 0xFFF00000u;
+    __syncthreads();
+
+    // pass 2: keys above the bucket go out, the bucket is compacted when it fits
+    const bool fits = bucket <= TOPK_WG_CAP;
+    auto place = [&](const int c, const float v) {
+        const uint32_t key = opus_qsatopk_key(v);
+        const uint32_t top = key >> 20;
+        if (top > (uint32_t) b12) {
+            out[atomicAdd(&n_out, 1)] = c;
+        } else if (fits && top == (uint32_t) b12) {
+            const int p = atomicAdd(&n_cand, 1);
+            ckey[p] = key; ccol[p] = c;
+        }
+    };
+    {
+        int c = tid;
+        for (; c + 3 * TOPK_WG_THREADS < ncols; c += 4 * TOPK_WG_THREADS) {
+            const float v0 = x[c], v1 = x[c + TOPK_WG_THREADS], v2 = x[c + 2 * TOPK_WG_THREADS], v3 = x[c + 3 * TOPK_WG_THREADS];
+            place(c, v0); place(c + TOPK_WG_THREADS, v1); place(c + 2 * TOPK_WG_THREADS, v2); place(c + 3 * TOPK_WG_THREADS, v3);
+        }
+        for (; c < ncols; c += TOPK_WG_THREADS) place(c, x[c]);
+    }
+    __syncthreads();
+
+    // remaining 20 bits: 10 + 10, on the candidates or on the row
+    const int ncand = fits ? n_cand : 0;
+    for (int shift = 10; shift >= 0; shift -= 10) {
+        for (int i = tid; i < 1024; i += TOPK_WG_THREADS) hist[i] = 0;
+        __syncthreads();
+        if (fits) {
+            for (int i = tid; i < ncand; i += TOPK_WG_THREADS) {
+                const uint32_t key = ckey[i];
+                if ((key & pmask) == prefix) atomicAdd(&hist[(key >> shift) & 1023], 1);
+            }
+        } else {
+            for (int c = tid; c < ncols; c += TOPK_WG_THREADS) {
+                const uint32_t key = opus_qsatopk_key(x[c]);
+                if ((key & pmask) == prefix) atomicAdd(&hist[(key >> shift) & 1023], 1);
+            }
+        }
+        __syncthreads();
+        int b10, r2;
+        top_k_wg_find<1024>(hist, rank, red, b10, r2);
+        rank = r2;
+        prefix |= (uint32_t) b10 << shift;
+        pmask  |= 1023u << shift;
+        __syncthreads();
+    }
+    const uint32_t thr = prefix;   // the k-th largest canonical key; `rank` keys equal to it are taken
+
+    // keys above the threshold inside the bucket
+    if (fits) {
+        for (int i = tid; i < ncand; i += TOPK_WG_THREADS) {
+            if (ckey[i] > thr) out[atomicAdd(&n_out, 1)] = ccol[i];
+        }
+    } else {
+        for (int c = tid; c < ncols; c += TOPK_WG_THREADS) {
+            const uint32_t key = opus_qsatopk_key(x[c]);
+            if ((key >> 20) == (uint32_t) b12 && key > thr) out[atomicAdd(&n_out, 1)] = c;
+        }
+    }
+    __syncthreads();
+    const int base = n_out;   // == k - rank
+
+    // equal keys, lowest columns first: always the row-order ballot gather (uniform loop, ncols/1024 steps)
+    {
+        const int lane = tid % warpSize, warp = tid / warpSize;
+        constexpr int NW = TOPK_WG_THREADS / 32;
+        int taken = 0;
+        for (int c0 = 0; c0 < ncols && taken < rank; c0 += TOPK_WG_THREADS) {
+            const int c = c0 + tid;
+            const bool eq = c < ncols && opus_qsatopk_key(x[c]) == thr;
+            const unsigned long long m = __ballot(eq);
+            if (lane == 0) red[warp] = __popcll(m);
+            __syncthreads();
+            int before = taken;
+            for (int w = 0; w < NW; ++w) { if (w < warp) before += red[w]; }
+            int total = 0;
+            for (int w = 0; w < NW; ++w) total += red[w];
+            const int pos = before + __popcll(m & ((1ULL << lane) - 1));
+            if (eq && pos < rank) out[base + pos] = c;
+            taken += total;
+            __syncthreads();
+        }
+    }
+}
+
+// CHECK : ensemble candidat (k ids distincts dans [0, ncols)) == ensemble de reference, ligne par ligne
+static __global__ void opus_qsatopk_mark(const int * __restrict__ cand, int * __restrict__ mark, const int ncols, const int k,
+        int * __restrict__ bad_rows) {
+    const int row = blockIdx.x;
+    __shared__ int bad;
+    if (threadIdx.x == 0) bad = 0;
+    __syncthreads();
+    for (int i = threadIdx.x; i < k; i += blockDim.x) {
+        const int c = cand[(size_t) row * k + i];
+        if (c < 0 || c >= ncols || atomicExch(&mark[(size_t) row * ncols + c], 1) != 0) {
+            bad = 1;   // hors bornes ou doublon
+        }
+    }
+    __syncthreads();
+    if (threadIdx.x == 0 && bad) atomicAdd(bad_rows, 1);
+}
+
+static __global__ void opus_qsatopk_cmp(const int * __restrict__ ref_sorted, const int * __restrict__ mark, const int ncols,
+        const int k, int * __restrict__ bad_rows) {
+    const int row = blockIdx.x;
+    __shared__ int bad;
+    if (threadIdx.x == 0) bad = 0;
+    __syncthreads();
+    for (int i = threadIdx.x; i < k; i += blockDim.x) {
+        const int c = ref_sorted[(size_t) row * ncols + i];   // reference : k premiers ids du tri hipCUB de la ligne
+        if (c < 0 || c >= ncols || mark[(size_t) row * ncols + c] != 1) {
+            bad = 1;
+        }
+    }
+    __syncthreads();
+    if (threadIdx.x == 0 && bad) atomicAdd(bad_rows, 1);
+}
+
+static void opus_qsatopk_count(const int64_t nrows, const int64_t ncols, const int64_t k) {
+    static std::atomic<uint64_t> n{0};
+    const uint64_t v = n.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (v == 1 || v == 10 || v == 100 || v == 1000 || v % 10000 == 0) {
+        fprintf(stderr, "[OPUS-QSATOPK] declenche n=%llu (dernier : nrows=%lld ncols=%lld k=%lld)\n",
+                (unsigned long long) v, (long long) nrows, (long long) ncols, (long long) k);
+    }
+}
