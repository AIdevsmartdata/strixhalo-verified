+                (unsigned long long) pst_slow[3], (unsigned long long) pst_slow[4], (unsigned long long) pf_n_req.load(),
+                (unsigned long long) pf_n_rows.load(), (unsigned long long) pf_n_ranges.load(), (unsigned long long) pf_n_drop_full.load(),
+                (unsigned long long) pf_n_drop_stale.load(), (unsigned long long) pf_n_cut.load(), pf_mode, pf_nthr);
+    }
+
+    // ---- OPUS PLEDOUBLE: hedged reads ----
+    static int64_t pd_now_ns() {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+    static int pd_bucket(int64_t us) {   // 4 classes per octave (resolution 25 %), as the PLEKEEP histogram
+        if (us < 1) { return 0; }
+        const int l = 63 - __builtin_clzll((unsigned long long) us);
+        const int s = l >= 2 ? (int) ((us >> (l - 2)) & 3) : (int) ((us << (2 - l)) & 3);
+        return std::min(63, l) * 4 + s;
+    }
+    static int64_t pd_bucket_lo(int b) {
+        const int l = b / 4, s = b % 4;
+        return l >= 2 ? (int64_t) (4 + s) << (l - 2) : (int64_t) 1 << l;
+    }
+    // percentile q of a histogram (lower bound of the class), 0 when empty
+    static int64_t pd_pct(const uint64_t * h, double q) {
+        uint64_t n = 0;
+        for (int b = 0; b < 256; ++b) { n += h[b]; }
+        if (n == 0) { return 0; }
+        const uint64_t want = (uint64_t) std::max(1.0, q * (double) n + 0.999999);
+        uint64_t acc = 0;
+        for (int b = 0; b < 256; ++b) {
+            acc += h[b];
+            if (acc >= want) { return pd_bucket_lo(b); }
+        }
+        return 0;
+    }
+    static int64_t pd_max_us(const uint64_t * h) {
+        for (int b = 255; b >= 0; --b) {
+            if (h[b]) { return pd_bucket_lo(b); }
+        }
+        return 0;
+    }
+    static void pd_clock(char * s, size_t n) {
+        const time_t t = time(nullptr);
+        struct tm tm {};
+        localtime_r(&t, &tm);
+        strftime(s, n, "%H:%M:%S", &tm);
+    }
+
+    void pd_init(const std::vector<std::pair<std::string, size_t>> & copies) {
+        bool force_direct = false;
+        if (const char * e = getenv("LLAMA_OPUS_PLE_DOUBLE_DIRECT")) { force_direct = atoi(e) != 0; }
+        auto c0 = std::make_unique<pd_copy>();
+        c0->name = fname; c0->fd = fd; c0->offs = offs; c0->direct = direct;
+        pd.push_back(std::move(c0));
+        for (const auto & cp : copies) {
+            if ((int) pd.size() >= pd_max) {
+                LLAMA_LOG_WARN("ple_double: at most %d copies; %s ignored\n", pd_max - 1, cp.first.c_str());
+                break;
+            }
+            bool dio = direct || force_direct;
+            int  f   = -1;
+#if defined(O_DIRECT)
+            if (dio) {
+                f = open(cp.first.c_str(), O_RDONLY | O_DIRECT | O_CLOEXEC);
+            }
+#endif
+            if (f < 0) {
+                dio = false;
+                f   = open(cp.first.c_str(), O_RDONLY | O_CLOEXEC);
+            }
+            if (f < 0) {
+                LLAMA_LOG_WARN("ple_double: cannot open %s (%s); copy ignored\n", cp.first.c_str(), strerror(errno));
+                continue;
+            }
+            if (!dio && getenv("LLAMA_PLE_EVICT") && atoi(getenv("LLAMA_PLE_EVICT")) != 0) {
+                posix_fadvise(f, 0, 0, POSIX_FADV_DONTNEED);   // same cold start as the source (bench control)
+            }
+            auto c = std::make_unique<pd_copy>();
+            c->name = cp.first; c->fd = f; c->offs = cp.second; c->direct = dio; c->own = true;
+            pd.push_back(std::move(c));
+        }
+        pd_last_dump = pd_now_ns();
+        if (pd.size() < 2) {
+            pd.clear();   // copy 0 owns nothing
+            LLAMA_LOG_WARN("ple_double: no usable copy; single reads\n");
+            return;
+        }
+        pd_nthr = n_threads;
+        if (const char * e = getenv("LLAMA_OPUS_PLE_DOUBLE_THREADS"))  { pd_nthr = std::max(1, atoi(e)); }
+        if (const char * e = getenv("LLAMA_OPUS_PLE_DOUBLE_PROBE"))    { pd_probe = std::max(0, atoi(e)); }
+        if (const char * e = getenv("LLAMA_OPUS_PLE_DOUBLE_STATS_S"))  { pd_stats_ns = (int64_t) std::max(0, atoi(e)) * 1000000000LL; }
+        for (size_t c = 0; c < pd.size(); ++c) {
+            LLAMA_LOG_WARN("ple_double: c%zu = %s @ %zu (%s%s)\n", c, pd[c]->name.c_str(), pd[c]->offs,
+                           pd[c]->direct ? "O_DIRECT" : "page cache", c == 0 ? ", source" : "");
+        }
+        LLAMA_LOG_WARN("ple_double: hedged reads over %zu copies, %d readers per copy, probe every %lld gathers, mode %d, delay %d us "
+                       "(mode and delay switchable)\n", pd.size(), pd_nthr, (long long) pd_probe,
+                       (int) GGML_OPUS_INT("LLAMA_OPUS_PLE_DOUBLE_MODE", 1), (int) GGML_OPUS_INT("LLAMA_OPUS_PLE_DOUBLE_DELAY_US", 2000));
+    }
+
+    // join every reader (a late read finishes first) before any descriptor closes
+    void pd_shutdown() {
+        if (pd.empty()) {
+            return;
+        }
+        {
+            std::lock_guard<std::mutex> lk(pd_mx);
+            pd_stop = true;
+            for (auto & c : pd) { c->cv.notify_all(); }
+        }
+        for (auto & c : pd) {
+            for (auto & t : c->thr) { t.join(); }
+            c->thr.clear();
+            c->ka.reset();
+            if (c->own && c->fd >= 0) { close(c->fd); }
+        }
+        pd.clear();
+    }
+
+    uint8_t pd_live() const {
+        uint8_t m = 0;
+        for (size_t c = 0; c < pd.size(); ++c) {
+            m |= pd[c]->dead.load(std::memory_order_relaxed) ? 0 : (uint8_t) (1u << c);
+        }
+        return m;
+    }
+
+    // Lead copy. The source while it is healthy; a copy takes the lead only during a slow episode of the source (moving
+    // latency above 1 ms AND 4x the copy's), and gives it back as soon as the source is under 1 ms or within 2x (no
+    // flapping between two healthy disks). Without the source (dropped), the fastest live copy.
+    int pd_choose_lead(uint8_t live) {
+        int     cand = -1;
+        int64_t ec   = 0;
+        for (size_t c = 1; c < pd.size(); ++c) {
+            const int64_t e = pd[c]->ewma_us.load(std::memory_order_relaxed);
+            if ((live & (1u << c)) && e >= 0 && (cand < 0 || e < ec)) {
+                cand = (int) c;
+                ec   = e;
+            }
+        }
+        const int64_t e0   = pd[0]->ewma_us.load(std::memory_order_relaxed);
+        const int64_t slow = 1000;
+        int best = 0;
+        if (!(live & 1)) {
+            best = cand >= 0 ? cand : __builtin_ctz(live);
+        } else if (cand >= 0 && e0 > slow && (pd_lead == 0 ? e0 > 4 * ec : e0 > 2 * ec)) {
+            best = cand;
+        }
+        if (best != pd_lead) {
+            char ts[16];
+            pd_clock(ts, sizeof(ts));
+            fprintf(stderr, "ple_double: %s lead c%d -> c%d (moving latency c0 %lld us, best copy c%d %lld us)\n", ts, pd_lead, best,
+                    (long long) e0, cand, (long long) ec);
+            pd_lead = best;
+            pd_switches[0]++;
+        }
+        return best;
+    }
+
+    // one read of `row` on copy `cp` into `bounce`; pointer to the row, nullptr on error or short read (never aborts)
+    const uint8_t * pd_pread(const pd_copy & cp, int32_t row, uint8_t * bounce) const {
+        const off_t  off  = (off_t) cp.offs + (off_t) row * (off_t) rs;
+        const off_t  a0   = cp.direct ? off & ~(off_t) (block - 1) : off;
+        const size_t need = (size_t) (off - a0) + rs;
+        const size_t len  = cp.direct ? ((need + block - 1) / block) * block : need;
+        size_t got = 0;
+        while (got < len) {
+            const ssize_t r = pread(cp.fd, bounce + got, len - got, a0 + (off_t) got);
+            if (r < 0 && errno == EINTR) {
+                continue;
+            }
+            if (r <= 0) {
+                break;
+            }
+            got += (size_t) r;
+        }
+        return got >= need ? bounce + (off - a0) : nullptr;
+    }
+
+    void pd_read_one(int c, pd_batch & b, size_t i, uint8_t * bounce) {
+        pd_copy & cp = *pd[c];
+        const int64_t t0 = pd_now_ns();
+        b.t_last[i].store(t0, std::memory_order_relaxed);
+        b.issued[i].fetch_or((uint8_t) (1u << c), std::memory_order_release);
+        cp.n_issued.fetch_add(1, std::memory_order_relaxed);
+        errno = 0;   // REVUE PLEDOUBLE: a short read leaves errno untouched
+        const uint8_t * p   = pd_pread(cp, b.rows[i], bounce);
+        const int       err = errno;
+        const int64_t   us  = (pd_now_ns() - t0) / 1000;
+        if (p == nullptr) {
+            cp.n_err.fetch_add(1, std::memory_order_relaxed);
+            if (!cp.dead.exchange(true)) {
+                fprintf(stderr, "ple_double: read of row %d in %s failed (%s); copy c%d dropped\n", b.rows[i], cp.name.c_str(),
+                        err ? strerror(err) : "short read", c);
+            }
+            std::lock_guard<std::mutex> lk(pd_mx);
+            pd_cv_done.notify_one();   // the gather thread hands the row to a live copy
+            return;
+        }
+        cp.hist[pd_bucket(us)].fetch_add(1, std::memory_order_relaxed);
+        const int64_t e = cp.ewma_us.load(std::memory_order_relaxed);   // racy update: statistics and lead choice only
+        cp.ewma_us.store(e < 0 ? us : e + (us - e) / 8, std::memory_order_relaxed);
+        uint8_t expect = 0;
+        if (b.owner[i].compare_exchange_strong(expect, (uint8_t) (c + 1), std::memory_order_acq_rel)) {
+            memcpy(b.buf.data() + i * rs, p, rs);
+            b.ready[i].store(1, std::memory_order_release);
+            cp.n_won.fetch_add(1, std::memory_order_relaxed);
+            if (b.done.fetch_add(1, std::memory_order_acq_rel) + 1 == b.n) {
+                std::lock_guard<std::mutex> lk(pd_mx);
+                pd_cv_done.notify_one();
+            }
+            return;
+        }
+        cp.n_lost.fetch_add(1, std::memory_order_relaxed);
+        if (b.ready[i].load(std::memory_order_acquire) && memcmp(b.buf.data() + i * rs, p, rs) != 0) {
+            if (pd_n_diff.fetch_add(1) == 0) {
+                fprintf(stderr, "ple_double: ROW %d DIFFERS between c%d and c%d (%s): the copies are not identical\n", b.rows[i],
+                        (int) expect - 1, c, cp.name.c_str());
+            }
+            // REVUE PLEDOUBLE: never keep serving rows from two sources that disagree. Back to the source alone (copy 0, the
+            // GGUF or the PLEFILE copy compared with it at load): every other copy is dropped for good, the rows they were
+            // reading go to the source at the next tick of the gather thread (no delay for rows read by dropped copies only).
+            if (!pd[0]->dead.load(std::memory_order_relaxed)) {
+                for (size_t k = 1; k < pd.size(); ++k) {
+                    if (!pd[k]->dead.exchange(true)) {
+                        fprintf(stderr, "ple_double: copy c%zu (%s) dropped after a difference: single reads from the source\n",
+                                k, pd[k]->name.c_str());
+                    }
+                }
+            } else if (pd_n_diff.load() == 1) {
+                fprintf(stderr, "ple_double: the source is already dropped: no reference left to fall back to\n");
+            }
+        }
+    }
+
+    void pd_worker(int c) {
+        set_ioprio(ioprio_mode);
+        pd_copy &     cp     = *pd[c];
+        const uint8_t bit    = (uint8_t) (1u << c);
+        uint8_t *     bounce = alloc_bounce();
+        uint64_t      seen   = 0;
+        for (;;) {
+            std::shared_ptr<pd_batch> b;
+            {
+                std::unique_lock<std::mutex> lk(pd_mx);
+                cp.cv.wait(lk, [&] { return pd_stop || (pd_epoch != seen && pd_cur && (pd_cur->armed.load() & bit)); });
+                if (pd_stop) {
+                    break;
+                }
+                seen = pd_epoch;
+                b    = pd_cur;
+            }
+            while (!cp.dead.load(std::memory_order_relaxed) && b->done.load(std::memory_order_acquire) < b->n) {
+                size_t i = b->next.fetch_add(1, std::memory_order_relaxed);
+                if (i >= b->n) {   // no free row left: rows handed again by the gather thread
+                    std::lock_guard<std::mutex> lk(pd_mx);
+                    i = SIZE_MAX;
+                    while (b->redo_cur[c] < b->redo.size()) {
+                        const uint32_t k = b->redo[b->redo_cur[c]++];
+                        if (b->owner[k].load(std::memory_order_acquire) == 0 && !(b->issued[k].load() & bit)) {
+                            i = k;
+                            break;
+                        }
+                    }
+                    if (i == SIZE_MAX) {
+                        break;
+                    }
+                }
+                pd_read_one(c, *b, i, bounce);
+            }
+        }
+        free(bounce);
+    }
+
+    // replaces run_job(read) when PLEDOUBLE is on: same rows, same destination in `raw`
+    void pd_read_misses(int mode) {
+        const size_t n = misses.size();
+        if (!pd_started) {
+            pd_started = true;
+            for (size_t c = 0; c < pd.size(); ++c) {
+                for (int t = 0; t < pd_nthr; ++t) {
+                    pd[c]->thr.emplace_back([this, c] { pd_worker((int) c); });
+                }
+            }
+        }
+        auto b = std::make_shared<pd_batch>(n, rs);
+        for (size_t i = 0; i < n; ++i) {
+            b->rows[i] = misses[i].first;
+        }
+        uint8_t live = pd_live();
+        if (live == 0) {
+            GGML_ABORT("llama_ple_disk: no readable copy of %s left", fname.c_str());
+        }
+        const bool    probe    = pd_probe > 0 && (pd_g[0] % (uint64_t) pd_probe) == (uint64_t) pd_probe - 1;
+        const int     lead     = pd_choose_lead(live);
+        const int64_t delay_ns = (int64_t) std::max(50, (int) GGML_OPUS_INT("LLAMA_OPUS_PLE_DOUBLE_DELAY_US", 2000)) * 1000;
+        const int64_t t0       = pd_now_ns();
+        bool hedged = false;
+        {
+            std::unique_lock<std::mutex> lk(pd_mx);
+            const uint8_t arm = (mode == 2 || probe) ? live : (uint8_t) (1u << lead);
+            b->armed.store(arm);
+            if (mode == 2) {   // every row to every copy: the readers of each copy also take the rows the others took
+                b->redo.resize(n);
+                for (size_t i = 0; i < n; ++i) {
+                    b->redo[i]  = (uint32_t) i;
+                    b->asked[i] = live;
+                }
+            }
+            pd_cur = b;
+            ++pd_epoch;
+            for (size_t c = 0; c < pd.size(); ++c) {
+                if (arm & (1u << c)) { pd[c]->cv.notify_all(); }
+            }
+            size_t lo = 0;   // rows below lo all have a winner
+            const int64_t tick = std::max<int64_t>(delay_ns / 2, 100000);
+            while (b->done.load(std::memory_order_acquire) < n) {
+                pd_cv_done.wait_for(lk, std::chrono::nanoseconds(tick));
+                if (b->done.load(std::memory_order_acquire) == n) {
+                    break;
+                }
+                live = pd_live();
+                if (live == 0) {
+                    GGML_ABORT("llama_ple_disk: no readable copy of %s left", fname.c_str());
+                }
+                const int64_t now = pd_now_ns();
+                uint8_t add    = 0;
+                size_t  pushed = 0;
+                const size_t hi = std::min(b->next.load(), n);
+                while (lo < hi && b->owner[lo].load(std::memory_order_acquire) != 0) {
+                    ++lo;
+                }
+                for (size_t i = lo; i < hi; ++i) {
+                    if (b->owner[i].load(std::memory_order_acquire) != 0) {
+                        continue;
+                    }
+                    const uint8_t is = b->issued[i].load(std::memory_order_acquire);
+                    if (is == 0) {
+                        continue;   // taken from the cursor, its read is starting
+                    }
+                    const uint8_t want = live & ~is & ~b->asked[i];
+                    const bool    lost = (is & live) == 0;   // only dropped copies read it: no delay
+                    if (want == 0 || (!lost && now - b->t_last[i].load(std::memory_order_relaxed) < delay_ns)) {
+                        continue;
+                    }
+                    b->redo.push_back((uint32_t) i);
+                    b->asked[i] |= want;
+                    add |= want;
+                    ++pushed;
+                }
+                pd_rows_again[0] += pushed;
+                if (b->next.load() < n && now - t0 >= delay_ns) {
+                    add |= live;   // free rows still waiting: the armed readers are all held by slow reads
+                }
+                add &= live;
+                if (pushed != 0 || (add & ~b->armed.load()) != 0) {
+                    b->armed.store(b->armed.load() | add);
+                    ++pd_epoch;
+                    hedged = true;
+                    for (size_t c = 0; c < pd.size(); ++c) {
+                        if (add & (1u << c)) { pd[c]->cv.notify_all(); }
+                    }
+                }
+            }
+            pd_cur.reset();   // late readers keep their own reference
+        }
+        // rows won by another copy than the lead: "rescued" when the lead was reading them too (a hedge that paid),
+        // "shared" otherwise (free rows of a big gather taken by a copy armed later, or a probe)
+        size_t n_resc = 0, n_shared = 0;
+        for (size_t i = 0; i < n; ++i) {
+            memcpy(raw.data() + (size_t) misses[i].second * rs, b->buf.data() + i * rs, rs);
+            if (b->owner[i].load(std::memory_order_relaxed) != (uint8_t) (lead + 1)) {
+                if (b->issued[i].load(std::memory_order_relaxed) & (1u << lead)) {
+                    ++n_resc;
+                } else {
+                    ++n_shared;
+                }
+            }
+        }
+        const bool rescued = n_resc > 0;
+        const int64_t t1 = pd_now_ns();
+        pd_g[0]++;
+        pd_g_hedged[0]  += hedged;
+        pd_g_rescued[0] += rescued && mode != 2;
+        pd_rows_resc[0]   += n_resc;
+        pd_rows_shared[0] += n_shared;
+        pd_g_probe[0]   += probe && mode != 2;
+        pd_g_doubled[0] += mode == 2;
+        pd_ghist[pd_bucket((t1 - t0) / 1000)]++;
+        if (pd_stats_ns > 0 && t1 - pd_last_dump >= pd_stats_ns) {
+            pd_summary(false);
+        }
+    }
+
+    // "ple_double:" line: window since the last line (or everything, final)
+    void pd_summary(bool final) {
+        const int64_t now = pd_now_ns();
+        const double  win = pd_last_dump ? (double) (now - pd_last_dump) * 1e-9 : 0.0;
+        pd_last_dump = now;
+        auto d = [&](uint64_t * v) { const uint64_t r = final ? v[0] : v[0] - v[1]; v[1] = v[0]; return (unsigned long long) r; };
+        uint64_t gh[256];
+        for (int k = 0; k < 256; ++k) {
+            gh[k] = final ? pd_ghist[k] : pd_ghist[k] - pd_gprev[k];
+            pd_gprev[k] = pd_ghist[k];
+        }
+        char ts[16];
+        pd_clock(ts, sizeof(ts));
+        std::string line = format("ple_double: %s %s gathers %llu (hedged %llu, rescued %llu, probes %llu, doubled %llu) "
+                                  "rows (again %llu, rescued %llu, shared %llu) "
+                                  "| read p50 %.2f p90 %.2f p99 %.2f max %.1f ms | lead c%d, switches %llu | diff %llu",
+                                  ts, final ? "[total]" : format("[%.1f s]", win).c_str(), d(pd_g), d(pd_g_hedged), d(pd_g_rescued),
+                                  d(pd_g_probe), d(pd_g_doubled), d(pd_rows_again), d(pd_rows_resc), d(pd_rows_shared),
+                                  pd_pct(gh, 0.50) * 1e-3, pd_pct(gh, 0.90) * 1e-3,
+                                  pd_pct(gh, 0.99) * 1e-3, pd_max_us(gh) * 1e-3, pd_lead, d(pd_switches),
+                                  (unsigned long long) pd_n_diff.load());
+        for (size_t c = 0; c < pd.size(); ++c) {
+            pd_copy & cp = *pd[c];
+            uint64_t h[256];
+            for (int k = 0; k < 256; ++k) {
+                const uint64_t v = cp.hist[k].load(std::memory_order_relaxed);
+                h[k] = final ? v : v - cp.prev[k];
+                cp.prev[k] = v;
+            }
+            uint64_t cnt[4] = { cp.n_issued.load(), cp.n_won.load(), cp.n_lost.load(), cp.n_err.load() };
+            uint64_t dc[4];
+            for (int k = 0; k < 4; ++k) {
+                dc[k] = final ? cnt[k] : cnt[k] - cp.prev_cnt[k];
+                cp.prev_cnt[k] = cnt[k];
+            }
+            line += format(" | c%zu%s reads %llu won %llu lost %llu err %llu p50 %lld p90 %lld p99 %lld max %lld us", c,
+                           cp.dead.load() ? " DEAD" : "", (unsigned long long) dc[0], (unsigned long long) dc[1],
+                           (unsigned long long) dc[2], (unsigned long long) dc[3], (long long) pd_pct(h, 0.50),
+                           (long long) pd_pct(h, 0.90), (long long) pd_pct(h, 0.99), (long long) pd_max_us(h));
+        }
+        fprintf(stderr, "%s\n", line.c_str());
+    }
+
     void gather(const int32_t * idx, size_t n, float * out) {
+        if (ka) { ka->touch(); }   // OPUS PLEKEEP: the table is in use (one atomic store)
+        for (auto & c : pd) {      // OPUS PLEDOUBLE: and the disks of the copies
+            if (c->ka) { c->ka->touch(); }
+        }
         std::lock_guard<std::mutex> lk(mtx);
+        epoch.fetch_add(1, std::memory_order_relaxed);   // OPUS PLEPREF: staleness clock
