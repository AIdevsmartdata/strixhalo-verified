+// a MUL_MAT / MUL_MAT_ID that ggml_cuda_mul_mat / ggml_cuda_mul_mat_id send to ggml_cuda_mul_mat_vec_q
+static bool ggml_cuda_mmvq_y_reader(const ggml_tensor * node, const int cc, ggml_cuda_mmvq_y_key & key) {
+    if ((node->op != GGML_OP_MUL_MAT && node->op != GGML_OP_MUL_MAT_ID) || node->type != GGML_TYPE_F32) {
+        return false;
+    }
+    const ggml_tensor * src0 = node->src[0];
+    const ggml_tensor * src1 = node->src[1];
+    if (src0 == nullptr || src1 == nullptr || src1->data == nullptr || src1->type != GGML_TYPE_F32 ||
+            !ggml_is_quantized(src0->type) || !ggml_is_contiguous(src1) || src1->ne[0] % QK8_1 != 0) {
+        return false;
+    }
+    if (node->op == GGML_OP_MUL_MAT) {
+        if (src1->ne[1] > MMVQ_MAX_BATCH_SIZE || !ggml_cuda_should_use_mmvq(src0->type, cc, src1->ne[1])) {
+            return false;
+        }
