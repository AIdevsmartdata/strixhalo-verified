+#pragma once
+
+#include "ggml.h"
+
+#include <cstdint>
+
+static inline uintptr_t ggml_cuda_graph_buffer_key(uintptr_t key, const ggml_cgraph * cgraph) {
+    constexpr uintptr_t prime = (uintptr_t) 0x100000001B3ull;
+
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        key = (key ^ (uintptr_t) node->data)*prime;
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            if (node->src[j]) {
+                key = (key ^ (uintptr_t) node->src[j]->data)*prime;
+            }
+        }
+    }
+
+    return key;
+}
