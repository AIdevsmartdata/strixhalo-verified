+
+static const char * const k_names[P_N] = {
+    "gap", "gap_tasks", "pre", "pre_draft", "draft_mtp", "draft_ngram",
+    "h0_launch", "h0_sample", "h1_launch", "h1_sample", "h2_launch", "h2_sample", "h3_launch", "h3_sample",
