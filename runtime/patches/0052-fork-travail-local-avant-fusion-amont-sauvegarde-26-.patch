diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/qsa_finalize.comp b/ggml/src/ggml-vulkan/vulkan-shaders/qsa_finalize.comp
new file mode 100644
index 00000000000..d1103b25cde
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/qsa_finalize.comp
@@ -0,0 +1,122 @@
+#version 450
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+#if MASK_F16
+#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
+#extension GL_EXT_shader_16bit_storage : require
+#endif
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+layout(binding = 0, std430) readonly buffer Scores { float scores[]; };
+layout(binding = 1, std430) readonly buffer Blocks { int blocks[]; };
+#if MASK_F16
+layout(binding = 2, std430) readonly buffer Masks { uint16_t masks[]; };
+#else
+layout(binding = 2, std430) readonly buffer Masks { float masks[]; };
+#endif
+layout(binding = 3, std430) writeonly buffer Output { int cells_out[]; };
+
+layout(push_constant) uniform Parameters {
+    uint n_kv;
+    uint n_out;
+    uint score_offset;
+    uint score_nb0;
+    uint score_nb1;
+    uint block_offset;
+    uint block_nb0;
+    uint block_nb1;
+    uint mask_offset;
+    uint mask_nb0;
+    uint mask_nb1;
+    uint out_offset;
+} p;
+
+shared uvec2 subgroup_minimum[256];
+shared uint dropped[8];
+shared uint first_cell;
+
+bool less_pair(uvec2 a, uvec2 b) {
+    return a.x < b.x || (a.x == b.x && a.y < b.y);
+}
+
+void main() {
+    const uint row = gl_WorkGroupID.x;
+    const uint tid = gl_LocalInvocationID.x;
+    const uint n_cand = 2056u + p.n_kv%4u;
+    const uint n_drop = n_cand - 2051u;
+    uint keys[9];
+    uint slots[9];
+    uint cells[9];
+    for (uint i = 0u; i < 9u; ++i) {
+        const uint slot = tid + 256u*i;
+        keys[i] = 0xffffffffu;
+        slots[i] = 0xffffffffu;
+        cells[i] = 0u;
+        if (slot >= n_cand) {
+            continue;
+        }
+        const uint block = slot < 2056u ? uint(blocks[p.block_offset + row*p.block_nb1 + (slot/4u)*p.block_nb0]) : p.n_kv/4u;
+        const uint cell = 4u*block + slot%4u;
+        const uint mask_idx = p.mask_offset + row*p.mask_nb1 + cell*p.mask_nb0;
+#if MASK_F16
+        const float mask = unpackHalf2x16(uint(masks[mask_idx])).x;
+#else
+        const float mask = masks[mask_idx];
+#endif
+        precise float effective = scores[p.score_offset + row*p.score_nb1 + block*p.score_nb0] + mask;
+        const uint bits = floatBitsToUint(effective);
+        keys[i] = (bits & 0x80000000u) != 0u ? ~bits : bits | 0x80000000u;
+        slots[i] = slot;
+        cells[i] = cell;
+    }
+
+    for (uint round = 0u; round < n_drop; ++round) {
+        uvec2 best = uvec2(0xffffffffu);
+        for (uint i = 0u; i < 9u; ++i) {
+            const uvec2 candidate = uvec2(keys[i], slots[i]);
+            if (slots[i] != 0xffffffffu && less_pair(candidate, best)) {
+                best = candidate;
+            }
+        }
+        const uint min_key = subgroupMin(best.x);
+        const uint min_slot = subgroupMin(best.x == min_key ? best.y : 0xffffffffu);
+        if (subgroupElect()) {
+            subgroup_minimum[gl_SubgroupID] = uvec2(min_key, min_slot);
+        }
+        barrier();
+        if (tid == 0u) {
+            uvec2 winner = uvec2(0xffffffffu);
+            for (uint s = 0u; s < gl_NumSubgroups; ++s) {
+                if (less_pair(subgroup_minimum[s], winner)) {
+                    winner = subgroup_minimum[s];
+                }
+            }
+            dropped[round] = winner.y;
+        }
+        barrier();
+        for (uint i = 0u; i < 9u; ++i) {
+            if (slots[i] == dropped[round]) {
+                slots[i] = 0xffffffffu;
+            }
+        }
+    }
+
+    const uint output_base = p.out_offset + row*p.n_out;
+    for (uint i = 0u; i < 9u; ++i) {
+        if (slots[i] == 0xffffffffu) {
+            continue;
+        }
+        uint rank = slots[i];
+        for (uint j = 0u; j < n_drop; ++j) {
+            rank -= uint(dropped[j] < slots[i]);
+        }
+        cells_out[output_base + rank] = int(cells[i]);
+        if (rank == 0u) {
+            first_cell = cells[i];
+        }
+    }
+    barrier();
+    for (uint i = 2051u + tid; i < p.n_out; i += 256u) {
+        cells_out[output_base + i] = int(first_cell);
+    }
+}
