+// ---------------------------------------------------------------------------------------------------------------------
+// LLAMA_OPUS_PFX=1 (V12PFX, default OFF): learned shared-prefix checkpoint. A small registry keeps the tokens of the last
+// prompts seen; when a new prompt shares a long prefix L with one of them (a branch: neither is a prefix of the other) and
+// no checkpoint restores it near L, the prefill of THIS prompt captures a checkpoint at exactly L (in-batch when
+// LLAMA_CKPT_INBATCH applies, else by cutting the batch at L); the checkpoint is protected from eviction in its slot, so
+// the next conversation with the same system prompt + tool definitions restores it and prefills only its own tail.
+// Idea (not code) from Gufo (MIT) docs/KV-CACHE.md "learned shared-prefix boundaries" (commit 92aaed5).
+// ---------------------------------------------------------------------------------------------------------------------
+// ---------------------------------------------------------------------------------------------------------------------
+// CYCLESTATS (GAINS2/CYCLESTATS, 14/10/2026) : LLAMA_OPUS_CYCLE_STATS=1|2, absent/0 = OFF. Voir server-cycle.h.
+// Jalons HTTP : poses par le gestionnaire de la route sur son propre fil, relus par handle_completions_impl (meme fil).
+// ---------------------------------------------------------------------------------------------------------------------
+static thread_local int64_t cyc_tls_recv = 0, cyc_tls_json = 0, cyc_tls_tpl = 0;
+static thread_local int32_t cyc_tls_body = 0;
+#define CYC_T0()        (cyc_eng.on ? (cyc_eng.nclk++, cyc::engine::now()) : (int64_t) 0)
+#define CYC_ADD(P, T0)  do { if (T0) { cyc_eng.nclk++; cyc_eng.d[(P)] += cyc::engine::now() - (T0); } } while (0)
+
+static bool opus_pfx_on() {
+    static const bool on = GGML_OPUS_INT("LLAMA_OPUS_PFX", 0) != 0;
+    return on;
+}
+// ---------------------------------------------------------------------------------------------------------------------
+// LLAMA_OPUS_PPFLOOR (GAINS2/PPFLOOR, 14/10/2026) : bitmask, absent/0 = OFF = the code path is the production one.
+//   1 TAILSMALL (class N)  : a prompt tail of at most LLAMA_OPUS_PPFLOOR_TAILMAX tokens (default 64) is NOT cut 4 tokens before its end
+//                            (no second pass, no second checkpoint): one pass instead of two. The batch shape changes (the last 4 tokens
+//                            take the prefill kernels instead of the decode kernels): same family as LLAMA_CKPT_NO_TAIL / INBATCH.
+//   2 CKPOOL   (class B)   : recycled host buffers for checkpoints (common.cpp), same bytes
+//   4 CKDEFER  (class B)   : in-batch checkpoints are built AFTER the first token is sampled and handed to the client (same bytes:
+//                            the snapshot planes are not touched before the next decode; the draft / speculative parts are captured
+//                            at the original moment)
+//   8 TRACE                : one journal line per request (HTTP, queue, checkpoints, passes, speculative), no effect on the output
+//  16 (reserved)          : MMVF16 was withdrawn at review (14/10): it changed the precision of the activations (f32 instead of bf16 rounding),
+//                            which the contract forbids. The bit has no effect.
+//  32 TPLCACHE (class B)   : read in common/chat.cpp: the differential template analysis (autoparser.analyze_template, ~50 renders of fixed synthetic
+//                            messages, a pure function of the template) is computed once per template instead of at every request.
+// ---------------------------------------------------------------------------------------------------------------------
+static int32_t opus_ppfloor_mask() {
+    static const int32_t m = [] {
+        const int32_t a = GGML_OPUS_INT("LLAMA_OPUS_PPFLOOR", 0);
+        return a != 0 ? a : (int32_t) GGML_OPUS_INT("GGML_OPUS_PPFLOOR", 0);
+    }();
+    return m;
+}
+static inline bool opus_ppfloor(int32_t bit) {
+    return (opus_ppfloor_mask() & bit) != 0;
+}
+static int32_t opus_ppfloor_tailmax() {
+    static const int32_t v = std::max<int32_t>(0, GGML_OPUS_INT("LLAMA_OPUS_PPFLOOR_TAILMAX", 64));
+    return v;
+}
+// ---------------------------------------------------------------------------------------------------------------------
+// LLAMA_OPUS_TOURPRIO (GAINS3/BTOUR, 15/10/2026) : bitmask, absent/0 = OFF = the production code path (no branch below is taken).
+// Read at each use from the hot-flag registry (category 'd', switchable by POST /opus/flags when LLAMA_OPUS_HOTFLAGS=1).
+// Nothing happens unless another slot is GENERATING (U >= 2): with one active agent the code path is the production one.
+//
+// Why: the hybrid memory splits a batch into ubatches of equal per-sequence length (split_equal + n_keep_tail,
+// llama-memory-hybrid-idx.cpp:132). A warm turn of 18 new tokens arriving while 3 agents decode is processed today in two
+// whole cycles: [draft x3][ubatch 3 seqs x 3 tokens + 3 of the new prompt][ubatch 11 tokens of the prompt] then
+// [draft x3][ubatch 9 verification tokens][ubatch the 4-token tail alone] : the prompt's passes are NOT shared with the
+// verification, they are separate graph passes, but the first token waits for two draft steps and two verification passes
+// (~2 x 200 ms at U=4, CYCLESTATS 14/10, res_m4d_cycle/CYCLE_u4.md). Gufo runs a short prefill as a work unit of its own
+// between two decode units (text_generation_scheduler.cpp:1894-1907, commit 89d6185, MIT).
+//   1 TAIL  : a prompt already being processed (SLOT_STATE_PROCESSING_PROMPT: its batch was cut at the last user message or
+//             4 tokens before the end) with at most LLAMA_OPUS_TOURPRIO_MAX tokens left gets an iteration of its own: the
+//             generating slots neither draft nor verify in it, they do so in the next iteration. Same ubatches as today
+//             (the tail was already alone in its ubatch), only their order changes: the first token is sampled one draft step
+//             and one verification pass earlier.
+//   2 FIRST : same for the FIRST chunk of a warm turn: a slot just launched (SLOT_STATE_STARTED) whose cached tokens are all a
+//             prefix of the new prompt (live continuation: no checkpoint restore) with at most _MAX new tokens. Its prompt is
+//             then batched exactly as with a single agent (same cuts, one ubatch, in-batch checkpoints allowed since it starts
+//             the batch) instead of lending its first 3 tokens to the verification ubatch of the others.
+//   4 HOLD  : when a slot has just finished its turn while others generate, the next cycle waits up to
+//             LLAMA_OPUS_TOURPRIO_GRACE_MS (15) for a completion request to reach the chat route, then up to _HOLD_MS (60)
+//             for it to be posted, so that it is launched before the next verification pass instead of after it.
+// LLAMA_OPUS_TOURPRIO_RUN (3): at most that many priority iterations in a row, then one ordinary iteration (the generating
+// slots never wait for more than RUN prompt passes in a row).
+// Proof that the path is taken: the line "[TOURPRIO] ... priority iterations=N" (first use, then every 8; cumulative counters).
+// ---------------------------------------------------------------------------------------------------------------------
+static int32_t opus_tourprio_mask() {
+    return std::max<int32_t>(0, GGML_OPUS_INT("LLAMA_OPUS_TOURPRIO", 0));
+}
+static inline bool opus_tourprio(int32_t bit) {
