+// ---------------------------------------------------------------------------------------------------------------------
+// [OPUS-SAMPGPU] top-K par ligne en deux noyaux : (1) la ligne est coupee en OPUS_TOPK_CHUNKS tranches, un bloc par
+// (tranche, ligne) en extrait les K meilleurs ; (2) un bloc par ligne fusionne les CHUNKS*K candidats, trie par rang et
+// ecrit le resultat. Chaque selection est un radix de 4 passes de 8 bits (seuil du K-ieme meilleur) puis une collecte.
+// Les valeurs sont recopiees telles quelles (aucun calcul flottant) : memes bits que les logits de la copie complete.
+// Ensemble retenu = K plus grandes clefs ; a la frontiere K les egalites sont departagees arbitrairement (l'appelant
+// ne s'appuie que sur les clefs strictement distinctes).
+#define OPUS_TOPK_BLOCK  512
+#define OPUS_TOPK_MAXK   128
+#define OPUS_TOPK_CHUNKS 16
+
+static __device__ __forceinline__ uint32_t opus_topk_key(float v) {
+    const uint32_t b = __float_as_uint(v);
+    return b ^ (((uint32_t) (-(int32_t) (b >> 31))) | 0x80000000U);
+}
+
+struct opus_topk_shared {
+    unsigned int hist[256];
+    unsigned int s_gt, s_eq;
+    int          s_bin, s_rank;
+    uint32_t     sg_key[OPUS_TOPK_MAXK], se_key[OPUS_TOPK_MAXK];
+    int          sg_pos[OPUS_TOPK_MAXK], se_pos[OPUS_TOPK_MAXK];
+};
+
+// selectionne les positions des K plus grandes clefs parmi n ; sel_pos[0..K) (ordre quelconque). n >= K requis.
+template <typename KeyFn>
+static __device__ void opus_topk_select(opus_topk_shared & sh, const int n, const int K, const KeyFn keyfn, int * sel_pos) {
+    const int tid = threadIdx.x;
+    uint32_t prefix = 0, mask = 0;
+    int rank = K;
+    for (int pass = 0; pass < 4; ++pass) {
+        const int shift = 24 - 8 * pass;
+        for (int b = tid; b < 256; b += OPUS_TOPK_BLOCK) {
+            sh.hist[b] = 0;
+        }
+        __syncthreads();
+        for (int i = tid; i < n; i += OPUS_TOPK_BLOCK) {
+            const uint32_t key = keyfn(i);
+            if ((key & mask) == prefix) {
+                atomicAdd(&sh.hist[(key >> shift) & 255], 1u);
+            }
+        }
+        __syncthreads();
+        if (tid == 0) {
+            int cum = 0, bin = 0;
+            for (int b = 255; b >= 0; --b) {
+                const int c = (int) sh.hist[b];
+                if (cum + c >= rank) { bin = b; break; }
+                cum += c;
+            }
+            sh.s_bin  = bin;
+            sh.s_rank = rank - cum;
+        }
+        __syncthreads();
+        prefix |= ((uint32_t) sh.s_bin) << shift;
+        mask   |= 0xFFU << shift;
+        rank    = sh.s_rank;
+        __syncthreads();
+    }
+    const uint32_t thr = prefix; // clef du K-ieme meilleur
+
+    if (tid == 0) { sh.s_gt = 0; sh.s_eq = 0; }
+    __syncthreads();
+    for (int i = tid; i < n; i += OPUS_TOPK_BLOCK) {
+        const uint32_t key = keyfn(i);
+        if (key > thr) {
+            const unsigned int p = atomicAdd(&sh.s_gt, 1u);
+            if (p < OPUS_TOPK_MAXK) { sh.sg_pos[p] = i; }
+        } else if (key == thr) {
+            const unsigned int p = atomicAdd(&sh.s_eq, 1u);
+            if (p < OPUS_TOPK_MAXK) { sh.se_pos[p] = i; }
+        }
+    }
+    __syncthreads();
+    const int n_gt = (int) sh.s_gt; // < K par construction ; n_gt + n_eq >= K
+    for (int t = tid; t < K; t += OPUS_TOPK_BLOCK) {
+        sel_pos[t] = t < n_gt ? sh.sg_pos[t] : sh.se_pos[t - n_gt];
+    }
+    __syncthreads();
+}
+
+struct opus_topk_row_key {
+    const float * p;
+    __device__ __forceinline__ uint32_t operator()(int i) const { return opus_topk_key(p[i]); }
+};
+
+static __global__ void __launch_bounds__(OPUS_TOPK_BLOCK) opus_topk_chunk_kernel(
+        const float * __restrict__ src, const int64_t row_stride, const int n, const int K,
+        float * __restrict__ cand_vals, int * __restrict__ cand_ids) {
+    __shared__ opus_topk_shared sh;
+    __shared__ int sel[OPUS_TOPK_MAXK];
+
+    const int chunk = blockIdx.x, row = blockIdx.y;
+    const int c0 = (int) (((int64_t) n * chunk) / OPUS_TOPK_CHUNKS);
+    const int c1 = (int) (((int64_t) n * (chunk + 1)) / OPUS_TOPK_CHUNKS);
+    const float * base = src + (int64_t) row * row_stride + c0;
+
+    opus_topk_select(sh, c1 - c0, K, opus_topk_row_key{ base }, sel);
+
+    float * ov = cand_vals + ((int64_t) row * OPUS_TOPK_CHUNKS + chunk) * K;
+    int   * oi = cand_ids  + ((int64_t) row * OPUS_TOPK_CHUNKS + chunk) * K;
+    for (int t = threadIdx.x; t < K; t += OPUS_TOPK_BLOCK) {
+        ov[t] = base[sel[t]];
+        oi[t] = c0 + sel[t];
+    }
+}
+
+struct opus_topk_cand_key {
+    const float * v;
+    __device__ __forceinline__ uint32_t operator()(int i) const { return opus_topk_key(v[i]); }
+};
+
+static __global__ void __launch_bounds__(OPUS_TOPK_BLOCK) opus_topk_merge_kernel(
+        const float * __restrict__ cand_vals, const int * __restrict__ cand_ids, const int K,
+        float * __restrict__ ovals, int * __restrict__ oids) {
+    __shared__ opus_topk_shared sh;
+    __shared__ int      sel[OPUS_TOPK_MAXK];
+    __shared__ uint32_t f_key[OPUS_TOPK_MAXK];
+    __shared__ int      f_id [OPUS_TOPK_MAXK];
+
+    const int row = blockIdx.x;
+    const int N = OPUS_TOPK_CHUNKS * K;
+    const float * cv = cand_vals + (int64_t) row * N;
+    const int   * ci = cand_ids  + (int64_t) row * N;
+
+    opus_topk_select(sh, N, K, opus_topk_cand_key{ cv }, sel);
+
+    for (int t = threadIdx.x; t < K; t += OPUS_TOPK_BLOCK) {
+        f_key[t] = opus_topk_key(cv[sel[t]]);
+        f_id [t] = ci[sel[t]];
+    }
+    __syncthreads();
+    // rang = nombre d'elements strictement meilleurs (clef decroissante, puis id croissant)
+    for (int t = threadIdx.x; t < K; t += OPUS_TOPK_BLOCK) {
+        const uint32_t kt = f_key[t];
+        const int      it = f_id[t];
+        int r = 0;
+        for (int u = 0; u < K; ++u) {
+            const uint32_t ku = f_key[u];
+            r += (ku > kt) || (ku == kt && f_id[u] < it);
+        }
+        ovals[(int64_t) row * K + r] = cv[sel[t]];
+        oids [(int64_t) row * K + r] = it;
+    }
+}
+
+// cand_vals / cand_ids : n_rows * OPUS_TOPK_CHUNKS * k elements de travail (fournis par l'appelant)
+void ggml_cuda_opus_topk_rows(const float * src, int64_t row_stride, int n, int n_rows, int k,
+        float * vals, int * ids, float * cand_vals, int * cand_ids, cudaStream_t stream) {
+    opus_topk_chunk_kernel<<<dim3(OPUS_TOPK_CHUNKS, n_rows), OPUS_TOPK_BLOCK, 0, stream>>>(src, row_stride, n, k, cand_vals, cand_ids);
+    CUDA_CHECK(cudaGetLastError());
+    opus_topk_merge_kernel<<<n_rows, OPUS_TOPK_BLOCK, 0, stream>>>(cand_vals, cand_ids, k, vals, ids);
+    CUDA_CHECK(cudaGetLastError());
+}
