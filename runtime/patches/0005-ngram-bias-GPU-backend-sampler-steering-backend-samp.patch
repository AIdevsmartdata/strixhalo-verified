index b9fc46df636..94a81a85876 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -1534,9 +1534,17 @@ extern "C" {
         void * ctx, float alpha, const llama_token * tokens, int n_tokens,
         int ngram_min, int ngram_max, llama_token_data * data, size_t n_data);
 
+    // Backend (GPU) variant: fills out_tokens/out_biases with up to max_n (token, bias)
+    // pairs from the stupid-backoff lookup. Returns the number of pairs written.
+    // The sampler pads the remainder with (token=0, bias=0) which is a no-op scatter.
+    typedef int (*llama_sampler_ngram_bias_lookup_callback)(
+        void * ctx, float alpha, const llama_token * tokens, int n_tokens,
+        int ngram_min, int ngram_max, int32_t * out_tokens, float * out_biases, int max_n);
+
     LLAMA_API struct llama_sampler * llama_sampler_init_ngram_bias(
         void * ctx,
         llama_sampler_ngram_bias_callback callback,
+        llama_sampler_ngram_bias_lookup_callback lookup_callback,
         float   alpha,
         int32_t ngram_min,
         int32_t ngram_max,
diff --git a/src/llama-sampler.cpp b/src/llama-sampler.cpp
index ca4f941a79c..f8520c9dd79 100644
--- a/src/llama-sampler.cpp
+++ b/src/llama-sampler.cpp
@@ -4068,13 +4068,24 @@ struct llama_sampler * llama_sampler_init_logit_bias(
 struct llama_sampler_ngram_bias : public llama_sampler_backend {
     void * cache;
     llama_sampler_ngram_bias_callback callback;
+    llama_sampler_ngram_bias_lookup_callback lookup_callback;
     float alpha;
     int ngram_min;
     int ngram_max;
     int n_last;
     std::vector<llama_token> recent;
+
+    // backend state (GPU scatter)
+    std::vector<int32_t> pairs_tokens;
+    std::vector<float>   pairs_biases;
+    struct ggml_tensor * inp_logit_bias;
+    struct ggml_tensor * inp_logit_idxs;
 };
 
+// Max number of (token, bias) pairs pushed to the GPU backend per token.
+// A shell-command n-gram has << 512 successors; the lookup truncates beyond this.
+static const int LLAMA_NGRAM_BIAS_MAX_PAIRS = 512;
+
 static const char * llama_sampler_ngram_bias_name(const struct llama_sampler * smpl) {
     return ((llama_sampler_ngram_bias *) smpl->ctx)->get_name();
 }
@@ -4099,6 +4110,78 @@ static void llama_sampler_ngram_bias_apply(struct llama_sampler * smpl, llama_to
                   ctx->ngram_min, ctx->ngram_max, cur_p->data, cur_p->size);
 }
 
+static bool llama_sampler_ngram_bias_backend_init(
+        struct llama_sampler       * smpl,
+        ggml_backend_buffer_type_t   buft,
+        uint32_t                     n_outputs_max_per_seq) {
+    GGML_UNUSED(buft);
+    GGML_UNUSED(n_outputs_max_per_seq);
+
+    auto * sctx = (llama_sampler_ngram_bias *) smpl->ctx;
+    sctx->init(true);
+
+    // backend only when a lookup callback is available
+    return sctx->lookup_callback != nullptr;
+}
+
+static void llama_sampler_ngram_bias_backend_apply(
+        struct llama_sampler      * smpl,
+        struct ggml_context       * ctx,
+        struct ggml_cgraph        * gf,
+        struct llama_sampler_data * data) {
+    GGML_UNUSED(gf);
+
+    auto * sctx = (llama_sampler_ngram_bias *) smpl->ctx;
+
+    if (sctx->inp_logit_bias == nullptr) {
+        GGML_ASSERT(sctx->inp_logit_idxs == nullptr);
+
+        sctx->inp_logit_bias = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1, LLAMA_NGRAM_BIAS_MAX_PAIRS);
+        ggml_set_name(sctx->inp_logit_bias, "ngram_bias");
+        ggml_set_input(sctx->inp_logit_bias);
+
+        sctx->inp_logit_idxs = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, LLAMA_NGRAM_BIAS_MAX_PAIRS);
+        ggml_set_name(sctx->inp_logit_idxs, "ngram_idxs");
+        ggml_set_input(sctx->inp_logit_idxs);
+    }
+
+    ggml_tensor * cur = ggml_fill(ctx, data->logits, 0.0f);
+
+    cur = ggml_reshape_2d(ctx, cur, 1, ggml_nelements(cur));
+    cur = ggml_set_rows(ctx, cur, sctx->inp_logit_bias, sctx->inp_logit_idxs);
+    cur = ggml_reshape_1d(ctx, cur, ggml_nelements(cur));
+
+    data->logits = ggml_add(ctx, data->logits, cur);
+}
+
+static void llama_sampler_ngram_bias_backend_set_input(struct llama_sampler * smpl) {
+    auto * sctx = (llama_sampler_ngram_bias *) smpl->ctx;
+
+    GGML_ASSERT(sctx->inp_logit_bias != nullptr);
+    GGML_ASSERT(sctx->inp_logit_idxs != nullptr);
+
+    // padding (idx 0, bias 0) = no-op scatter entries
+    sctx->pairs_tokens.assign(LLAMA_NGRAM_BIAS_MAX_PAIRS, 0);
+    sctx->pairs_biases.assign(LLAMA_NGRAM_BIAS_MAX_PAIRS, 0.0f);
+
+    if (sctx->lookup_callback != nullptr && sctx->alpha > 0.0f &&
+            (int) sctx->recent.size() >= sctx->ngram_min) {
+        sctx->lookup_callback(sctx->cache, sctx->alpha, sctx->recent.data(),
+                              (int) sctx->recent.size(), sctx->ngram_min, sctx->ngram_max,
+                              sctx->pairs_tokens.data(), sctx->pairs_biases.data(),
+                              LLAMA_NGRAM_BIAS_MAX_PAIRS);
+    }
+
+    ggml_backend_tensor_set(sctx->inp_logit_bias, sctx->pairs_biases.data(), 0, ggml_nbytes(sctx->inp_logit_bias));
+    ggml_backend_tensor_set(sctx->inp_logit_idxs, sctx->pairs_tokens.data(), 0, ggml_nbytes(sctx->inp_logit_idxs));
+}
+
+static void llama_sampler_ngram_bias_backend_reset(struct llama_sampler * smpl) {
+    auto * sctx = (llama_sampler_ngram_bias *) smpl->ctx;
+    sctx->inp_logit_bias = nullptr;
+    sctx->inp_logit_idxs = nullptr;
+}
+
 static void llama_sampler_ngram_bias_reset(struct llama_sampler * smpl) {
     auto * ctx = (llama_sampler_ngram_bias *) smpl->ctx;
     ctx->recent.clear();
@@ -4106,7 +4189,7 @@ static void llama_sampler_ngram_bias_reset(struct llama_sampler * smpl) {
 
