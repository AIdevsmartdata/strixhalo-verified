+                    const float r0 = res16 ? hc_bf2f32(res16[col]) : res[col];
+                    const float m0 = blk16 ? hc_bf2f32(blk16[col]) : blk[col];
+                    const float a0 = hc_add_rn(r0, hc_mul_rn(m0, w));
