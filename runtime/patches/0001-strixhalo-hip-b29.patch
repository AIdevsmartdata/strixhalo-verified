+static void opus_q8wave_dense_launch(
+        const void * vx, const void * vy, float * dst, const int ncols_x, const int nrows_x, const int ncols_dst,
+        const int stride_row_x, const int stride_col_y, const int stride_col_dst, cudaStream_t stream) {
+    const dim3 grid(nrows_x, 1, 1);
+    const bool ragged = ncols_dst % 8 != 0;
+#define OPUS_Q8WAVE_LAUNCH(W) \
+    if (ragged) { \
+        const ggml_cuda_kernel_launch_params lp(grid, dim3(32*W, 1, 1), 0, stream); \
+        ggml_cuda_kernel_launch(opus_q8wave_dense_kernel<W, true>, lp, vx, vy, dst, ncols_x, ncols_dst, stride_row_x, stride_col_y, stride_col_dst); \
+    } else { \
+        const ggml_cuda_kernel_launch_params lp(grid, dim3(32*W, 1, 1), 0, stream); \
+        ggml_cuda_kernel_launch(opus_q8wave_dense_kernel<W, false>, lp, vx, vy, dst, ncols_x, ncols_dst, stride_row_x, stride_col_y, stride_col_dst); \
+    }
+    if (ncols_dst <= 16) {
+        OPUS_Q8WAVE_LAUNCH(2);
+    } else {
+        OPUS_Q8WAVE_LAUNCH(3);
+    }
+#undef OPUS_Q8WAVE_LAUNCH
+}
