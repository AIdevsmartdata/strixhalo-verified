+        if (!sv || !dc || sv->view_src != cc || sv->type != GGML_TYPE_F32 || dc->type != GGML_TYPE_F32 ||
+                sv->view_offs % 4 || sv->view_offs / 4 + 3 > (size_t) cc->ne[0] ||
+                sv->ne[0] != 3 || sv->ne[1] != cc->ne[1] || sv->ne[2] != 1 || sv->ne[3] != 1 ||
+                sv->nb[0] != 4 || sv->nb[1] != cc->nb[1] || !ggml_is_contiguous(dc) ||
