+        {
+            const int64_t a = now();
+            int64_t sink = 0;
+            for (int i = 0; i < 2000; ++i) { sink += now(); }
+            const int64_t b = now();
+            clock_ns = (double) (b - a) / 2001.0 + (sink == 42 ? 1e-9 : 0.0);
+        }
+        t_origin = now();
+        t_report = t_origin;
+        ready = true;
+        std::string names;
+        for (int i = 0; i < P_N; ++i) { names += k_names[i]; if (i + 1 < P_N) { names += ","; } }
+        LOG_INF("[CYCLE] actif niveau=%d periode=%ds echantillons/classe=%d horloge=%.1f ns/appel postes=%s\n",
