+
+    static_assert(MAX_PARAMETER_COUNT == 12);
 
     uint32_t ne = ggml_nelements(dst);
+    std::array<uint32_t, 3> elements;
     if (ne > 262144) {
         elements = { 512, 512, CEIL_DIV(ne, 262144) };
     } else if (ne > 512) {
@@ -13233,7 +13367,6 @@ static void ggml_vk_multi_add(ggml_backend_vk_context * ctx, vk_context& subctx,
         elements = { ne, 1, 1 };
