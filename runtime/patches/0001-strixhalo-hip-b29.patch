+    key.ne10        = src1->ne[0];
+    key.nrows       = src1->ne[1]*src1->ne[2]*src1->ne[3];
+    key.ne10_padded = GGML_PAD(src1->ne[0], MATRIX_ROW_PADDING);
+    return true;
