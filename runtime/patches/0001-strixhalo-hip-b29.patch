+void server_prompt_cache::evic_init_env() {
+    auto geti = [](const char * name, int32_t def) -> int32_t {
+        const char * v = getenv(name);
+        return (v && *v) ? (int32_t) atoi(v) : def;
+    };
+    evic = server_prompt_cache_evic_config();
+    evic.dedup = geti("LLAMA_OPUS_EVIC_DEDUP", 0) != 0;
+    evic.cost  = geti("LLAMA_OPUS_EVIC_COST",  0) != 0;
+    if (!evic.on()) {
+        return;
+    }
+    evic.dedup_pct     = std::clamp<int32_t>(geti("LLAMA_OPUS_EVIC_DEDUP_PCT", 90), 50, 100);
+    evic.dedup_min_tok = std::max<int32_t>(1, geti("LLAMA_OPUS_EVIC_DEDUP_MIN_TOK", 256));
+    evic.dedup_max     = std::max<int32_t>(1, geti("LLAMA_OPUS_EVIC_DEDUP_MAX", 1));
+    evic.prot_s        = std::max<int32_t>(0, geti("LLAMA_OPUS_EVIC_PROT_S", 900));
+    evic.prot_pct      = std::clamp<int32_t>(geti("LLAMA_OPUS_EVIC_PROT_PCT", 75), 1, 100);
+    evic.half_s        = std::max<int32_t>(0, geti("LLAMA_OPUS_EVIC_HALF_S", 1800));
+    evic.admit         = geti("LLAMA_OPUS_EVIC_ADMIT", 200);
+    SRV_INF("[EVIC] policy on: dedup=%d cost=%d (dedup_pct=%d dedup_min_tok=%d dedup_max=%d prot_s=%d prot_pct=%d half_s=%d admit=%d)\n",
+            (int) evic.dedup, (int) evic.cost, evic.dedup_pct, evic.dedup_min_tok, evic.dedup_max, evic.prot_s, evic.prot_pct,
+            evic.half_s, evic.admit);
+}
+
+int64_t server_prompt_cache::evic_now_ms() const {
+    if (evic_clock_ms >= 0) {
+        return evic_clock_ms;
+    }
+    return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+bool server_prompt_cache::evic_make_room(const server_prompt & np, size_t size_new) {
+    const size_t cur = size();
+    if (cur + size_new <= limit_size) {
+        return true; // room left, nothing to remove
+    }
+
+    std::vector<std::list<server_prompt_cache_state>::iterator> its;
+    std::vector<const server_prompt *> prompts;
+    for (auto it = states.begin(); it != states.end(); ++it) {
+        its.push_back(it);
+        prompts.push_back(&it->prompt);
+    }
+    const size_t n = its.size();
+    prompts.push_back(&np);
+
+    const int64_t now = evic_now_ms();
+    std::vector<size_t> bytes(n);
+    std::vector<double> age(n);
+    for (size_t i = 0; i < n; ++i) {
+        bytes[i] = its[i]->size();
+        age[i]   = std::max<int64_t>(0, now - its[i]->evic_t_ms) / 1000.0;
+    }
+    const int64_t n_new = np.n_tokens();
+
+    evic_set S;
+    S.init(prompts, n, true);
+
+    // protect the biggest session while it is recent (PROT_S) and not above PROT_PCT % of the limit, unless the new state is as big
+    int prot = -1;
+    if (evic.cost && evic.prot_s > 0 && n > 0) {
+        size_t big = 0;
+        for (size_t i = 1; i < n; ++i) {
+            if (its[i]->prompt.n_tokens() >= its[big]->prompt.n_tokens()) {
+                big = i;
+            }
+        }
+        // a transport entry (loaded back at once) never becomes the biggest session, so it never releases the protection
+        if ((its[big]->prompt.n_tokens() > n_new || evic_transport) && age[big] <= (double) evic.prot_s &&
+            (double) bytes[big] * 100.0 <= (double) limit_size * (double) evic.prot_pct) {
+            prot = (int) big;
+        }
+    }
+
+    std::vector<size_t>      victims;
+    std::vector<const char*> kinds;
+    std::vector<int64_t>     uniq;
+    double lost  = 0.0;
+    size_t freed = 0;
+    auto missing = [&]() { return cur - freed + size_new > limit_size; };
+    auto take = [&](size_t i, const char * kind, int64_t u, double score) {
+        S.alive[i] = 0;
+        freed += bytes[i];
+        victims.push_back(i);
+        kinds.push_back(kind);
+        uniq.push_back(u);
+        lost += score;
+    };
+
+    // (a) near-duplicates go first, oldest first: shares >= PCT % of the shorter prompt and is not longer than the new one by more than the slack.
+    // Not for a transport entry: it is erased by load() at once, so it covers nothing (the state its caller saved just before would be taken for covered).
+    if (evic.dedup && !evic_transport) {
+        int done = 0;
+        for (size_t i = 0; i < n && done < evic.dedup_max && missing(); ++i) {
+            const int64_t len_i = its[i]->prompt.n_tokens();
+            const int64_t mn    = std::min<int64_t>(len_i, n_new);
+            const int64_t lc    = S.L(i, n);
+            if (mn > 0 && lc >= evic.dedup_min_tok && lc * 100 >= (int64_t) evic.dedup_pct * mn &&
+                len_i <= n_new + (int64_t) (100 - evic.dedup_pct) * mn / 100) {
+                const int64_t u = S.unique(i, true);
+                take(i, "dedup", u, (double) u * evic_decay(age[i], evic.half_s));
+                ++done;
+            }
+        }
+    }
+
+    // (b) cheapest entry to recompute, else the oldest
+    bool reject = false;
+    while (missing()) {
+        int     pick   = -1;
+        double  best   = 0.0;
+        int64_t best_u = 0;
+        if (evic.cost) {
+            for (size_t i = 0; i < n; ++i) {
+                if (!S.alive[i] || (int) i == prot) {
+                    continue;
+                }
+                const int64_t u  = S.unique(i, !evic_transport);
+                const double  sc = (double) u * evic_decay(age[i], evic.half_s);
+                if (pick < 0 || sc < best) { // strict: on a tie the oldest (scanned first) goes
+                    pick = (int) i; best = sc; best_u = u;
+                }
+            }
+        } else {
+            for (size_t i = 0; i < n; ++i) {
+                if (S.alive[i]) {
+                    pick = (int) i;
+                    break;
+                }
+            }
+        }
+        if (pick < 0) {
+            if (evic.cost && prot >= 0 && S.alive[prot]) {
+                if (evic.admit > 0 || evic_transport) {
+                    reject = true; // only the protected session is left: the new state is refused, also a transport one (its caller prefills instead)
+                    break;
+                }
+                pick   = prot; // ADMIT=0 (never refuse): the protection is dropped
+                best_u = S.unique(prot, true);
+                best   = (double) best_u * evic_decay(age[prot], evic.half_s);
+            } else {
+                break; // nothing left, the new state fits the limit alone
+            }
+        }
+        take((size_t) pick, evic.cost ? "cost" : "lru", best_u, best);
+    }
+
+    // admission: refuse the new state only when it pushes out much more recompute (ADMIT %) than it brings back
+    if (!reject && evic.cost && evic.admit > 0 && !evic_transport && !victims.empty()) {
+        const int64_t gain = S.unique_new();
+        if (lost * 100.0 > (double) evic.admit * (double) gain) {
+            reject = true;
+            SRV_WRN(" - [EVIC] reject: new entry (%lld tokens, %.3f MiB) would push out %.0f tokens of recompute for %lld of its own\n",
+                    (long long) n_new, size_new / (1024.0 * 1024.0), lost, (long long) gain);
+        }
+    }
+    if (reject) {
+        ++evic_n_reject;
+        if (!victims.empty() || prot >= 0) {
+            SRV_WRN(" - [EVIC] reject: new entry not saved (%lld tokens, %.3f MiB); %d cached prompt(s) kept (protected: %s), cache %.3f of %.3f MiB\n",
+                    (long long) n_new, size_new / (1024.0 * 1024.0), (int) n, prot >= 0 ? "yes" : "no", cur / (1024.0 * 1024.0), limit_size / (1024.0 * 1024.0));
+        }
+        return false;
+    }
+
+    // count the protection only if the oldest-first order would have removed the protected entry
+    if (prot >= 0) {
+        size_t f2 = 0;
+        for (size_t i = 0; i < n && cur - f2 + size_new > limit_size; ++i) {
+            f2 += bytes[i];
+            if ((int) i == prot) {
+                ++evic_n_protect;
+                SRV_WRN(" - [EVIC] protect: the largest recent session stays (%d tokens, %.3f MiB, age %.0f s)\n",
+                        its[i]->prompt.n_tokens(), bytes[i] / (1024.0 * 1024.0), age[i]);
+                break;
+            }
+        }
+    }
+
+    for (size_t k = 0; k < victims.size(); ++k) {
+        const size_t i = victims[k];
+        SRV_WRN(" - [EVIC] %s: removing cached prompt (%d tokens, %lld to recompute, %.3f MiB, age %.0f s) to make room for the new entry (%lld tokens, %.3f MiB, lcp %lld), cache %.3f of %.3f MiB\n",
+                kinds[k], its[i]->prompt.n_tokens(), (long long) uniq[k], bytes[i] / (1024.0 * 1024.0), age[i], (long long) n_new,
+                size_new / (1024.0 * 1024.0), (long long) S.L(i, n), cur / (1024.0 * 1024.0), limit_size / (1024.0 * 1024.0));
+        if (std::strcmp(kinds[k], "dedup") == 0) {
+            ++evic_n_dedup;
+        } else if (std::strcmp(kinds[k], "cost") == 0) {
+            ++evic_n_cost;
+        }
+        states.erase(its[i]);
+    }
+    return true;
+}
+
+std::list<server_prompt_cache_state>::iterator server_prompt_cache::evic_victim_update() {
+    if (!evic.cost || states.size() < 2) {
+        return states.begin();
+    }
+    std::vector<std::list<server_prompt_cache_state>::iterator> its;
+    std::vector<const server_prompt *> prompts;
+    for (auto it = states.begin(); it != states.end(); ++it) {
+        its.push_back(it);
+        prompts.push_back(&it->prompt);
+    }
+    const size_t n = its.size();
+    const int64_t now = evic_now_ms();
+
+    int prot = -1;
+    if (evic.prot_s > 0) {
+        size_t big = 0;
+        for (size_t i = 1; i < n; ++i) {
+            if (its[i]->prompt.n_tokens() >= its[big]->prompt.n_tokens()) {
+                big = i;
+            }
+        }
+        const double age = std::max<int64_t>(0, now - its[big]->evic_t_ms) / 1000.0;
+        if (big != n - 1 && age <= (double) evic.prot_s &&
+            (limit_size == 0 || (double) its[big]->size() * 100.0 <= (double) limit_size * (double) evic.prot_pct)) {
+            prot = (int) big;
+        }
+    }
+
+    evic_set S;
+    S.init(prompts, n, false);
+    int    pick = -1;
+    double best = 0.0;
+    for (size_t i = 0; i + 1 < n; ++i) { // the newest entry is not a candidate
+        if ((int) i == prot) {
+            continue;
+        }
+        const double age = std::max<int64_t>(0, now - its[i]->evic_t_ms) / 1000.0;
+        const double sc  = (double) S.unique(i, false) * evic_decay(age, evic.half_s);
+        if (pick < 0 || sc < best) {
+            pick = (int) i; best = sc;
+        }
+    }
+    if (pick >= 0) {
+        ++evic_n_cost;
+        return its[pick];
+    }
+    if (prot >= 0) {
+        ++evic_n_reject;
+        return its[n - 1]; // only the protected entry and the newest are left
+    }
+    return states.begin();
+}
