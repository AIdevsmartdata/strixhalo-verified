+                    const float a0 = hc_add_rn(r0, hc_mul_rn(m0, w));
+                    const float a1 = hc_add_rn(r1, hc_mul_rn(m1, w));
+                    if (dst16) *(uint32_t *)(dst16 + col) = hc_pack2(a0, a1);
+                    else       *(float2 *)(dst + col)     = make_float2(a0, a1);
