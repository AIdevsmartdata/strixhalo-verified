 std::mutex vk_memory_logger::log_mutex;
 
+// [TAG_PERF_ACCOUNT] horloge monotone pour la comptabilite CPU du perf-logger.
+// Objectif : expliquer 100 % du temps mural, pas seulement le temps des noyaux GPU.
+//   wall = cpu_loop (iteration des noeuds + construction des command buffers) + submit
+//        + cpu_wait (attente de la fence, pendant laquelle le GPU execute les noyaux)
+//        + gap (temps hors graph_compute : echantillonnage, boucle de speculation, HTTP)
+//   kernel_s est un SOUS-ENSEMBLE de cpu_wait (le travail GPU reellement execute).
+static inline uint64_t vk_perf_now_ns() {
+    return (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
 static bool vk_perf_logger_enabled = false;
 static bool vk_perf_logger_concurrent = false;
+// [TAG_PERF_COVERAGE] trace par graph_compute + suivi de couverture (noeuds vs timestamps)
+static bool vk_perf_logger_trace = false;
 static bool vk_enable_sync_logger = false;
 // number of calls between perf logger prints
 static uint32_t vk_perf_logger_frequency = 1;
