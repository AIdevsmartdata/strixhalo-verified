 ggml/src/ggml-vulkan/ggml-vulkan.cpp          | 76 ++++++++++++++++++-
 .../vulkan-shaders/flash_attn_cm1.comp        | 72 +++++++++++++++---
 .../vulkan-shaders/vulkan-shaders-gen.cpp     | 16 ++++
 3 files changed, 150 insertions(+), 14 deletions(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index cd97be04232..18e61ae21a2 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -4009,6 +4009,33 @@ static void ggml_vk_wait_events(vk_context& ctx, std::vector<vk::Event>&& events
     );
 }
 
+// [TAG_FA_STAGE_KV] Le banc de diagnostic (variantes FA_DIAG) montre que le FA prefill
+// passe 55 % (32k) a 73 % (131k) de son temps dans les chargements cooperatifs K/V
+// directs depuis la memoire globale : chaque coopMatLoad rapatrie une tuile 16x16 f16
+// par sous-groupe et il n'y a pas assez de registres pour pipeliner les 16 iterations
+// du noyau HSK, donc la latence L2/DRAM n'est pas cachee. Le chemin SHMEM_STAGING
+// (chargement coalesce vers la memoire partagee, puis mma depuis le shmem) existe mais
+// est reserve a NVIDIA avec hsk/hsv < 256 -- ni notre vendor ni notre geometrie.
+// GGML_VK_FA_STAGE_KV=1 force ce chemin pour l'A/B.
+// [TAG_FA_MR] Nombre de groupes de 16 lignes de requetes par workgroup (1 = historique).
+// Le shader est compile avec MR correspondant (variantes mr2/mr4) : les chargements K/V
+// sont partages entre les groupes, ce qui divise leur cout par MR.
+static int ggml_vk_fa_mr() {
+    static const int v = [] {
+        const char * e = getenv("GGML_VK_FA_MR");
+        return e ? atoi(e) : 0;
+    }();
+    return (v == 2 || v == 4) ? v : 1;
+}
+
+static bool ggml_vk_fa_stage_kv_forced() {
+    static const bool v = [] {
+        const char * e = getenv("GGML_VK_FA_STAGE_KV");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    return v;
+}
+
 struct vk_fa_tuning_params {
     FaCodePath path;
     uint32_t workgroup_size;
@@ -4082,7 +4109,7 @@ static vk_fa_tuning_params get_fa_tuning_params_scalar(const vk_device& device,
 
     result.d_split = std::min(std::min(result.subgroup_size, 8u), D_lsb / 4);
 
-    result.shmem_staging = (device->vendor_id == VK_VENDOR_ID_NVIDIA && hsk < 256 && hsv < 256) ? 1 : 0;
+    result.shmem_staging = ggml_vk_fa_stage_kv_forced() ? 1 : ((device->vendor_id == VK_VENDOR_ID_NVIDIA && hsk < 256 && hsv < 256) ? 1 : 0);
 
     if (!reduce_block_rows && !ggml_vk_flash_attn_scalar_shmem_support(device, result, hsk, hsv, f32acc, k_type, v_type)) {
         result.block_rows /= 2;
@@ -4130,10 +4157,17 @@ static vk_fa_tuning_params get_fa_tuning_params_coopmat1(const vk_device& device
     result.subgroup_size = device->subgroup_size;
     result.workgroup_size = num_subgroups * result.subgroup_size;
 
+    // [TAG_FA_MR] MR groupes de lignes par workgroup. Uniquement pour l'accumulateur f32 :
+    // les variantes SPIR-V mr2/mr4 ne sont compilees que pour ce cas (sinon Br=32 serait
+    // utilise avec un shader MR=1 -> resultat faux).
+    if (f32acc && ggml_vk_fa_mr() > 1) {
+        result.block_rows = 16 * ggml_vk_fa_mr();
+    }
+
     const uint32_t D_lsb = D ^ (D & (D-1));  // extract lowest set bit
     result.d_split = std::min(std::min(result.subgroup_size, 8u), D_lsb / 4);
 
-    result.shmem_staging = (device->vendor_id == VK_VENDOR_ID_NVIDIA && hsk < 256 && hsv < 256) ? 1 : 0;
+    result.shmem_staging = ggml_vk_fa_stage_kv_forced() ? 1 : ((device->vendor_id == VK_VENDOR_ID_NVIDIA && hsk < 256 && hsv < 256) ? 1 : 0);
 
     return result;
 }
@@ -5058,6 +5092,44 @@ static void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
                 if (f32acc) { spv_data = flash_attn_f32_f16_cm1_data;        spv_size = flash_attn_f32_f16_cm1_len; }
                 else        { spv_data = flash_attn_f32_f16_f16acc_cm1_data; spv_size = flash_attn_f32_f16_f16acc_cm1_len; }
                 name = aligned ? "flash_attn_f32_f16_aligned_cm1" : "flash_attn_f32_f16_cm1";
+                // [TAG_FA_MR] variante multi-lignes (SPIR-V compile avec MR=2 ou 4)
+                if (f32acc) {
+                    const int mr = ggml_vk_fa_mr();
+                    if (mr == 2) {
+                        spv_data = flash_attn_f32_f16_mr2_cm1_data; spv_size = flash_attn_f32_f16_mr2_cm1_len;
+                        name = "flash_attn_f32_f16_mr2_cm1";
+                        static bool mr_logged = false;
+                        if (!mr_logged) { mr_logged = true; fprintf(stderr, "[FA_MR] variante MR=%d active (Br=%u Bc=%u)\n", mr, Br, Bc); }
+                    } else if (mr == 4) {
+                        spv_data = flash_attn_f32_f16_mr4_cm1_data; spv_size = flash_attn_f32_f16_mr4_cm1_len;
+                        name = "flash_attn_f32_f16_mr4_cm1";
+                        static bool mr_logged = false;
+                        if (!mr_logged) { mr_logged = true; fprintf(stderr, "[FA_MR] variante MR=%d active (Br=%u Bc=%u)\n", mr, Br, Bc); }
+                    }
+                }
+                // [TAG_FA_DIAG] variante de diagnostic selectionnee par GGML_VK_FA_DIAG (1..5).
+                // Jamais utilisee en production : ces variantes neutralisent une phase et
+                // produisent donc un resultat FAUX (mesure de temps uniquement).
+                if (f32acc) {
+                    static const int fa_diag_env = [] {
+                        const char * e = getenv("GGML_VK_FA_DIAG");
+                        return e ? atoi(e) : 0;
+                    }();
+                    if (fa_diag_env >= 1 && fa_diag_env <= 5) {
+                        switch (fa_diag_env) {
+                            case 1: spv_data = flash_attn_f32_f16_diag1_cm1_data; spv_size = flash_attn_f32_f16_diag1_cm1_len; break;
+                            case 2: spv_data = flash_attn_f32_f16_diag2_cm1_data; spv_size = flash_attn_f32_f16_diag2_cm1_len; break;
+                            case 3: spv_data = flash_attn_f32_f16_diag3_cm1_data; spv_size = flash_attn_f32_f16_diag3_cm1_len; break;
+                            case 4: spv_data = flash_attn_f32_f16_diag4_cm1_data; spv_size = flash_attn_f32_f16_diag4_cm1_len; break;
+                            case 5: spv_data = flash_attn_f32_f16_diag5_cm1_data; spv_size = flash_attn_f32_f16_diag5_cm1_len; break;
+                        }
+                        name = "flash_attn_f32_f16_diag";
+                        static bool diag_logged = false;
+                        if (!diag_logged) { diag_logged = true;
+                            fprintf(stderr, "[FA_DIAG] variante %d active (f32acc=1, aligned=%d, Br=%u Bc=%u)\n",
+                                    fa_diag_env, (int)aligned, Br, Bc); }
+                    }
+                }
             }
             ggml_vk_create_pipeline(device, fa.second, name, spv_size, spv_data, "main", 7,
                                     sizeof(vk_flash_attn_push_constants), {Br, 1, 1},
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_cm1.comp b/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_cm1.comp
