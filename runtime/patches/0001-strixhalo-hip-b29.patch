+// whole disk holding a file system (e.g. "nvme1n1" for a file on nvme1n1p2), "" if unknown (no block device, dm, ...)
+std::string opus_lm_disk(dev_t d) {
+    char lnk[64];
+    snprintf(lnk, sizeof(lnk), "/sys/dev/block/%u:%u", (unsigned) major(d), (unsigned) minor(d));
+    char buf[1024];
+    const ssize_t n = readlink(lnk, buf, sizeof(buf) - 1);
+    if (n <= 0) {
+        return "";
+    }
+    buf[n] = '\0';
+    std::string p(buf);
+    struct stat x {};
+    if (stat((std::string(lnk) + "/partition").c_str(), &x) == 0) {
+        p = p.substr(0, p.rfind('/'));   // a partition: its disk is the parent directory
+    }
+    const size_t k = p.rfind('/');
+    return k == std::string::npos ? p : p.substr(k + 1);
+}
