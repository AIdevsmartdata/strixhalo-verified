+    const int lane = threadIdx.x;
+    const int tid  = warp_size*threadIdx.y + lane;
+
+    const int  row      = blockIdx.x*nwarps + threadIdx.y;
+    const bool row_ok   = row < nrows_x;
+    const int  row_safe = row_ok ? row : nrows_x - 1;
