diff --git a/common/leviathan.h b/common/leviathan.h
new file mode 100644
index 0000000000000000000000000000000000000000..0e8a305634340cada19e915939a3e5872ce37618
--- /dev/null
+++ b/common/leviathan.h
@@ -0,0 +1,106 @@
+#pragma once
+
+// Bounded integer proposal: derived from Gufo's MIT mtp_sampling.hpp.
+// Copyright (c) 2026 gufo contributors. See leviathan-LICENSE.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <random>
+#include <stdexcept>
+#include <unordered_map>
+#include <vector>
+
+namespace common_leviathan {
+
+constexpr uint32_t units = 1u << 24;
+constexpr size_t max_candidates = 64;
+struct weight { int32_t id; double p; };
+struct mass { int32_t id; uint32_t n; };
+struct proposal {
+    std::vector<mass> masses;
+    int32_t token = -1;
+    bool s12_copy = false;
+};
+struct decision { int32_t token; bool accepted; };
+
+inline std::vector<weight> normalize(std::vector<weight> p) {
+    double sum = 0;
+    for (const auto & e : p) {
+        if (!std::isfinite(e.p) || e.p < 0) { throw std::invalid_argument("invalid Leviathan weight"); }
+        sum += e.p;
+    }
+    if (!(sum > 0) || !std::isfinite(sum)) { throw std::invalid_argument("empty Leviathan distribution"); }
+    for (auto & e : p) { e.p /= sum; }
+    return p;
+}
+
+inline proposal quantize(const std::vector<weight> & weights) {
+    if (weights.empty() || weights.size() > max_candidates) { throw std::invalid_argument("invalid Leviathan support"); }
+    const auto p = normalize(weights);
+    proposal q;
+    uint32_t total = 0;
+    size_t largest = 0;
+    for (size_t i = 0; i < p.size(); ++i) {
+        if (p[i].p > p[largest].p) { largest = i; }
+        const auto n = static_cast<uint32_t>(std::floor(p[i].p * units));
+        q.masses.push_back({p[i].id, n});
+        total += n;
+    }
+    if (total > units) { throw std::invalid_argument("Leviathan mass overflow"); }
+    q.masses[largest].n += units - total;
+    return q;
+}
+
+inline int32_t draw(proposal & q, std::mt19937 & rng) {
+    const uint32_t u = rng() >> 8;
+    uint32_t sum = 0;
+    for (const auto & e : q.masses) {
+        sum += e.n;
+        if (u < sum) { return q.token = e.id; }
+    }
+    throw std::invalid_argument("unnormalized Leviathan proposal");
+}
+
+inline double uniform(std::mt19937 & rng) {
+    return std::generate_canonical<double, 53>(rng);
+}
+
+inline int32_t categorical(const std::vector<weight> & p, std::mt19937 & rng) {
+    double total = 0;
+    int32_t last = -1;
+    for (const auto & e : p) { total += e.p; if (e.p > 0) { last = e.id; } }
+    if (!(total > 0)) { throw std::invalid_argument("empty Leviathan residual"); }
+    const double u = total * uniform(rng);
+    double sum = 0;
+    for (const auto & e : p) {
+        sum += e.p;
+        if (u < sum) { return e.id; }
+    }
+    return last;
+}
+
+// p is the normalized target law after all transformations, not raw logits.
+inline decision verify(const std::vector<weight> & p, const proposal & q, std::mt19937 & rng) {
+    if (q.masses.empty() || q.masses.size() > max_candidates) { throw std::invalid_argument("invalid Leviathan proposal"); }
+    uint64_t total = 0;
+    double qx = 0, px = 0;
+    std::unordered_map<int32_t, double> qm;
+    for (const auto & e : q.masses) {
+        if (e.id < 0 || !qm.emplace(e.id, double(e.n) / units).second) { throw std::invalid_argument("invalid Leviathan token"); }
+        total += e.n;
+        if (e.id == q.token) { qx = double(e.n) / units; }
+    }
+    if (total != units || !(qx > 0)) { throw std::invalid_argument("Leviathan proposal does not match its draw"); }
+    for (const auto & e : p) { if (e.id == q.token) { px = e.p; } }
+    if (uniform(rng) * qx < px) { return {q.token, true}; }
+    std::vector<weight> residual;
+    residual.reserve(p.size());
+    for (const auto & e : p) {
+        const auto it = qm.find(e.id);
+        const double d = e.p - (it == qm.end() ? 0 : it->second);
+        if (d > 0) { residual.push_back({e.id, d}); }
+    }
+    return {categorical(residual, rng), false};
+}
+
+} // namespace common_leviathan
