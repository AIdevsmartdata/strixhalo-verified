--- /dev/null
+++ b/tests/test-bf16-f32-exact.cpp
@@ -0,0 +1,114 @@
+// [TAG_ROUTER_BF16_EXACT] Test op-level byte-exactness: BF16 weights (widened values)
+// vs F32 weights on the Vulkan backend, matvec (decode) and matmul (prefill) paths.
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include <cstdio>
+#include <cstring>
+#include <cstdint>
+#include <random>
+#include <vector>
+
+struct Case { int k, m, n; };
+
+int main() {
+    ggml_backend_dev_t dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+    if (!dev) {
+        // Strix Halo: le Radeon 8060S est un iGPU (uma:1) -> classe IGPU, pas GPU.
+        dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_IGPU);
+    }
+    if (!dev) {
+        // dernier recours: premier device non-CPU enregistre
+        for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+            ggml_backend_dev_t d = ggml_backend_dev_get(i);
+            if (ggml_backend_dev_type(d) != GGML_BACKEND_DEVICE_TYPE_CPU) { dev = d; break; }
+        }
+    }
+    if (!dev) { printf("NO_GPU_DEVICE\n"); return 1; }
+    printf("DEVICE=%s\n", ggml_backend_dev_name(dev));
+    ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+    if (!backend) { printf("BACKEND_INIT_FAIL\n"); return 1; }
+    printf("BACKEND=%s\n", ggml_backend_name(backend));
+
+    const std::vector<Case> cases = {
+        {2560, 512, 1},    // router decode (dmmv)
+        {2560, 512, 8},     // dmmv multi-col
+        {2560, 512, 512},  // prefill batch
+        {2560, 512, 2048}, // prefill full ubatch
+        {2561, 512, 1},    // odd k (dmmv OOB tail)
+        {2561, 512, 512},  // odd k matrix (unaligned)
+        {2559, 512, 3},    // n<4, k%4!=0 (dmmv scalar tail)
+        {2560, 513, 1},    // odd m (partial NUM_ROWS group)
+    };
+
+    ggml_init_params params = { ggml_tensor_overhead() * 64 + ggml_graph_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(params);
+    if (!ctx) { printf("CTX_FAIL\n"); return 1; }
+
+    std::vector<ggml_tensor *> w_f32, w_bf16, xs, outs_f32, outs_bf16;
+    for (const Case & c : cases) {
+        ggml_tensor * wf = ggml_new_tensor_2d(ctx, GGML_TYPE_F32,  c.k, c.m);
+        ggml_tensor * wb = ggml_new_tensor_2d(ctx, GGML_TYPE_BF16, c.k, c.m);
+        ggml_tensor * x  = ggml_new_tensor_2d(ctx, GGML_TYPE_F32,  c.k, c.n);
+        outs_f32.push_back(ggml_mul_mat(ctx, wf, x));
+        outs_bf16.push_back(ggml_mul_mat(ctx, wb, x));
+        w_f32.push_back(wf); w_bf16.push_back(wb); xs.push_back(x);
+    }
+
+    ggml_backend_buffer * buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    if (!buf) { printf("ALLOC_FAIL\n"); return 1; }
+
+    std::mt19937 rng(424242);
+    for (size_t i = 0; i < cases.size(); ++i) {
+        const Case & c = cases[i];
+        // Weights: random bf16 bit patterns (no NaN/Inf exponents), widened exactly by shift.
+        std::vector<uint16_t> h(c.k * c.m);
+        for (auto & v : h) {
+            do { v = (uint16_t)(rng() & 0xffff); } while (((v >> 7) & 0xff) == 0xff);
+        }
+        std::vector<uint32_t> wf(c.k * c.m);
+        for (size_t j = 0; j < h.size(); ++j) wf[j] = ((uint32_t)h[j]) << 16;
+        std::vector<float> x(c.k * c.n);
+        for (auto & v : x) {
+            uint32_t u;
+            do { u = rng(); } while (((u >> 23) & 0xff) == 0xff);
+            memcpy(&v, &u, 4);
+        }
+        ggml_backend_tensor_set(w_f32[i], wf.data(), 0, wf.size() * 4);
+        ggml_backend_tensor_set(w_bf16[i], h.data(), 0, h.size() * 2);
+        ggml_backend_tensor_set(xs[i], x.data(), 0, x.size() * 4);
+    }
+
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    for (size_t i = 0; i < cases.size(); ++i) {
+        ggml_build_forward_expand(gf, outs_f32[i]);
+        ggml_build_forward_expand(gf, outs_bf16[i]);
+    }
+    if (ggml_backend_graph_compute(backend, gf) != GGML_STATUS_SUCCESS) { printf("COMPUTE_FAIL\n"); return 1; }
+    ggml_backend_synchronize(backend);
+
+    int failures = 0;
+    for (size_t i = 0; i < cases.size(); ++i) {
+        const Case & c = cases[i];
+        std::vector<float> a(c.m * c.n), b(c.m * c.n);
+        ggml_backend_tensor_get(outs_f32[i], a.data(), 0, a.size() * 4);
+        ggml_backend_tensor_get(outs_bf16[i], b.data(), 0, b.size() * 4);
+        size_t diff = SIZE_MAX;
+        for (size_t j = 0; j < a.size(); ++j) {
+            uint32_t ua, ub; memcpy(&ua, &a[j], 4); memcpy(&ub, &b[j], 4);
+            if (ua != ub) { diff = j; break; }
+        }
+        if (diff == SIZE_MAX) {
+            printf("CASE_PASS k=%d m=%d n=%d\n", c.k, c.m, c.n);
+        } else {
+            uint32_t ua, ub; memcpy(&ua, &a[diff], 4); memcpy(&ub, &b[diff], 4);
+            printf("CASE_FAIL k=%d m=%d n=%d idx=%zu f32=%08x bf16=%08x\n", c.k, c.m, c.n, diff, ua, ub);
+            ++failures;
+        }
+    }
+    printf(failures ? "ROUTER_BF16_EXACT_KO (%d)\n" : "ROUTER_BF16_EXACT_PASS\n", failures);
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+    ggml_backend_free(backend);
+    return failures ? 1 : 0;
+}
