+                overlaps_unsynced(ctx->fused_hc_combine->sig, ctx->unsynced_nodes_written)) {
+                need_sync = true;
+            }
+        }
 
         if (need_sync) {
             if (vk_enable_sync_logger) {
@@ -16169,6 +16265,12 @@ static bool ggml_vk_build_graph(ggml_backend_vk_context * ctx, ggml_cgraph * cgr
         if (ctx->fused_gdn_state_read) {
             ctx->unsynced_nodes_read.push_back(ctx->fused_gdn_state_read);
         }
+        // [TAG_HC_COMBINE_FUSED] mémoriser les lectures GPU directes (b reshape, inject)
+        // pour ordonner les nœuds suivants qui écriraient ces buffers.
+        if (ctx->fused_hc_combine) {
+            ctx->unsynced_nodes_read.push_back(ctx->fused_hc_combine->b);
+            ctx->unsynced_nodes_read.push_back(ctx->fused_hc_combine->sig);
+        }
     }
     if (vk_enable_sync_logger) {
         for (int i = 0; i < ctx->num_additional_fused_ops + 1; ++i) {
@@ -16208,7 +16310,11 @@ static bool ggml_vk_build_graph(ggml_backend_vk_context * ctx, ggml_cgraph * cgr
 
         break;
     case GGML_OP_ADD:
-        if (ctx->num_additional_fused_ops) {
+        if (ctx->fused_hc_combine) {
+            // [TAG_HC_COMBINE_FUSED] chaîne entière en un kernel : dst = res + b*(4*sigmoid(inject))
+            ggml_vk_hc_combine(ctx, compute_ctx, ctx->fused_hc_combine->res,
+                               ctx->fused_hc_combine->b, ctx->fused_hc_combine->sig, node);
+        } else if (ctx->num_additional_fused_ops) {
             ggml_vk_multi_add(ctx, compute_ctx, cgraph, node_idx);
         } else {
             ggml_vk_add(ctx, compute_ctx, src0, src1, node);
@@ -17938,6 +18044,162 @@ static int32_t find_first_set(uint32_t x) {
 //   cpy  = CPY(src, dst) where dst is a VIEW of the recurrent state cache
 // Returns the cache view the GDN kernel must write, or nullptr when the pattern
 // does not match exactly (anything else keeps the plain CPY path).
+// [TAG_HC_COMBINE_FUSED] Préparation par DÉPENDANCES (leçon S1 : l'ordre DFS réel
+// rend REPEAT/MUL/ADD adjacents mais SIGMOID/SCALE ailleurs — le matcher ne suppose
+// AUCUN ordre, il remonte les pointeurs src).
+// Motif cible (qwen4exp build_hc_combine, hc = hyper_connection.count >= 2) :
+//   w_r = RESHAPE_3D(1, hc, nt) ; w_r->src = SCALE(2.0) -> SCALE(2.0) -> SIGMOID -> inject
+//   b_r = RESHAPE_3D(n_embd, 1, nt) ; rep = REPEAT_4D(b_r, (n_embd, hc, nt))
+//   mul = MUL(rep, w_r) ; add = ADD(res, mul) ; dst de l'ADD = (n_embd, hc, nt) f32
+// Identité requise : tous f32, misalign nul, intermédiaires à usage unique,
+// scales EXACTEMENT 2.0f (le kernel fait 2*(2*sigmoid)).
+static bool ggml_vk_match_hc_combine(ggml_backend_vk_context * ctx, const ggml_cgraph * cgraph, int node_idx,
+                                      std::unordered_map<const ggml_tensor *, int> & idx_of,
+                                      ggml_backend_vk_context::vk_hc_combine_entry * out) {
+    const ggml_tensor * add = cgraph->nodes[node_idx];
+    if (add->op != GGML_OP_ADD || add->ne[3] != 1) {
+        return false;
+    }
+    const ggml_tensor * res = add->src[0];
+    const ggml_tensor * mul = add->src[1];
+    if (!res || !mul || mul->op != GGML_OP_MUL) {
+        return false;
+    }
+    const ggml_tensor * rep = mul->src[0];
+    const ggml_tensor * w_r = mul->src[1];
+    if (!rep || !w_r || rep->op != GGML_OP_REPEAT || w_r->op != GGML_OP_RESHAPE) {
+        return false;
+    }
+    const ggml_tensor * b_r = rep->src[0];
+    if (!b_r || b_r->op != GGML_OP_RESHAPE) {
+        return false;
+    }
+    // shapes : dst (n_embd, hc, nt), b_r (n_embd, 1, nt), w_r (1, hc, nt)
+    const int64_t n_embd = add->ne[0];
+    const int64_t hc     = add->ne[1];
+    const int64_t nt     = add->ne[2];
+    if (hc < 2 || add->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (!ggml_are_same_shape(add, res) || !ggml_are_same_shape(add, mul) || !ggml_are_same_shape(add, rep)) {
+        return false;
+    }
+    if (b_r->ne[0] != n_embd || b_r->ne[1] != 1 || b_r->ne[2] != nt || b_r->ne[3] != 1 || b_r->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (w_r->ne[0] != 1 || w_r->ne[1] != hc || w_r->ne[2] != nt || w_r->ne[3] != 1 || w_r->type != GGML_TYPE_F32) {
+        return false;
+    }
+    // chaîne w : RESHAPE <- SCALE(2.0f) <- SCALE(2.0f) <- SIGMOID <- inject (f32 (hc, nt))
+    const ggml_tensor * s1 = w_r->src[0];
+    if (!s1 || s1->op != GGML_OP_SCALE || s1->type != GGML_TYPE_F32) {
+        return false;
+    }
+    const ggml_tensor * s2 = s1->src[0];
+    if (!s2 || s2->op != GGML_OP_SCALE || s2->type != GGML_TYPE_F32) {
+        return false;
+    }
+    const ggml_tensor * sig = s2->src[0];
+    if (!sig || sig->op != GGML_OP_UNARY || ggml_get_unary_op(sig) != GGML_UNARY_OP_SIGMOID || sig->type != GGML_TYPE_F32) {
+        return false;
+    }
+    // Le kernel lit le RÉSULTAT du SIGMOID (exécuté normalement par le pipeline unary
+    // standard : codegen identique, bit-exact). Le SIGMOID lui-même n'est PAS élidé.
+    const ggml_tensor * sig_out = sig;
+    if (sig_out->ne[0] != hc || sig_out->ne[1] != nt) {
+        return false;
+    }
+    // les deux scale portent EXACTEMENT le facteur 2.0f (op_params), le kernel fait 2*(2*sig)
+    float f1, f2;
+    memcpy(&f1, s1->op_params, sizeof(float));
+    memcpy(&f2, s2->op_params, sizeof(float));
+    if (f1 != 2.0f || f2 != 2.0f) {
+        return false;
+    }
+    // intermédiaires à usage unique (par pointeur d'index dans le graphe)
+    auto uses1 = [&](const ggml_tensor * t) {
+        auto it = idx_of.find(t);
+        return it != idx_of.end() && ggml_node_get_use_count(cgraph, it->second) == 1;
+    };
+    if (!uses1(mul) || !uses1(rep) || !uses1(s1) || !uses1(s2) || !uses1(sig)) {
+        return false;
+    }
+    // alignment (comme multi_add : aucun misalign toléré)
+    if (get_misalign_bytes(ctx, res) || get_misalign_bytes(ctx, b_r) ||
+        get_misalign_bytes(ctx, sig_out) || get_misalign_bytes(ctx, add)) {
+        return false;
+    }
+    // v5 : lignes i contiguës f32 (4 scalaires consécutifs par thread) —
+    // aucune contrainte d'alignement 16B : les offsets de base ne sont que 4B-alignés
+    if (add->ne[0] % 4 != 0 ||
+        res->nb[0] != 4 || add->nb[0] != 4 || b_r->nb[0] != 4) {
+        return false;
+    }
+    out->res = res;
+    out->b   = b_r;
+    out->sig = sig_out;
+    return true;
+}
+
+static void ggml_vk_prepare_hc_combine_fusion(ggml_backend_vk_context * ctx, ggml_cgraph * cgraph) {
+    ctx->hc_combine_fused.clear();
+    ctx->hc_combine_skip.clear();
+
+#if defined(GGML_VULKAN_CHECK_RESULTS)
+    // Le checker recalculerait chaque nœud contre le CPU : des nœuds élidés
+    // produiraient de faux mismatches.
+    return;
+#endif
+    if (ctx->device->disable_fusion || getenv("GGML_VK_DISABLE_HC_COMBINE_FUSED") != nullptr) {
+        return;
+    }
+
+    static bool dbg_init = false;
+    static bool dbg = false;
+    if (!dbg_init) {
+        dbg_init = true;
+        dbg = getenv("GGML_VK_DEBUG_HC_COMBINE") != nullptr;
+    }
+
+    // index des pointeurs -> node_idx (une passe, O(n))
+    std::unordered_map<const ggml_tensor *, int> idx_of;
+    idx_of.reserve(cgraph->n_nodes);
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        idx_of[cgraph->nodes[i]] = i;
+    }
+
+    uint32_t fused_n = 0;
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * add = cgraph->nodes[i];
+        if (add->op != GGML_OP_ADD) {
+            continue;
+        }
+        ggml_backend_vk_context::vk_hc_combine_entry entry;
+        if (!ggml_vk_match_hc_combine(ctx, cgraph, i, idx_of, &entry)) {
+            continue;
+        }
+        const ggml_tensor * mul = add->src[1];
+        const ggml_tensor * rep = mul->src[0];
+        const ggml_tensor * w_r = mul->src[1];
+        const ggml_tensor * s1 = w_r->src[0];
+        const ggml_tensor * s2 = s1->src[0];
+        const ggml_tensor * sig = s2->src[0];
+        // SIGMOID VOLONTAIREMENT NON élidé : il reste un nœud unary standard
+        // (le kernel lit son résultat — recomputer l'exp in-kernel a produit des
+        // ULP différents et cassé l'identité byte-à-byte, test S2 du 05/09).
+        ctx->hc_combine_fused[add] = entry;
+        ctx->hc_combine_skip.insert(s1);
+        ctx->hc_combine_skip.insert(s2);
+        ctx->hc_combine_skip.insert(rep);
+        ctx->hc_combine_skip.insert(mul);
+        ++fused_n;
+    }
+    if (dbg) {
+        fprintf(stderr, "[HC_COMBINE] %u chaînes fusionnées, %zu nœuds élidés (graphe de %d nœuds)\n",
+                fused_n, ctx->hc_combine_skip.size(), cgraph->n_nodes);
+    }
+}
