+constexpr size_t OPUS_LM_PIECE     = 64u * 1024 * 1024;  // largest piece, like the 64 MiB staging buffers of the original code
+constexpr size_t OPUS_LM_MIN_PIECE = 1u * 1024 * 1024;   // a slower file is never handed less than this near the end
+constexpr size_t OPUS_LM_RATE_MIN  = 4u * 1024 * 1024;   // pieces smaller than this are latency, not throughput
+constexpr size_t OPUS_LM_MAX_ALIGN = 64u * 1024;
+
+double opus_lm_now() {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+// pread of the window [off, off+len) into buf (O_DIRECT: off, len and buf aligned); stops at the end of the file.
+// Returns the bytes read (fewer than len only at the end of the file), or -1 with errno set.
+ssize_t opus_lm_pread(int fd, uint8_t * buf, size_t len, size_t off, size_t fsize) {
+    size_t got = 0;
+    while (got < len && off + got < fsize) {
+        const ssize_t r = pread(fd, buf + got, len - got, (off_t) (off + got));
+        if (r < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return -1;
+        }
+        if (r == 0) {
+            break;
+        }
+        got += (size_t) r;
+    }
+    return (ssize_t) got;
+}
+
+// Compares [off, off+len) (aligned, clipped at the end of the file) of the GGUF (fa) and of a copy (fb), in windows of at
+// most `cap` bytes; the file read first alternates with `b_first`. Returns "" if identical, otherwise the reason.
+std::string opus_lm_compare(int fa, int fb, size_t off, size_t len, size_t fsize, size_t A, size_t cap, uint8_t * ba, uint8_t * bb,
+                            bool b_first, std::vector<double> & la, std::vector<double> & lb) {
+    const size_t end = std::min(off + len, fsize);
+    for (size_t pos = off; pos < end; pos += cap) {
+        const size_t n  = std::min(cap, end - pos);
+        const size_t wl = (n + A - 1) / A * A;
+        ssize_t ra = 0, rb = 0;
+        int     ea = 0, eb = 0;
+        double  ta = 0, tb = 0;
+        auto rd = [&](int fd, uint8_t * buf, ssize_t & r, int & e, double & ms) {
+            const double t0 = opus_lm_now();
+            r  = opus_lm_pread(fd, buf, wl, pos, fsize);
+            e  = errno;
+            ms = (opus_lm_now() - t0) * 1e3;
+        };
+        if (b_first) {
+            rd(fb, bb, rb, eb, tb);
+            rd(fa, ba, ra, ea, ta);
+        } else {
+            rd(fa, ba, ra, ea, ta);
+            rd(fb, bb, rb, eb, tb);
+        }
+        la.push_back(ta);
+        lb.push_back(tb);
+        if (ra < (ssize_t) n) {
+            return format("lecture du GGUF impossible a l'octet %zu (%s)", pos, ra < 0 ? strerror(ea) : "fichier court");
+        }
+        if (rb < (ssize_t) n) {
+            return format("lecture de la copie impossible a l'octet %zu (%s)", pos, rb < 0 ? strerror(eb) : "fichier court");
+        }
+        if (memcmp(ba, bb, n) != 0) {
+            return format("OCTETS DIFFERENTS dans [%zu, %zu)", pos, pos + n);
+        }
+    }
+    return "";
+}
