+        // [TAG_HC_COMBINE_FUSED] SIGMOID/SCALE/SCALE/REPEAT/MUL élidés par le kernel hc_combine
+        if (ctx->hc_combine_skip.count(cgraph->nodes[i])) {
+            continue;
+        }
 
         {
             auto node_flops = ggml_vk_get_node_flops(cgraph->nodes[i]);
@@ -18379,6 +18647,7 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
         ctx->fused_gdn_cache_dst = nullptr;
         ctx->fused_gdn_state_read = nullptr;
         ctx->fused_gdn_state_idx  = nullptr;
