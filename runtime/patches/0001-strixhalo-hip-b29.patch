+                                ux[u][w] = load8 ? opus_load8_pair(x2, col2) : x2[col2];
+#pragma unroll
+                                for (int j = 0; j < NC; ++j) {
+                                    uy[u][w][j] = y2[j*stride_col_y2 + col2];
+                                }
+                            }
+                        }
+                    }
+#pragma unroll
+                    for (int u = 0; u < U; ++u) {
+#pragma unroll
+                        for (int w = 0; w < nvw; ++w) {
+                            const int col2 = col0 + u*256 + w*warp_size + lane;
+                            if (col2 < ncols2) {
+                                const uint32_t uu = ux[u][w];
+                                const float2 x = make_float2(__uint_as_float(uu << 16), __uint_as_float(uu & 0xFFFF0000u));
+#pragma unroll
+                                for (int j = 0; j < NC; ++j) {
+                                    ggml_cuda_mad(sumf[j][w], x, uy[u][w][j]);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+            for (; col0 < ncols2; col0 += 256) {
+                uint32_t tmpx[nvw];
+                float2 tmpy[nvw][NC];
+#pragma unroll
+                for (int w = 0; w < nvw; ++w) {
+                    const int col2 = col0 + w*warp_size + lane;
+                    if (col2 < ncols2) {
+                        tmpx[w] = load8 ? opus_load8_pair(x2, col2) : x2[col2];
+#pragma unroll
+                        for (int j = 0; j < NC; ++j) {
+                            tmpy[w][j] = y2[j*stride_col_y2 + col2];
+                        }
+                    }
+                }
+#pragma unroll
+                for (int w = 0; w < nvw; ++w) {
+                    const int col2 = col0 + w*warp_size + lane;
+                    if (col2 < ncols2) {
+                        const uint32_t uu = tmpx[w];
+                        const float2 x = make_float2(__uint_as_float(uu << 16), __uint_as_float(uu & 0xFFFF0000u));
+#pragma unroll
+                        for (int j = 0; j < NC; ++j) {
+                            ggml_cuda_mad(sumf[j][w], x, tmpy[w][j]);
+                        }
+                    }
+                }
+            }
+        }
+#pragma unroll
+        for (int j = 0; j < NC; ++j) {
+#pragma unroll
+            for (int w = 0; w < nvw; ++w) {
+                sumf[j][w] = (warp_reduce_sum<warp_size>(sumf[j][w]) + 0.0f) + 0.0f;
+            }
+            const float value = ((sumf[j][0] + sumf[j][4]) + (sumf[j][2] + sumf[j][6])) + ((sumf[j][1] + sumf[j][5]) + (sumf[j][3] + sumf[j][7]));
+            if (lane == 0) {
+                seg.dst[(int64_t) j*seg.stride_col_dst + row] = value;
+            }
+        }
+        return;
+    }
+
+    constexpr int qk = QK8_0;
+    constexpr int qi = QI8_0;
+    constexpr int vdr = VDR_Q8_0_Q8_1_MMVQ;
+    constexpr int blocks_per_iter = vdr * warp_size / qi;
+    const block_q8_1 * y  = (const block_q8_1 *) vy_q8;
+    const block_q8_0 * bx0 = (const block_q8_0 *) seg.vx + (int64_t) row*seg.stride_row;
+    const block_q8_0 * bg0 = seg.gate ? (const block_q8_0 *) seg.gate + (int64_t) row*seg.gate_stride_row : nullptr;
+    const bool use_gate = bg0 != nullptr;
+    const int blocks_per_row_x = ncols_x / qk;
+    const int kqs = vdr * (lane % (qi/vdr));
+
+    float tmp[NC] = {};
+    float tmp_g[NC] = {};
+    int kbx = lane / (qi/vdr);
+    if constexpr (LONG) {
+        constexpr int PF = 4;
+        if (!use_gate) {
+            for (; kbx + (PF - 1)*blocks_per_iter < blocks_per_row_x; kbx += PF*blocks_per_iter) {
+                int   xv[PF][VDR_Q8_0_Q8_1_MMVQ];
+                float dx[PF];
+#pragma unroll
+                for (int p = 0; p < PF; ++p) {
+                    const block_q8_0 * bx = bx0 + kbx + p*blocks_per_iter;
+#pragma unroll
+                    for (int i = 0; i < VDR_Q8_0_Q8_1_MMVQ; ++i) {
+                        xv[p][i] = get_int_b2(bx->qs, kqs + i);
+                    }
+                    dx[p] = __half2float(bx->d);
+                }
+#pragma unroll
+                for (int p = 0; p < PF; ++p) {
+                    const int kby = (kbx + p*blocks_per_iter) * (qk/QK8_1);
+#pragma unroll
+                    for (int j = 0; j < NC; ++j) {
+                        const block_q8_1 * by = &y[j*stride_col_y_q8 + kby];
+                        int sumi = 0;
+#pragma unroll
+                        for (int i = 0; i < VDR_Q8_0_Q8_1_MMVQ; ++i) {
+                            sumi = ggml_cuda_dp4a(xv[p][i], get_int_b4(by->qs, kqs + i), sumi);
+                        }
+                        tmp[j] += dx[p] * __half2float(__low2half(by->ds)) * (float) sumi;
+                    }
+                }
+            }
+        }
+    }
+    for (; kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const block_q8_0 * bx = bx0 + kbx;
+        int xv[VDR_Q8_0_Q8_1_MMVQ];
+#pragma unroll
+        for (int i = 0; i < VDR_Q8_0_Q8_1_MMVQ; ++i) {
+            xv[i] = get_int_b2(bx->qs, kqs + i);
+        }
+        const float dx = __half2float(bx->d);
+        int xg[VDR_Q8_0_Q8_1_MMVQ] = {};
+        float dg = 0.0f;
+        if (use_gate) {
+            const block_q8_0 * bg = bg0 + kbx;
+#pragma unroll
+            for (int i = 0; i < VDR_Q8_0_Q8_1_MMVQ; ++i) {
+                xg[i] = get_int_b2(bg->qs, kqs + i);
+            }
+            dg = __half2float(bg->d);
+        }
+#pragma unroll
+        for (int j = 0; j < NC; ++j) {
+            const block_q8_1 * by = &y[j*stride_col_y_q8 + kby];
+            int sumi = 0;
+#pragma unroll
+            for (int i = 0; i < VDR_Q8_0_Q8_1_MMVQ; ++i) {
+                sumi = ggml_cuda_dp4a(xv[i], get_int_b4(by->qs, kqs + i), sumi);
+            }
+            tmp[j] += dx * __half2float(__low2half(by->ds)) * (float) sumi;
+            if (use_gate) {
+                int sumg = 0;
+#pragma unroll
+                for (int i = 0; i < VDR_Q8_0_Q8_1_MMVQ; ++i) {
+                    sumg = ggml_cuda_dp4a(xg[i], get_int_b4(by->qs, kqs + i), sumg);
+                }
+                tmp_g[j] += dg * __half2float(__low2half(by->ds)) * (float) sumg;
+            }
+        }
+    }
+#pragma unroll
+    for (int j = 0; j < NC; ++j) {
+        const float v = warp_reduce_sum<warp_size>(tmp[j]);
+        if (use_gate) {
+            const float g = warp_reduce_sum<warp_size>(tmp_g[j]);
+            if (lane == 0) {
+                seg.dst[(int64_t) j*seg.stride_col_dst + row] = ggml_cuda_op_silu_single(g) * v;
+            }
+        } else if (lane == 0) {
+            seg.dst[(int64_t) j*seg.stride_col_dst + row] = v;
+        }
+    }
+}
+
+bool ggml_cuda_mmv_ngrp_seg_ok(const ggml_tensor * w, const ggml_tensor * y) {
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    if (!GGML_CUDA_CC_IS_RDNA3_5(cc)) {
+        return false;
+    }
+    if (y->type != GGML_TYPE_F32 || y->ne[1] < 2 || y->ne[1] > 4 || y->ne[2] != 1 || y->ne[3] != 1 || !ggml_is_contiguous(y) ||
+            y->ne[0] != w->ne[0] || (uintptr_t) y->data % 8 != 0 || y->nb[1] % 8 != 0) {
+        return false;
+    }
+    if (w->ne[2] != 1 || w->ne[3] != 1 || w->nb[0] != ggml_type_size(w->type) || w->ne[1] > INT32_MAX ||
+            (w->buffer && ggml_backend_buffer_get_usage(w->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE)) {
+        return false;
+    }
+    if (w->type == GGML_TYPE_Q8_0) {
+        return ggml_cuda_mmv_group_nc_seg_ok(w, y);
+    }
+    if (w->type == GGML_TYPE_F32 || ggml_cuda_is_f32_twin(w)) {
+        const size_t al = w->type == GGML_TYPE_F32 ? 8 : 4;
+        if (w->ne[0] % 2 != 0 || w->nb[1] % al != 0 || (uintptr_t) w->data % al != 0) {
+            return false;
+        }
+        // the dispatch of ggml_cuda_mul_mat for this batch must be mul_mat_vec_f with its 256-thread block (emulated here)
+        size_t nb32[GGML_MAX_DIMS];
+        for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+            nb32[i] = w->type == GGML_TYPE_F32 ? w->nb[i] : w->nb[i]*2;
+        }
+        if (!ggml_cuda_should_use_mmvf(GGML_TYPE_F32, cc, w->ne, nb32, y->ne[1])) {
+            return false;
+        }
+        const int64_t ncols = w->ne[0];
+        int64_t best = 32, niter_best = (ncols + 63) / 64;
+        for (int64_t bs = 64; bs <= 256; bs += 32) {
+            const int64_t niter = (ncols + 2*bs - 1) / (2*bs);
+            if (niter < niter_best) {
+                niter_best = niter;
+                best       = bs;
+            }
+        }
+        return best == 256;
+    }
+    return false;
+}
+
+void ggml_cuda_mmv_ngrp(ggml_backend_cuda_context & ctx, const ggml_tensor * y, const ggml_cuda_mmv_group_seg * segs, const int nseg) {
+    GGML_ASSERT(nseg >= 1 && nseg <= MMVQ_GROUP_MAX);
+    cudaStream_t stream = ctx.stream();
+    const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+    GGML_ASSERT(warp_size == 32);
+
+    const int64_t ne10 = y->ne[0];
+    const int64_t ne11 = y->ne[1];
+    const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+
+    bool any_q8 = false;
+    for (int i = 0; i < nseg; ++i) {
+        any_q8 = any_q8 || segs[i].w->type == GGML_TYPE_Q8_0;
+    }
+    // the q8_1 copy of y, in this order of preference (the same sources as ggml_cuda_mul_mat_vec_q, all bit-identical to a fresh
+    // quantize_row_q8_1_cuda): written by the producer kernel (V3Q8FULL), kept by the Q8PROD cache (shared with the routed experts
+    // that read the same bytes), else quantized here. Not reusing them made NGRP lose what those levers saved.
+    ggml_cuda_pool_alloc<char> y_q8_1(ctx.pool());
+    const char * y_q8_ptr = nullptr;
+    if (any_q8) {
+        const size_t nbytes_q8_1 = ne11*ne10_padded * sizeof(block_q8_1)/QK8_1;
+        // NGRP bit 8 = ancien comportement (toujours requantifier), pour l'A/B a chaud
+        const bool reuse = (GGML_OPUS_INT("GGML_OPUS_NGRP", 0) & 8) == 0;
+        const void * pre = (!reuse || ctx.q8full.empty()) ? nullptr : ctx.q8full_lookup(y);
+        auto & yc = ctx.mmvq_y_cache;
+        bool quantize = true;
+        if (pre != nullptr) {
+            y_q8_ptr = (const char *) pre;
+            quantize = false;
+        } else if (reuse && yc.armed && ctx.curr_stream_no == 0 && (const char *) y->data == yc.y0 && ggml_is_contiguous(y) &&
+                ne10 == yc.ne10 && ne11 == yc.nrows && ne10_padded == yc.ne10_padded) {
+            if (yc.ptr == nullptr) {
+                yc.pool = &ctx.pool();
+                yc.ptr  = yc.pool->alloc(nbytes_q8_1, &yc.size);
+            } else {
+                quantize = false;
+            }
+            y_q8_ptr = (const char *) yc.ptr;
+        } else {
+            y_q8_ptr = y_q8_1.alloc(nbytes_q8_1);
+        }
+        if (quantize) {
+            const int64_t ts = sizeof(float);
+            quantize_row_q8_1_cuda((const float *) y->data, nullptr, (char *) y_q8_ptr, GGML_TYPE_Q8_0, ne10, y->nb[1] / ts, y->nb[2] / ts,
+                y->nb[3] / ts, ne10_padded, ne11, 1, 1, stream);
+        }
+    }
+
+    opus_ngrp_args_dev args{};
+    args.nseg = nseg;
+    int nblocks = 0;
+    for (int i = 0; i < nseg; ++i) {
+        const ggml_tensor * w = segs[i].w;
+        GGML_ASSERT(ggml_cuda_mmv_ngrp_seg_ok(w, y));
+        GGML_ASSERT(segs[i].dst->type == GGML_TYPE_F32 && ggml_is_contiguous(segs[i].dst) && segs[i].dst->ne[1] == ne11);
+        GGML_ASSERT(segs[i].gate == nullptr || (w->type == GGML_TYPE_Q8_0 && segs[i].gate->type == GGML_TYPE_Q8_0 &&
+            ggml_are_same_shape(w, segs[i].gate) && segs[i].gate->nb[0] == sizeof(block_q8_0) &&
+            segs[i].gate->nb[1] % sizeof(block_q8_0) == 0 && segs[i].glu_op == GGML_GLU_OP_SWIGLU));
+        opus_ngrp_seg_dev & d = args.seg[i];
+        d.vx              = w->data;
+        d.gate            = segs[i].gate ? segs[i].gate->data : nullptr;
+        d.dst             = (float *) segs[i].dst->data;
+        d.nrows           = (int) w->ne[1];
+        d.stride_row      = (int) (w->nb[1] / ggml_type_size(w->type));
+        d.gate_stride_row = segs[i].gate ? (int) (segs[i].gate->nb[1] / sizeof(block_q8_0)) : 0;
+        d.stride_col_dst  = (int) (segs[i].dst->nb[1] / sizeof(float));
+        d.blocks_begin    = nblocks;
+        d.kind            = w->type == GGML_TYPE_Q8_0 ? 0 : (w->type == GGML_TYPE_F32 ? 1 : 2);
+        nblocks += d.nrows;
+    }
+    const dim3 block_nums(nblocks, 1, 1);
+    const dim3 block_dims(warp_size, 1, 1);
+    const ggml_cuda_kernel_launch_params lp = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
+    const int stride_col_y_q8 = (int) (ne10_padded / QK8_1);
+    const int stride_col_y_f  = (int) (y->nb[1] / sizeof(float));
+    const void * q8 = any_q8 ? (const void *) y_q8_ptr : nullptr;
+    const bool is_long = ne10 >= 8192;
+    bool use_load8 = GGML_OPUS_ON("GGML_OPUS_BF16_LOAD8") &&
+        (ne10 == 2560 || ne10 == 10240) && GGML_CUDA_CC_IS_RDNA3_5(ggml_cuda_info().devices[ctx.device].cc);
+    bool has_bf16 = false;
+    for (int i = 0; i < nseg; ++i) {
+        const auto & d = args.seg[i];
+        if (d.kind == 2) {
+            has_bf16 = true;
+            if ((uintptr_t) d.vx % 8 != 0 || d.stride_row % 4 != 0 || d.nrows > 512) { use_load8 = false; }
+        }
+    }
+    use_load8 = use_load8 && has_bf16;
+    switch (ne11) {
+#define OPUS_NGRP_LAUNCH(NCV) \
+        case NCV: \
+            if (use_load8 && is_long) { ggml_cuda_kernel_launch(opus_ngrp<NCV, true, true>, lp, args, q8, (const float *) y->data, (int) ne10, stride_col_y_q8, stride_col_y_f); } \
+            else if (use_load8)       { ggml_cuda_kernel_launch(opus_ngrp<NCV, false, true>, lp, args, q8, (const float *) y->data, (int) ne10, stride_col_y_q8, stride_col_y_f); } \
+            if (is_long) { ggml_cuda_kernel_launch(opus_ngrp<NCV, true>, lp, args, q8, (const float *) y->data, (int) ne10, stride_col_y_q8, stride_col_y_f); } \
+            else         { ggml_cuda_kernel_launch(opus_ngrp<NCV, false>, lp, args, q8, (const float *) y->data, (int) ne10, stride_col_y_q8, stride_col_y_f); } \
+            break;
+        OPUS_NGRP_LAUNCH(2)
+        OPUS_NGRP_LAUNCH(3)
+        OPUS_NGRP_LAUNCH(4)
+#undef OPUS_NGRP_LAUNCH
+        default: GGML_ABORT("fatal error");
+    }
+}
+
+// Dedicated MoE multi-token kernel.
+// Grid: (ceil(nrows_x / c_rows_per_block), nchannels_dst)
+// Block: (warp_size, ncols_dst) - each warp handles one token independently.
+// No shared memory reduction needed since each warp works alone.
+// MOE16: block height (tokens) the kernel is compiled for; wide = true for batches above the historical limit of the type
+// (GGML_OPUS_MMID_MAXB*), up to OPUS_MMID_WIDE_MAX tokens. wide = false is the original instantiation.
+template <ggml_type type, bool wide>
+static constexpr __device__ int mmvq_moe_max_cols() {
+    return wide ? OPUS_MMID_LEGACY_MAX : get_mmvq_mmid_max_batch_for_device<type>();
+}
+
+template <ggml_type type, int c_rows_per_block, bool has_fusion = false, bool wide = false>
+// parentheses: the comma of <type, wide> would split the arguments of the __launch_bounds__ macro (HIP: select_impl_ on __VA_ARGS__)
+__launch_bounds__((mmvq_moe_max_cols<type, wide>()*ggml_cuda_get_physical_warp_size()), 1)
+static __global__ void mul_mat_vec_q_moe(
+        const void * vx_ptr, const void * vy_ptr, const int32_t * ids_ptr, const ggml_cuda_mm_fusion_args_device fusion,
+        float * dst_ptr,
+        const uint32_t ncols_x, const uint3 nchannels_y, const uint32_t nrows_x,
+        const uint32_t stride_row_x, const uint32_t stride_col_y, const uint32_t stride_col_dst,
+        const uint32_t stride_channel_x, const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
+        const uint32_t ncols_dst, const uint32_t ids_stride) {
+    const void    * GGML_CUDA_RESTRICT vx  = vx_ptr;
+    const void    * GGML_CUDA_RESTRICT vy  = vy_ptr;
+    const int32_t * GGML_CUDA_RESTRICT ids = ids_ptr;
+    float         * GGML_CUDA_RESTRICT dst = dst_ptr;
+
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    // fuse gate, bias, scales, and glu_op into the up projection
+    bool use_gate = false;
+    const void  * vgate      = nullptr;
+    const float * x_bias     = nullptr;
+    const float * gate_bias  = nullptr;
+    const float * x_scale    = nullptr;
+    const float * gate_scale = nullptr;
+    ggml_glu_op   active_glu = GGML_GLU_OP_SWIGLU;
+    float         glu_limit  = 0.0f;
+
+    if constexpr (has_fusion) {
+        use_gate   = fusion.gate != nullptr;
+        vgate      = fusion.gate;
+        x_bias     = (const float *) fusion.x_bias;
+        gate_bias  = (const float *) fusion.gate_bias;
+        active_glu = fusion.glu_op;
+        glu_limit  = fusion.glu_limit;
+        if constexpr (type == GGML_TYPE_NVFP4) {
+            x_scale    = (const float *) fusion.x_scale;
+            gate_scale = (const float *) fusion.gate_scale;
+        }
+    }
+
+    const uint32_t token_idx   = threadIdx.y;
+    const int      row0        = c_rows_per_block*blockIdx.x;
+    const int      blocks_per_row_x = ncols_x / qk;
+    constexpr int  blocks_per_iter  = vdr * warp_size / qi;
+
+    const uint32_t channel_dst = blockIdx.y;
+
+    if (token_idx >= ncols_dst) {
+        return;
+    }
+
+    ggml_cuda_pdl_sync();
+    const uint32_t channel_x = ids[channel_dst + token_idx * ids_stride];
+    const uint32_t channel_y = fastmodulo(channel_dst, nchannels_y);
+
+    const block_q8_1 * y = ((const block_q8_1 *) vy) + channel_y*stride_channel_y + token_idx*stride_col_y;
+    const int kbx_offset  = channel_x*stride_channel_x + row0*stride_row_x;
+
+    // partial sum for each thread
+    float tmp[c_rows_per_block] = {0.0f};
+    float tmp_gate[c_rows_per_block] = {0.0f};
+
+    for (int kbx = threadIdx.x / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (threadIdx.x % (qi/vdr));
+
+#pragma unroll
+        for (int i = 0; i < c_rows_per_block; ++i) {
+            tmp[i] += vec_dot_q_cuda(vx, &y[kby], kbx_offset + i*stride_row_x + kbx, kqs);
+            if constexpr (has_fusion) {
+                if (use_gate) {
+                    tmp_gate[i] += vec_dot_q_cuda(vgate, &y[kby], kbx_offset + i*stride_row_x + kbx, kqs);
+                }
+            }
+        }
+    }
+
+    ggml_cuda_pdl_lc();
+
+    // Warp-level reduction only - no shared memory needed
+#pragma unroll
+    for (int i = 0; i < c_rows_per_block; ++i) {
+        tmp[i] = warp_reduce_sum<warp_size>(tmp[i]);
+        if constexpr (has_fusion) {
+            if (use_gate) {
+                tmp_gate[i] = warp_reduce_sum<warp_size>(tmp_gate[i]);
+            }
+        }
+    }
+
+    // Write results
+    if (threadIdx.x < c_rows_per_block && (c_rows_per_block == 1 || uint32_t(row0 + threadIdx.x) < nrows_x)) {
+        float result = tmp[threadIdx.x];
+        if constexpr (has_fusion) {
+            const uint32_t bias_idx = channel_x*stride_channel_dst + row0 + threadIdx.x;
+
+            if constexpr (type == GGML_TYPE_NVFP4) {
+                if (x_scale) {
+                    result *= x_scale[channel_x];
+                }
+            }
+            if (x_bias) {
