 // prime number used for LCG hash function (32 bit), it is near (sqrt(5) - 1)/2 * 2^32.
 #define LCG_FACTOR 2654435761UL
 
@@ -112,6 +120,102 @@ llama_tokens common_ngram_simple_draft(
 }
 
 
+// [OPUS-NGRB] variant of common_ngram_simple_draft: same key, same most-recent-first scan, but
+//   - with n_cand > 1 a match without room for a draft of at least size_ngram tokens is skipped (with n_cand = 1 the original
+//     behaviour is kept: the first match decides, empty draft if it has no room),
+//   - up to n_cand usable matches are compared and the longest common suffix wins (ties: the most recent),
+//   - the length of that suffix is reported, so the caller can size the draft.
+llama_tokens common_ngram_simple_draft_ext(
+        const common_ngram_simple_config & config,
+        const llama_tokens & tokens, llama_token sampled,
+        int n_cand, size_t * suffix_len) {
+    if (suffix_len) {
+        *suffix_len = 0;
+    }
+
+    const size_t cur_len = tokens.size();
+
+    const size_t n_draft_min = config.size_ngram;
+    const size_t n_draft_max = config.size_mgram;
+
+    llama_tokens draft_tokens;
+
+    if (cur_len <= static_cast<size_t>(n_draft_min + n_draft_max + 1)) {
+        return draft_tokens;
+    }
+
+    llama_tokens pattern;
+    pattern.reserve(n_draft_min);
+    for (size_t j = cur_len - n_draft_min + 1; j < cur_len; ++j) {
+        pattern.push_back(tokens[j]);
+    }
+    pattern.push_back(sampled);
+
+    const size_t ext_cap = 48; // backward extension of the common suffix beyond the key
+
+    size_t best_pos = 0;
+    size_t best_len = 0;
+    int    n_found  = 0;
+
+    for (size_t j = cur_len - n_draft_min - 1; j > 0; --j) {
+        bool match = true;
+        for (size_t k = 0; k < pattern.size(); ++k) {
+            if (tokens[j + k] != pattern[k]) {
+                match = false;
+                break;
+            }
+        }
+        if (!match) {
+            continue;
+        }
+
+        // room after the match for a draft of at least size_ngram tokens: with n_cand = 1 the original behaviour (stop at the
+        // first match, empty draft if it has no room), with n_cand > 1 such a match is skipped for an older one
+        if (std::min(n_draft_max, cur_len - (j + n_draft_min)) < n_draft_min) {
+            if (n_cand <= 1) {
+                return draft_tokens;
+            }
+            continue;
+        }
+
+        // common suffix: tokens[j-1-e] against tokens[cur_len-n_draft_min-e], going back from the key
+        size_t ext = 0;
+        while (ext < ext_cap && j >= ext + 1 && tokens[j - 1 - ext] == tokens[cur_len - n_draft_min - ext]) {
+            ext++;
+        }
+        const size_t len = n_draft_min + ext;
+
+        if (len > best_len) {
+            best_len = len;
+            best_pos = j;
+        }
+
+        if (++n_found >= n_cand) {
+            break;
+        }
+    }
+
+    if (best_pos == 0) {
+        return draft_tokens;
+    }
+
+    const size_t copy_max = std::min(
+            n_draft_max,
+            cur_len - (best_pos + n_draft_min)
+            );
+
+    draft_tokens.reserve(copy_max);
+    for (size_t j = 0; j < copy_max; ++j) {
+        draft_tokens.push_back(tokens[best_pos + n_draft_min + j]);
+    }
+
+    if (suffix_len) {
+        *suffix_len = best_len;
+    }
+    return draft_tokens;
+}
+
+
