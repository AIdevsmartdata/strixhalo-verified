diff --git a/common/s12-audit.h b/common/s12-audit.h
new file mode 100644
index 0000000000000000000000000000000000000000..17b6a94c6472dc04328a287eb5e9f42b3a28e4c6
--- /dev/null
+++ b/common/s12-audit.h
@@ -0,0 +1,65 @@
+#pragma once
+// Private observation only. No RNG draws and no changes to candidate arrays.
+#include "llama.h"
+#include "leviathan.h"
+#include <cstdio>
+#include <cstdlib>
+#include <stdexcept>
+#include <string>
+namespace s12_audit {
+inline FILE * open_file(const char * suffix) {
+    const char * prefix = std::getenv("LLAMA_OPUS_S12_AUDIT_FILE");
+    if (!prefix || prefix[0] != '/') { throw std::runtime_error("S12 absolute audit file required"); }
+    FILE * f = std::fopen((std::string(prefix)+suffix).c_str(), "wbx");
+    if (!f) { throw std::runtime_error("S12 audit file exists or cannot be created"); }
+    return f;
+}
+inline void grammar(bool present, bool lazy) {
+    static FILE * f = open_file(".grammar.jsonl");
+    if (std::fprintf(f,"{\"present\":%s,\"lazy\":%s}\n",present?"true":"false",lazy?"true":"false")<0 || std::fflush(f)) {
+        throw std::runtime_error("S12 grammar audit write failed");
+    }
+}
+inline void logits(llama_context * ctx, int idx, uint64_t position) {
+    // The public getter prefers backend-ranked candidates over vocabulary-indexed logits.
+    // Never read n_vocab floats from that compact allocation, or label it as a target row.
+    if (llama_get_sampled_logits_ith(ctx, idx) != nullptr) { return; }
+    static FILE * f = open_file(".logits.bin");
+    const int32_t n = llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx)));
+    const uint32_t role = n == 248320 ? 0 : n == 69632 ? 1 : 2;
+    const float * p = llama_get_logits_ith(ctx, idx);
+    if (!p || role == 2 || std::fwrite("S12C", 1, 4, f) != 4 ||
+            std::fwrite(&n, sizeof(n), 1, f) != 1 || std::fwrite(&role, sizeof(role), 1, f) != 1 ||
+            std::fwrite(&position, sizeof(position), 1, f) != 1 ||
+            std::fwrite(p, sizeof(float), n, f) != size_t(n) || std::fflush(f)) {
+        throw std::runtime_error("S12 logits write failed");
+    }
+}
+inline FILE * events() {
+    static FILE * f = open_file(".pq.jsonl");
+    return f;
+}
+inline size_t & cycle_id() { static size_t id = 0; return id; }
+inline void cycle(const std::vector<common_leviathan::proposal> & q, size_t n) {
+    FILE * f = events();
+    std::fprintf(f, "{\"kind\":\"cycle\",\"cycle_id\":%zu,\"sources\":[", ++cycle_id());
+    for (size_t i = 0; i < n; ++i) { std::fprintf(f, "%s\"%s\"", i ? "," : "", q[i].s12_copy ? "copy" : "mtp"); }
+    if (std::fprintf(f, "]}\n") < 0 || std::fflush(f)) { throw std::runtime_error("S12 cycle write failed"); }
+}
+inline void restore(bool leviathan_cycle) {
+    FILE * f = events();
+    if (std::fprintf(f,"{\"kind\":\"restore\",\"leviathan_cycle\":%s}\n",leviathan_cycle?"true":"false")<0 || std::fflush(f)) {
+        throw std::runtime_error("S12 restore audit write failed");
+    }
+}
+inline void distribution(const std::vector<common_leviathan::weight> & p, const common_leviathan::proposal & q, int32_t result, size_t position, bool accepted) {
+    FILE * f = events();
+    std::fprintf(f, "{\"kind\":\"verify\",\"cycle_id\":%zu,\"position\":%zu,\"source\":\"%s\",\"accepted\":%s,\"p\":[", cycle_id(), position, q.s12_copy ? "copy" : "mtp", accepted ? "true" : "false");
+    for (size_t i=0;i<p.size();++i) { std::fprintf(f,"%s[%d,%.17g]",i?",":"",p[i].id,p[i].p); }
+    std::fprintf(f,"],\"q\":[");
+    for (size_t i=0;i<q.masses.size();++i) { std::fprintf(f,"%s[%d,%u]",i?",":"",q.masses[i].id,q.masses[i].n); }
+    if (std::fprintf(f,"],\"proposal\":%d,\"result\":%d}\n",q.token,result)<0 || std::fflush(f)) {
+        throw std::runtime_error("S12 distribution write failed");
+    }
+}
