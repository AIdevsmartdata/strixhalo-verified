+// [TAG_FA_TUNING] debug: print the selected FA code path + tuning params for a given shape.
+// Usage: GGML_VK_DEBUG_FA_TUNING=1 (prints one line per distinct shape, from the dispatch side).
+static vk_fa_tuning_params get_fa_tuning_params_dbg(const vk_device& device, uint32_t hsk, uint32_t hsv, uint32_t n_rows, uint32_t n_kv, ggml_type k_type, ggml_type v_type, bool f32acc) {
+    vk_fa_tuning_params params = get_fa_tuning_params(device, hsk, hsv, n_rows, n_kv, k_type, v_type, f32acc);
+    // [TAG_FA_TUNING] experiment knobs (no rebuild): GGML_VK_FA_FORCE=scalar|cm1 re-selects the
+    // code path; GGML_VK_FA_TUNING="Br,Bc,wg,rs" overrides block/workgroup parameters.
+    static const char * force = getenv("GGML_VK_FA_FORCE");
+    static const char * ovr_s = getenv("GGML_VK_FA_TUNING");
+    // Overrides gated to the prefill regime (n_rows >= 128): decode/MTP calls (N <= 8)
+    // must keep their upstream-tuned small-N parameters.
+    if ((force || ovr_s) && n_rows >= 128) {
+        if (force) {
+            if (strcmp(force, "scalar") == 0) {
+                params = get_fa_tuning_params_scalar(device, hsk, hsv, n_rows, n_kv, k_type, v_type, f32acc);
+            } else if (strcmp(force, "cm1") == 0) {
+                params = get_fa_tuning_params_coopmat1(device, hsk, hsv, n_rows, n_kv, k_type, v_type, f32acc);
+            }
+        }
+        if (ovr_s) {
+            uint32_t Br = 0, Bc = 0, wg = 0, rs = 0, sub = 0;
+            int nf = sscanf(ovr_s, "%u,%u,%u,%u,%u", &Br, &Bc, &wg, &rs, &sub);
+            if (nf >= 4 && Br > 0 && Bc > 0 && wg > 0 && rs > 0) {
+                params.block_rows = Br;
+                params.block_cols = Bc;
+                params.workgroup_size = wg;
+                params.row_split = rs;
+                if (nf == 5 && sub > 0) {
+                    params.subgroup_size = sub;
+                }
+            }
+        }
+    }
+    static const bool dbg = getenv("GGML_VK_DEBUG_FA_TUNING") != nullptr;
+    if (dbg) {
+        std::cerr << "[FA_TUNING] hsk=" << hsk << " hsv=" << hsv << " n_rows=" << n_rows << " n_kv=" << n_kv
+                  << " k=" << ggml_type_name(k_type) << " v=" << ggml_type_name(v_type) << " f32acc=" << f32acc
+                  << " device.coopmat2=" << device->coopmat2 << " coopmat1_fa=" << device->coopmat1_fa_support << " -> ";
+        params.print();
+    }
+    return params;
+}
