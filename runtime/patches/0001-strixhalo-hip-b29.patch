diff --git a/tests/test-evic-policy.cpp b/tests/test-evic-policy.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..40502076c2d9b3f7246eb5c444c28d2d86aad0cc
--- /dev/null
+++ b/tests/test-evic-policy.cpp
@@ -0,0 +1,834 @@
+// EVIC: tests of the RAM prompt cache eviction policy (LLAMA_OPUS_EVIC_DEDUP / LLAMA_OPUS_EVIC_COST). No model, no GPU.
+// Not in CMake. Build by hand against a build tree, for example:
+//   c++ -std=gnu++17 -O1 -I tools/server -I tools/mtmd -I common -I include -I ggml/include -I vendor/nlohmann/.. \
+//       tests/test-evic-policy.cpp -DEVIC_API=1 -L<bin> -lllama-server-impl -lllama-common -lllama -lggml -lggml-base -Wl,-rpath,<bin> -o test-evic-policy
+// Without -DEVIC_API=1 the file uses only the original API (constructor, alloc, states, size, update), so it builds against the headers and
+// library of the ORIGINAL tree (integ7 or the SLOTS snap, where OFF = origin) to make the reference trace.
+//
+// usage:
+//   test-evic-policy              all tests (needs -DEVIC_API=1), exit code = number of failures
+//   test-evic-policy --trace N [--seed S] [--limit MIB] [--limit-tok T] [--env K=V]...
+//                                 N random operations traced on stdout: the same source built against the original and against EVIC must give
+//                                 the same trace byte for byte when no EVIC switch is set, and also with switches set when the cache has room
+//
+// Scale: 1 "vMiB" = 16384 bytes = 1/64 MiB, so a 4096 vMiB limit is 64 MiB in the constructor. States really allocate their bytes (about 70 MiB at most).
+#include "server-task.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+static int n_fail = 0;
+static int n_ok = 0;
+static bool g_verbose = false;
+#define CHECK(cond) do { if (!(cond)) { fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); ++n_fail; } else { ++n_ok; } } while (0)
+#define SECTION(name) fprintf(stderr, "---- %s\n", name)
+
+static constexpr size_t VMIB = 16384;                 // 1/64 MiB
+static size_t vm(double x) { return (size_t) (x * VMIB); }
+
+static const char * EVIC_VARS[] = {
+    "LLAMA_OPUS_EVIC_DEDUP", "LLAMA_OPUS_EVIC_COST", "LLAMA_OPUS_EVIC_DEDUP_PCT", "LLAMA_OPUS_EVIC_DEDUP_MIN_TOK",
+    "LLAMA_OPUS_EVIC_DEDUP_MAX", "LLAMA_OPUS_EVIC_PROT_S", "LLAMA_OPUS_EVIC_PROT_PCT", "LLAMA_OPUS_EVIC_HALF_S", "LLAMA_OPUS_EVIC_ADMIT",
+};
+
+static void env_clear() { for (const char * v : EVIC_VARS) unsetenv(v); }
+// "A=1,B=2" -> setenv
+static void env_set(const std::string & spec) {
+    env_clear();
+    size_t i = 0;
+    while (i < spec.size()) {
+        size_t j = spec.find(',', i);
+        if (j == std::string::npos) j = spec.size();
+        const std::string kv = spec.substr(i, j - i);
+        const size_t e = kv.find('=');
+        if (e != std::string::npos) setenv(("LLAMA_OPUS_EVIC_" + kv.substr(0, e)).c_str(), kv.substr(e + 1).c_str(), 1);
+        i = j + 1;
+    }
+}
+
+// ---- synthetic prompts
+static llama_tokens seq(uint32_t hdr_id, size_t hdr_len, uint32_t tail_id, size_t tail_len) {
+    llama_tokens t;
+    t.reserve(hdr_len + tail_len);
+    for (size_t i = 0; i < hdr_len; ++i)  t.push_back((llama_token) ((hdr_id * 7919u + (uint32_t) i * 31u + 5u) % 30000u + 1u));
+    for (size_t i = 0; i < tail_len; ++i) t.push_back((llama_token) ((tail_id * 104729u + (uint32_t) i * 37u + 11u) % 30000u + 1u + 30000u));
+    return t;
+}
+
+struct Entry {
+    server_prompt p;
+    size_t        tgt = 0;        // bytes passed as state_size_tgt
+    size_t        total = 0;      // tgt + checkpoints
+};
+
+// total_vmib: wanted total size (state + checkpoints), ck: checkpoint positions in tokens, ck_vmib: size of each checkpoint
+static Entry mk(const llama_tokens & t, double total_vmib, const std::vector<int64_t> & ck = {}, double ck_vmib = 0.0) {
+    Entry e;
+    e.p.tokens = server_tokens(t, false);
+    for (int64_t pos : ck) {
+        auto & c = e.p.checkpoints.emplace_back();
+        c.n_tokens = pos;
+        c.pos_min  = 0;
+        c.pos_max  = (llama_pos) pos - 1;
+        c.data_tgt.assign(vm(ck_vmib), (uint8_t) 7);
+    }
+    const size_t total = vm(total_vmib);
+    const size_t ckb   = ck.size() * vm(ck_vmib);
+    e.tgt   = total > ckb ? total - ckb : 0;
+    e.total = e.tgt + ckb;
+    return e;
+}
+
+static server_prompt_cache_state * save(server_prompt_cache & c, const Entry & e) { return c.alloc(e.p, e.tgt, 0); }
+
+// what server_prompt_cache::load() picks (without contexts): best lcp with f_keep >= 0.25; returns the token count of the entry taken out, 0 = none
+static int take_best(server_prompt_cache & c, const llama_tokens & req_t) {
+    server_tokens req(req_t, false);
+    auto best = c.states.end();
+    float f_keep_best = -1.0f, f_sim_best = 0.0f;
+    for (auto it = c.states.begin(); it != c.states.end(); ++it) {
+        const int lcp = (int) it->prompt.tokens.get_common_prefix(req);
+        const float f_keep = float(lcp) / it->prompt.tokens.size();
+        const float f_sim  = float(lcp) / req.size();
+        if (f_keep < 0.25f) continue;
+        if (f_keep_best < f_keep && f_sim_best < f_sim) { f_keep_best = f_keep; f_sim_best = f_sim; best = it; }
+    }
+    if (best == c.states.end()) return 0;
+    const int n = (int) best->prompt.tokens.size();
+    c.states.erase(best);
+    return n;
+}
+
+static bool has_prompt(const server_prompt_cache & c, const llama_tokens & t) {
+    server_tokens q(t, false);
+    for (const auto & s : c.states) {
+        if (s.prompt.tokens.size() == q.size() && s.prompt.tokens.get_common_prefix(q) == q.size()) return true;
+    }
+    return false;
+}
+
+static size_t sum_size(const server_prompt_cache & c) { size_t r = 0; for (const auto & s : c.states) r += s.size(); return r; }
+
+#ifdef EVIC_API
+static server_prompt_cache * mkcache(int limit_mib, size_t limit_tok, const char * spec) {
+    env_set(spec);
+    auto * c = new server_prompt_cache(limit_mib, limit_tok);
+    c->evic_clock_ms = 1000000;
+    return c;
+}
+#define NOW(c, s) (c).evic_clock_ms = 1000000 + (int64_t) (s) * 1000
+#endif
+
+// ---- SLOTS scenario: sequence of the R pass log (cache 4096 MiB), sizes from gufo_36_A6zz_SLOTS_1g_R/srv.log (MiB, here scaled to vMiB)
+//   short 346.4 / 348.7 / 348.5 / 348.7; M 2448.6 (57971 tokens); A1 984.6 (14723); A2 979.4 (13810); M3 2359.8 (58802); A3 2152.6 (46845); A4 about as A3 (46517)
+// ORDER OF THE REAL SERVER (server-context.cpp): at every launch get_available_slot() first TAKES from the cache (prompt_load: the best entry
+// for the new prompt, which is erased), then, after launch_slot_with_task(), every idle slot is SAVED and cleared (cache_idle_slots + kv_unified).
+// So the state of a finished request enters the cache at the NEXT launch, and M3/M4 find the cache as it was BEFORE the save of the slot that
+// just finished (A2 for M3, A4 for M4). Times (s) are those of the log (H.MM.SS of the R pass, from its start).
+#ifdef EVIC_API
+struct Replay {
+    bool m3_hit = false, m4_hit = false, m_alive_after_a1 = false, m_alive_after_a2 = false;
+    size_t peak = 0;
+    int n_removed_m = 0;
+    int n_dedup = 0, n_cost = 0, n_protect = 0, n_reject = 0;
+};
+
+static Replay replay_slots(const char * spec, int limit_mib) {
+    Replay r;
+    auto * c = mkcache(limit_mib, 131072, spec);
+    const size_t lim = c->limit_size;
+    // M and A1 share a 2800 token system header, the others have their own
+    const llama_tokens sh[5] = { seq(1, 400, 101, 0), seq(2, 400, 102, 0), seq(3, 400, 103, 0), seq(4, 400, 104, 0), seq(5, 400, 105, 0) };
+    Entry s1 = mk(sh[0], 346.393), s2 = mk(sh[1], 348.714), s3 = mk(sh[2], 348.542), s4 = mk(sh[3], 348.742);
+    llama_tokens tM = seq(9, 2800, 21, 55171);                         // 57971 tokens
+    Entry M  = mk(tM, 2448.553, {2048, 10240, 18432, 26624, 34816, 43008, 51200, 57971}, 113.0);
+    llama_tokens tD0 = seq(31, 380, 131, 7), tD1 = seq(32, 380, 132, 7), tD2 = seq(33, 380, 133, 7);
+    Entry d0 = mk(tD0, 348.799), d1 = mk(tD1, 348.742), d2 = mk(tD2, 348.771);
+    llama_tokens tA1 = seq(9, 2800, 22, 11923);                        // same header as M, 14723 tokens
+    Entry A1 = mk(tA1, 984.590, {2048, 8192, 14723}, 113.0);
+    llama_tokens tA2 = seq(41, 2800, 23, 11010);                       // other header, 13810 tokens
+    Entry A2 = mk(tA2, 979.406, {2048, 8192, 13810}, 113.0);
+    llama_tokens tA3 = seq(51, 2800, 24, 44045);                       // 46845 tokens
+    Entry A3 = mk(tA3, 2152.597, {2048, 10240, 18432, 26624, 34816, 43008, 46845}, 113.0);
+    llama_tokens tA4 = seq(61, 2800, 25, 43717);                       // 46517 tokens
+    Entry A4 = mk(tA4, 2150.0, {2048, 10240, 18432, 26624, 34816, 43008, 46517}, 113.0);
+    llama_tokens tM3 = seq(9, 2800, 21, 55171 + 831);                  // M + 831 tokens = 58802 (request M3 extends M)
+    llama_tokens tM4 = seq(9, 2800, 21, 55171 + 831 + 852);            // 59654 (M4)
+
+    const char * step = "";
+    auto touch = [&]() {
+        r.peak = std::max(r.peak, c->size()); CHECK(c->size() <= lim); CHECK(sum_size(*c) == c->size());
+        if (g_verbose) {
+            printf("%-14s cache %7.1f vMiB:", step, (double) c->size() / VMIB);
+            for (const auto & st : c->states) printf(" %d(%.0f)", st.prompt.n_tokens(), (double) st.size() / VMIB);
+            printf("\n");
+        }
+    };
+    // warm-up and D0 (launches of d0_0, d0_1, d0_2, M1): the state of the previous request is saved at each launch
+    NOW(*c, 73);  step = "save warm";  save(*c, s1); c->update(); touch();
+    NOW(*c, 76);  step = "save d0_0";  save(*c, s2); c->update(); touch();
+    NOW(*c, 79);  step = "save d0_1";  save(*c, s3); c->update(); touch();
+    NOW(*c, 82);  step = "save d0_2";  save(*c, s4); c->update(); touch();
+    // launch of d1_0: M (idle since M2) is saved
+    NOW(*c, 124); step = "save M";     save(*c, M);  c->update(); touch();
+    // launches of d1_1, d1_2, A1_t1: the D1 shorts are saved
+    NOW(*c, 127); step = "save d1_0";  save(*c, d0); c->update(); touch();
+    NOW(*c, 130); step = "save d1_1";  save(*c, d1); c->update(); touch();
+    NOW(*c, 133); step = "save d1_2";  save(*c, d2); c->update(); touch();
+    // launch of A2_t1: A1 is saved (log: removing 348.742 then 2448.553 = M)
+    NOW(*c, 145); step = "save A1";    save(*c, A1); c->update(); touch();
+    r.m_alive_after_a1 = has_prompt(*c, tM);
+    // launch of M3: FIRST the cache gives M back if it is still there, THEN A2 (idle) is saved
+    NOW(*c, 157);
+    const int got3 = take_best(*c, tM3);
+    r.m3_hit = got3 == 57971;
+    if (g_verbose) printf("M3 request     -> %s (%d tokens restored)\n", r.m3_hit ? "HIT" : "MISS (full prefill)", got3);
+    r.m_alive_after_a2 = r.m3_hit;                                      // (M leaves the cache when taken)
+    step = "save A2";   save(*c, A2); c->update(); touch();
+    // launch of A3_t1: M3 (58802 tokens after its answer) is saved
+    Entry M3 = mk(tM3, 2359.785, {2048, 10240, 18432, 26624, 34816, 43008, 51200, 58802}, 113.0);
+    NOW(*c, 197); step = "save M3";    save(*c, M3); c->update(); touch();
+    // launch of A4_t1: A3 is saved (log: removing 979.406 then 2359.785 = M3)
+    NOW(*c, 231); step = "save A3";    save(*c, A3); c->update(); touch();
+    // launch of M4: FIRST the cache gives M3 back, THEN A4 is saved (log: removing 2152.597 = A3)
+    NOW(*c, 265);
+    const int got4 = take_best(*c, tM4);
+    r.m4_hit = got4 == 58802;
+    if (g_verbose) printf("M4 request     -> %s (%d tokens restored)\n", r.m4_hit ? "HIT" : "MISS (full prefill)", got4);
+    step = "save A4";   save(*c, A4); c->update(); touch();
+    r.n_dedup = c->evic_n_dedup; r.n_cost = c->evic_n_cost; r.n_protect = c->evic_n_protect; r.n_reject = c->evic_n_reject;
+    delete c;
+    env_clear();
+    return r;
+}
+#endif
+
+// ---- differential: random trace (original API only)
+static void run_trace(int n_ops, unsigned seed, int limit_mib, size_t limit_tok) {
+    server_prompt_cache c(limit_mib, limit_tok);
+    std::mt19937_64 rng(seed);
+    // small universe of prompts: 6 headers, tails of varied length, extensions of prompts already seen
+    std::vector<llama_tokens> seen;
+    auto dump = [&](const char * what, int op) {
+        printf("%d %s n=%zu size=%zu ntok=%zu |", op, what, c.states.size(), c.size(), c.n_tokens());
+        for (const auto & s : c.states) printf(" %zu:%zu:%zu", s.prompt.tokens.size(), s.size(), s.prompt.checkpoints.size());
+        printf("\n");
+    };
+    for (int op = 0; op < n_ops; ++op) {
+        const unsigned k = (unsigned) (rng() % 10);
+        if (k < 6) {                                             // alloc
+            llama_tokens t;
+            if (!seen.empty() && rng() % 4 == 0) {               // extend or cut a prompt seen before
+                t = seen[rng() % seen.size()];
+                if (rng() % 2) { const auto extra = seq(1 + (unsigned) (rng() % 6), 0, (unsigned) (rng() % 50), 50 + rng() % 400); t.insert(t.end(), extra.begin(), extra.end()); }
+                else t.resize(std::max<size_t>(1, t.size() - rng() % (t.size() / 3 + 1)));
+            } else {
+                t = seq(1 + (unsigned) (rng() % 6), 200 + rng() % 3000, (unsigned) (rng() % 1000), 20 + rng() % 4000);
+            }
+            std::vector<int64_t> ck;
+            for (int64_t pos = 512; pos < (int64_t) t.size(); pos += 1024 + (int64_t) (rng() % 1024)) if (rng() % 2) ck.push_back(pos);
+            Entry e = mk(t, (double) (50 + rng() % 900), ck, 5.0 + (double) (rng() % 20));
+            auto * r = save(c, e);
+            if (r) seen.push_back(t);
+            dump(r ? "alloc+" : "alloc-", op);
+        } else if (k < 8) {                                      // simulated load: takes one entry out
+            if (!c.states.empty()) {
+                auto it = c.states.begin();
+                std::advance(it, (long) (rng() % c.states.size()));
+                const int n = (int) it->prompt.tokens.size();
+                c.states.erase(it);
+                printf("%d take %d\n", op, n);
+            }
+        } else {
+            c.update();
+            dump("update", op);
+        }
+    }
+    dump("end", n_ops);
+}
+
+// ---- tests
+#ifdef EVIC_API
+static void test_env() {
+    SECTION("environment: unset or 0 = origin, settings are clamped");
