+            d[P_GAP_TASKS] = g0_ns[GOC_TASK_MAIN] - tm_prev_end;
+        }
+        d[P_SELF] = last_end_cost + (now() - t0);   // bornes : enregistrement du tour precedent + ce debut de tour
