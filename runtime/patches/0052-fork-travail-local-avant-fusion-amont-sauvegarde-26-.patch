+// Runtime activation marker for the MoE gate/up/SwiGLU 101 fusion. UINT64_MAX means the backend
+// does not expose the counter, so the replay cannot prove the fused kernel ran.
+static bool backend_is_vulkan(ggml_backend_t backend) {
+    ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+    if (dev == nullptr) {
+        return false;
+    }
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    return reg != nullptr && strcmp(ggml_backend_reg_name(reg), "Vulkan") == 0;
+}
+
+static uint64_t backend_moe_gate_up_101_dispatch_count(ggml_backend_t backend) {
+    if (!backend_is_vulkan(backend)) {
+        return UINT64_MAX;
+    }
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend));
+    auto get_count = (uint64_t (*)()) ggml_backend_reg_get_proc_address(reg, "ggml_backend_vk_moe_gate_up_101_dispatch_count");
+    return get_count == nullptr ? UINT64_MAX : get_count();
+}
+
+static bool moe_replay_fusion_enabled() {
+    const char * value = getenv("GGML_VK_MOE_GATE_UP_101");
