+        const float * g = gamma + (int64_t) c * n_embd;
+#pragma unroll
+        for (int k = 0; k < KP; ++k) {
+            const int col = (tid + k * HC_CN_BLOCK2) * 2;
+            if (col + 1 < n_embd) {
+                const float2 gv = *(const float2 *)(g + col);
+                float v0[2], v1[2];
+#pragma unroll
+                for (int q = 0; q < 2; ++q) {
+                    const int64_t row = (int64_t) (t0 + q) * hc + c;
