+static bool opus_moevec_check_decide(cudaStream_t stream) {
+    const int every = GGML_OPUS_INT("GGML_OPUS_MOEVEC_CHECK", 0);
+    if (every <= 0) {
+        return false;
+    }
+    cudaStreamCaptureStatus capture = cudaStreamCaptureStatusNone;
+    if (cudaStreamIsCapturing(stream, &capture) != cudaSuccess || capture != cudaStreamCaptureStatusNone) {
+        (void) cudaGetLastError();
+        static std::atomic<int> dit{0};
+        if (dit.exchange(1) == 0) {
+            fprintf(stderr, "[OPUS-MOEVEC-CHECK-SAUTE] flux en capture de graphe : controle saute\n");
+        }
+        return false;
+    }
+    opus_moevec_chk_state & S = opus_moevec_chk();
+    std::lock_guard<std::mutex> lk(S.mu);
+    const uint64_t c = S.calls++;
+    return c % uint64_t(every) == 0;
+}
