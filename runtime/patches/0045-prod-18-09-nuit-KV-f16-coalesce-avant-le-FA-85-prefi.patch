index 00000000000..20ef28132c3
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/fa_kv_contig_f16.comp
@@ -0,0 +1,44 @@
+#version 450
+
+// [TAG_FA_F16_CONTIG] Coalesce the f16 KV cache before the coopmat1 flash attention.
+//
+// The KV cache stores heads interleaved per token: for K, ne = [HS, KV, NH, NS] with
+// nb[1] = HS * NH * 2 bytes. Stepping one KV position for a fixed head therefore jumps
+// HS * NH * 2 bytes (1 KB for HS=256, NH=2) instead of HS * 2 (512 B), so every tile the
+// FA walks touches 4x more cache lines than it uses. On Strix Halo's unified LPDDR5X the
+// measured cost of that gap is a 3.2x bandwidth tax (sequential 73 GB/s, 256 B chunks
+// back-to-back 70 GB/s, the same chunks at 1 KB stride 22 GB/s), which is why the f16 KV
+// prefill lands ~35% below the q8_0 one (which never paid it: its dequant scratch already
+// writes per-head-contiguous rows).
+//
+// This shader is the f16 counterpart of the q8_0 dequant+transpose path: a pure copy that
+// reorders [HS, NH, KV, NS] into [HS, KV, NH, NS]. Values are bit-identical (no arithmetic),
+// so the FA result must be unchanged. Prefill only (the caller gates on n_tokens >= 64).
+//
+// Push constants (shared with the dequant shaders): M = HS, K = NH, stride_a = KV, nel = count.
+
+#include "dequant_head.glsl"
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly  buffer A {float16_t data_a[];};
+layout (binding = 1) writeonly buffer D {float16_t data_b[];};
+
+void main() {
+    const uint HS  = p.M;
+    const uint NH  = p.K;
+    const uint KVn = p.stride_a;
+    const uint n   = p.nel;
+
+    // grid-stride: the element count (HS*KV*NH) exceeds the max workgroup count at depth
+    const uint step = gl_WorkGroupSize.x * gl_NumWorkGroups.x;
+
+    for (uint e = gl_GlobalInvocationID.x; e < n; e += step) {
+        const uint hs = e % HS;
+        const uint nh = (e / HS) % NH;
+        const uint kv = (e / (HS * NH)) % KVn;
+        const uint ns = e / (HS * NH * KVn);
+
+        data_b[hs + HS * kv + HS * KVn * nh + HS * KVn * NH * ns] = data_a[e];
+    }
+}
