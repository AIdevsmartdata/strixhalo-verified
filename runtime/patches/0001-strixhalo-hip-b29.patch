+// [OPUS-NMXD] (23/10/2026, GAINS3/DPNMA et DPROD22C) Plafond de brouillon pilote par la profondeur.
+// Mesure : n-max 3 FIXE = +13,1 % a 8K de profondeur mais -2,6 % a 32K et -10,3 % a profondeur 0 ; le controleur
+// adaptatif du fork (--spec-draft-adaptive, EMA d'acceptation) perd 16 % a 0 et 10 % a 20K : il ne voit pas la
+// profondeur. Ici le plafond depend directement de pos0 (jetons deja dans la sequence au pas courant) :
+//     LLAMA_OPUS_NMXD="lo:hi:n_hi:n_lo"   (ex. "4096:12288:3:2")
+// Absent, vide ou mal forme : aucun effet, comportement d'origine (le plafond reste params.n_max).
+// Lu UNE fois au premier appel (pas de relecture a chaud : le lot se mesure sur des valeurs figees).
+static int32_t opus_nmxd_cap(int64_t pos0, int32_t n_cfg) {
+    struct cfg_t { bool on = false; int32_t lo = 0, hi = 0, n_hi = 0, n_lo = 0; };
+    static const cfg_t c = [] {
+        cfg_t r;
+        const char * e = std::getenv("LLAMA_OPUS_NMXD");
+        if (e == nullptr || *e == '\0') {
+            return r;
+        }
+        long long a = 0, b = 0, x = 0, y = 0;
+        if (std::sscanf(e, "%lld:%lld:%lld:%lld", &a, &b, &x, &y) != 4) {
+            return r;
+        }
+        if (b <= a || x <= 0 || y <= 0 || b > (1 << 30)) {
+            return r;
+        }
+        r.on = true;
+        r.lo = (int32_t) a;
+        r.hi = (int32_t) b;
+        r.n_hi = (int32_t) x;
+        r.n_lo = (int32_t) y;
+        return r;
+    }();
+    if (!c.on) {
+        return n_cfg;
+    }
+    const int32_t want = (pos0 >= (int64_t) c.lo && pos0 < (int64_t) c.hi) ? c.n_hi : c.n_lo;
+    return std::min(n_cfg, std::max(1, want));
+}
