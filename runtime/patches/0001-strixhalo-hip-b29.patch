+// ---------------------------------------------------------------------------------------------------------------
+// [OPUS-P1] copie groupee des petites entrees de split hote -> device (appelee par le planificateur ggml, interrupteur
+// GGML_OPUS_P1 cote ggml-backend.cpp). Remplace N x (cudaMemcpyAsync + cudaStreamSynchronize) par :
+//   N memcpy CPU vers un anneau de staging epingle, 1 cudaMemcpyAsync H2D vers un staging device, 1 noyau de dispersion
+//   D2D vers les tenseurs de destination, 1 evenement qui garde la reutilisation de la case. Tout dans le flux de calcul :
+//   l'ordre vis-a-vis du calcul precedent est celui du flux, aucun arret hote. Les octets copies sont identiques.
+#define OPUS_H2D_MAX_ITEMS 64
+#define OPUS_H2D_NSLOT     8
+#define OPUS_H2D_CAP       (256u*1024u)   // octets de donnees par case
+#define OPUS_H2D_MAX_ITEM  (64u*1024u)    // au-dela : chemin d'origine
+
+struct opus_h2d_item {
+    char *       dst;
+    const char * src;
+    int          nbytes;
+    int          pad;
+};
+
+struct opus_h2d_args {
+    opus_h2d_item it[OPUS_H2D_MAX_ITEMS];
+};
+
+static __global__ void k_opus_h2d_scatter(const opus_h2d_args args, const int n) {
+    const int i = blockIdx.y;
+    if (i >= n) {
+        return;
+    }
+    const char * src = args.it[i].src;
+    char       * dst = args.it[i].dst;
+    const int    nb  = args.it[i].nbytes;
+    const int    tid = blockIdx.x*blockDim.x + threadIdx.x;
+    const int    nth = gridDim.x*blockDim.x;
+
+    if ((((uintptr_t) src | (uintptr_t) dst) & 15) == 0) {
+        const int n16 = nb >> 4;
+        for (int k = tid; k < n16; k += nth) {
+            ((uint4 *) dst)[k] = ((const uint4 *) src)[k];
+        }
+        for (int k = (n16 << 4) + tid; k < nb; k += nth) {
+            dst[k] = src[k];
+        }
+    } else {
+        for (int k = tid; k < nb; k += nth) {
+            dst[k] = src[k];
+        }
+    }
+}
+
+struct opus_h2d_state {
+    bool        init   = false;
+    bool        failed = false;
+    char *      host[OPUS_H2D_NSLOT] = {};
+    char *      dev [OPUS_H2D_NSLOT] = {};
+    cudaEvent_t ev  [OPUS_H2D_NSLOT] = {};
+    bool        ev_valid[OPUS_H2D_NSLOT] = {};
+    int         next = 0;
+};
+
+static opus_h2d_state g_opus_h2d[GGML_CUDA_MAX_DEVICES];
+static std::mutex     g_opus_h2d_mutex; // plusieurs contextes (principal + brouillon) peuvent appeler depuis des fils differents
+
+static bool opus_h2d_init(opus_h2d_state & st, int device) {
+    if (st.init) {
+        return !st.failed;
+    }
+    st.init = true;
+    ggml_cuda_set_device(device);
+    for (int s = 0; s < OPUS_H2D_NSLOT; s++) {
+        st.host[s] = (char *) ggml_cuda_host_malloc(OPUS_H2D_CAP);
+        if (st.host[s] == nullptr) { st.failed = true; return false; }
+        if (cudaMalloc((void **) &st.dev[s], OPUS_H2D_CAP) != cudaSuccess) {
+            (void) cudaGetLastError();
+            st.dev[s] = nullptr; st.failed = true; return false;
+        }
+        if (cudaEventCreateWithFlags(&st.ev[s], cudaEventDisableTiming) != cudaSuccess) {
+            (void) cudaGetLastError();
+            st.failed = true; return false;
+        }
+    }
+    return true;
+}
+
+// retourne le nombre de tenseurs copies ; done[i] = 1 pour chaque tenseur traite. 0 = rien fait (chemin d'origine).
+static int ggml_backend_cuda_opus_h2d_batch(ggml_backend_t backend, int n,
+        const ggml_tensor * const * srcs, ggml_tensor * const * dsts, unsigned char * done) {
+    if (!ggml_backend_is_cuda(backend) || n <= 0) {
+        return 0;
+    }
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    const int device = cuda_ctx->device;
+    if (device < 0 || device >= GGML_CUDA_MAX_DEVICES) {
+        return 0;
+    }
+
+    // selection : petites entrees non quantifiees, meme disposition, destination = tampon device de CE backend
+    int    sel[OPUS_H2D_MAX_ITEMS];
+    size_t off[OPUS_H2D_MAX_ITEMS];
+    int    n_sel = 0;
+    size_t total = 0;
+    for (int i = 0; i < n && n_sel < OPUS_H2D_MAX_ITEMS; i++) {
+        const ggml_tensor * src = srcs[i];
+        const ggml_tensor * dst = dsts[i];
+        const size_t nb = ggml_nbytes(dst);
+        if (nb == 0 || nb > OPUS_H2D_MAX_ITEM || nb != ggml_nbytes(src) || !ggml_are_same_layout(src, dst) ||
+                ggml_is_quantized(dst->type) || src->data == nullptr || dst->data == nullptr) {
+            continue;
+        }
+        ggml_backend_buffer_t buf = dst->view_src ? dst->view_src->buffer : dst->buffer;
+        if (buf == nullptr || !ggml_backend_buffer_is_cuda(buf) ||
+                ((ggml_backend_cuda_buffer_context *) buf->context)->device != device) {
+            continue;
+        }
+        const size_t o = (total + 15) & ~(size_t) 15;
+        if (o + nb > OPUS_H2D_CAP) {
+            continue;
+        }
+        sel[n_sel] = i;
+        off[n_sel] = o;
+        total = o + nb;
+        n_sel++;
+    }
+    if (n_sel < 2) {
+        return 0;
