diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
index bded206808c..5636acb4adf 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
@@ -4,6 +4,30 @@
 
 #include "types.glsl"
 
+#ifdef USE_COALESCED_LOADS
+// Raw u32 view of the A buffer: reads become aligned dword transactions shared
+// between adjacent threads (full 64/128-byte cache lines) instead of typed
+// struct loads at 17/18-byte strides that straddle cache lines.
+uint32_t buf_read_u32(uint byte_off) {
+    return data_a_u32[byte_off >> 2u];
+}
+
+int32_t buf_read_i32(uint byte_off) {
+    uint w = byte_off >> 2u;
+    uint shift = (byte_off & 3u) << 3u;
+    if (shift == 0u) {
+        return int32_t(data_a_u32[w]);
+    }
+    return int32_t((data_a_u32[w] >> shift) | (data_a_u32[w + 1u] << (32u - shift)));
+}
+
+uint8_t buf_read_u8(uint byte_off) {
+    uint w = byte_off >> 2u;
+    uint shift = (byte_off & 3u) << 3u;
+    return uint8_t((data_a_u32[w] >> shift) & 0xFFu);
+}
+#endif
+
 #if defined(DATA_A_Q2_0)
 FLOAT_TYPE get_dm(uint ib) {
     return FLOAT_TYPE(data_a[ib / 2].d);
@@ -140,14 +164,25 @@ FLOAT_TYPE mul_q8_1(const int32_t q_sum, const float da, const vec2 dsb, const i
 #if defined(DATA_A_ROCMFP4)
 // dual UE4M3 scales: e[0] covers elements 0-15, e[1] covers 16-31
 FLOAT_TYPEV2 get_dm2(uint ib) {
+#ifdef USE_COALESCED_LOADS
+    const uint base = ib * A_BLOCK_SIZE;
+    return FLOAT_TYPEV2(FLOAT_TYPE(ue4m3_to_fp32(uint8_t(buf_read_u8(base + A_BLOCK_OFFSET_E)))),
+                        FLOAT_TYPE(ue4m3_to_fp32(uint8_t(buf_read_u8(base + A_BLOCK_OFFSET_E + 1u)))));
+#else
     return FLOAT_TYPEV2(ue4m3_to_fp32(data_a[ib].e[0]), ue4m3_to_fp32(data_a[ib].e[1]));
+#endif
 }
 #endif
 
 #if defined(DATA_A_ROCMFP4_FAST)
 FLOAT_TYPEV2 get_dm2(uint ib) {
+#ifdef USE_COALESCED_LOADS
+    const FLOAT_TYPE d = FLOAT_TYPE(ue4m3_to_fp32(uint8_t(buf_read_u8(ib * A_BLOCK_SIZE + A_BLOCK_OFFSET_E))));
+    return FLOAT_TYPEV2(d, d);
+#else
     const FLOAT_TYPE d = FLOAT_TYPE(ue4m3_to_fp32(data_a[ib].e));
     return FLOAT_TYPEV2(d, d);
+#endif
 }
 #endif
 
@@ -155,10 +190,16 @@ FLOAT_TYPEV2 get_dm2(uint ib) {
 // 1-byte quant loads for ROCmFP4 blocks (18 / 17 bytes). Low nibbles are the
 // first half of the block, high nibbles the second half.
 i32vec2 repack(uint ib, uint iqs) {
+#ifdef USE_COALESCED_LOADS
+    // the 16 qs bytes of a block start at an offset that is NOT 4-byte aligned
+    // for odd blocks (17/18-byte stride): gather the 4 bytes via shift/combine
+    const uint32_t qs = uint32_t(buf_read_i32(ib * A_BLOCK_SIZE + A_BLOCK_OFFSET_QS + iqs * 4u));
+#else
     const uint32_t qs = pack32(u8vec4(data_a[ib].qs[iqs * 4    ],
                                       data_a[ib].qs[iqs * 4 + 1],
                                       data_a[ib].qs[iqs * 4 + 2],
                                       data_a[ib].qs[iqs * 4 + 3]));
+#endif
 
     const u8vec4 i_a0 = unpack8( qs       & 0x0F0F0F0F);
     const u8vec4 i_a1 = unpack8((qs >> 4) & 0x0F0F0F0F);
