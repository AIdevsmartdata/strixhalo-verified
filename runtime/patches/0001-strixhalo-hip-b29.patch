+template <int ncols, bool has_gate, int nwarps, int pf>
+__launch_bounds__(nwarps * ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_fq_nc(
+        const void * vx_ptr, const void * vgate_ptr, const float * y_ptr, float * dst_ptr,
+        const int ncols_x, const int nrows_x, const int stride_row_x, const int stride_col_y, const int stride_col_dst,
+        const float y_scale, const float y_bias, const int y_op) {
