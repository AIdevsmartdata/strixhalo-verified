+        bool     alive  = true;   // false after a read error: not used again by this loader
+        double   rate   = 0;      // throughput of one reader (bytes/s, pieces >= 4 MiB), carried from one call to the next
+        double   bytes  = 0;      // cumulative counters, all calls
+        double   busy   = 0;      // seconds spent in pread
+        uint64_t pieces = 0;
+        uint64_t errors = 0;
