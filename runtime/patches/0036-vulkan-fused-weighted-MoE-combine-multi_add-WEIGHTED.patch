+    };
+    std::unordered_map<const ggml_tensor *, vk_moe_weighted_entry> moe_weighted_fused;
+    std::unordered_set<const ggml_tensor *>                       moe_weighted_skip;
+    const vk_moe_weighted_entry * fused_moe_weighted {};   // entry du nœud courant (nullptr = normal)
+
