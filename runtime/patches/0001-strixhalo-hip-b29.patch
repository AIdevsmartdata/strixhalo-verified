+// ---------------------------------------------------------------------------------------------------------
+// OPUS KA-4: wred + shared_gate_mul_add + hc_combine_norm_f32_b256 in one kernel (see hyperconn.cuh).
+// Every expression below is copied from the three kernels it replaces; only the F32 round trip of the
+// reduction and of block_out through memory is removed (a float stored and reloaded is the same float).
+template <int KP, bool FULL>
+static __global__ void __launch_bounds__(HC_CN_BLOCK2, 4) hc_ffn_tail_f32_b256(
+        const float * experts, const float * expert_scale, const float * weights, const int n_used,
+        const float * gate_w, const float * gate_y, const int ncols2, const float * shexp,
+        const float * inject, const float * residual, const float * gamma,
+        float * out_res, float * out_xn, uint16_t * out_xn_bf16, const bool store_xn_f32,
+        const int n_embd, const float s1, const float b1, const float s2, const float b2, const float eps) {
+    __shared__ float s_sum[32];
+    __shared__ float buf_iw[32];
+    __shared__ float gate_s;
+    const int c = blockIdx.x, t = blockIdx.y, hc = gridDim.x;
+    const int tid = threadIdx.x;
+
+    // (1) routed experts: moe_weighted_reduction_f32_v4 per element (same k order, same expression)
+    float sacc[2 * KP];
+    {
+        const uint64_t first_row = (uint64_t) t * n_used;
+        const float first_scale = expert_scale != nullptr ? expert_scale[first_row] : 1.0f;
+        const float w0 = weights[first_row];
+#pragma unroll
+        for (int k = 0; k < KP; ++k) {
+            const int col = (tid + k * HC_CN_BLOCK2) * 2;
+            sacc[2 * k] = 0.0f; sacc[2 * k + 1] = 0.0f;
+            if (FULL || col + 1 < n_embd) {
+                const float2 e0 = *(const float2 *)(experts + first_row * n_embd + col);
+                sacc[2 * k]     = (e0.x * first_scale) * w0;
+                sacc[2 * k + 1] = (e0.y * first_scale) * w0;
+            }
+        }
+        for (int expert = 1; expert < n_used; ++expert) {
+            const uint64_t row = first_row + expert;
+            const float scale = expert_scale != nullptr ? expert_scale[row] : 1.0f;
+            const float w = weights[row];
+#pragma unroll
+            for (int k = 0; k < KP; ++k) {
+                const int col = (tid + k * HC_CN_BLOCK2) * 2;
+                if (FULL || col + 1 < n_embd) {
+                    const float2 e = *(const float2 *)(experts + row * n_embd + col);
+                    sacc[2 * k]     += (e.x * scale) * w;
+                    sacc[2 * k + 1] += (e.y * scale) * w;
+                }
+            }
+        }
+    }
+
+    // (2) shared-expert gate: shared_gate_mul_add_f32 (one block of 256 threads per token)
+    {
+        if (tid < 32) {
+            buf_iw[tid] = 0.0f;
+        }
+        __syncthreads();
+        const float2 * x2 = (const float2 *) gate_w;
+        const float2 * y2 = (const float2 *) (gate_y + (int64_t) t * (2 * (int64_t) ncols2));
+        float sumf = 0.0f;
+        for (int col2 = tid; col2 < ncols2; col2 += 256) {
+            const float2 tmpx = x2[col2];
+            const float2 tmpy = y2[col2];
+            ggml_cuda_mad(sumf, tmpx.x, tmpy.x);
+            ggml_cuda_mad(sumf, tmpx.y, tmpy.y);
+        }
+        sumf = warp_reduce_sum<32>(sumf);
+        buf_iw[tid / 32] = sumf;
+        __syncthreads();
+        if (tid < 32) {
+            sumf = buf_iw[tid];
+            sumf = warp_reduce_sum<32>(sumf);
+            if (tid == 0) {
+                gate_s = 1.0f / (1.0f + expf(-sumf));
+            }
+        }
+        __syncthreads();
+    }
+    const float gate = gate_s;
+
+    // (3) merge: block_out = routed + shexp * gate (rounded product, rounded sum), then (4) the combine row
+    const float x1 = s1 * inject[(int64_t) t * hc + c] + b1;
+    const float x2s = hc_sigmoid(x1);
+    const float w  = s2 * x2s + b2;
+    const int64_t row = (int64_t) t * hc + c;
+    const float * res = residual + row * n_embd;
+    float *       dst = out_res  + row * n_embd;
+    const float * sh  = shexp + (int64_t) t * n_embd;
+    float xs[2 * KP];
+    float tmp = 0.0f;
+#pragma unroll
+    for (int k = 0; k < KP; ++k) {
+        const int col = (tid + k * HC_CN_BLOCK2) * 2;
+        xs[2 * k] = 0.0f; xs[2 * k + 1] = 0.0f;
+        if (FULL || col + 1 < n_embd) {
+            const float2 v = *(const float2 *)(res + col);
+            const float2 a = *(const float2 *)(sh + col);
+            const float m0 = hc_add_rn(sacc[2 * k],     hc_mul_rn(a.x, gate));
+            const float m1 = hc_add_rn(sacc[2 * k + 1], hc_mul_rn(a.y, gate));
+            const float a0 = hc_add_rn(v.x, hc_mul_rn(m0, w));
+            const float a1 = hc_add_rn(v.y, hc_mul_rn(m1, w));
+            *(float2 *)(dst + col) = make_float2(a0, a1);
+            xs[2 * k] = a0; xs[2 * k + 1] = a1;
+            tmp += a0 * a0 + a1 * a1;
+        }
+    }
+    tmp = block_reduce<block_reduce_method::SUM, HC_CN_BLOCK2>(tmp, s_sum);
+    const float mean  = tmp / n_embd;
+    const float scale = rsqrtf(mean + eps);
+    const float * g  = gamma  + (int64_t) c * n_embd;
+    float *       xn = out_xn + row * n_embd;
+    uint16_t *    xh = out_xn_bf16 ? out_xn_bf16 + row * n_embd : nullptr;
+#pragma unroll
+    for (int k = 0; k < KP; ++k) {
+        const int col = (tid + k * HC_CN_BLOCK2) * 2;
+        if (FULL || col + 1 < n_embd) {
+            const float2 gv = *(const float2 *)(g + col);
+            const float v0 = scale * xs[2 * k] * gv.x, v1 = scale * xs[2 * k + 1] * gv.y;
+            if (store_xn_f32) *(float2 *)(xn + col) = make_float2(v0, v1);
+            if (xh) *(uint32_t *)(xh + col) = hc_pack2(v0, v1);
+        }
+    }
+}
