+// OPUS LOAD_DUMP : sums of the 64-bit words of a weight read back from its buffer (same definition as LOADER_CHECK, CHARGEUR)
+static void opus_load_dump_tensor(FILE * f, const ggml_tensor * t) {
+    const size_t nb   = ggml_nbytes(t);
+    const size_t step = 16u * 1024 * 1024;
+    std::vector<uint8_t> buf(std::min(nb, step) + 8);
+    uint64_t s1 = 0, s2 = 0, pos = 0;
+    for (size_t o = 0; o < nb; o += step) {
+        const size_t c = std::min(step, nb - o);
+        std::fill(buf.begin(), buf.end(), 0);
+        ggml_backend_tensor_get(t, buf.data(), o, c);
+        const size_t w = (c + 7) / 8;
+        for (size_t i = 0; i < w; ++i) {
+            uint64_t v;
+            memcpy(&v, buf.data() + 8 * i, sizeof(v));
+            s1 += v;
+            s2 += v * (2 * (pos + i) + 1);
+        }
+        pos += w;
+    }
+    fprintf(f, "%s %zu %016" PRIx64 " %016" PRIx64 "\n", ggml_get_name(t), nb, s1, s2);
+}
