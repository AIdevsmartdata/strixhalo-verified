diff --git a/ggml/include/ggml-opus-cycle.h b/ggml/include/ggml-opus-cycle.h
new file mode 100644
index 0000000000000000000000000000000000000000..19744536862c5deb02c8267b436d5b0a43cd5f98
--- /dev/null
+++ b/ggml/include/ggml-opus-cycle.h
@@ -0,0 +1,63 @@
+#pragma once
+// CYCLESTATS (GAINS2, 14/10/2026) : accumulateurs de chronometrage hote, toujours disponibles, sans allocation, OFF par defaut.
+//
+// Interrupteur : LLAMA_OPUS_CYCLE_STATS (0/absent = OFF ; 1 = resume periodique ; 2 = une ligne par cycle), registre a chaud.
+// OFF : ggml_opus_cycle_level() rend 0 et AUCUN site ne lit l'horloge (un seul chargement atomique relaxe par site).
+// Les compteurs sont CUMULATIFS (jamais remis a zero) : le serveur en prend la difference entre deux instants.
+// Horloge : std::chrono::steady_clock (nanosecondes). Aucune synchronisation GPU ajoutee : les sites chronometrent des attentes qui
+// existent deja (attente de la porte PLEOFF, retour de graph_compute, attente de la file de taches).
+// Cet en-tete n'est inclus que par les fichiers qui chronometrent : il ne touche pas aux noyaux HIP (pas de recompilation .cu).
+
+#include "ggml.h"
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum ggml_opus_cycle_id {
+    GOC_GRAPH_BUILD = 0,   // llama_context::process_ubatch : build_graph (graphe non reutilise)
+    GOC_GRAPH_ALLOC,       // ... ggml_backend_sched_alloc_graph
+    GOC_GRAPH_REUSED,      // ... graphe reutilise (compte seul : ns = 0)
+    GOC_INPUTS,            // ... res->set_inputs (PLE synchrone inclus)
+    GOC_PLE_INPUT,         // llm_graph_input_ple::set_input (index, collecte ou lancement du fil, envoi)
+    GOC_PLE_ASYNC,         // travail du fil PLEOFF=2 (gather + envoi) : hors fil de calcul, en parallele
+    GOC_LAUNCH,            // ... graph_compute (mise en file du graphe sur le GPU)
+    GOC_PLE_WAIT,          // attente de la porte PLEOFF (ggml_opus_gate_release) : le fil de calcul attend le fil PLE
+    GOC_YIELD_TAIL,        // yield_to_queue : attente de la fin de la tache en cours du fil auxiliaire apres le travail
+    GOC_TASK_MAIN,         // process_single_task execute par la boucle principale (hors yield)
+    GOC_TASK_YIELD,        // process_single_task execute par le fil auxiliaire PENDANT un yield (en parallele du calcul)
+    GOC_DRAFT_MTP,         // common_speculative_draft : implementation MTP (toutes les tetes, tous les slots)
+    GOC_DRAFT_NGRAM,       // ... implementation n-gram
+    GOC_DRAFT_OTHER,       // ... autres implementations
+    GOC_MTP_LAUNCH0,       // MTP, tete i (0..3) : llama_process(ctx_dft) (construction du lot de la tete + mise en file)
+    GOC_MTP_LAUNCH1,
+    GOC_MTP_LAUNCH2,
+    GOC_MTP_LAUNCH3,
+    GOC_MTP_SAMPLE0,       // MTP, tete i : echantillonnage des slots (la 1re lecture de logits attend le GPU) + reconstruction du lot
+    GOC_MTP_SAMPLE1,
+    GOC_MTP_SAMPLE2,
+    GOC_MTP_SAMPLE3,
+    GOC_CTX_SYNC,          // (revue) synchronisations GPU internes de llama_context : synchronize() et sched_synchronize de process_ubatch
+    GOC_N
+};
+
+GGML_API int     ggml_opus_cycle_level(void);                       // 0 = OFF, 1, 2
+GGML_API int64_t ggml_opus_cycle_now_ns(void);                      // std::chrono::steady_clock
+GGML_API void    ggml_opus_cycle_acc(int id, int64_t ns);           // ajoute ns et 1 appel au compteur id (atomique relaxe)
+GGML_API void    ggml_opus_cycle_read(int64_t ns[GOC_N], int64_t n[GOC_N]);   // valeurs cumulees
+
+#ifdef __cplusplus
+}
+
+// chronometre de portee : ne lit l'horloge que si la sonde est active
+struct ggml_opus_cycle_scope {
+    int     id;
+    int64_t t0;
+    explicit ggml_opus_cycle_scope(int id_) : id(id_), t0(ggml_opus_cycle_level() ? ggml_opus_cycle_now_ns() : 0) {}
+    ~ggml_opus_cycle_scope() { if (t0) { ggml_opus_cycle_acc(id, ggml_opus_cycle_now_ns() - t0); } }
+    ggml_opus_cycle_scope(const ggml_opus_cycle_scope &) = delete;
+    ggml_opus_cycle_scope & operator=(const ggml_opus_cycle_scope &) = delete;
+};
+#endif
diff --git a/ggml/include/ggml-opus-flags.h b/ggml/include/ggml-opus-flags.h
new file mode 100644
index 0000000000000000000000000000000000000000..9f7d1d74c1cc2f016c53fb62d4009460630bf16f
--- /dev/null
+++ b/ggml/include/ggml-opus-flags.h
@@ -0,0 +1,63 @@
+#pragma once
+// V6CHAUD : registre de commutateurs « a chaud » (leviers OPUS).
+//
+// Chaque interrupteur d'environnement (GGML_OPUS_*, LLAMA_OPUS_*, GGML_CUDA_P_*, ...) est une case atomique int32 d'une table
+// de ggml-base, initialisee depuis l'environnement au premier acces. Les sites de lecture gardent la meme semantique que
+// l'ancien `getenv` : UNSET = variable absente ; sinon la valeur est atoi(texte) (donc « present mais non numerique » = 0).
+//   - flottants (LLAMA_OPUS_SP3...) : stockes en micro-unites (strtof * 1e6) ;
+//   - LLAMA_SPEC_UNIFORM_DRAFT : off/vide -> 0, min -> -1, N -> N.
+// Changer une case par ggml_opus_flag_set() incremente le compteur de generation ; llama_context le compare avant de
+// reutiliser un graphe et, s'il a change, reconstruit le graphe ET re-reserve le planificateur (les decisions de fusion /
+// de decoupage lues par graph_optimize sont alors reprises avec les nouvelles valeurs).
+// Les interrupteurs lus au CHARGEMENT du modele (categorie 'c') sont inscrits mais refuses par ggml_opus_flag_set().
+// Jamais d'effet sans appel a ggml_opus_flag_set() : le registre vide se comporte exactement comme l'ancien getenv.
+
+#include "ggml.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+#include <atomic>
+#include <limits>
+
+#define GGML_OPUS_FLAG_UNSET (std::numeric_limits<int32_t>::min())
+
+// pointeur STABLE vers la case (cree si besoin ; nom inconnu de la table = categorie 'a')
+GGML_API std::atomic<int32_t> * ggml_opus_flag_ptr(const char * name);
+
+// ecrit une valeur brute (GGML_OPUS_FLAG_UNSET = comme variable absente).
+// 0 = ok, -1 = nom inconnu, -2 = interrupteur de chargement (non commutable). Incremente la generation si la valeur change.
+GGML_API int ggml_opus_flag_set(const char * name, int32_t value);
+// idem depuis un texte, interprete selon le genre du commutateur (entier, flottant, off/min/N) ; NULL = UNSET
+GGML_API int ggml_opus_flag_set_str(const char * name, const char * text);
+
+// compteur de generation : change a chaque modification effective
+GGML_API uint64_t ggml_opus_flag_generation(void);
+// vrai si le commutateur a ete modifie par ggml_opus_flag_set depuis le demarrage (et non lu seulement de l'environnement)
+GGML_API bool ggml_opus_flag_touched(const char * name);
+// categorie : 'a' dispatch noyaux, 'b' construction de graphe, 'c' chargement (non commutable), 'd' serveur / speculation ; 0 si inconnu
+GGML_API char ggml_opus_flag_category(const char * name);
+
+// JSON {"NOM": {"v": valeur|null, "cat": "a", "kind": "i"}, ...} ; ecrit au plus `size` octets (NUL compris) et rend la taille
+// necessaire (sans le NUL), comme snprintf. buf == NULL : rend seulement la taille.
+GGML_API size_t ggml_opus_flag_dump(char * buf, size_t size);
+// meme chose, vers stderr (diagnostic)
+GGML_API void ggml_opus_flag_dump_stderr(void);
+
+// ---- aides de lecture aux sites (meme place que l'ancien `static const ... = getenv`) ------------------------------------
+#define GGML_OPUS_PTR(NAME) ([]() -> std::atomic<int32_t> * { static std::atomic<int32_t> * const p_ = ggml_opus_flag_ptr(NAME); return p_; }())
+#define GGML_OPUS_RAW(NAME) (GGML_OPUS_PTR(NAME)->load(std::memory_order_relaxed))
+
+static inline bool    ggml_opus_raw_set (int32_t v)              { return v != GGML_OPUS_FLAG_UNSET; }
+static inline bool    ggml_opus_raw_on  (int32_t v)              { return v != GGML_OPUS_FLAG_UNSET && v != 0; }   // getenv && atoi != 0
+static inline bool    ggml_opus_raw_on1 (int32_t v)              { return v == GGML_OPUS_FLAG_UNSET || v != 0; }   // !getenv || atoi != 0
+static inline int32_t ggml_opus_raw_int (int32_t v, int32_t def) { return v == GGML_OPUS_FLAG_UNSET ? def : v; }  // getenv ? atoi : def
+static inline float   ggml_opus_raw_f   (int32_t v)              { return v == GGML_OPUS_FLAG_UNSET ? 0.0f : (float) ((double) v * 1e-6); }
+
+#define GGML_OPUS_SET(NAME)       ggml_opus_raw_set(GGML_OPUS_RAW(NAME))
+#define GGML_OPUS_ON(NAME)        ggml_opus_raw_on(GGML_OPUS_RAW(NAME))
+#define GGML_OPUS_ON1(NAME)       ggml_opus_raw_on1(GGML_OPUS_RAW(NAME))
+#define GGML_OPUS_INT(NAME, DEF)  ggml_opus_raw_int(GGML_OPUS_RAW(NAME), (DEF))
+#define GGML_OPUS_FLT(NAME)       ggml_opus_raw_f(GGML_OPUS_RAW(NAME))
+#endif // __cplusplus
diff --git a/ggml/include/ggml-opus-ppsmall.h b/ggml/include/ggml-opus-ppsmall.h
new file mode 100644
index 0000000000000000000000000000000000000000..056a7388de89b0677b8dc83d3c16b6f913d1155c
--- /dev/null
+++ b/ggml/include/ggml-opus-ppsmall.h
@@ -0,0 +1,28 @@
+#pragma once
+// GGML_OPUS_PPSMALL : masque de bits (decimal ou 0x..) des leviers de PREFILL COURT (tours d'agent < 512 jetons).
+// DEFAUT OFF (variable absente ou 0 : comportement strictement inchange). Chantier V5GDNCH (10/10/2026).
+//   bit 0 (0x1) CHUNK : le GDN par blocs + les points de controle dans la passe (INB) s'activent des 64 jetons
+//                       (au lieu de 256) : GGML_GDN_CHUNK_MIN 256 -> 64 et LLAMA_RS_SNAPSHOT_MAX 255 -> 63 par defaut.
+//                       Les variables explicites GGML_GDN_CHUNK_MIN / LLAMA_RS_SNAPSHOT_MAX restent prioritaires.
+//                       PIEGE : un lot de verification ngram-simple fait jusqu'a size_m+1 = 49 jetons et se repose sur les
+//                       instantanes de retour arriere (n_rollback <= n_rs_seq) : le plafond d'instantanes doit rester
+//                       >= size_m+1 (le serveur le verifie au demarrage et refuse sinon).
+//                       numerique-KLD (blocs != sequentiel pour T < 256).
+//   bit 1 (0x2) MMB   : les noyaux WMMA-BF16 'mmb' (denses, experts routes, HC) servent des GGML_OPUS_MMB_MIN_T lignes
+//                       (defaut 128, plancher 64) au lieu de 512. numerique-KLD (BF16 au lieu de MMQ-Q8 sous 512).
+//   bit 2 (0x4) reserve (elagage des Q de la derniere attention : non implemente, voir RAPPORT.md).
+#include <stdlib.h>
+
+static inline int ggml_opus_ppsmall_mask(void) {
+    static const int v = [] {
+        const char * e = getenv("GGML_OPUS_PPSMALL");
+        return e && *e ? (int) strtol(e, nullptr, 0) : 0;
+    }();
+    return v;
+}
+static inline bool ggml_opus_ppsmall(int bit) { return (ggml_opus_ppsmall_mask() >> bit) & 1; }
+
+// seuil par defaut (en jetons) du GDN par blocs / INB
+static inline int ggml_opus_chunk_min_default(void) { return ggml_opus_ppsmall(0) ? 64 : 256; }
+// plafond par defaut (en jetons) des lots qui gardent les instantanes de retour arriere du GDN
+static inline int ggml_opus_rs_snapshot_max_default(void) { return ggml_opus_ppsmall(0) ? 63 : 255; }
