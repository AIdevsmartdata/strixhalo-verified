 .../vulkan-shaders/mul_mat_vec_iface.glsl     |  3 ++
 .../vulkan-shaders/mul_mat_vecq_funcs.glsl    | 41 +++++++++++++++++++
 .../src/ggml-vulkan/vulkan-shaders/types.glsl | 14 +++++++
 .../vulkan-shaders/vulkan-shaders-gen.cpp     | 24 +++++++++++
 5 files changed, 109 insertions(+), 2 deletions(-)

