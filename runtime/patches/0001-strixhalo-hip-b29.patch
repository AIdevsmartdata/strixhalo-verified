+static void test_dedup() {
+    SECTION("(a) prefix dedup");
+    // limit 10 MiB = 640 vMiB; sub-agents of 200 vMiB (8000 token header, different tails)
+    auto mkagent = [&](int i, size_t tail) { return mk(seq(70, 8000, 300 + i, tail), 200.0, {2048, 8000}, 40.0); };
+    // near-duplicate (header 8000 of 8300 = 96 %): leaves before the oldest entry
+    {
+        auto * c = mkcache(10, 0, "DEDUP=1");
+        Entry old_big = mk(seq(5, 3000, 5, 3000), 200.0);               // oldest: an unrelated session
+        Entry a0 = mkagent(0, 300), a1 = mkagent(1, 300), a2 = mkagent(2, 300);
+        save(*c, old_big); NOW(*c, 1); save(*c, a0); NOW(*c, 2);
+        save(*c, a1); NOW(*c, 3);                                         // 600 of 640 vMiB: room left
+        CHECK(c->states.size() == 3);
+        save(*c, a2);                                                     // 160 vMiB needed: a0 (near-duplicate) goes, not old_big
+        CHECK(c->evic_n_dedup == 1);
+        CHECK(has_prompt(*c, seq(5, 3000, 5, 3000)));
+        CHECK(!has_prompt(*c, seq(70, 8000, 300, 300)));
+        CHECK(has_prompt(*c, seq(70, 8000, 301, 300)));
+        CHECK(has_prompt(*c, seq(70, 8000, 302, 300)));
+        CHECK(c->size() <= c->limit_size);
+        delete c;
+    }
+    // without DEDUP: the oldest (old_big) goes
+    {
+        auto * c = mkcache(10, 0, "");
+        Entry old_big = mk(seq(5, 3000, 5, 3000), 200.0), a0 = mkagent(0, 300), a1 = mkagent(1, 300), a2 = mkagent(2, 300);
+        save(*c, old_big); save(*c, a0); save(*c, a1); save(*c, a2);
+        CHECK(!has_prompt(*c, seq(5, 3000, 5, 3000)));
+        CHECK(has_prompt(*c, seq(70, 8000, 300, 300)));
+        delete c;
+    }
+    // no pressure: nothing is replaced
+    {
+        auto * c = mkcache(100, 0, "DEDUP=1");
+        Entry a0 = mkagent(0, 300), a1 = mkagent(1, 300);
+        save(*c, a0); save(*c, a1);
+        CHECK(c->states.size() == 2); CHECK(c->evic_n_dedup == 0);
+        delete c;
+    }
+    // below the threshold: header 3000 of 8300 = 36 %, not a near-duplicate
+    {
+        auto * c = mkcache(10, 0, "DEDUP=1");
+        Entry s0 = mk(seq(70, 3000, 400, 5300), 250.0), s1 = mk(seq(70, 3000, 401, 5300), 250.0), s2 = mk(seq(70, 3000, 402, 5300), 250.0);
+        save(*c, s0); NOW(*c, 1); save(*c, s1); NOW(*c, 2); save(*c, s2);
+        CHECK(c->evic_n_dedup == 0);
+        CHECK(!has_prompt(*c, seq(70, 3000, 400, 5300)));                // the oldest goes
+        delete c;
+    }
+    // the old entry is much longer than the new one: it is not a near-duplicate even with 97 % of the new one shared
+    {
+        auto * c = mkcache(10, 0, "DEDUP=1");
+        Entry big = mk(seq(70, 9000, 500, 40000), 300.0);               // 49000 tokens
+        Entry small = mk(seq(70, 9000, 501, 300), 300.0);               // 9300 tokens, lcp 9000 = 97 % of the shorter
+        Entry other = mk(seq(80, 1000, 502, 1000), 100.0);
+        save(*c, big); NOW(*c, 1); save(*c, other); NOW(*c, 2);
+        save(*c, small);                                                 // 700 > 640: big is not eligible (49000 > 9300 + 10 %)
+        CHECK(c->evic_n_dedup == 0);
+        CHECK(!has_prompt(*c, seq(70, 9000, 500, 40000)));              // plain oldest-first removed it
+        delete c;
+    }
+    // DEDUP_MAX=2: two near-duplicates may leave
+    {
+        env_set("DEDUP=1,DEDUP_MAX=2");
+        auto * c = new server_prompt_cache(10, 0); c->evic_clock_ms = 1000000;
+        Entry a0 = mkagent(0, 300), a1 = mkagent(1, 300), a2 = mkagent(2, 300), a3 = mkagent(3, 300);
+        save(*c, a0); NOW(*c, 1); save(*c, a1); NOW(*c, 2); save(*c, a2); NOW(*c, 3);   // 600 vMiB
+        Entry big = mk(seq(70, 8000, 310, 300), 400.0, {2048, 8000}, 40.0);             // 360 needed: a0 and a1 leave
+        save(*c, big);
+        CHECK(c->evic_n_dedup == 2);
+        CHECK(c->size() <= c->limit_size);
+        (void) a3;
+        delete c; env_clear();
+    }
+    // absolute floor: 190 of 200 tokens but under DEDUP_MIN_TOK (256)
+    {
+        auto * c = mkcache(10, 0, "DEDUP=1");
+        Entry t0 = mk(seq(70, 190, 600, 10), 250.0), t1 = mk(seq(70, 190, 601, 10), 250.0), t2 = mk(seq(70, 190, 602, 10), 250.0);
+        save(*c, t0); NOW(*c, 1); save(*c, t1); NOW(*c, 2); save(*c, t2);
+        CHECK(c->evic_n_dedup == 0);
+        delete c;
+    }
+}
