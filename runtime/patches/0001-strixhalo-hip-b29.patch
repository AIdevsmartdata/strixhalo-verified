+    float tmp[8] = {};
+
+    ggml_cuda_pdl_sync();
+    for (int kbx = lane/(qi/vdr); kbx < blocks_per_row; kbx += blocks_per_iter) {
+        const block_q8_0 * bx = x + kbx;
+        int xv[vdr];
+#pragma unroll
+        for (int i = 0; i < vdr; ++i) {
+            xv[i] = get_int_b2(bx->qs, kqs + i);
+        }
+        const float dx = __half2float(bx->d);
+#pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const int token = ragged ? min(first_token + j, ncols_dst - 1) : first_token + j;
+            const block_q8_1 * by = y + token*stride_col_y + kbx;
+            int sumi = 0;
+#pragma unroll
+            for (int i = 0; i < vdr; ++i) {
+                sumi = ggml_cuda_dp4a(xv[i], get_int_b4(by->qs, kqs + i), sumi);
+            }
+            tmp[j] += dx*__half2float(__low2half(by->ds))*(float) sumi;
+        }
+    }
+#pragma unroll
+    for (int j = 0; j < 8; ++j) {
+        tmp[j] = warp_reduce_sum<32>(tmp[j]);
+        if (lane == 0 && first_token + j < ncols_dst) {
+            dst_ptr[(int64_t) (first_token + j)*stride_col_dst + row] = tmp[j];
+        }
+    }
+}
