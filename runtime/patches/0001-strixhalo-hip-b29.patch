+//
+// EVIC: RAM prompt cache eviction policy. Only reached when LLAMA_OPUS_EVIC_DEDUP or LLAMA_OPUS_EVIC_COST is set, see server-task.h.
+//
+namespace {
+
+// Tokens `donor` gives back for a request that shares `lcp` tokens with it: its end state if it lies fully in the prefix, else its
+// latest checkpoint in the prefix (a recurrent state restores only at a checkpoint). Low estimate for attention-only models.
+int64_t evic_restorable(const server_prompt & donor, int64_t lcp) {
+    const int64_t n = donor.n_tokens();
+    if (lcp >= n) {
+        return n;
+    }
+    int64_t best = 0;
+    for (const auto & c : donor.checkpoints) {
+        if (c.n_tokens <= lcp && c.n_tokens > best) {
+            best = c.n_tokens;
+        }
+    }
+    return best;
+}
+
+// age discount 2^(-age/half-life), floor 1/16
+double evic_decay(double age_s, int32_t half_s) {
+    if (half_s <= 0 || age_s <= 0.0) {
+        return 1.0;
+    }
+    return std::max(1.0 / 16.0, std::exp2(-age_s / (double) half_s));
+}
+
+// Cached entries 0..n-1 (oldest first) and, with has_new, the new state at index n. The prefix matrix is built once per eviction.
+struct evic_set {
+    std::vector<const server_prompt *> p;
+    std::vector<int64_t>               lcp;
+    std::vector<char>                  alive;
+    size_t                             n = 0;
+    size_t                             m = 0;
+    bool                               has_new = false;
+
+    void init(const std::vector<const server_prompt *> & prompts, size_t n_cached, bool with_new) {
+        p       = prompts;
+        n       = n_cached;
+        m       = prompts.size();
+        has_new = with_new;
+        alive.assign(n, 1);
+        lcp.assign(m * m, 0);
+        for (size_t i = 0; i < m; ++i) {
+            lcp[i * m + i] = p[i]->n_tokens();
+            for (size_t j = 0; j < i; ++j) {
+                const int64_t l = (int64_t) p[i]->tokens.get_common_prefix(p[j]->tokens);
+                lcp[i * m + j] = l;
+                lcp[j * m + i] = l;
+            }
+        }
+    }
+    int64_t L(size_t i, size_t j) const { return lcp[i * m + j]; }
+
+    // tokens of entry i that no other live entry (nor the new state with with_new) can give back: the recompute cost if i leaves
+    int64_t unique(size_t i, bool with_new) const {
+        int64_t best = 0;
+        for (size_t j = 0; j < n; ++j) {
+            if (j != i && alive[j]) {
+                best = std::max(best, evic_restorable(*p[j], L(i, j)));
+            }
+        }
+        if (with_new && has_new) {
+            best = std::max(best, evic_restorable(*p[n], L(i, n)));
+        }
+        return std::max<int64_t>(0, p[i]->n_tokens() - best);
+    }
+
+    // same for the new state against the live entries
+    int64_t unique_new() const {
+        int64_t best = 0;
+        for (size_t j = 0; j < n; ++j) {
+            if (alive[j]) {
+                best = std::max(best, evic_restorable(*p[j], L(n, j)));
+            }
+        }
+        return std::max<int64_t>(0, p[n]->n_tokens() - best);
+    }
+};
+
+} // namespace
