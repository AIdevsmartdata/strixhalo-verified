+
+constexpr int    K_CAP  = 256;
+constexpr size_t K_NAME = 64;
+
+struct slot {
+    char                  name[K_NAME];
+    char                  cat;
+    char                  kind;
+    std::atomic<int32_t>  val;
+    std::atomic<bool>     touched;
+};
+
+struct registry {
+    std::mutex            mu;
+    slot                  tab[K_CAP];
+    std::atomic<int>      n{0};
+    std::atomic<uint64_t> gen{1};
+};
+
+int32_t parse_text(char kind, const char * s) {
+    if (s == nullptr) {
+        return GGML_OPUS_FLAG_UNSET;
+    }
+    switch (kind) {
+        case 'f': {
+            if (*s == '\0') {
+                return GGML_OPUS_FLAG_UNSET;
+            }
+            char * end = nullptr;
+            const double v = std::strtod(s, &end);
+            if (end == s) {
+                return 0;
+            }
+            double m = v * 1e6;
+            if (m > 2147483000.0) { m = 2147483000.0; }
+            if (m < -2147483000.0) { m = -2147483000.0; }
+            return (int32_t) (m >= 0 ? m + 0.5 : m - 0.5);
+        }
+        case 'u':
+            if (*s == '\0' || std::strcmp(s, "off") == 0) { return 0; }
+            if (std::strcmp(s, "min") == 0)               { return -1; }
+            return std::max<int32_t>(0, (int32_t) std::atoi(s));
+        default:
+            return (int32_t) std::atoi(s);
+    }
+}
+
+slot * find_or_add_locked(registry & r, const char * name, bool create, char cat, char kind) {
+    const int n = r.n.load(std::memory_order_acquire);
+    for (int i = 0; i < n; ++i) {
+        if (std::strcmp(r.tab[i].name, name) == 0) {
+            return &r.tab[i];
+        }
+    }
+    // refus si la table est pleine OU si le nom ne tient pas : un nom tronque pourrait entrer en collision avec un autre
+    if (!create || n >= K_CAP || std::strlen(name) >= K_NAME) {
+        return nullptr;
+    }
+    slot & s = r.tab[n];
+    std::snprintf(s.name, sizeof(s.name), "%s", name);
+    s.cat  = cat;
+    s.kind = kind;
+    s.touched.store(false);
+    s.val.store(parse_text(kind, std::getenv(name)), std::memory_order_relaxed);
+    r.n.store(n + 1, std::memory_order_release);
+    return &s;
+}
+
+registry & reg() {
+    static registry * r = [] {
+        registry * x = new registry();   // jamais detruit : des threads peuvent lire a l'arret
+        std::lock_guard<std::mutex> lk(x->mu);
+        for (const flag_def & d : k_defs) {
+            find_or_add_locked(*x, d.name, true, d.cat, d.kind);
+        }
+        return x;
+    }();
+    return *r;
+}
+
+} // namespace
+
+std::atomic<int32_t> * ggml_opus_flag_ptr(const char * name) {
+    registry & r = reg();
+    std::lock_guard<std::mutex> lk(r.mu);
+    slot * s = find_or_add_locked(r, name, true, 'a', 'i');
+    if (s == nullptr) {
+        // V6CHAUD (revue) : ne jamais dereferencer un pointeur nul. Table pleine ou nom hors limites : le nom reste
+        // non enregistre, GGML_OPUS_RAW rend UNSET et le site garde exactement sa valeur par defaut.
+        static std::atomic<int32_t> overflow{GGML_OPUS_FLAG_UNSET};
+        return &overflow;
+    }
+    return &s->val;
+}
+
+int ggml_opus_flag_set(const char * name, int32_t value) {
+    registry & r = reg();
+    std::lock_guard<std::mutex> lk(r.mu);
+    slot * s = find_or_add_locked(r, name, false, 0, 0);
+    if (s == nullptr) {
+        return -1;
+    }
+    if (s->cat == 'c') {
+        return -2;
+    }
+    const int32_t old = s->val.exchange(value, std::memory_order_relaxed);
+    s->touched.store(true);
+    if (old != value) {
+        r.gen.fetch_add(1, std::memory_order_release);
+    }
+    return 0;
+}
+
+int ggml_opus_flag_set_str(const char * name, const char * text) {
+    registry & r = reg();
+    char kind = 'i';
+    {
+        std::lock_guard<std::mutex> lk(r.mu);
+        slot * s = find_or_add_locked(r, name, false, 0, 0);
+        if (s == nullptr) {
+            return -1;
+        }
+        kind = s->kind;
+    }
+    return ggml_opus_flag_set(name, parse_text(kind, text));
+}
+
+uint64_t ggml_opus_flag_generation(void) {
+    return reg().gen.load(std::memory_order_acquire);
+}
+
+bool ggml_opus_flag_touched(const char * name) {
+    registry & r = reg();
+    std::lock_guard<std::mutex> lk(r.mu);
+    slot * s = find_or_add_locked(r, name, false, 0, 0);
+    return s != nullptr && s->touched.load();
+}
+
+char ggml_opus_flag_category(const char * name) {
+    registry & r = reg();
+    std::lock_guard<std::mutex> lk(r.mu);
+    slot * s = find_or_add_locked(r, name, false, 0, 0);
+    return s ? s->cat : 0;
+}
+
+size_t ggml_opus_flag_dump(char * buf, size_t size) {
+    registry & r = reg();
+    std::string out = "{";
+    {
+        std::lock_guard<std::mutex> lk(r.mu);
+        const int n = r.n.load(std::memory_order_acquire);
+        for (int i = 0; i < n; ++i) {
+            const slot & s = r.tab[i];
+            const int32_t v = s.val.load(std::memory_order_relaxed);
+            char one[256];
+            if (v == GGML_OPUS_FLAG_UNSET) {
+                std::snprintf(one, sizeof(one), "%s\"%s\":{\"v\":null,\"cat\":\"%c\",\"kind\":\"%c\",\"touched\":%s}",
+                              i ? "," : "", s.name, s.cat, s.kind, s.touched.load() ? "true" : "false");
+            } else if (s.kind == 'f') {
+                std::snprintf(one, sizeof(one), "%s\"%s\":{\"v\":%.6f,\"cat\":\"%c\",\"kind\":\"f\",\"touched\":%s}",
+                              i ? "," : "", s.name, (double) v * 1e-6, s.cat, s.touched.load() ? "true" : "false");
+            } else {
+                std::snprintf(one, sizeof(one), "%s\"%s\":{\"v\":%d,\"cat\":\"%c\",\"kind\":\"%c\",\"touched\":%s}",
+                              i ? "," : "", s.name, (int) v, s.cat, s.kind, s.touched.load() ? "true" : "false");
+            }
+            out += one;
+        }
+    }
+    out += "}";
+    if (buf != nullptr && size > 0) {
+        const size_t k = std::min(out.size(), size - 1);
+        std::memcpy(buf, out.data(), k);
+        buf[k] = '\0';
+    }
+    return out.size();
+}
+
+void ggml_opus_flag_dump_stderr(void) {
+    const size_t n = ggml_opus_flag_dump(nullptr, 0);
+    std::string s(n + 1, '\0');
+    ggml_opus_flag_dump(&s[0], s.size());
+    std::fprintf(stderr, "ggml_opus_flags (generation %llu) : %s\n", (unsigned long long) ggml_opus_flag_generation(), s.c_str());
+}
+
+
+// ---- CYCLESTATS (ggml-opus-cycle.h) ---------------------------------------------------------------------------------------
+namespace {
+std::atomic<int64_t> g_cyc_ns[GOC_N];
+std::atomic<int64_t> g_cyc_n [GOC_N];
+}
+
+extern "C" {
+
+int ggml_opus_cycle_level(void) {
+    return GGML_OPUS_INT("LLAMA_OPUS_CYCLE_STATS", 0);
+}
+
+int64_t ggml_opus_cycle_now_ns(void) {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+void ggml_opus_cycle_acc(int id, int64_t ns) {
+    if (id < 0 || id >= GOC_N) {
+        return;
+    }
+    g_cyc_ns[id].fetch_add(ns, std::memory_order_relaxed);
+    g_cyc_n [id].fetch_add(1,  std::memory_order_relaxed);
+}
+
+void ggml_opus_cycle_read(int64_t ns[GOC_N], int64_t n[GOC_N]) {
+    for (int i = 0; i < GOC_N; ++i) {
+        ns[i] = g_cyc_ns[i].load(std::memory_order_relaxed);
+        n [i] = g_cyc_n [i].load(std::memory_order_relaxed);
+    }
+}
+
+} // extern "C"
