+        if (ctx->gdn_state_skip.count(cgraph->nodes[i])) {
+            continue;
+        }
 
         {
             auto node_flops = ggml_vk_get_node_flops(cgraph->nodes[i]);
@@ -18134,6 +18334,8 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
         ctx->fused_topk_moe_mode = TOPK_MOE_COUNT;
         ctx->fused_topk_moe_scale = false;
         ctx->fused_gdn_cache_dst = nullptr;
+        ctx->fused_gdn_state_read = nullptr;
+        ctx->fused_gdn_state_idx  = nullptr;
         {
             // [TAG_GDN_ZC] si ce nœud est un GDN dont le CPY de cache est éliminé,
             // le noyau écrit lui-même la tranche de cache.
@@ -18141,6 +18343,12 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
             if (gdn_it != ctx->gdn_cache_dst.end()) {
                 ctx->fused_gdn_cache_dst = gdn_it->second;
             }
+            // idem pour le GET_ROWS d'état en entrée : le noyau lit le ring.
+            auto sit = ctx->gdn_state_fused.find(cgraph->nodes[i]);
+            if (sit != ctx->gdn_state_fused.end()) {
+                ctx->fused_gdn_state_read = sit->second.first;
+                ctx->fused_gdn_state_idx  = sit->second.second;
+            }
         }
         const char *fusion_string {};
         if (!ctx->device->disable_fusion) {
@@ -18361,6 +18569,8 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
                 ctx->fused_topk_moe_mode = TOPK_MOE_COUNT;
                 ctx->fused_topk_moe_scale = false;
                 ctx->fused_gdn_cache_dst = nullptr;
+                ctx->fused_gdn_state_read = nullptr;
+                ctx->fused_gdn_state_idx  = nullptr;
             }
         }
 
@@ -18405,6 +18615,8 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
         ctx->num_additional_fused_ops = 0;
         ctx->fused_ops_write_mask = 0;
         ctx->fused_gdn_cache_dst = nullptr;
+        ctx->fused_gdn_state_read = nullptr;
+        ctx->fused_gdn_state_idx  = nullptr;
     }
 
     ctx->last_total_flops = total_flops;
