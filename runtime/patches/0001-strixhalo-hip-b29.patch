--- /dev/null
+++ b/ggml/src/ggml-cuda/q8full.cuh
@@ -0,0 +1,46 @@
+#pragma once
+#include "common.cuh"
+
+// V3Q8FULL (GGML_OPUS_Q8FULL) : lignes q8_1 ecrites par les noyaux producteurs, identiques au bit pres a quantize_q8_1.
+// Technique (b) de Gufo 0.11 (MIT, executor.cpp ReadyQ8 / kernels.hip.cpp QuantizeQ8_1Lane), reecrite ici sur la
+// formule exacte de quantize_q8_1 (quantize.cu) : memes reductions amax puis somme (butterfly XOR 16,8,4,2,1), meme arrondi.
+// Code initialement redige par DeepSeek V4.1 Flash, relu et corrige.
+
+// Un warp complet (32 lanes appellent) ; lane = indice de l'element dans le bloc de 32.
+static __device__ __forceinline__ void q8full_store_warp32(
+        block_q8_1 * __restrict__ y, const int64_t ib, const int lane, const float xi) {
+    float amax = fabsf(xi);
+    float sum  = xi;
+    amax = warp_reduce_max<QK8_1>(amax);
+    sum  = warp_reduce_sum<QK8_1>(sum);
+    const float  d = amax / 127.0f;
+    const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
+    y[ib].qs[lane] = q;
+    if (lane == 0) {
+        y[ib].ds = make_half2(d, sum);
+    }
+}
+
+// 16 lanes consecutives alignees (l = threadIdx.x % 16), chacune detient 2 elements consecutifs : v0 = element 2l,
+// v1 = element 2l+1. La somme rejoue le butterfly XOR de 32 lanes (offsets 16,8,4,2,1, operande propre d'abord) :
+// offsets 16..2 = decalages de lanes 8,4,2,1 sur les deux registres, offset 1 = a0 + a1 (commutativite exacte de l'addition).
+static __device__ __forceinline__ void q8full_store_pair16(
+        block_q8_1 * __restrict__ y, const int64_t ib, const int l, const float v0, const float v1) {
+    float a0 = v0;
+    float a1 = v1;
+    float amax = fmaxf(fabsf(v0), fabsf(v1));
+#pragma unroll
+    for (int m = 8; m >= 1; m >>= 1) {
+        a0   += __shfl_xor_sync(0xffffffff, a0,   m, 16);
+        a1   += __shfl_xor_sync(0xffffffff, a1,   m, 16);
+        amax  = fmaxf(amax, __shfl_xor_sync(0xffffffff, amax, m, 16));
+    }
+    const float  sum = a0 + a1;
+    const float  d   = amax / 127.0f;
+    const int8_t q0  = amax == 0.0f ? 0 : roundf(v0 / d);
+    const int8_t q1  = amax == 0.0f ? 0 : roundf(v1 / d);
+    *(char2 *) (y[ib].qs + 2 * l) = make_char2(q0, q1);
+    if (l == 0) {
+        y[ib].ds = make_half2(d, sum);
+    }
+}
