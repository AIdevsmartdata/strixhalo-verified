+                ggml_backend_tensor_get(output, enabled ? actual.data() : reference.data(), 0, ggml_nbytes(output));
+            }
+            ok = ok && reference == actual;
+            // Non-finite keys outside the shortcut domain only require agreement with the old path.
+            for (int64_t row = 0; row < rows && ok && pattern < 8; ++row) {
+                std::set<int32_t> seen;
+                for (int i = 0; i < shape.k; ++i) {
+                    const int32_t id = actual[row * shape.k + i];
+                    ok = ok && id >= 0 && id < shape.cols && seen.insert(id).second;
+                }
+            }
+            printf("  TOP_K_QSA_TAIL_EXACT(ne=[%lld,%lld,%lld,1],k=%d,pattern=%d): %s\n",
+                   (long long) shape.cols, (long long) shape.rows, (long long) shape.planes, shape.k, pattern, ok ? "OK" : "FAIL");
+            ++n_run;
+            n_fail += !ok;
+        }
+    }
+    printf("  TOP_K_QSA_TAIL_EXACT: %d cases, %d failed\n", n_run, n_fail);
+    return n_fail == 0;
+}
