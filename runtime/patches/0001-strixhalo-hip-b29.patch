+#pragma once
+// CYCLESTATS (GAINS2, 14/10/2026) : sonde de chronometrage INTERNE du serveur. Classe B : aucune valeur calculee ne change.
+//
+//   LLAMA_OPUS_CYCLE_STATS = 0/absent : OFF (un test d'entier par tour de update_slots, aucune horloge lue)
+//                            1        : resume toutes les LLAMA_OPUS_CYCLE_SEC secondes (defaut 10) + une ligne [REQ] par requete
+//                            2        : en plus, une ligne [CYCLE] par cycle de decodage
+//
+// Un « cycle » = un tour de update_slots() qui decode (preparation du lot + brouillon, verification, echantillonnage/acceptation).
+// Toutes les mesures sont des differences de std::chrono::steady_clock lues cote hote. AUCUNE synchronisation GPU n'est ajoutee :
+// les attentes mesurees (llama_synchronize, lecture des logits du brouillon, porte PLEOFF) existent deja.
+// Aucune allocation sur le chemin chaud : les tampons sont crees une fois au premier tour actif, les lignes sont formatees dans des
+// tampons de pile, et le journal n'est ecrit qu'a la periode (ou a chaque cycle avec =2).
+//
+// Ce fichier est inclus UNIQUEMENT par server-context.cpp.
+
+#include "ggml-opus-cycle.h"
+#include "log.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace cyc {
+
+// ---- postes (durees, en ns pendant le tour ; en ms a l'affichage) ---------------------------------------------------------
+enum post : int {
+    P_GAP = 0,        // fin du tour precedent -> debut de celui-ci (boucle de taches, attente, HTTP) ; 0 apres une periode inactive
+    P_GAP_TASKS,      //   dont : taches servies par le fil principal (get_available_slot, launch, ...)
+    P_PRE,            // pre_decode() : preparation du lot, brouillon, points de controle
+    P_PRE_DRAFT,      //   common_speculative_draft (toutes implementations, yield compris)
+    P_DRAFT_MTP,      //     dont brouillon MTP (toutes les tetes)
+    P_DRAFT_NGRAM,    //     dont brouillon n-gram
+    P_H0_LAUNCH, P_H0_SAMPLE, P_H1_LAUNCH, P_H1_SAMPLE, P_H2_LAUNCH, P_H2_SAMPLE, P_H3_LAUNCH, P_H3_SAMPLE,   // tete MTP i : mise en file / attente+echantillonnage
+    P_PRE_SPECCK,     //   points de controle speculatifs (brouillon)
+    P_PRE_PROMPT,     //   remplissage du lot par les prompts (jetons, restaurations de points de controle, sauvegardes)
+    P_PRE_OTHER,      //   reste (liste des slots, handle_last_sampled_token, ...)
+    P_CKPT_SAVE,      // create_checkpoint (dans le tour, tous endroits confondus)
+    P_CKPT_REST,      // restauration d'un point de controle de contexte
+    P_DEC,            // decode() : lancement + verification + brouillon de rattrapage
+    P_DEC_PROC,       //   llama_process(cible) cote hote : construction/lancement du graphe de verification
+    P_V_BUILD,        //     dont build_graph (graphe non reutilise)
+    P_V_ALLOC,        //     dont alloc du graphe
+    P_V_INPUTS,       //     dont set_inputs (PLE synchrone compris)
+    P_V_PLE,          //       dont entree PLE (fil de calcul)
+    P_V_PLEWAIT,      //       dont (dans P_V_LAUNCH : la porte est relachee par graph_compute) attente de la porte PLEOFF
+    P_V_LAUNCH,       //     dont graph_compute (mise en file, attente de la porte PLEOFF comprise)
+    P_V_SYNC,         //     (revue) dont synchronisations GPU internes (sched_synchronize du graphe non reutilise, synchronize() des sorties reordonnees)
