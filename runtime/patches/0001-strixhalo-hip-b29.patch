+static void test_slots_replay() {
+    SECTION("SLOTS scenario (log of pass R, real server order: take BEFORE save): does the main session survive?");
+    const size_t V4096 = 4096 * VMIB;
+    // OFF: oldest first, M leaves when A1 is saved, as in the log
+    { const Replay r = replay_slots("", 64);                       // 64 MiB = 4096 vMiB
+      CHECK(!r.m_alive_after_a1); CHECK(!r.m3_hit); CHECK(!r.m4_hit); }
+    // dedup only: A1 shares the header with M but not 90 %, so nothing changes (DEDUP is inert in this scenario)
+    { const Replay r = replay_slots("DEDUP=1", 64);
+      CHECK(!r.m_alive_after_a1); CHECK(!r.m3_hit); CHECK(!r.m4_hit); CHECK(r.n_dedup == 0); }
+    // cost (E4 of the GPU series): M stays and comes back at M3 and M4, with 4096 MiB
+    { const Replay r = replay_slots("COST=1", 64);
+      CHECK(r.m_alive_after_a1); CHECK(r.m3_hit); CHECK(r.m4_hit); CHECK(r.peak <= V4096); CHECK(r.n_dedup == 0); CHECK(r.n_reject >= 1); }   // A3 is refused: only the protected M3 could leave
+    // (a)+(b): same, dedup never fires
+    { const Replay r = replay_slots("DEDUP=1,COST=1", 64);
+      CHECK(r.m_alive_after_a1); CHECK(r.m3_hit); CHECK(r.m4_hit); CHECK(r.n_dedup == 0); }
+    // R5 witness of the GPU series: the ORIGIN with more room (5120 MiB = 80 scaled, 6144 MiB = 96) already gives M back at M3 and M4 in the real
+    // server order, through the same restore path as E4. 4096 MiB is the smallest limit where EVIC does it.
+    { const Replay r = replay_slots("", 80);
+      CHECK(r.m3_hit); CHECK(r.m4_hit); CHECK(r.peak <= 5120 * VMIB); CHECK(r.peak > V4096); }       // R5: it really needs more than 4096 MiB
+    { const Replay r = replay_slots("", 96);
+      CHECK(r.m3_hit); CHECK(r.m4_hit); }
+    // E6 (cost, 6144 MiB) gives nothing more than the origin at 6144
+    { const Replay r = replay_slots("COST=1", 96);
+      CHECK(r.m3_hit); CHECK(r.m4_hit); }
+    // the protection decides M4. PROT_S=0 (no protection): documented behaviour, M3 is pushed out by A3 (loss 72.6k tokens against a gain of 46.8k, ratio 1.55 < ADMIT 2)
+    { const Replay r = replay_slots("COST=1,PROT_S=0", 64);
+      CHECK(r.m3_hit); CHECK(!r.m4_hit); CHECK(r.n_reject == 0); }
+    // PROT_S=30: M is protected when A1 is saved (age 21 s) but not when A3 is saved (age 34 s): M3 hit, M4 missed (information pass E4S of the GPU series)
+    { const Replay r = replay_slots("COST=1,PROT_S=30", 64);
+      CHECK(r.m3_hit); CHECK(!r.m4_hit); }
+}
