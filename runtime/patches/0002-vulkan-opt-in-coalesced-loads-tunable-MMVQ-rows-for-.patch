+// byte layout for the coalesced (USE_COALESCED_LOADS) raw-u32 reads
+#define BLOCK_ROCMFP4_SIZE       18
+#define BLOCK_ROCMFP4_OFFSET_QS  0
+#define BLOCK_ROCMFP4_OFFSET_E   16
+#define BLOCK_ROCMFP4_FAST_SIZE       17
+#define BLOCK_ROCMFP4_FAST_OFFSET_QS  0
+#define BLOCK_ROCMFP4_FAST_OFFSET_E   16
+
 #if defined(DATA_A_ROCMFP4)
 #define QUANT_K QUANT_K_ROCMFP4
 #define QUANT_R QUANT_R_ROCMFP4
 #define QUANT_AUXF 1
 #define A_TYPE block_rocmfp4
+#define A_BLOCK_SIZE       BLOCK_ROCMFP4_SIZE
+#define A_BLOCK_OFFSET_QS  BLOCK_ROCMFP4_OFFSET_QS
+#define A_BLOCK_OFFSET_E   BLOCK_ROCMFP4_OFFSET_E
 #endif
 
 #if defined(DATA_A_ROCMFP4_FAST)
@@ -1831,6 +1842,9 @@ struct block_rocmfp4_fast
 #define QUANT_R QUANT_R_ROCMFP4
 #define QUANT_AUXF 1
 #define A_TYPE block_rocmfp4_fast
+#define A_BLOCK_SIZE       BLOCK_ROCMFP4_FAST_SIZE
+#define A_BLOCK_OFFSET_QS  BLOCK_ROCMFP4_FAST_OFFSET_QS
+#define A_BLOCK_OFFSET_E   BLOCK_ROCMFP4_FAST_OFFSET_E
 #endif
 
