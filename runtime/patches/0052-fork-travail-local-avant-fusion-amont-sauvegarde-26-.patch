index 80dd3547e7f..5fe769579c5 100644
--- a/src/llama-memory-hybrid-idx.cpp
+++ b/src/llama-memory-hybrid-idx.cpp
@@ -8,9 +8,128 @@
 
 #include <algorithm>
 #include <cassert>
+#include <cctype>
 #include <cmath>
+#include <cstdio>
+#include <cstdlib>
 #include <iterator>
 #include <stdexcept>
+#include <string>
+
+//
+// [TAG_DRAFT_QSA] interrupteur de l'indexeur de la tete MTP du draft
+//
+
+static std::string draft_qsa_trim_lower(const char * s) {
+    std::string r = s == nullptr ? std::string() : std::string(s);
+
+    while (!r.empty() && (unsigned char) r.back() <= ' ') {
+        r.pop_back();
+    }
+    size_t i = 0;
+    while (i < r.size() && (unsigned char) r[i] <= ' ') {
+        i++;
+    }
+    r.erase(0, i);
+
+    for (char & c : r) {
+        c = (char) tolower((unsigned char) c);
+    }
+
+    return r;
+}
+
+// true when the token means "no draft indexer at all"
+static bool draft_qsa_off_token(const std::string & v) {
+    return v.empty() || v == "0" || v == "off" || v == "false" || v == "no";
+}
+
+static llama_draft_qsa_arm draft_qsa_parse(const std::string & v) {
+    if (draft_qsa_off_token(v)) {
+        return LLAMA_DRAFT_QSA_OFF;
+    }
+    if (v == "sel" || v == "b" || v == "sel_dense") {
+        return LLAMA_DRAFT_QSA_SEL;
+    }
+    if (v == "on" || v == "1" || v == "true" || v == "yes" || v == "c") {
+        return LLAMA_DRAFT_QSA_ON;
+    }
+
+    LLAMA_LOG_WARN("%s: unknown LLAMA_DRAFT_QSA arm '%s' (expected off/keys/sel/on) - using ON\n",
+            __func__, v.c_str());
+
+    return LLAMA_DRAFT_QSA_ON;
+}
+
+static const char * draft_qsa_env() {
+    const char * e = getenv("LLAMA_DRAFT_QSA");
+
+    return e != nullptr && *e != '\0' ? e : nullptr;
+}
+
+bool llama_draft_qsa_mem() {
+    // "keys" is a value of the control FILE, not of the env var: as an env value it names a file
+    static const bool v = [] {
+        const char * e = draft_qsa_env();
+
+        return e != nullptr && !draft_qsa_off_token(draft_qsa_trim_lower(e));
+    }();
+
+    return v;
+}
+
+llama_draft_qsa_arm llama_draft_qsa_read() {
+    const char * e = draft_qsa_env();
+    if (e == nullptr) {
+        return LLAMA_DRAFT_QSA_OFF;
+    }
+
+    const std::string v = draft_qsa_trim_lower(e);
+
+    // a constant arm, so that a single-process run can arm the memory without a control file
+    if (draft_qsa_off_token(v) || v == "sel" || v == "b" || v == "sel_dense" ||
+        v == "on" || v == "1" || v == "true" || v == "yes" || v == "c") {
+        return draft_qsa_parse(v);
+    }
+    if (v == "keys") {
+        // "keys" = arme pour la memoire, bras OFF (cles ecrites, aucune selection, attention dense)
+        return LLAMA_DRAFT_QSA_OFF;
+    }
+
+    // otherwise `v` is the path of a control file, re-read at every graph build
+    FILE * f = fopen(v.c_str(), "rb");
+    if (f == nullptr) {
+        // noisy on purpose: a typo in the path would silently run the candidate arm, which is the
+        // one that changes what the model computes
+        static bool warned = false;
+        if (!warned) {
+            warned = true;
+            LLAMA_LOG_WARN("%s: LLAMA_DRAFT_QSA='%s' is not a readable control file - using ON\n",
+                    __func__, v.c_str());
+        }
+        return LLAMA_DRAFT_QSA_ON;
+    }
+
+    char buf[64] = { 0 };
+    const size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+    fclose(f);
+    buf[n] = '\0';
+
+    const std::string c = draft_qsa_trim_lower(buf);
+
+    // "keys" is the arm-OFF spelling that reminds that the indexer keys are still written
+    return c == "keys" ? LLAMA_DRAFT_QSA_OFF : draft_qsa_parse(c);
+}
+
+const char * llama_draft_qsa_arm_name(llama_draft_qsa_arm arm) {
+    switch (arm) {
+        case LLAMA_DRAFT_QSA_OFF: return "off (dense, indexer keys written)";
+        case LLAMA_DRAFT_QSA_SEL: return "sel (selection computed + dumped, dense attention)";
+        case LLAMA_DRAFT_QSA_ON:  return "on (selection + sparse attention)";
+    }
+
+    return "?";
+}
 
