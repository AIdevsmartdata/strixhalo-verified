@@ -821,6 +824,25 @@ static bool ggml_is_view_op(enum ggml_op op) {
 #define GGML_SCHED_MAX_COPIES 4
 #endif
 
+// [OPUS-P1] copies d'entrees de split : interrupteur GGML_OPUS_P1 (defaut OFF), masque de bits :
+//   2 = copie groupee des petites entrees hote (un H2D + un noyau de dispersion, sans arret hote)
