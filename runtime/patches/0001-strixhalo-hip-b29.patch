+namespace {
+struct ple_async_runner {
+    std::mutex              m;
+    std::condition_variable cv;
+    std::function<void()>   job;
+    bool                    busy = false;
+    bool                    stop = false;
+    std::thread             th;
+
+    ~ple_async_runner() {
+        {
+            std::lock_guard<std::mutex> lk(m);
+            stop = true;
+        }
+        cv.notify_all();
+        if (th.joinable()) {
+            th.join();   // a job in flight finishes first (a gather is bounded by the NVMe latency)
+        }
+    }
+
+    void loop() {
+        std::unique_lock<std::mutex> lk(m);
+        for (;;) {
+            cv.wait(lk, [&] { return stop || job; });
+            if (!job) {
+                return;   // stop with nothing pending
+            }
+            std::function<void()> j = std::move(job);
+            job = nullptr;
+            lk.unlock();
+            j();
+            lk.lock();
+            busy = false;
+            cv.notify_all();
+        }
+    }
