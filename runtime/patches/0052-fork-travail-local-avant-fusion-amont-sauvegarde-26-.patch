+// Deterministic routing patterns for the MoE replay. OFF and ON arms (two processes) must
+// replay identical B and IDs, so the IDs are a pure function of (pattern, seed, token, col).
+enum moe_replay_routing {
+    MOE_ROUTING_ARBITRARY = 0, // token and column both vary (historic formula)
+    MOE_ROUTING_PERMUTED  = 1, // per-token permutation, 10 consecutive columns are distinct
+    MOE_ROUTING_REPEATED  = 2, // token pairs share the same expert set in the same order
+    MOE_ROUTING_DISJOINT  = 3, // disjoint expert sets while 10*n <= 512
+    MOE_ROUTING_HOT       = 4, // a small hot set reused across tokens
+};
+
+static int32_t moe_replay_id(int routing, uint32_t seed, int64_t token, int64_t col) {
+    const uint32_t tb = (uint32_t) token;
+    const uint32_t cb = (uint32_t) col;
+    switch (routing) {
+        case MOE_ROUTING_PERMUTED: {
+            // odd stride => the 10 columns of a top-k view are 10 distinct experts
+            const uint32_t stride = 2u * ((seed + 0x9E3779B9u * (tb + 1u)) % 256u) + 1u;
+            return (int32_t) ((seed + 0x85EBCA6Bu * tb + stride * cb) % 512u);
+        }
+        case MOE_ROUTING_REPEATED:
+            return (int32_t) ((37u * (tb / 2u) + cb) % 512u);
+        case MOE_ROUTING_DISJOINT:
+            return (int32_t) ((10u * tb + cb) % 512u);
+        case MOE_ROUTING_HOT:
+            return (int32_t) ((7u + (3u * tb + cb) % 32u) % 512u);
+        case MOE_ROUTING_ARBITRARY:
+        default:
+            return (int32_t) ((503u + 73u * tb + 37u * cb) % 512u);
+    }
+}
+
+static uint64_t moe_replay_hash(uint64_t h, const void * data, size_t size) {
+    const uint8_t * p = (const uint8_t *) data;
+    for (size_t i = 0; i < size; ++i) {
+        h ^= p[i];
+        h *= 1099511628211ULL;
+    }
+    return h;
+}
