+    double    s_act[NCLS], s_gen[NCLS], s_ver[NCLS], s_acc[NCLS], s_pf[NCLS], s_emit[NCLS];
+    uint64_t  n_clk_period = 0, n_acc_period = 0, n_round_period = 0;
+    int64_t   t_report = 0, t_origin = 0;
+    slot_stat ss[MAXS];
+    std::vector<req_t> req;
+
+    static int64_t now() { return ggml_opus_cycle_now_ns(); }
+
+    void init() {
+        smp.assign((size_t) NCLS * P_N * CAP, 0.0f);
+        memset(cnt, 0, sizeof(cnt)); memset(ntot, 0, sizeof(ntot)); memset(sum, 0, sizeof(sum));
+        memset(s_act, 0, sizeof(s_act)); memset(s_gen, 0, sizeof(s_gen)); memset(s_ver, 0, sizeof(s_ver));
+        memset(s_acc, 0, sizeof(s_acc)); memset(s_pf, 0, sizeof(s_pf)); memset(s_emit, 0, sizeof(s_emit));
