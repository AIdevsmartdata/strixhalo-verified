     uint32_t nb21, nb22, nb31;
@@ -2475,6 +2499,21 @@ struct ggml_backend_vk_context {
     std::unordered_map<const ggml_tensor *, vk_hc_combine_entry>  hc_combine_fused;
     std::unordered_set<const ggml_tensor *>                       hc_combine_skip;
 
+    // [TAG_MOE_WEIGHTED] Combine MoE pondéré en un seul kernel (port Vulkan du PR cuda #25952) :
+    //   E = MUL_MAT_ID down_exps (n_embd, K, T) f32 ; W = MUL(E, weights [1,K,T]) ;
+    //   K vues de W -> chaîne ADD -> un kernel multi_add pondéré lit E directement
+    //   (le MUL et son passage mémoire complet de W disparaissent).
+    // Clé = premier ADD de la chaîne ; skip = {W} (le nœud MUL élidé).
+    struct vk_moe_weighted_entry {
