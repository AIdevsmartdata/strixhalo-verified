diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index 708ca6d9063..94e5dd163cb 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -8560,6 +8560,59 @@ void ggml_compute_forward_top_k(
     }
 }
 
+void ggml_compute_forward_qsa_finalize(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * scores = dst->src[0];
+    const ggml_tensor * blocks = dst->src[1];
+    const ggml_tensor * mask = dst->src[2];
+    const int n_kv = mask->ne[0];
+    const int n_cand = 2056 + n_kv%4;
+    for (int64_t row = params->ith; row < dst->ne[1]; row += params->nth) {
+        std::pair<uint32_t, int> ranked[2059];
+        int32_t cells[2059];
+        bool dropped[2059] = {};
+        for (int slot = 0; slot < n_cand; ++slot) {
+            int32_t block = n_kv/4;
+            if (slot < 2056) {
+                memcpy(&block, (const char *) blocks->data + row*blocks->nb[1] + (slot/4)*blocks->nb[0], sizeof(block));
+                GGML_ASSERT(block >= 0 && block < n_kv/4);
+            }
+            const int cell = block*4 + slot%4;
+            float score, m;
+            memcpy(&score, (const char *) scores->data + row*scores->nb[1] + block*scores->nb[0], sizeof(score));
+            const char * pm = (const char *) mask->data + row*mask->nb[1] + cell*mask->nb[0];
+            if (mask->type == GGML_TYPE_F16) {
+                ggml_fp16_t h;
