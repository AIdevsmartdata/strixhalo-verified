+// [TAG_EXPERT_SAMPLE] Gumbel perturbation for Expert-Sample routing (arXiv 2602.02443):
+// the noise tensor is created by build_moe_ffn, filled host-side here and uploaded
+// via ggml_backend_tensor_set on every decode step (fresh noise -> fresh samples).
+class llama_model_qwen4exp::llm_graph_input_es : public llm_graph_input_i {
+public:
+    virtual ~llm_graph_input_es() = default;
+
+    ggml_tensor * noise = nullptr; // F32 [n_cand, n_tokens]
+
+    void set_input(const llama_ubatch * ubatch) override;
+
+    bool can_reuse(const llm_graph_params & params) override {
+        return noise != nullptr && noise->ne[1] == params.ubatch.n_tokens;
+    }
+
+    std::vector<float> buf;
+};
+
+void llama_model_qwen4exp::llm_graph_input_es::set_input(const llama_ubatch * /* ubatch */) {
+    if (!noise) {
+        return;
+    }
+
+    const size_t n = (size_t) noise->ne[0] * noise->ne[1];
+    buf.resize(n);
+
+    std::mt19937_64 rng(std::random_device{}());
+    std::uniform_real_distribution<float> U(1e-12f, 1.0f - 1e-12f);
+    for (size_t i = 0; i < n; ++i) {
+        buf[i] = -logf(-logf(U(rng)));
+    }
+
+    ggml_backend_tensor_set(noise, buf.data(), 0, n * sizeof(float));
+}
