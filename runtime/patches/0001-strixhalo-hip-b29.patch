+        d[P_DRAFT_NGRAM] = dl(GOC_DRAFT_NGRAM);
+        for (int h = 0; h < 4; ++h) {
+            d[P_H0_LAUNCH + 2 * h]     = dl(GOC_MTP_LAUNCH0 + h);
+            d[P_H0_LAUNCH + 2 * h + 1] = dl(GOC_MTP_SAMPLE0 + h);
+        }
+        d[P_YIELD_TAIL]     = dl(GOC_YIELD_TAIL);
+        d[P_PAR_TASK_YIELD] = dl(GOC_TASK_YIELD);
+        d[P_PAR_PLE_ASYNC]  = dl(GOC_PLE_ASYNC);
