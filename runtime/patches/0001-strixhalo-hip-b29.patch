+
+constexpr int MAXS  = 64;     // slots suivis
+constexpr int NCLS  = 8;      // 4 niveaux de charge (1, 2, 3, 4+ slots actifs) x {decodage seul, avec prefill}
+constexpr int CAP   = 2048;   // echantillons conserves par classe et par periode (au-dela : comptes mais pas dans les percentiles)
+constexpr int NPASS = 10;
+
+struct pass_t { int32_t tok = 0, batch = 0; float proc_ms = 0, sync_ms = 0; };
+
+// une requete (tour d'agent) : jalons en ns (steady_clock), 0 = non vu
+struct req_t {
