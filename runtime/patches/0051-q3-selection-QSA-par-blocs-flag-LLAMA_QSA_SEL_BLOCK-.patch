     const bool select = !skip_prefill_sel && !(nosel_guard && n_kv <= (int64_t) hparams.indexer_top_k + r - 1);
 
+    // [TAG_QSA_SEL_BLOCK] Selection au niveau BLOC (LLAMA_QSA_SEL_BLOCK=1) : on ne materialise les
+    // scores que pour les cellules CANDIDATES (K_blk blocs x r cellules + la queue incomplete) au
