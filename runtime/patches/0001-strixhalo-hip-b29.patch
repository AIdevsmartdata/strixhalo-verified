+        std::unique_lock<std::mutex> lk(m);
+        cv.wait(lk, [&] { return !busy; });   // never two jobs
+        if (!th.joinable()) {
+            th = std::thread([this] { loop(); });
+        }
+        busy = true;
+        job  = std::move(fn);
+        cv.notify_all();
+    }
+
+    void wait() {
+        std::unique_lock<std::mutex> lk(m);
+        cv.wait(lk, [&] { return !busy; });
+    }
