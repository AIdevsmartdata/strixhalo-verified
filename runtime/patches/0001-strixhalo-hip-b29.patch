+double opus_lm_pct(std::vector<double> v, double q) {
+    if (v.empty()) {
+        return 0.0;
+    }
+    std::sort(v.begin(), v.end());
+    return v[std::min(v.size() - 1, (size_t) (q * (double) (v.size() - 1) + 0.5))];
