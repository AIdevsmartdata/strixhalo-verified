+                for (int64_t tt = 0; tt < t->ne[1]; ++tt) {
+                    int32_t * p = buf.data() + width*(tt + t->ne[1]*s);
+                    bool ok = true;
+                    for (int64_t k = 0; k < width; ++k) {
+                        if (p[k] < 0 || p[k] >= n_kv) {
+                            ok = false;
+                            break;
+                        }
+                    }
+                    if (!ok) {
+                        skipped++;
+                        continue;
+                    }
+                    std::sort(p, p + width);
+                    fprintf(f, "step=%ld il=%d s=%lld t=%lld n=%lld cells=", step, (int) il,
+                            (long long) s, (long long) tt, (long long) width);
+                    for (int64_t k = 0; k < width; ++k) {
+                        fprintf(f, "%d%s", p[k], k + 1 < width ? "," : "");
+                    }
+                    fprintf(f, "\n");
+                }
+            }
+        }
+        fflush(f);
+        step++;
+    }
