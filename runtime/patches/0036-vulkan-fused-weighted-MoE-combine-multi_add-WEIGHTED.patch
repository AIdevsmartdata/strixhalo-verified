+        // (les strides pushés restent ceux des vues — identiques car layout identique)
+        vk_buffer e_buf = nullptr;
+        size_t e_off = 0;
+        if (ctx->device->uma) {
+            ggml_vk_host_get(ctx->device, E->data, e_buf, e_off);
+        }
+        if (e_buf == nullptr) {
+            e_buf = ((ggml_backend_vk_buffer_context *)E->buffer->context)->dev_buffer;
+            e_off = vk_tensor_offset(E);
+        }
+        GGML_ASSERT((e_off & (ctx->device->properties.limits.minStorageBufferOffsetAlignment - 1)) == 0);
+        for (uint32_t s = 0; s < num_srcs; ++s) {
+            buf[s] = e_buf;
+            offset[s] = e_off + s * E->nb[1];
+        }
+        // binding 12 : tenseur poids
+        vk_buffer w_buf = nullptr;
+        size_t w_off = 0;
+        if (ctx->device->uma) {
+            ggml_vk_host_get(ctx->device, w->data, w_buf, w_off);
+        }
+        if (w_buf == nullptr) {
+            w_buf = ((ggml_backend_vk_buffer_context *)w->buffer->context)->dev_buffer;
+            w_off = vk_tensor_offset(w);
+        }
+
+        pc.w_nb1 = (uint32_t)(w->nb[1] / sizeof(float));
+        pc.w_nb2 = (uint32_t)(w->nb[2] / sizeof(float));
+
+        ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, {
+            ggml_vk_subbuffer(ctx, buf[0], offset[0]),
+            ggml_vk_subbuffer(ctx, buf[1], offset[1]),
+            ggml_vk_subbuffer(ctx, buf[2], offset[2]),
+            ggml_vk_subbuffer(ctx, buf[3], offset[3]),
+            ggml_vk_subbuffer(ctx, buf[4], offset[4]),
+            ggml_vk_subbuffer(ctx, buf[5], offset[5]),
+            ggml_vk_subbuffer(ctx, buf[6], offset[6]),
+            ggml_vk_subbuffer(ctx, buf[7], offset[7]),
+            ggml_vk_subbuffer(ctx, buf[8], offset[8]),
+            ggml_vk_subbuffer(ctx, buf[9], offset[9]),
+            ggml_vk_subbuffer(ctx, buf[10], offset[10]),
+            ggml_vk_subbuffer(ctx, w_buf, w_off),   // binding 11 : poids (alias a11)
+        }, pc, elements);
