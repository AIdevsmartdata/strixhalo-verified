+    P_DEC_CKPT,       //   points de controle « dans la passe »
+    P_DEC_SPECPROC,   //   common_speculative_process (rattrapage MTP apres verification)
+    P_YIELD_TAIL,     //   attente du fil auxiliaire a la fin d'un yield_to_queue
+    P_DEC_OTHER,      //   reste
+    P_POST,           // post_decode() : echantillonnage, acceptation, envoi
+    P_POST_SAMPLE,    //   echantillonnage + acceptation (sample, sample_and_accept_n)
+    P_POST_EMIT,      //   process_token (detokenisation, arret, envoi du delta)
