+// fills the `mtp_h_input` rows of this ubatch: virtual row v (0 <= v < total) is `head` when v == 0 and head != null,
+// else row nextn_req_row0 + v - (head ? 1 : 0) of the target's device buffer
+bool llama_context::nextn_dev_apply_src(llm_graph_result * res, const llama_ubatch & ubatch) {
+    ggml_tensor * h = ggml_graph_get_tensor(res->get_gf(), "mtp_h_input");
+    if (!h || h->ne[0] != nextn_req_tgt->nextn_dev_t->ne[0] || h->type != GGML_TYPE_F32 || !ggml_is_contiguous(h)) {
+        LLAMA_LOG_ERROR("%s: no usable mtp_h_input tensor in the draft graph\n", __func__);
+        return false;
+    }
+    const int64_t n  = ubatch.n_tokens;
+    const int64_t v0 = nextn_req_done;
+    if (v0 + n > nextn_req_total) {
+        LLAMA_LOG_ERROR("%s: the draft decode has more tokens than announced (%" PRId64 " + %" PRId64 " > %" PRId64 ")\n",
+                __func__, v0, n, nextn_req_total);
+        return false;
+    }
+    const int64_t head = nextn_req_head ? 1 : 0;
+    const size_t  row_bytes = (size_t) h->nb[1];
+
+    ggml_backend_t backend_dst = ggml_backend_sched_get_tensor_backend(sched.get(), h);
+    ggml_backend_t backend_src = nextn_req_tgt->nextn_dev_backend;
+    if (!backend_dst && h->buffer) {
+        for (auto * b : backend_ptrs) {
+            if (ggml_backend_supports_buft(b, ggml_backend_buffer_get_type(h->buffer))) { backend_dst = b; break; }
