+static void ggml_cuda_mmvq_y_cache_step(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, const int i) {
+    const bool enabled = GGML_OPUS_ON("GGML_OPUS_Q8PROD");
+    if (!enabled) {
+        return;
+    }
+    auto & yc = ctx.mmvq_y_cache;
+    if (yc.armed && i > yc.last_reader) {
+        ggml_cuda_mmvq_y_cache_release(ctx);
+    }
+    if (yc.armed || ctx.curr_stream_no != 0) {
+        return;
+    }
+    const int cc = ggml_cuda_info().devices[ctx.device].cc;
+    if (!GGML_CUDA_CC_IS_RDNA3_5(cc)) {
+        return;
+    }
+    const ggml_tensor * node = cgraph->nodes[i];
+    ggml_cuda_mmvq_y_key key;
+    if (!ggml_cuda_mmvq_y_reader(node, cc, key)) {
+        return;
+    }
+    const char * y0 = key.y0;
+    const char * y1 = y0 + ggml_nbytes(node->src[1]);
+
+    int last_reader = -1;
+    for (int k = i + 1; k < cgraph->n_nodes && k <= i + 48; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        const char * d0 = (const char *) n->data;
+        if (d0 == nullptr || (d0 < y1 && y0 < d0 + ggml_nbytes(n))) {
+            break;
+        }
+        ggml_cuda_mmvq_y_key kn;
+        if (ggml_cuda_mmvq_y_reader(n, cc, kn) && kn.y0 == key.y0 && kn.ne10 == key.ne10 && kn.nrows == key.nrows &&
+                kn.ne10_padded == key.ne10_padded) {
+            last_reader = k;
+        }
+    }
+    if (last_reader > i) {
+        yc.armed       = true;
+        yc.y0          = key.y0;
+        yc.ne10        = key.ne10;
+        yc.nrows       = key.nrows;
+        yc.ne10_padded = key.ne10_padded;
+        yc.last_reader = last_reader;
+    }
