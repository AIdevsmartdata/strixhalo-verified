+    }
+
+    void end_round() {
+        if (!on) {
+            return;
+        }
+        const int64_t t1 = now();
+        if (idle) {
+            // plus rien a faire : le prochain tour demarre apres une periode inactive (pas de « gap » significatif)
+            prev_valid = false;
+            flush(t1, true);
+            return;
+        }
+        if (!decoded) {
+            return;   // tour sans decodage (taches, attente) : son temps tombe dans le gap du tour suivant
+        }
