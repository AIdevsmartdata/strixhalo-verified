+    CUDA_CHECK(cudaMemcpyAsync(&h_bad, bad.get(), sizeof(int), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    const uint64_t c = n_chk.fetch_add(1, std::memory_order_relaxed) + 1;
+    const uint64_t b = n_bad_rows.fetch_add((uint64_t) h_bad, std::memory_order_relaxed) + (uint64_t) h_bad;
