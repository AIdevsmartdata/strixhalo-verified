+// RMS_NORM -> SCALE fusion, opt-in via GGML_VK_FUSE_RMS_NORM_SCALE. Runs the same
+// width-128 graph on an unfused and a fused device and requires bit-identical F32
+// output. Covers n=1/5/64/2048, a real nb[1] stride, a byte offset, constant and
+// finite-extreme data, and a non-zero bias which must fall back to the unfused path.
+// The env flag is backend-global, so this runs after the parallel workers joined.
+static bool run_rms_norm_scale_exact(ggml_backend_t backend, const char * op_names_filter) {
+    if (!op_names_filter_selects(op_names_filter, "RMS_NORM_SCALE_EXACT")) {
+        return true;
+    }
+    auto * dev = ggml_backend_get_device(backend);
+    if (strcmp(ggml_backend_reg_name(ggml_backend_dev_backend_reg(dev)), "Vulkan") != 0) {
+        return true;
+    }
+    struct scoped_flag {
+        bool present;
+        std::string saved;
+        scoped_flag() {
+            const char * value = getenv("GGML_VK_FUSE_RMS_NORM_SCALE");
+            present = value != nullptr;
+            saved = value ? value : "";
+        }
+        static int set(const char * value) {
+#ifdef _WIN32
+            return _putenv_s("GGML_VK_FUSE_RMS_NORM_SCALE", value ? value : "");
+#else
+            return value ? setenv("GGML_VK_FUSE_RMS_NORM_SCALE", value, 1) : unsetenv("GGML_VK_FUSE_RMS_NORM_SCALE");
+#endif
+        }
+        ~scoped_flag() { set(present ? saved.c_str() : nullptr); }
+    } flag;
+    if (flag.set("0") != 0) { return false; }
+    ggml_backend_ptr off(ggml_backend_dev_init(dev, nullptr));
+    if (flag.set("1") != 0) { return false; }
+    ggml_backend_ptr on(ggml_backend_dev_init(dev, nullptr));
+    if (!off || !on) { return false; }
+    flag.set(flag.present ? flag.saved.c_str() : nullptr);
+
+    const int64_t width  = 128;
+    const int64_t ns[]   = { 1, 5, 64, 2048 };
+    const int64_t pad    = 8;   // extra columns so the row stride is larger than the width
+    const int64_t offset = 64;  // view start in elements (256 bytes, keeps the base aligned)
+    const float   scales[] = { 1.0f / sqrtf(128.0f), 2.0f, -0.75f, 1.0e-20f, 1.0e20f, 0.0f };
+    const int     n_scales = (int) (sizeof(scales) / sizeof(scales[0]));
+    const float   bias_only = 0.5f; // must not fuse
+    const float   eps = 1.0e-6f;
+
+    int n_run = 0, n_fail = 0;
+    for (int64_t n : ns) {
+        for (int strided = 0; strided < 2; ++strided) {
+            // +1 iteration runs the non-zero bias case, which must fall back.
+            for (int si = 0; si <= n_scales; ++si) {
+                const bool  with_bias = si == n_scales;
+                const float scale = with_bias ? 1.0f : scales[si];
+                const float bias  = with_bias ? bias_only : 0.0f;
+
+                const int64_t raw_ne0 = strided ? width + offset + pad : width;
+                const int64_t total   = raw_ne0 * n;
+                const int64_t view_off = strided ? offset * (int64_t) sizeof(float) : 0;
+                const int64_t nb1      = raw_ne0 * (int64_t) sizeof(float);
+
+                ggml_init_params params = {
+                    8 * ggml_tensor_overhead() + ggml_graph_overhead_custom(16, false),
+                    nullptr, true,
+                };
+                ggml_context_ptr ctx(ggml_init(params));
+                ggml_tensor * raw = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, raw_ne0, n);
+                ggml_tensor * a = strided
+                    ? ggml_view_2d(ctx.get(), raw, width, n, nb1, view_off)
+                    : raw;
+                ggml_tensor * rms = ggml_rms_norm(ctx.get(), a, eps);
+                ggml_tensor * out = bias == 0.0f ? ggml_scale(ctx.get(), rms, scale)
+                                                 : ggml_scale_bias(ctx.get(), rms, scale, bias);
+                ggml_cgraph * graph = ggml_new_graph_custom(ctx.get(), 16, false);
+                ggml_build_forward_expand(graph, out);
+                ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors(ctx.get(), off.get()));
+                if (!buffer || !ggml_backend_supports_op(off.get(), out) || !ggml_backend_supports_op(on.get(), out)) {
+                    fprintf(stderr, "RMS_NORM_SCALE_EXACT: allocation or operation unavailable\n");
+                    return false;
+                }
+
+                std::vector<float> data(total);
+                std::vector<float> ref(width * n), act(width * n);
+                const size_t out_bytes = (size_t) width * (size_t) n * sizeof(float);
+                for (int pattern = 0; pattern < 6; ++pattern) {
+                    std::mt19937 rng(777 + pattern + 31 * (int) n + strided);
+                    for (int64_t i = 0; i < total; ++i) {
+                        switch (pattern) {
+                            case 0: data[i] = 1.0f; break;
+                            case 1: data[i] = (i % 2) ? -1.0e30f : 1.0e30f; break;
+                            case 2: data[i] = (i % 2) ? -1.0e-40f : 1.0e-40f; break;
+                            case 3: data[i] = (i % 3 == 0) ? -0.0f : 0.0f; break;
+                            case 4: data[i] = (float) ((int) (i % 2001) - 1000) / 100.0f; break;
+                            default: data[i] = (float) (rng() % 2001) / 100.0f - 10.0f; break;
+                        }
+                    }
+                    ggml_backend_tensor_set(raw, data.data(), 0, (size_t) total * sizeof(float));
+
+                    bool ok = true;
+                    for (int enabled = 0; enabled < 2; ++enabled) {
+                        ggml_backend_t current = enabled ? on.get() : off.get();
+                        if (ggml_backend_graph_compute(current, graph) != GGML_STATUS_SUCCESS) { ok = false; break; }
+                        ggml_backend_tensor_get(out, enabled ? act.data() : ref.data(), 0, out_bytes);
+                    }
+                    ok = ok && memcmp(ref.data(), act.data(), out_bytes) == 0;
+                    printf("  RMS_NORM_SCALE_EXACT(n=%lld,strided=%d,scale=%g,bias=%g,pattern=%d): %s\n",
+                           (long long) n, strided, scale, bias, pattern, ok ? "OK" : "FAIL");
+                    ++n_run;
+                    n_fail += !ok;
+                }
+            }
+        }
+    }
+    printf("  RMS_NORM_SCALE_EXACT: %d cases, %d failed\n", n_run, n_fail);
+    return n_fail == 0;
+}
