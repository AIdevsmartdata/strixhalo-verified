+    auto fail = [&](const char * reason, int at, llama_token got_id, llama_token cpu_id, float got_val, float cpu_val) {
+        static std::atomic<bool> reported{false};
+        if (reported.exchange(true)) {
+            return;
+        }
+        uint32_t got_bits = 0, cpu_bits = 0;
+        std::memcpy(&got_bits, &got_val, sizeof(got_bits));
+        std::memcpy(&cpu_bits, &cpu_val, sizeof(cpu_bits));
+        LLAMA_LOG_WARN("[TOPK_CHECK] reason=%s seq=%d input=%d row=%lld n_outputs=%d slots=%u chain=%s k=%u width=%u pass_tokens=%u src_ne=%s src_nb=%s dst_ne=%s dst_nb=%s val_ne=%s val_nb=%s src_rel=%td dst_rel=%td val_rel=%td at=%d got_id=%d got_val=%a got_bits=%08x cpu_id=%d cpu_val=%a cpu_bits=%08x\n",
+                reason, info.seq, i, (long long) row, topk_check_n_outputs, info.n_slots, info.proposal ? "proposal" : "standard",
+                out.n_logits, info.width, info.pass_tokens, info.src_ne.c_str(), info.src_nb.c_str(), info.dst_ne.c_str(), info.dst_nb.c_str(),
+                info.val_ne.c_str(), info.val_nb.c_str(), info.src_rel, info.dst_rel, info.val_rel, at, got_id, got_val, got_bits, cpu_id, cpu_val, cpu_bits);
+    };
+
+    if (!info.source_ok || (size_t) (row + 1)*n_vocab > topk_check_logits.size()) {
+        fail("source-layout", -1, -1, -1, 0.0f, 0.0f);
+        return;
+    }
+    if (out.n_candidates != out.n_logits || out.n_logits > (uint32_t) n_vocab) {
+        fail("candidate-count", -1, -1, -1, 0.0f, 0.0f);
+        return;
+    }
+    if (out.candidates != sampling.candidates.data + row*n_vocab || out.sampled_logits != sampling.logits.data + row*n_vocab) {
+        fail("host-row", -1, -1, -1, 0.0f, 0.0f);
+        return;
+    }
+
+    const float * source = topk_check_logits.data() + row*n_vocab;
+    std::vector<bool> seen(n_vocab, false);
+    for (uint32_t j = 0; j < out.n_logits; ++j) {
+        const llama_token id = out.candidates[j];
+        const float value = out.sampled_logits[j];
+        if (id < 0 || id >= n_vocab) {
+            fail("id-range", j, id, -1, value, 0.0f);
+            return;
+        }
+        if (seen[id]) {
+            fail("id-duplicate", j, id, -1, value, 0.0f);
+            return;
+        }
+        seen[id] = true;
+        if (!std::isfinite(value)) {
+            fail("value-finite", j, id, -1, value, 0.0f);
+            return;
+        }
+        if (j > 0 && out.sampled_logits[j - 1] < value) {
+            fail("value-order", j, id, -1, value, 0.0f);
+            return;
+        }
+    }
+
+    std::vector<llama_token> ref(n_vocab);
+    std::iota(ref.begin(), ref.end(), 0);
+    const auto better = [source](llama_token a, llama_token b) {
+        const bool a_nan = std::isnan(source[a]);
+        const bool b_nan = std::isnan(source[b]);
+        if (a_nan != b_nan) return !a_nan;
+        if (!a_nan) {
+            if (source[a] > source[b]) return true;
+            if (source[a] < source[b]) return false;
+        }
+        return a < b;
+    };
+    std::partial_sort(ref.begin(), ref.begin() + out.n_logits, ref.end(), better);
+    for (uint32_t j = 0; j < out.n_logits; ++j) {
+        if (out.candidates[j] != ref[j] || out.sampled_logits[j] != source[ref[j]]) {
+            fail("cpu-topk", j, out.candidates[j], ref[j], out.sampled_logits[j], source[ref[j]]);
+            return;
+        }
+    }
+}
