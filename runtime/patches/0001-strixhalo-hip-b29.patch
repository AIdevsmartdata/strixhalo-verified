+//
+// WARMHOST (14/10/2026, Claude Opus, GAINS2) : tokenisation incrementale des tours chauds, BIT-EXACTE.
+//
+// Probleme : a chaque tour chaud, pi renvoie tout l'historique ; le serveur rend le gabarit (chaine de ~100 Ko a 500 Ko) puis la tokenise en entier
+// (llama_tokenize : partition des jetons speciaux + pre-tokeniseur regex + BPE sur TOUT le texte) alors que seul le dernier tour est nouveau.
+//
+// Principe : llama_vocab::impl::tokenizer_st_partition decoupe le texte aux jetons speciaux (CONTROL / USER_DEFINED / UNKNOWN) et chaque fragment de
+// texte brut est tokenise INDEPENDAMMENT (src/llama-vocab.cpp, boucle sur les fragments). Donc, si une frontiere B est un jeton special qui ne peut
+// chevaucher aucun autre jeton special (verifie a l'initialisation, sans attribut LSTRIP/RSTRIP) :
+//     tokens(P[0:off_B] + P[off_B:]) = tokens(P[0:off_B]) ++ tokens(P[off_B:])      (off_B = fin de l'occurrence de B)
+// On garde en memoire quelques prompts recents (chaine + jetons + liste de frontieres (offset, nb de jetons)). Pour un nouveau prompt, on prend
+// l'entree de plus long prefixe commun L (octets), la derniere frontiere avec off_B + marge <= L, on recopie les jetons de l'entree jusqu'a la
+// frontiere et on ne tokenise que le suffixe. Resultat identique, au bit pres, a llama_tokenize(texte entier, add_special=true, parse_special=true)
+// des que le vocabulaire est BPE sans BOS/EOS automatique (sinon le mecanisme se desactive : chemin d'origine).
+// Interrupteur : LLAMA_OPUS_WARMHOST = 0 (defaut, chemin inchange) | 1 (actif) | 2 (actif + verification contre la tokenisation complete, journal).
+//
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+
+namespace {
+
+struct wh_cp { size_t off; size_t idx; };           // off : octet juste apres l'occurrence ; idx : nombre de jetons jusqu'a elle INCLUSE
+
+struct wh_entry {
+    std::string  text;
+    llama_tokens toks;
+    std::vector<wh_cp> cps;                          // croissant en off et en idx
+};
+
+struct wh_bnd { std::string s; llama_token id; };
+
+struct wh_ctx {
+    std::mutex mu;
+    std::vector<std::pair<uint64_t, std::shared_ptr<const wh_entry>>> v;   // (horodatage d'usage, entree)
+    uint64_t clock = 0;
+    const llama_vocab * vocab = nullptr;
+    bool ok = false;
+    std::vector<wh_bnd> bnd;
+    size_t cap = 8;
+    size_t min_common = 2048;                        // en dessous : tokenisation complete
+};
+
+wh_ctx & wh() { static wh_ctx c; return c; }
+
+int wh_env_int(const char * k, int d) {
+    const char * e = getenv(k);
+    if (!e || !*e) return d;
+    return atoi(e);
+}
+
+// vrai si un suffixe de a est un prefixe de b
+bool wh_border(const std::string & a, const std::string & b) {
+    const size_t m = std::min(a.size(), b.size());
+    for (size_t k = 1; k <= m; ++k) {
+        if (a.compare(a.size() - k, k, b, 0, k) == 0) return true;
+    }
+    return false;
+}
+
+// a appeler sous verrou
+void wh_init(wh_ctx & c, const llama_vocab * vocab) {
+    c.vocab = vocab;
+    c.ok = false;
+    c.bnd.clear();
+    c.v.clear();
+    c.cap        = (size_t) std::max(1, wh_env_int("LLAMA_OPUS_WARMHOST_N", 8));
+    c.min_common = (size_t) std::max(0, wh_env_int("LLAMA_OPUS_WARMHOST_MIN", 2048));
+    if (llama_vocab_type(vocab) != LLAMA_VOCAB_TYPE_BPE || llama_vocab_get_add_bos(vocab) || llama_vocab_get_add_eos(vocab)) {
+        LOG_WRN("WARMHOST : vocabulaire non BPE ou BOS/EOS automatique, mecanisme desactive\n");
+        return;
+    }
+    const char * e = getenv("LLAMA_OPUS_WARMHOST_BND");
+    std::vector<std::string> want;
+    {
+        std::string s = (e && *e) ? e : "<|im_end|>,<|im_start|>";
+        size_t p = 0;
+        while (p <= s.size()) {
+            size_t q = s.find(',', p);
+            if (q == std::string::npos) q = s.size();
+            if (q > p) want.push_back(s.substr(p, q - p));
+            p = q + 1;
+        }
+    }
+    const int32_t n = llama_vocab_n_tokens(vocab);
+    const int special_mask = LLAMA_TOKEN_ATTR_CONTROL | LLAMA_TOKEN_ATTR_USER_DEFINED | LLAMA_TOKEN_ATTR_UNKNOWN;
+    std::vector<std::string> specials;               // textes de tous les jetons de la partition
+    std::vector<llama_token> ids;
+    for (llama_token t = 0; t < n; ++t) {
+        if ((int) llama_vocab_get_attr(vocab, t) & special_mask) {
+            const char * tx = llama_vocab_get_text(vocab, t);
+            specials.push_back(tx ? tx : "");
+            ids.push_back(t);
+        }
+    }
+    for (const auto & w : want) {
+        llama_token id = LLAMA_TOKEN_NULL;
+        int n_match = 0;
+        for (size_t i = 0; i < specials.size(); ++i) {
+            if (specials[i] == w) { id = ids[i]; ++n_match; }
+        }
+        if (n_match != 1) { LOG_WRN("WARMHOST : frontiere '%s' absente ou ambigue, ignoree\n", w.c_str()); continue; }
+        const int attr = (int) llama_vocab_get_attr(vocab, id);
+        if ((attr & (LLAMA_TOKEN_ATTR_LSTRIP | LLAMA_TOKEN_ATTR_RSTRIP)) || !(attr & special_mask)) {
+            LOG_WRN("WARMHOST : frontiere '%s' avec LSTRIP/RSTRIP ou non speciale, ignoree\n", w.c_str());
+            continue;
+        }
+        bool clash = false;
+        for (size_t i = 0; i < specials.size() && !clash; ++i) {
+            if (ids[i] == id || specials[i].empty()) continue;
+            const std::string & o = specials[i];
+            if (o.find(w) != std::string::npos || w.find(o) != std::string::npos || wh_border(w, o) || wh_border(o, w)) clash = true;
+        }
+        if (clash) { LOG_WRN("WARMHOST : frontiere '%s' chevauche un autre jeton special, ignoree\n", w.c_str()); continue; }
+        c.bnd.push_back({w, id});
+    }
+    // deux frontieres ne doivent pas se chevaucher entre elles non plus (deja couvert : ce sont des jetons speciaux distincts)
+    c.ok = !c.bnd.empty();
+    LOG_INF("WARMHOST : %zu frontiere(s) active(s), cache de %zu prompt(s)\n", c.bnd.size(), c.cap);
+}
+
+// positions (offset de fin, indice de la frontiere) de toutes les occurrences, par ordre croissant, a partir de `from`
+std::vector<std::pair<size_t, int>> wh_scan_text(const std::string & t, size_t from, const std::vector<wh_bnd> & bnd) {
+    std::vector<std::pair<size_t, int>> r;
+    for (size_t b = 0; b < bnd.size(); ++b) {
+        const std::string & s = bnd[b].s;
+        size_t p = from;
+        while ((p = t.find(s, p)) != std::string::npos) {
+            r.push_back({p + s.size(), (int) b});
+            p += s.size();
+        }
+    }
+    std::sort(r.begin(), r.end());
+    return r;
+}
+
+// construit les frontieres d'une portion : text a partir de `off0`, jetons a partir de `idx0` ; renvoie false si texte et jetons ne concordent pas
+bool wh_build_cps(const std::string & text, size_t off0, const llama_tokens & toks, size_t idx0, const std::vector<wh_bnd> & bnd, std::vector<wh_cp> & out) {
+    auto occ = wh_scan_text(text, off0, bnd);
+    std::vector<size_t> tix;                         // indices (1-based, "jusqu'a elle incluse") des jetons-frontieres dans toks[idx0:]
+    std::vector<int> tkind;
+    for (size_t i = idx0; i < toks.size(); ++i) {
+        for (size_t b = 0; b < bnd.size(); ++b) {
+            if (toks[i] == bnd[b].id) { tix.push_back(i + 1); tkind.push_back((int) b); break; }
+        }
+    }
+    if (occ.size() != tix.size()) return false;
+    for (size_t k = 0; k < occ.size(); ++k) {
+        if (occ[k].second != tkind[k]) return false;
+        out.push_back({occ[k].first, tix[k]});
+    }
+    return true;
+}
+
+llama_tokens wh_full(const llama_vocab * vocab, const std::string & text, bool add_special) {
+    // identique a mtmd_tokenize_text_internal / common_tokenize
+    int n_tokens = (int) text.length() + 2 * add_special;
+    llama_tokens result(n_tokens);
+    n_tokens = llama_tokenize(vocab, text.data(), (int32_t) text.length(), result.data(), (int32_t) result.size(), add_special, true);
+    if (n_tokens < 0) {
+        result.resize(-n_tokens);
+        int check = llama_tokenize(vocab, text.data(), (int32_t) text.length(), result.data(), (int32_t) result.size(), add_special, true);
+        GGML_ASSERT(check == -n_tokens);
+    } else {
+        result.resize(n_tokens);
+    }
+    return result;
+}
+
+} // namespace
+
+int opus_warmhost_mode() {
+    static const int m = []() { int v = wh_env_int("LLAMA_OPUS_WARMHOST", 0); return v < 0 ? 0 : (v > 2 ? 2 : v); }();
+    return m;
+}
+
+void opus_warmhost_reset() {
+    auto & c = wh();
+    std::lock_guard<std::mutex> lk(c.mu);
+    c.v.clear();
+    c.vocab = nullptr;
+}
+
+llama_tokens opus_warmhost_tokenize(const llama_vocab * vocab, const std::string & text, opus_warmhost_info * info) {
+    const int mode = opus_warmhost_mode();
+    const int64_t t0 = ggml_time_us();
+    opus_warmhost_info local;
+    opus_warmhost_info & I = info ? *info : local;
+    I = opus_warmhost_info();
+
+    auto & c = wh();
+    std::shared_ptr<const wh_entry> best;
+    size_t best_lcp = 0;
+    std::vector<wh_bnd> bnd;
+    size_t min_common = 0;
+    {
+        std::lock_guard<std::mutex> lk(c.mu);
+        if (c.vocab != vocab) wh_init(c, vocab);
+        if (c.ok) {
+            bnd = c.bnd;
+            min_common = c.min_common;
+            for (auto & pr : c.v) {
+                const std::string & a = pr.second->text;
+                const size_t m = std::min(a.size(), text.size());
+                const size_t l = (size_t) (std::mismatch(a.begin(), a.begin() + m, text.begin()).first - a.begin());
+                if (l > best_lcp) { best_lcp = l; best = pr.second; }
+            }
+            if (best) {
+                for (auto & pr : c.v) { if (pr.second == best) { pr.first = ++c.clock; break; } }
+            }
+        }
+    }
+    if (bnd.empty()) {
+        return wh_full(vocab, text, true);           // mecanisme desactive : chemin d'origine
+    }
+
+    llama_tokens out;
+    std::vector<wh_cp> cps;
+    bool used = false;
+    if (best && best_lcp >= min_common) {
+        // derniere frontiere dont l'occurrence est ENTIEREMENT dans le prefixe commun (off <= best_lcp)
+        const auto & v = best->cps;
+        size_t lo = 0, hi = v.size();                // premier cp avec off > best_lcp
+        while (lo < hi) { size_t mid = (lo + hi) / 2; if (v[mid].off <= best_lcp) lo = mid + 1; else hi = mid; }
+        if (lo > 0) {
+            const wh_cp & cp = v[lo - 1];
+            out.assign(best->toks.begin(), best->toks.begin() + cp.idx);
+            const std::string suffix = text.substr(cp.off);
+            if (!suffix.empty()) {
+                llama_tokens st = wh_full(vocab, suffix, false);
+                out.insert(out.end(), st.begin(), st.end());
+            }
+            cps.assign(v.begin(), v.begin() + lo);
+            used = true;
+            I.reuse_bytes  = cp.off;
+            I.reuse_tokens = cp.idx;
+            I.suffix_bytes = text.size() - cp.off;
+        }
+    }
+    if (!used) {
+        out = wh_full(vocab, text, true);
+        cps.clear();
+    }
+
+    // frontieres du nouveau prompt : on garde celles du prefixe reutilise, on scanne le reste ; en cas d'incoherence, on n'en garde aucune
+    bool cps_ok = true;
+    {
+        const size_t off0 = used ? cps.back().off : 0;
+        const size_t idx0 = used ? cps.back().idx : 0;
+        if (!wh_build_cps(text, off0, out, idx0, bnd, cps)) { cps_ok = false; cps.clear(); }
+    }
+    I.used = used;
+    I.ms   = (ggml_time_us() - t0) / 1000.0;
+
+    if (mode == 2) {
+        const int64_t tv = ggml_time_us();
+        llama_tokens ref = wh_full(vocab, text, true);
+        I.verified = true;
+        I.verify_ms = (ggml_time_us() - tv) / 1000.0;
+        if (ref != out) {
+            I.verify_ok = false;
+            LOG_ERR("WARMHOST : DIFFERENCE de jetons (reuse=%zu octets, %zu jetons) : repli sur la tokenisation complete\n", I.reuse_bytes, I.reuse_tokens);
+            out = std::move(ref);
+            cps.clear();
+            cps_ok = false;
+        }
+    }
+
+    if (cps_ok) {
+        auto e = std::make_shared<wh_entry>();
+        e->text = text;
+        e->toks = out;
+        e->cps  = std::move(cps);
+        std::lock_guard<std::mutex> lk(c.mu);
+        if (c.vocab == vocab) {
+            // remplace la lignee (entree qui partage au moins la moitie de son contenu avec le nouveau prompt), sinon insere / evince la plus ancienne
+            bool done = false;
+            if (best && best_lcp * 2 >= best->text.size()) {
+                for (auto & pr : c.v) {
+                    if (pr.second == best) { pr.second = e; pr.first = ++c.clock; done = true; break; }
+                }
+            }
+            if (!done) {
+                if (c.v.size() >= c.cap) {
+                    size_t k = 0;
+                    for (size_t i = 1; i < c.v.size(); ++i) if (c.v[i].first < c.v[k].first) k = i;
+                    c.v.erase(c.v.begin() + k);
+                }
+                c.v.push_back({++c.clock, e});
+            }
+        }
+    }
+    return out;
+}
