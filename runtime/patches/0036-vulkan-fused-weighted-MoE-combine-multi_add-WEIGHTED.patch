-    static_assert(MAX_PARAMETER_COUNT == 12);
     ggml_vk_dispatch_pipeline(ctx, subctx, pipeline,
         {
             ggml_vk_subbuffer(ctx, buf[0], offset[0]),
@@ -13526,6 +13659,112 @@ static void ggml_vk_gated_delta_net(
 
     const uint32_t s_off = S_v * H * n_tokens * n_seqs;
 
+    // [TAG_GDN_VK_CHUNKED] chunked parallel path (PR #20377 port), valid only for the
+    // plain K=1 op: no MTP snapshot slots, no fused cache, no state-ring fusion.
+    static const bool vk_gdn_chunked_enabled = getenv("LLAMA_GDN_VK_CHUNKED") != nullptr;
+    static constexpr uint32_t GDN_CHUNK_SIZE = 64;
+    const ggml_tensor * src_g = dst->src[3];
+    const bool kda = (src_g->ne[0] == (int64_t)S_v);
+    const bool use_chunked = vk_gdn_chunked_enabled
+        && K == 1 && fused_cache_dst == nullptr && fused_state_ring == nullptr
+        && !kda && S_v == 128 && n_tokens > GDN_CHUNK_SIZE;
+
+    if (use_chunked) {
+        const uint32_t n_chunks = (n_tokens + GDN_CHUNK_SIZE - 1) / GDN_CHUNK_SIZE;
+
+        vk_pipeline pl_intra  = ctx->device->pipeline_gated_delta_net_chunk_intra;
+        vk_pipeline pl_inter  = ctx->device->pipeline_gated_delta_net_chunk_inter;
+        vk_pipeline pl_output = ctx->device->pipeline_gated_delta_net_chunk_output_cm
+                              ? ctx->device->pipeline_gated_delta_net_chunk_output_cm
+                              : ctx->device->pipeline_gated_delta_net_chunk_output;
+        if (!pl_intra || !pl_inter || !pl_output) {
+            // coopmat/base pipelines not built on this device -> caller falls through below
+            GGML_ABORT("GDN chunked pipelines missing");
+        }
+
+        ggml_pipeline_request_descriptor_sets(ctx, pl_intra, 1);
+        ggml_pipeline_request_descriptor_sets(ctx, pl_inter, 1);
+        ggml_pipeline_request_descriptor_sets(ctx, pl_output, 1);
+
+        vk_subbuffer dst_buf_c = ggml_vk_tensor_subbuffer(ctx, dst);
+        vk_subbuffer src_buf_c[6] = {};
+        for (int i = 0; i < 6; i++) {
+            src_buf_c[i] = ggml_vk_tensor_subbuffer(ctx, dst->src[i]);
+        }
+
+        const uint32_t sq1c = (uint32_t)(src_q->nb[1] / sizeof(float));
+        const uint32_t sq2c = (uint32_t)(src_q->nb[2] / sizeof(float));
+        const uint32_t sq3c = (uint32_t)(src_q->nb[3] / sizeof(float));
+        const uint32_t sv1c = (uint32_t)(src_v->nb[1] / sizeof(float));
+        const uint32_t sv2c = (uint32_t)(src_v->nb[2] / sizeof(float));
+        const uint32_t sv3c = (uint32_t)(src_v->nb[3] / sizeof(float));
+        const uint32_t sb1c = (uint32_t)(src_beta->nb[1] / sizeof(float));
+        const uint32_t sb2c = (uint32_t)(src_beta->nb[2] / sizeof(float));
+        const uint32_t sb3c = (uint32_t)(src_beta->nb[3] / sizeof(float));
+        const uint32_t neq1c = (uint32_t)src_q->ne[1];
+        const uint32_t rq3c  = (uint32_t)(src_v->ne[3] / src_q->ne[3]);
+
+        // scratch layout inside prealloc_split_k (PR #20377 layout)
+        const size_t wu_size = (size_t)n_seqs * n_chunks * H * GDN_CHUNK_SIZE * S_v * sizeof(float);
+        const size_t d_size  = (size_t)n_seqs * n_chunks * H * sizeof(float);
+        const size_t g_size  = (size_t)n_seqs * n_chunks * H * GDN_CHUNK_SIZE * sizeof(float);
+        const size_t h_size  = (size_t)n_seqs * n_chunks * H * S_v * S_v * sizeof(float);
+        const size_t vn_off  = 2 * wu_size;
+        const size_t dec_off  = 3 * wu_size;
+        const size_t gcum_off = dec_off + d_size;
+        const size_t h_off    = gcum_off + g_size;
+        const size_t total_scratch = h_off + h_size;
+
+        if (total_scratch > ctx->device->properties.limits.maxStorageBufferRange) {
+            // too big for SSBO range -> let the AR path below handle it
+        } else {
+            if (ctx->prealloc_size_split_k < total_scratch) {
+                ctx->prealloc_size_split_k = total_scratch;
+                ggml_vk_preallocate_buffers(ctx, subctx);
+            }
+            if (ctx->prealloc_split_k_need_sync) {
+                ggml_vk_sync_buffers(ctx, subctx);
+            }
+
+            vk_subbuffer scratch_w    = { ctx->prealloc_split_k, 0,        wu_size };
+            vk_subbuffer scratch_u    = { ctx->prealloc_split_k, wu_size,  wu_size };
+            vk_subbuffer scratch_vnew = { ctx->prealloc_split_k, vn_off,   wu_size };
+            vk_subbuffer scratch_dec  = { ctx->prealloc_split_k, dec_off,  d_size  };
+            vk_subbuffer scratch_gcum = { ctx->prealloc_split_k, gcum_off, g_size  };
+            vk_subbuffer scratch_h    = { ctx->prealloc_split_k, h_off,    h_size  };
+
+            const vk_op_gated_delta_net_chunk_push_constants pc_c = {
+                H, n_tokens, n_seqs,
+                sq1c, sq2c, sq3c,
+                sv1c, sv2c, sv3c,
+                sb1c, sb2c, sb3c,
+                neq1c, rq3c,
+                n_chunks, s_off
+            };
+
+            ggml_vk_dispatch_pipeline(ctx, subctx, pl_intra,
+                {src_buf_c[1], src_buf_c[2], src_buf_c[3], src_buf_c[4],
+                 scratch_w, scratch_u, scratch_dec, scratch_gcum},
+                pc_c, { n_chunks * H, n_seqs, 1u });
+
+            ggml_vk_sync_buffers(ctx, subctx);
+
+            ggml_vk_dispatch_pipeline(ctx, subctx, pl_inter,
+                {src_buf_c[1], scratch_w, scratch_u, scratch_dec, scratch_gcum,
+                 src_buf_c[5], scratch_h, scratch_vnew, dst_buf_c},
+                pc_c, { H, n_seqs, 1u });
+
+            ggml_vk_sync_buffers(ctx, subctx);
+
