@@ -109,7 +114,15 @@ void main() {
 
     const uint state_size = S_V * S_V;
     // input state holds s0 only [S_v, S_v, H, n_seqs]: per-seq stride is H*D.
-    const uint state_in_base       = (seq_id * H + head_id) * state_size;
+    // Fused input path: the GET_ROWS gather is elided; read the recurrent ring
+    // row given by the runtime index instead. Row layout is head-major, so the
+    // (head, col, row) addressing inside the row is unchanged.
+    uint state_in_base;
+    if (use_fused_state == 1u) {
+        state_in_base = uint(data_idx[seq_id]) * state_row_stride + head_id * state_size;
+    } else {
+        state_in_base = (seq_id * H + head_id) * state_size;
+    }
