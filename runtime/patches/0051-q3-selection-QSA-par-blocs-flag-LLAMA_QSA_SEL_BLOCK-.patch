+private:
+    void qsa_dump_read() {
+        const char * path = qsa_sel_dump_path();
+        if (path == nullptr) {
+            return;
+        }
+
+        // attendre que tous les sinks soient alloues : sinon la premiere lecture lirait du vide
+        for (ggml_tensor * t : dump_sinks) {
+            if (t != nullptr && t->buffer == nullptr) {
+                return;
+            }
+        }
+        if (!dump_armed) {
+            dump_armed = true;   // le pas suivant lira la selection du pas courant
+            return;
+        }
+
+        static FILE * f       = nullptr;
+        static long   step    = 0;
+        static int    skipped = 0;
+        if (f == nullptr) {
+            f = fopen(path, "w");
+            if (f == nullptr) {
+                return;
