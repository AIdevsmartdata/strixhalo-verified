+    env_set("DEDUP=0,COST=0");
+    { server_prompt_cache c(64, 131072); CHECK(!c.evic.on()); }
+    env_set("DEDUP=abc,COST=");
+    { server_prompt_cache c(64, 131072); CHECK(!c.evic.on()); }
+    env_set("DEDUP=1");
+    { server_prompt_cache c(64, 131072); CHECK(c.evic.on()); CHECK(c.evic.dedup); CHECK(!c.evic.cost); CHECK(c.evic.dedup_pct == 90); CHECK(c.evic.prot_s == 900); }
+    env_set("COST=1,DEDUP_PCT=10,PROT_PCT=500,DEDUP_MAX=0,DEDUP_MIN_TOK=0,PROT_S=-5,ADMIT=0,HALF_S=7");
+    { server_prompt_cache c(64, 131072); CHECK(c.evic.cost); CHECK(c.evic.dedup_pct == 50); CHECK(c.evic.prot_pct == 100); CHECK(c.evic.dedup_max == 1);
+      CHECK(c.evic.dedup_min_tok == 1); CHECK(c.evic.prot_s == 0); CHECK(c.evic.admit == 0); CHECK(c.evic.half_s == 7); }
+    env_set("COST=1");
+    { server_prompt_cache c(64, 131072); CHECK(c.evic.admit == 200); }
