     );
 }
 
@@ -1962,7 +1964,8 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
          ggml_tensor * up_exps_s,
          ggml_tensor * gate_exps_s,
          ggml_tensor * down_exps_s,
-         ggml_tensor * selected_experts_in) const {
+         ggml_tensor * selected_experts_in,
+         ggml_tensor ** es_noise_out) const {
     const int64_t n_embd   = cur->ne[0];
     const int64_t n_tokens = cur->ne[1];
     const bool weight_before_ffn = arch == LLM_ARCH_LLAMA4; // for llama4, we apply the sigmoid-ed weights before the FFN
@@ -2054,8 +2057,53 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
     // select experts
     ggml_tensor * selected_experts = selected_experts_in;
     if (selected_experts == nullptr) {
-        selected_experts = ggml_argsort_top_k(ctx0, selection_probs, n_expert_used); // [n_expert_used, n_tokens]
-        cb(selected_experts->src[0], "ffn_moe_argsort", il);
+        if (es_noise_out != nullptr && n_expert_used >= 6 && n_tokens > 0 && n_expert >= 4*n_expert_used) {
+            // [TAG_EXPERT_SAMPLE] Expert-Sample routing (arXiv 2602.02443): keep the top
+            // k_keep experts deterministic, sample the remaining experts from the tail of
+            // the top r=4k candidates, Gumbel-perturbed over log-probs (sample ∝ p).
+            // The aggregation weights stay the original softmax probs (unchanged below).
+            const int64_t k_keep = n_expert_used / 2 + 1;
+            const int64_t r      = 4 * n_expert_used;
+            const int64_t n_cand = r - k_keep;
+
+            ggml_tensor * top_all = ggml_argsort_top_k(ctx0, selection_probs, r); // [r, n_tokens]
+            cb(top_all, "ffn_moe_argsort_es", il);
+
+            ggml_tensor * top_keep = ggml_view_2d(ctx0, top_all, k_keep, n_tokens, top_all->nb[1], 0);
+            ggml_tensor * cand_ids = ggml_view_2d(ctx0, top_all, n_cand, n_tokens, top_all->nb[1], k_keep*ggml_type_size(top_all->type));
+            ggml_tensor * cand_ids_c = ggml_cont(ctx0, cand_ids); // [n_cand, n_tokens]
+
+            // this fork's get_rows gathers along dim 1: a=[1, n_expert, n_tokens], ids=[k, n_tokens] -> [1, k, n_tokens, 1]
+            ggml_tensor * sel3 = ggml_reshape_3d(ctx0, selection_probs, 1, n_expert, n_tokens);
+            ggml_tensor * cand_prob = ggml_get_rows(ctx0, sel3, cand_ids_c); // [1, n_cand, n_tokens, 1]
+            cand_prob = ggml_reshape_2d(ctx0, cand_prob, n_cand, n_tokens);
+            cand_prob = ggml_clamp(ctx0, cand_prob, 1e-12f, 1.0f);
+            ggml_tensor * cand_lp = ggml_log(ctx0, cand_prob); // [n_cand, n_tokens]
+
+            if (getenv("LLAMA_ES_DEBUG")) {
+                fprintf(stderr, "[ES_DEBUG] n_tokens=%lld n_expert=%lld cand_lp=[%lld,%lld,%lld,%lld]\n",
+                    (long long) n_tokens, (long long) n_expert,
+                    (long long) cand_lp->ne[0], (long long) cand_lp->ne[1], (long long) cand_lp->ne[2], (long long) cand_lp->ne[3]);
+            }
+
+            ggml_tensor * noise = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_cand, n_tokens);
+            ggml_set_input(noise);
+            ggml_set_name(noise, "ffn_moe_gumbel_noise");
+            *es_noise_out = noise;
+
+            ggml_tensor * perturbed = ggml_add(ctx0, cand_lp, noise); // [n_cand, n_tokens]
+            ggml_tensor * sampled_idx = ggml_argsort_top_k(ctx0, perturbed, n_expert_used - k_keep); // [k-k_keep, n_tokens]
+
+            ggml_tensor * cand3 = ggml_reshape_3d(ctx0, cand_ids_c, 1, n_cand, n_tokens);
+            ggml_tensor * sampled = ggml_get_rows(ctx0, cand3, sampled_idx); // [1, k-k_keep, n_tokens, 1]
+            sampled = ggml_reshape_2d(ctx0, sampled, n_expert_used - k_keep, n_tokens);
+
+            selected_experts = ggml_concat(ctx0, ggml_cont(ctx0, top_keep), sampled, 0); // [n_expert_used, n_tokens]
+            cb(selected_experts, "ffn_moe_topk_es", il);
+        } else {
+            selected_experts = ggml_argsort_top_k(ctx0, selection_probs, n_expert_used); // [n_expert_used, n_tokens]
+            cb(selected_experts->src[0], "ffn_moe_argsort", il);
+        }
     }
     cb(selected_experts, "ffn_moe_topk", il);
 
