+// ---- OPUS PLEFILE (agent BPLE, 15/10/2026 ; LLAMA_OPUS_PLE_FILE, OFF par defaut) ----
+// The n-gram table (per_layer_token_embd, read row by row by llama_ple_disk with -lzm on-direct) is read from ANOTHER
+// file that holds the same bytes: a second copy of the GGUF (same layout, same offset) or an extract of the table alone
+// (offset 0), on the same disk (other physical blocks, younger data) or on another disk. Only the SOURCE of the bytes
+// changes: the gather, its caches, the prefetch pools and the dequantization are untouched, so every value is identical
+// as long as the bytes are (classe B). Before switching, rows are read from both files and compared byte for byte (first
+// row, last row, then a fixed pseudo-random sample); one difference, a short file or a read error keeps the GGUF. The
+// verification reads alternate between the two files (O_DIRECT when possible) and their latencies are logged: a
+// same-moment comparison of the two sources of the bytes, at every load.
+//   LLAMA_OPUS_PLE_FILE=<path>         alternate source of the table (absent or empty = OFF, nothing changes)
+//   LLAMA_OPUS_PLE_FILE_OFFSET=<bytes> offset of row 0 in that file (default: the GGUF's offset if both files have the
+//                                      same size, 0 if the file is exactly the size of the table, otherwise refused)
+//   LLAMA_OPUS_PLE_FILE_VERIFY=<n>     rows compared before switching (default 4096, minimum 64)
+#if defined(__linux__)
+// Comparison of a copy of the table with the GGUF (PLEFILE, PLEDOUBLE): rows read from both files and compared byte for byte.
+struct qwen4exp_ple_check {
+    bool    ok     = false;
+    bool    same   = false;   // `alt` is the reference file itself (nothing compared)
+    size_t  aoffs  = 0;       // offset of row 0 in the copy
+    int64_t n_rows = 0;       // rows compared
+    double  s_all  = 0;
+    bool    dio    = false;
+    double  g[4]   = {0, 0, 0, 0};   // reference: p50 p90 p99 max (ms)
+    double  a[4]   = {0, 0, 0, 0};   // copy
+};
+
+// `tag` prefixes every line, `tail` ends every refusal (what is read instead). Offset of row 0 in `alt`: the env variable
+// `offs_env` when set (nullptr: none), else the reference's offset when both files have the same size (full copy), 0 when
+// `alt` is exactly the size of the table (extract), otherwise refused.
+static qwen4exp_ple_check qwen4exp_ple_copy_check(const char * tag, const char * tail, const std::string & fname, size_t offs,
+                                                  const char * alt, const char * offs_env, int64_t n_verify, size_t row_size,
+                                                  int64_t n_rows) {
+    qwen4exp_ple_check res;
+    const size_t tbytes = row_size * (size_t) n_rows;
+    struct stat sg {}, sa {};
+    if (stat(fname.c_str(), &sg) != 0 || stat(alt, &sa) != 0) {
+        LLAMA_LOG_ERROR("%s: REFUSE : stat(%s) impossible (%s) ; %s\n", tag, alt, strerror(errno), tail);
+        return res;
+    }
+    if (sg.st_dev == sa.st_dev && sg.st_ino == sa.st_ino) {
+        res.same = true;
+        return res;
+    }
+    size_t aoffs = 0;
+    if (const char * e = offs_env ? getenv(offs_env) : nullptr; e != nullptr && e[0] != '\0') {
+        aoffs = (size_t) strtoull(e, nullptr, 10);
+    } else if (sa.st_size == sg.st_size) {
+        aoffs = offs;
+    } else if ((size_t) sa.st_size == tbytes) {
+        aoffs = 0;
+    } else {
+        LLAMA_LOG_ERROR("%s: REFUSE : %s fait %lld octets, ni la taille du GGUF (%lld) ni celle de la table (%zu) ; "
+                        "%s%s ; %s\n", tag, alt, (long long) sa.st_size, (long long) sg.st_size, tbytes,
+                        offs_env ? "donner " : "copie complete ou extrait seulement", offs_env ? offs_env : "", tail);
+        return res;
+    }
+    if (aoffs > (size_t) sa.st_size || tbytes > (size_t) sa.st_size - aoffs) {
+        LLAMA_LOG_ERROR("%s: REFUSE : %s trop court (%lld octets) pour la table (%zu octets a %zu) ; %s\n",
+                        tag, alt, (long long) sa.st_size, tbytes, aoffs, tail);
+        return res;
+    }
+    n_verify = std::min<int64_t>(n_verify, n_rows);
+
+    // O_DIRECT so that the verification neither fills the page cache nor reads it (the latencies are those of the disks)
+#if defined(O_DIRECT)
+    const int f_direct = O_DIRECT;
+#else
+    const int f_direct = 0;
+#endif
+    bool dio = f_direct != 0;
+    int  fg  = dio ? open(fname.c_str(), O_RDONLY | O_CLOEXEC | f_direct) : -1;
+    int  fa  = fg >= 0 ? open(alt, O_RDONLY | O_CLOEXEC | f_direct) : -1;
+    if (fg < 0 || fa < 0) {
+        if (fg >= 0) { close(fg); }
+        dio = false;
+        fg  = open(fname.c_str(), O_RDONLY | O_CLOEXEC);
+        fa  = open(alt, O_RDONLY | O_CLOEXEC);
+    }
+    if (fg < 0 || fa < 0) {
+        LLAMA_LOG_ERROR("%s: REFUSE : ouverture de %s ou de %s impossible (%s) ; %s\n", tag, fname.c_str(), alt, strerror(errno), tail);
+        if (fg >= 0) { close(fg); }
+        if (fa >= 0) { close(fa); }
+        return res;
+    }
+    const size_t blk  = 4096;
+    const size_t span = ((row_size + 2 * blk - 1) / blk) * blk + blk;   // aligned window around one row, with room to align
+    std::vector<uint8_t> mem(2 * span + blk);
+    uint8_t * base = mem.data() + (blk - ((uintptr_t) mem.data() % blk)) % blk;
+    uint8_t * bg   = base;
+    uint8_t * ba   = base + span;
+    // read row `row` of a file whose row 0 is at `o0` into `buf`; returns a pointer to the row, nullptr on error. ms: latency
+    auto read_row = [&](int fd, size_t o0, int64_t row, uint8_t * buf, double & ms) -> const uint8_t * {
+        const size_t off  = o0 + (size_t) row * row_size;
+        const size_t a0   = dio ? off / blk * blk : off;
+        const size_t need = off - a0 + row_size;
+        const size_t len  = dio ? (need + blk - 1) / blk * blk : need;
+        const auto   t0   = std::chrono::steady_clock::now();
+        size_t got = 0;
+        while (got < len) {
+            const ssize_t r = pread(fd, buf + got, len - got, (off_t) (a0 + got));
+            if (r < 0 && errno == EINTR) {
+                continue;
+            }
+            if (r <= 0) {
+                break;
+            }
+            got += (size_t) r;
+        }
+        ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        return got >= need ? buf + (off - a0) : nullptr;
+    };
+    std::vector<double> lat_g, lat_a;
+    lat_g.reserve((size_t) n_verify);
+    lat_a.reserve((size_t) n_verify);
+    int64_t n_diff = 0, n_err = 0, first_bad = -1;
+    uint64_t sm = 0x9E3779B97F4A7C15ull;   // splitmix64, fixed seed: the same sample at every load
+    const auto t_all = std::chrono::steady_clock::now();
+    for (int64_t k = 0; k < n_verify; ++k) {
+        int64_t row;
+        if (k == 0) {
+            row = 0;
+        } else if (k == 1) {
+            row = n_rows - 1;
+        } else {
+            uint64_t z = (sm += 0x9E3779B97F4A7C15ull);
+            z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+            z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+            z ^= z >> 31;
+            row = (int64_t) (z % (uint64_t) n_rows);
+        }
+        double mg = 0, ma = 0;
+        const uint8_t * pg = nullptr;
+        const uint8_t * pa = nullptr;
+        if (k & 1) {   // alternate the order so that neither file is always read first
+            pa = read_row(fa, aoffs, row, ba, ma);
+            pg = read_row(fg, offs,  row, bg, mg);
+        } else {
+            pg = read_row(fg, offs,  row, bg, mg);
+            pa = read_row(fa, aoffs, row, ba, ma);
+        }
+        lat_g.push_back(mg);
+        lat_a.push_back(ma);
+        if (pg == nullptr || pa == nullptr) {
+            ++n_err;
+            if (first_bad < 0) { first_bad = row; }
+        } else if (memcmp(pg, pa, row_size) != 0) {
+            ++n_diff;
+            if (first_bad < 0) { first_bad = row; }
+        }
+        if (n_err + n_diff > 0) {
+            break;   // one is enough to refuse
+        }
+    }
+    close(fg);
+    close(fa);
+    res.s_all = std::chrono::duration<double>(std::chrono::steady_clock::now() - t_all).count();
+    auto pct = [](std::vector<double> v, double q) {
+        if (v.empty()) {
+            return 0.0;
+        }
+        std::sort(v.begin(), v.end());
+        return v[std::min(v.size() - 1, (size_t) (q * (double) (v.size() - 1) + 0.5))];
+    };
+    const double qs[4] = {0.5, 0.9, 0.99, 1.0};
+    for (int i = 0; i < 4; ++i) {
+        res.g[i] = pct(lat_g, qs[i]);
+        res.a[i] = pct(lat_a, qs[i]);
+    }
+    if (n_err + n_diff > 0) {
+        LLAMA_LOG_ERROR("%s: REFUSE : %s ligne %lld (%s) apres %zu lignes comparees ; %s\n",
+                        tag, alt, (long long) first_bad, n_err ? "lecture impossible ou fichier court" : "OCTETS DIFFERENTS",
+                        lat_g.size(), tail);
+        return res;
+    }
+    res.ok     = true;
+    res.aoffs  = aoffs;
+    res.n_rows = n_verify;
+    res.dio    = dio;
+    return res;
+}
