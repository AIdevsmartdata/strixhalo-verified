@@ -9753,6 +9753,79 @@ static size_t ggml_vk_align_size(size_t width, size_t align) {
     return CEIL_DIV(width, align) * align;
 }
 
+// CPU reads from device memory. On amdgpu a buffer that lands in the VRAM domain (the BIOS carve-out) is mapped
+// write-combined: a plain memcpy reads it at ~0.4 GB/s, MOVNTDQA streaming loads at 4-13 GB/s (RADV, Strix Halo).
+// On a cached mapping a streaming load is an ordinary load, so every bulk read from device memory goes through here.
+// GGML_VK_STREAM_READ=0 restores memcpy.
+#if defined(__x86_64__) && (defined(__clang__) || defined(__GNUC__))
+#define GGML_VK_HAVE_STREAM_READ 1
+__attribute__((target("avx512f")))
+static void ggml_vk_stream_read_avx512(uint8_t * dst, const uint8_t * src, size_t n_blocks) {
+    for (size_t i = 0; i < n_blocks; i++) {
+        _mm512_storeu_si512(dst + 64 * i, _mm512_stream_load_si512((void *) (src + 64 * i)));
+    }
+}
+
+__attribute__((target("avx2")))
+static void ggml_vk_stream_read_avx2(uint8_t * dst, const uint8_t * src, size_t n_blocks) {
+    for (size_t i = 0; i < n_blocks; i++) {
+        const __m256i a = _mm256_stream_load_si256((const __m256i *) (src + 64 * i));
+        const __m256i b = _mm256_stream_load_si256((const __m256i *) (src + 64 * i + 32));
+        _mm256_storeu_si256((__m256i *) (dst + 64 * i), a);
+        _mm256_storeu_si256((__m256i *) (dst + 64 * i + 32), b);
+    }
+}
+
+__attribute__((target("sse4.1")))
+static void ggml_vk_stream_read_sse41(uint8_t * dst, const uint8_t * src, size_t n_blocks) {
+    for (size_t i = 0; i < n_blocks; i++) {
+        for (size_t k = 0; k < 64; k += 16) {
+            _mm_storeu_si128((__m128i *) (dst + 64 * i + k), _mm_stream_load_si128((__m128i *) (src + 64 * i + k)));
+        }
+    }
+}
+#endif
+
+static void ggml_vk_memcpy_from_device(void * dst, const void * src, size_t size) {
+#ifdef GGML_VK_HAVE_STREAM_READ
+    static const int isa = [] {
+        const char * e = getenv("GGML_VK_STREAM_READ");
+        if (e != nullptr && atoi(e) == 0) {
+            return 0;
+        }
+        __builtin_cpu_init();
+        if (__builtin_cpu_supports("avx512f")) {
+            return 3;
+        }
+        if (__builtin_cpu_supports("avx2")) {
+            return 2;
+        }
+        return __builtin_cpu_supports("sse4.1") ? 1 : 0;
+    }();
+
+    if (isa != 0 && size >= 1024) {
+        const uint8_t * s = (const uint8_t *) src;
+        uint8_t * d = (uint8_t *) dst;
+
+        // a streaming load needs an aligned source
+        const size_t head = (64 - ((uintptr_t) s & 63)) & 63;
+        memcpy(d, s, head);
+
+        const size_t n_blocks = (size - head) / 64;
+        switch (isa) {
+            case 3:  ggml_vk_stream_read_avx512(d + head, s + head, n_blocks); break;
+            case 2:  ggml_vk_stream_read_avx2  (d + head, s + head, n_blocks); break;
+            default: ggml_vk_stream_read_sse41 (d + head, s + head, n_blocks); break;
+        }
+
+        const size_t done = head + 64 * n_blocks;
+        memcpy(d + done, s + done, size - done);
+        return;
+    }
+#endif
+    memcpy(dst, src, size);
+}
