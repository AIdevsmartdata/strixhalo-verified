+// __shfl_xor_sync over DPP row_xmask / permlanex16 on RDNA3 and RDNA4 (wave32). The generic __shfl_xor goes
+// through ds_bpermute, one LDS crossbar round trip per butterfly step; DPP moves the same lane values inside
+// the VALU. Lane i still receives lane i ^ laneMask and combines it with its own value exactly as before, so
+// every reduction built on __shfl_xor_sync stays bit-identical. Masks the DPP forms do not cover (>= width,
+// > 16, a 16 that would cross a narrower segment) and non 32-bit types keep the ds_bpermute path.
+// Build with -DGGML_HIP_NO_DPP_SHFL to get the plain __shfl_xor everywhere.
+#if (defined(RDNA3) || defined(RDNA4)) && !defined(GGML_HIP_NO_DPP_SHFL)
+static __device__ __forceinline__ int ggml_hip_xor_lane_i32(const int v, const int laneMask, const int width) {
+    if (laneMask > 0 && laneMask < width && width <= 32 && (width & (width - 1)) == 0) {
+        switch (laneMask) {
+            case  1: return __builtin_amdgcn_update_dpp(0, v, 0x161, 0xf, 0xf, true);
+            case  2: return __builtin_amdgcn_update_dpp(0, v, 0x162, 0xf, 0xf, true);
+            case  3: return __builtin_amdgcn_update_dpp(0, v, 0x163, 0xf, 0xf, true);
+            case  4: return __builtin_amdgcn_update_dpp(0, v, 0x164, 0xf, 0xf, true);
+            case  5: return __builtin_amdgcn_update_dpp(0, v, 0x165, 0xf, 0xf, true);
+            case  6: return __builtin_amdgcn_update_dpp(0, v, 0x166, 0xf, 0xf, true);
+            case  7: return __builtin_amdgcn_update_dpp(0, v, 0x167, 0xf, 0xf, true);
+            case  8: return __builtin_amdgcn_update_dpp(0, v, 0x168, 0xf, 0xf, true);
+            case  9: return __builtin_amdgcn_update_dpp(0, v, 0x169, 0xf, 0xf, true);
+            case 10: return __builtin_amdgcn_update_dpp(0, v, 0x16a, 0xf, 0xf, true);
+            case 11: return __builtin_amdgcn_update_dpp(0, v, 0x16b, 0xf, 0xf, true);
+            case 12: return __builtin_amdgcn_update_dpp(0, v, 0x16c, 0xf, 0xf, true);
+            case 13: return __builtin_amdgcn_update_dpp(0, v, 0x16d, 0xf, 0xf, true);
+            case 14: return __builtin_amdgcn_update_dpp(0, v, 0x16e, 0xf, 0xf, true);
+            case 15: return __builtin_amdgcn_update_dpp(0, v, 0x16f, 0xf, 0xf, true);
+            case 16: // width == 32 here: lane j of one 16-lane row reads lane j of the other row
+                     return __builtin_amdgcn_permlanex16(v, v, 0x76543210, 0xfedcba98, true, false);
+            default: break;
+        }
+    }
+    return __shfl_xor(v, laneMask, width);
+}
+
+template <typename T>
+static __device__ __forceinline__ T ggml_hip_shfl_xor(const T var, const int laneMask, const int width) {
+    if constexpr (sizeof(T) == 4) {
+        return __builtin_bit_cast(T, ggml_hip_xor_lane_i32(__builtin_bit_cast(int, var), laneMask, width));
+    } else {
+        return __shfl_xor(var, laneMask, width);
+    }
+}
+
+#undef __shfl_xor_sync
+#define __shfl_xor_sync(mask, var, laneMask, width) ggml_hip_shfl_xor(var, laneMask, width)
