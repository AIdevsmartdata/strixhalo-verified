+void llama_model::opus_bf16_fill() {
+    if (bf16_twin_cand.empty()) {
+        return;
+    }
+
+    size_t n_ok = 0;
+    size_t n_rej = 0;
+    size_t bytes_f32 = 0;
+    size_t bytes_bf16 = 0;
+
+    std::vector<uint32_t> f32;
+    std::vector<uint16_t> bf;
+
+    for (auto & pr : bf16_twin_cand) {
+        ggml_tensor * orig = pr.first;
+        ggml_tensor * twin = pr.second;
+
+        const int64_t n = ggml_nelements(orig);
+
+        bool ok = orig->buffer && twin->buffer
+               && !ggml_backend_buffer_is_host(orig->buffer)
+               && !ggml_backend_buffer_is_host(twin->buffer)
+               && ggml_nelements(twin) == n
+               && orig->type == GGML_TYPE_F32;
+
+        if (ok) {
+            f32.resize(n);
+            bf.resize(n);
+            ggml_backend_tensor_get(orig, f32.data(), 0, n*4);
+            for (int64_t i = 0; i < n; ++i) {
+                if ((f32[i] & 0xFFFFu) != 0) {
+                    ok = false;
+                    break;
+                }
+                bf[i] = (uint16_t)(f32[i] >> 16);
+            }
+        }
+
+        if (ok) {
+            ggml_backend_tensor_set(twin, bf.data(), 0, n*2);
+            prec_policy.bf16_twin[orig] = twin;
+            n_ok++;
+            bytes_f32  += (size_t) n*4;
+            bytes_bf16 += (size_t) n*2;
+        } else {
+            n_rej++;
+            LLAMA_LOG_WARN("%s: LLAMA_OPUS_BF16: rejected twin for %s\n", __func__, orig->name);
+        }
+    }
+
+    LLAMA_LOG_INFO("%s: LLAMA_OPUS_BF16: %zu twins, %zu rejected; F32 bytes %.2f MiB -> BF16 bytes %.2f MiB; read per token saved %.2f MiB (extra resident %.2f MiB)\n",
+            __func__, n_ok, n_rej,
+            (double) bytes_f32  / (1024.0*1024.0),
+            (double) bytes_bf16 / (1024.0*1024.0),
+            (double) (bytes_f32 - bytes_bf16) / (1024.0*1024.0),
+            (double) bytes_bf16 / (1024.0*1024.0));
+}
