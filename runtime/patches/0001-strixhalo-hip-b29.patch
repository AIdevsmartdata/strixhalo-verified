+            cx = nx;
+            if constexpr (has_gate) {
+                cg = ng;
+            }
+        }
+    }
+
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+        tmp[j] = warp_reduce_sum<warp_size>(tmp[j]);
+        if constexpr (has_gate) {
+            tmp_gate[j] = warp_reduce_sum<warp_size>(tmp_gate[j]);
+        }
+    }
+    if (lane == 0) {
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+            float result = tmp[j];
+            if constexpr (has_gate) {
+                result *= ggml_cuda_op_silu_single(tmp_gate[j]);
