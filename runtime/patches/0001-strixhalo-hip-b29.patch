+                    if (out_xn_bf16) out_xn_bf16[row * n_embd + col] = hc_f2bf32(v0[q]);
+                }
+#pragma unroll
+                for (int r = 0; r < HC_INJ_HC; ++r) {
+                    const int64_t wi = (int64_t) r * hc * n_embd + (int64_t) c * n_embd + col;
