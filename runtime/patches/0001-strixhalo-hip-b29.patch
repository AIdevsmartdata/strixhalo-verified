+// GGML_CUDA_PERF_LOGGER=1: per-op GPU time table for the CUDA/HIP backend, the counterpart of the Vulkan
+// GGML_VK_PERF_LOGGER. Off by default; with the variable unset the graph loop below keeps its old shape.
+//
+// One cudaEvent_t is recorded on the compute stream after each measured node, so op k owns the interval
+// [end of op k-1, end of op k]: its own kernels plus the launch latency that precedes them. The intervals add
+// up to the interval the opening and closing events bracket, which is the graph total. Nodes a fused handler
+// swallowed are charged to the previous boundary, or grouped under one FUSED entry when they skip nodes. The
+// difference between the sum of the entries and the graph total is the event overhead plus the timestamp
+// resolution; both numbers are printed so the error stays visible. GGML_CUDA_PERF_LOGGER_MS sets the minimum
+// graph time to print (default 50000 us) and GGML_CUDA_PERF_LOGGER_SHAPES adds m/n/k to GEMM entries.
+// See bench_qwen38/iq3s_20261007/RAPPORT-PROFIL-HIP-AGENT.md for the measurements of the bias.
+static bool ggml_cuda_perf_env_flag(const char * name) {
+    const char * v = getenv(name);
+    return v != nullptr && v[0] != '\0' && atoi(v) != 0;
+}
+
+struct ggml_cuda_perf_op_stats {
+    uint64_t n_calls  = 0;
+    double   total_us = 0.0;
+};
+
+class ggml_cuda_perf_logger {
+public:
+    const bool enabled      = ggml_cuda_perf_env_flag("GGML_CUDA_PERF_LOGGER");
+    const bool print_shapes = ggml_cuda_perf_env_flag("GGML_CUDA_PERF_LOGGER_SHAPES");
+
+    ggml_cuda_perf_logger() {
+        const char * ms = getenv("GGML_CUDA_PERF_LOGGER_MS");
+        threshold_us = ms != nullptr ? (uint64_t) (atof(ms) * 1000.0) : 50000;
+    }
+
+    std::string key(const ggml_tensor * node) const {
+        std::string name = ggml_op_name(node->op);
+        if (node->src[0] != nullptr) {
+            name += " ";
+            name += ggml_type_name(node->src[0]->type);
+        }
+        if (print_shapes && (node->op == GGML_OP_MUL_MAT || node->op == GGML_OP_MUL_MAT_ID) && node->src[1] != nullptr) {
+            name += " m=" + std::to_string(node->ne[0]) + " n=" + std::to_string(node->ne[1]) +
+                    " k=" + std::to_string(node->src[1]->ne[0]);
+            if (node->op == GGML_OP_MUL_MAT_ID) {
+                name += " n_expert=" + std::to_string(node->src[0]->ne[2]);
+            }
+            if (node->ne[2] * node->ne[3] > 1) {
+                name += " batch=" + std::to_string(node->ne[2] * node->ne[3]);
+            }
+        }
+        return name;
+    }
+
+    // one entry for a ggml_cuda_try_fuse call that computed nodes i..i+nodes_to_skip
+    std::string fused_key(const ggml_cgraph * cgraph, int i, int nodes_to_skip) const {
+        std::string name = "FUSED";
+        const int last = std::min(i + nodes_to_skip, cgraph->n_nodes - 1);
+        for (int k = i; k <= last && k < i + 6; ++k) {
+            name += " ";
+            name += ggml_op_name(cgraph->nodes[k]->op);
+        }
+        if (last > i + 5) {
+            name += " +" + std::to_string(last - (i + 5));
+        }
+        return name;
+    }
+
+    void begin(cudaStream_t stream, int device) {
+        cur_device = device;
+        n_marks    = 0;
+        marks.clear();
+        stats.clear();
+        record(stream, 0);
+    }
+
+    void mark(cudaStream_t stream, std::string name) {
+        record(stream, n_marks + 1);
+        marks.push_back(std::move(name));
+        n_marks++;
+    }
+
+    void end(cudaStream_t stream) {
+        record(stream, n_marks + 1);
+        CUDA_CHECK(cudaEventSynchronize(events[n_marks + 1]));
+
+        const double graph_us = elapsed_us(0, n_marks + 1);
+        if (n_marks == 0 || graph_us < (double) threshold_us) {
+            return;
+        }
+        for (int k = 1; k <= n_marks; ++k) {
+            ggml_cuda_perf_op_stats & s = stats[marks[k - 1]];
+            s.n_calls++;
+            s.total_us += elapsed_us(k - 1, k);
+        }
+        print(graph_us);
+        marks.clear();
+        stats.clear();
+        n_marks = 0;
+    }
+
+private:
+    void record(cudaStream_t stream, int idx) {
+        while ((int) events.size() <= idx) {
+            cudaEvent_t e = nullptr;
+            CUDA_CHECK(cudaEventCreate(&e));
+            events.push_back(e);
+        }
+        CUDA_CHECK(cudaEventRecord(events[idx], stream));
+    }
+
+    double elapsed_us(int a, int b) const {
+        float ms = 0.0f;
+        CUDA_CHECK(cudaEventElapsedTime(&ms, events[a], events[b]));
+        return (double) ms * 1000.0;
+    }
+
+    void print(double graph_us) const {
+        std::vector<std::pair<std::string, ggml_cuda_perf_op_stats>> rows(stats.begin(), stats.end());
+        std::sort(rows.begin(), rows.end(), [](const auto & a, const auto & b) {
+            return a.second.total_us > b.second.total_us;
+        });
+
+        double   sum_us    = 0.0;
+        uint64_t sum_calls = 0;
+        for (const auto & r : rows) {
+            sum_us += r.second.total_us;
+            sum_calls += r.second.n_calls;
+        }
+
+        fprintf(stderr, "=== GGML_CUDA_PERF_LOGGER BEGIN device=%d graph_us=%" PRIu64 " ops=%zu calls=%" PRIu64 " ===\n",
+                cur_device, (uint64_t) (graph_us + 0.5), rows.size(), sum_calls);
+        for (const auto & r : rows) {
+            fprintf(stderr, "GGML_CUDA_PERF op=\"%s\" calls=%" PRIu64 " total_us=%" PRIu64 " pct=%.2f\n",
+                    r.first.c_str(), r.second.n_calls, (uint64_t) (r.second.total_us + 0.5),
+                    100.0 * r.second.total_us / graph_us);
+        }
+        fprintf(stderr, "GGML_CUDA_PERF TOTAL calls=%" PRIu64 " total_us=%" PRIu64 " pct=%.2f graph_us=%" PRIu64 "\n",
+                sum_calls, (uint64_t) (sum_us + 0.5), 100.0 * sum_us / graph_us, (uint64_t) (graph_us + 0.5));
+        fprintf(stderr, "=== GGML_CUDA_PERF_LOGGER END ===\n");
+    }
+
+    std::vector<cudaEvent_t> events;   // reused across graphs, grown to n_marks + 2
+    std::vector<std::string> marks;    // marks[k-1] owns the interval that ends at event k
+    std::map<std::string, ggml_cuda_perf_op_stats> stats;
+    uint64_t threshold_us = 50000;
+    int      n_marks      = 0;
+    int      cur_device   = 0;
+};
