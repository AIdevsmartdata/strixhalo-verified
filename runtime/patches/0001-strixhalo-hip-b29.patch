+    if (model.arch != LLM_ARCH_QWEN4EXP || model.hparams.n_layer_nextn != 1 || tgt->nextn_dev_t == nullptr || !tgt->nextn_dev_ok) {
+        return false;
+    }
+    nextn_req_tgt   = tgt;
+    nextn_req_head  = head;
+    nextn_req_row0  = src_row0;
+    nextn_req_total = total;
+    nextn_req_done  = 0;
