+    bool    on = false;                 // vrai pendant un tour actif (fixe au debut du tour)
+    bool    ready = false;
+    int     level = 0;
+    int     period_s = 10;
+    double  clock_ns = 0;               // cout mesure d'un appel de steady_clock
