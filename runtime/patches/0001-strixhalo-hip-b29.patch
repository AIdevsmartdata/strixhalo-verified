+            }
+        }
+    }
+    __syncthreads();
+    if (tid < 2 * HC_INJ_HC) {
+        const int q = tid / HC_INJ_HC, r = tid % HC_INJ_HC;
+        float sum = 0.0f;
+#pragma unroll
+        for (int w = 0; w < HC_CN_BLOCK2 / WARP_SIZE; ++w) {
+            sum += s_inj[q][r][w];
+        }
+        out_inj[(int64_t) (t0 + q) * HC_INJ_HC + r] = sum;
