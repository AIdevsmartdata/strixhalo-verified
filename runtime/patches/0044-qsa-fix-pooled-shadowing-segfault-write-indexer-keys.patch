     }
 
+    // [TAG_PERF_COVERAGE] enregistre, pour un graph_compute, le nombre de noeuds du graphe,
+    // le nombre de timestamps effectivement ecrits (query_idx) et le temps mesure.
+    // Un ecart nodes != queries signale des ops non mesurees ; time_us sert a comparer au temps reel.
+    void log_graph_stats(uint32_t n_nodes, uint32_t n_queries, uint32_t n_invalid, uint64_t total_us) {
+        ++cov_graphs;
+        cov_nodes += n_nodes;
+        cov_queries += n_queries;
+        cov_invalid += n_invalid;
+        cov_time_ns += total_us;
+        if (vk_perf_logger_trace) {
+            std::cerr << "PERF_GRAPH nodes=" << n_nodes << " queries=" << n_queries
+                      << " invalid_deltas=" << n_invalid << " time_us=" << total_us << std::endl;
+        }
+    }
+
+    // [TAG_PERF_ACCOUNT] comptabilite CPU d'un graph_compute.
+    //   entry_ns     : entree dans ggml_backend_vk_graph_compute
+    //   loop_end_ns  : fin de l'iteration des noeuds (construction des command buffers incluse)
+    //   submitted_ns : apres vkQueueSubmit
+    //   waited_ns    : apres waitForFences (le GPU a fini)
+    //   skipped      : aucun timestamp ecrit (query_idx == 0) -> trou de mesure signale
+    void log_cpu_stats(uint64_t entry_ns, uint64_t loop_end_ns, uint64_t submitted_ns, uint64_t waited_ns,
+                       uint64_t kernel_ns, bool skipped) {
+        if (entry_ns == 0) {
+            return;
+        }
+        if (cov_wall_first_ns == 0) {
+            cov_wall_first_ns = entry_ns;
+        }
+        uint64_t gap = (cov_last_exit_ns != 0 && entry_ns > cov_last_exit_ns) ? entry_ns - cov_last_exit_ns : 0;
+        const uint64_t loop = loop_end_ns > entry_ns ? loop_end_ns - entry_ns : 0;
+        const uint64_t sub  = submitted_ns > loop_end_ns ? submitted_ns - loop_end_ns : 0;
+        const uint64_t wait = waited_ns > submitted_ns ? waited_ns - submitted_ns : 0;
+        cov_cpu_loop_ns   += loop;
+        cov_cpu_submit_ns += sub;
+        cov_cpu_wait_ns   += wait;
+        cov_gap_ns        += gap;
+        cov_last_exit_ns   = waited_ns;
+        if (waited_ns > cov_wall_last_ns) {
+            cov_wall_last_ns = waited_ns;
+        }
+        ++cov_graphs_instrumented;
+        if (skipped) {
+            ++cov_skipped;
+        }
+        if (vk_perf_logger_trace) {
+            std::cerr << "PERF_ACCOUNT cpu_loop_us=" << loop / 1000.0
+                      << " submit_us=" << sub / 1000.0
+                      << " wait_us=" << wait / 1000.0
+                      << " gap_us=" << gap / 1000.0
+                      << " kernel_us=" << kernel_ns / 1000.0
+                      << " skipped=" << (skipped ? 1 : 0) << std::endl;
+        }
+    }
+
+    void print_coverage() {
+        if (cov_graphs == 0) {
+            return;
+        }
+        char buf[320];
+        snprintf(buf, sizeof(buf),
+                 "PERF_COVERAGE graphs=%llu nodes=%llu queries=%llu invalid_deltas=%llu measured_s=%.3f query_ratio_pct=%.1f invalid_pct=%.1f",
+                 (unsigned long long) cov_graphs, (unsigned long long) cov_nodes,
+                 (unsigned long long) cov_queries, (unsigned long long) cov_invalid,
+                 cov_time_ns / 1e9,
+                 cov_nodes ? (100.0 * (double) cov_queries / (double) cov_nodes) : 0.0,
+                 cov_queries ? (100.0 * (double) cov_invalid / (double) cov_queries) : 0.0);
+        std::cerr << buf << std::endl;
+
+        // [TAG_PERF_ACCOUNT] le mur est explique : cpu_loop + submit + wait + gap.
+        // kernel_s est un sous-ensemble de cpu_wait (travail GPU pendant l'attente de fence).
+        const double wall = cov_wall_last_ns > cov_wall_first_ns
+                          ? (double) (cov_wall_last_ns - cov_wall_first_ns) / 1e9 : 0.0;
+        const double loop = cov_cpu_loop_ns / 1e9, sub = cov_cpu_submit_ns / 1e9;
+        const double wait = cov_cpu_wait_ns / 1e9, gap = cov_gap_ns / 1e9, kern = cov_time_ns / 1e9;
+        char buf2[440];
+        snprintf(buf2, sizeof(buf2),
+                 "PERF_ACCOUNT wall_s=%.3f cpu_loop_s=%.3f(%.0f%%) submit_s=%.3f(%.0f%%) wait_s=%.3f(%.0f%%) "
+                 "gap_s=%.3f(%.0f%%) kernel_s=%.3f(%.0f%% de wall, sous-ensemble du wait) "
+                 "graphs_instrumented=%llu skipped=%llu",
+                 wall, loop, wall ? 100.0 * loop / wall : 0.0, sub, wall ? 100.0 * sub / wall : 0.0,
+                 wait, wall ? 100.0 * wait / wall : 0.0, gap, wall ? 100.0 * gap / wall : 0.0,
+                 kern, wall ? 100.0 * kern / wall : 0.0,
+                 (unsigned long long) cov_graphs_instrumented, (unsigned long long) cov_skipped);
+        std::cerr << buf2 << std::endl;
+    }
+
