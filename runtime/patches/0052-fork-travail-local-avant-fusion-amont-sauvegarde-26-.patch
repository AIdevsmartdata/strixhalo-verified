+static const char * moe_ids_dump_path() {
+    static const char * p = getenv("LLAMA_MOE_IDS_DUMP");
+    return (p != nullptr && *p != '\0') ? p : nullptr;
+}
+
+void llm_graph_input_moe_ids_dump::record(int il, ggml_tensor * ids) {
+    if (ids == nullptr || il < 0 || il > 4096) {
+        return;
+    }
+    if ((int) ids_by_il.size() <= il) {
+        ids_by_il.resize(il + 1, nullptr);
+    }
+    if (ids_by_il[il] != nullptr && ids_by_il[il] != ids) {
+        return;   // deja enregistre pour cette couche (ne jamais ecraser l'entree d'un autre graphe)
+    }
+    // AUCUN tenseur cree, AUCUN noeud ajoute : le tenseur est DEJA dans le graphe (il porte ses srcs
+    // et obtient donc un backend valide) ; on empeche seulement l'allocateur de recycler sa memoire.
+    ggml_set_output(ids);
+    ids_by_il[il] = ids;
+    n_used        = ids->ne[0];
+    n_tokens      = ids->ne[1];
+    armed         = false;   // le pas suivant lira le pas courant
+}
+
+void llm_graph_input_moe_ids_dump::set_input(const llama_ubatch * /* ubatch */) {
+    if (moe_ids_dump_path() == nullptr) {
+        return;
+    }
+
+    bool any = false;
+    for (ggml_tensor * t : ids_by_il) {
+        if (t == nullptr) {
+            continue;
+        }
+        any = true;
+        if (t->buffer == nullptr) {
+            return;   // tenseur pas encore alloue : on lira au pas suivant
+        }
+    }
+    if (!any) {
+        return;
+    }
+    if (!armed) {
+        armed = true;
+        return;
+    }
+
+    static FILE * f    = nullptr;
+    static long   step = 0;
+    if (f == nullptr) {
+        f = fopen(moe_ids_dump_path(), "w");
+        if (f == nullptr) {
+            return;
+        }
+        fprintf(f, "# MOE_IDS_DUMP v2 n_used=%lld n_tokens=%lld n_layers=%d\n",
+                (long long) n_used, (long long) n_tokens, (int) ids_by_il.size());
+    }
+
+    for (size_t il = 0; il < ids_by_il.size(); ++il) {
+        ggml_tensor * t = ids_by_il[il];
+        if (t == nullptr || t->buffer == nullptr || t->type != GGML_TYPE_I32) {
+            continue;
+        }
+        const int64_t nu = t->ne[0];
+        const int64_t nt = t->ne[1];
+        // la forme est VERIFIEE, pas supposee : le tenseur doit rester [n_used, n_tokens]
+        if (nu <= 0 || nt <= 0 || nu != n_used || nt != n_tokens || t->nb[0] != sizeof(int32_t)) {
+            continue;
+        }
+        const int64_t n = nu*nt;
+        buf.resize(n);
+        if (ggml_is_contiguous(t)) {
+            ggml_backend_tensor_get(t, buf.data(), 0, n*sizeof(int32_t));
+        } else {
+            for (int64_t token = 0; token < nt; ++token) {
+                ggml_backend_tensor_get(t, buf.data() + token*nu, token*t->nb[1], nu*sizeof(int32_t));
+            }
+        }
+        fprintf(f, "step=%ld il=%lld n_used=%lld n_tokens=%lld ids=", step, (long long) il,
+                (long long) nu, (long long) nt);
+        for (int64_t k = 0; k < n; ++k) {
+            fprintf(f, "%d%s", buf[k], k + 1 < n ? "," : "");
+        }
+        fprintf(f, "\n");
+    }
+    fflush(f);   // le fichier doit etre lisible pendant le run
+    step++;
+}
+
+bool llm_graph_input_moe_ids_dump::can_reuse(const llm_graph_params & params) {
+    // rien d'enregistre (dump desarme ou prefill exclu) : aucun effet sur la reutilisation du graphe
+    if (n_used <= 0 || n_tokens <= 0) {
+        return true;
+    }
+    return n_tokens == (int64_t) params.ubatch.n_tokens;
+}
