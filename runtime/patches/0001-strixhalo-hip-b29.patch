+// the ubatch snapshots of the pending in-batch checkpoint request: only a single-sequence ubatch that takes the chunked
+// prefill path (no rollback snapshots, GDN chunk kernel) can write a snapshot, and only strictly inside the ubatch
+void llama_context::ck_prepare(const llama_ubatch & ubatch) {
+    ck_cur_n = 0;
+    if (ck_act.n <= 0 || ubatch.n_seqs != 1 || ubatch.n_seq_id[0] != 1 || ubatch.seq_id[0][0] != ck_act.seq) {
+        return;
+    }
+    static const int chunk_min = getenv("GGML_GDN_CHUNK_MIN") ? atoi(getenv("GGML_GDN_CHUNK_MIN")) : ggml_opus_chunk_min_default();
+    static const int chunk_on  = getenv("GGML_GDN_CHUNK") ? atoi(getenv("GGML_GDN_CHUNK")) : 1;
+    const uint32_t T = ubatch.n_seq_tokens;
+    if (!chunk_on || llama_rs_keep_snapshots(cparams.n_rs_seq, T) || (int) T < chunk_min) {
+        return;
+    }
+    for (int32_t i = 0; i < ck_act.n && ck_cur_n < 4; ++i) {
+        const int32_t rel = ck_act.offs[i] - ck_seq_done;
+        if (rel >= 16 && rel < (int32_t) T) { // >= the longest conv history (PLE: 9 columns)
+            ck_cur_pos[ck_cur_n]   = rel;
+            ck_cur_plane[ck_cur_n] = i;
+            ck_cur_n++;
+        }
+    }
+}
+
+void llama_context::ck_commit(const llama_ubatch & ubatch) {
+    for (int32_t k = 0; k < ck_cur_n; ++k) {
+        const int32_t i = ck_cur_plane[k];
+        ck_ok[i] = true;
+        memory->ckpt_inbatch_set_pos(i, ck_act.pos[i]);
+    }
+    ck_cur_n = 0;
+    if (ck_act.n > 0) {
+        for (uint32_t t = 0; t < ubatch.n_tokens; ++t) {
+            if (ubatch.seq_id[t][0] == ck_act.seq) {
+                ck_seq_done++;
+            }
+        }
+    }
+}
+
+int32_t llama_context::ckpt_inbatch_request(llama_seq_id seq_id, int32_t n, const int32_t * offs, const llama_pos * pos) {
+    ck_req = {};
+    for (int i = 0; i < 4; ++i) {
+        ck_ok[i] = false;
+    }
+    const int32_t planes = memory ? memory->ckpt_inbatch_n() : 0;
+    if (planes <= 0 || n <= 0) {
+        return 0;
+    }
+    n = std::min(std::min(n, planes), 4);
+    ck_req.seq = seq_id;
+    ck_req.n   = n;
+    for (int32_t i = 0; i < n; ++i) {
+        ck_req.offs[i] = offs[i];
+        ck_req.pos[i]  = pos[i];
+    }
+    return n;
+}
+
+int32_t llama_context::ckpt_inbatch_result(int32_t j) const {
+    return j >= 0 && j < 4 && ck_ok[j] ? 1 : 0;
+}
