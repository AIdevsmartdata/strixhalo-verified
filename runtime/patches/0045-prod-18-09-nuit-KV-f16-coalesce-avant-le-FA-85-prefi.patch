+// GGML_OP_GET_ROWS_RAW
+// [TAG_QSA_RAW_GATHER] Gather brut du chemin QSA au decodage : la sortie garde le type de la source
+// (q8_0) et la ligne est copiee telle quelle. Deux verifications, sur des formes reelles (512 dims,
+// 2304 puis 131072 lignes, indices NON contigus) :
+//   diff=false : la sortie comparee est le gather brut lui-meme (le banc dequantize les deux cotes) :
+//                l'ecart CPU/GPU doit etre EXACTEMENT nul, sinon la copie n'est pas fidele.
+//   diff=true  : la sortie comparee est sub(cast(raw -> F32), get_rows(q8_0 -> F32)) : elle doit etre
+//                nulle partout, ce qui prouve que le gather brut dequantize exactement comme le gather
+//                historique (c'est le critere decisif : le KV reste quantifie jusqu'au flash attention).
+struct test_get_rows_raw : public test_case {
+    const ggml_type type;
+    const int n;     // dims par ligne (d*hkv)
+    const int m;     // lignes de la source (n_kv)
+    const int r;     // lignes gatherées (n_sel)
+    const int ns;    // streams
+    const bool diff; // sortie = sub(raw, get_rows) au lieu de raw
+    // [TAG_TOPK_SORTED] indices TRIES et distincts : reproduit le cas ou le top_k QSA emettrait ses
+    // indices par ordre croissant (design D2-DESIGN.md §3). Sert a MESURER l'hypothese « des indices
+    // tries rendent le gather quasi sequentiel » AVANT d'ecrire le shader de selection triee.
+    const bool sorted;
+
+    std::string vars() override {
+        return VARS_TO_STR7(type, n, m, r, ns, diff, sorted);
+    }
+
+    test_get_rows_raw(ggml_type type = GGML_TYPE_Q8_0, int n = 512, int m = 131072, int r = 2304, int ns = 2, bool diff = false, bool sorted = false)
+        : type(type), n(n), m(m), r(r), ns(ns), diff(diff), sorted(sorted) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * in = ggml_new_tensor_3d(ctx, type, n, m, ns);
+        ggml_set_name(in, "in");
+
+        // indices non contigus : deux rangees utiles (n_tps = 2) par stream, la vue ne lit que la
+        // premiere et saute donc la seconde entre deux streams (meme motif que top_k dans le QSA)
+        ggml_tensor * rows_full = ggml_new_tensor_4d(ctx, GGML_TYPE_I32, r, 2, 1, ns);
+        ggml_set_name(rows_full, "rows_full");
+        ggml_tensor * rows = ggml_view_2d(ctx, rows_full, r, ns, rows_full->nb[3], 0);
+        ggml_set_name(rows, "rows");
+
+        ggml_tensor * raw = ggml_get_rows_raw(ctx, in, rows);
+
+        ggml_tensor * out = raw;
+        if (diff) {
+            // ggml_cpy et NON ggml_cast : ggml_cast renseigne src[1] = resultat (auto-reference), que
+            // ggml_backend_graph_copy ne recopie pas (node_copies[id] n'est renseigne qu'a la fin de la
+            // recursion => src[1] devient NULL et le CPU segfaute). Meme noyau Vulkan dans les deux cas
+            // (ggml_vk_cpy est appele avec src1 = nullptr).
+            ggml_tensor * raw_f32 = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, n, r, ns, 1);
+            out = ggml_sub(ctx, ggml_cpy(ctx, raw, raw_f32), ggml_get_rows(ctx, in, rows));
+        }
+        ggml_set_name(out, "out");
+
+        return out;
+    }
+
+    // ecart MAXIMAL, pas une erreur normalisee : nmse(x, 0) vaut NaN quand la sortie attendue est
+    // nulle, ce qui passerait le test sans rien verifier (piege du cas `diff`).
+    double max_err() override {
+        return 0.0;
+    }
+
+    double err(const float * a, const float * b, size_t n) override {
+        double result = 0.0;
+        for (size_t i = 0; i < n; ++i) {
+            // le masque QSA contient des -inf : |a-b| n'a pas de sens la, une egalite d'infinis est
+            // correcte et toute autre combinaison est un echec
+            if (std::isinf(a[i]) || std::isinf(b[i])) {
+                if (a[i] != b[i]) {
+                    return INFINITY;
+                }
+                continue;
+            }
+            result = std::max(result, (double) fabsf(a[i] - b[i]));
+        }
+        return result;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type == GGML_TYPE_I32) {
+                if (ggml_is_view_op(t->op)) { continue; }
+                std::vector<int> data(ggml_nelements(t));
+                if (sorted) {
+                    // indices DISTINCTS, TRIES croissants (motif du top_k QSA trie) : tirage sans
+                    // remise sur [0, m) puis tri. Meme nombre d'indices que le cas non trie, mais
+                    // adresses monotones -> on mesure uniquement l'effet de l'ORDRE.
+                    const size_t want = data.size();
+                    std::vector<int> all(m);
+                    std::iota(all.begin(), all.end(), 0);
+                    std::shuffle(all.begin(), all.end(), std::mt19937(12345));
+                    std::copy(all.begin(), all.begin() + std::min(want, (size_t) m), data.begin());
+                    std::sort(data.begin(), data.end());
+                } else {
+                    // indices : avec remise, donc non monotones et repetes
+                    for (size_t i = 0; i < data.size(); i++) {
+                        data[i] = rand() % m;
+                    }
+                }
+                ggml_backend_tensor_set(t, data.data(), 0, data.size()*sizeof(int));
+            } else if (t->type == GGML_TYPE_F16 && n == 1) {
+                // masque QSA : 0, -inf et des valeurs quelconques (le -inf est la valeur qui compte)
+                if (ggml_is_view_op(t->op)) { continue; }
