+++ b/ggml/src/ggml-vulkan/vulkan-shaders/hc_combine.comp
@@ -0,0 +1,61 @@
+#version 450
+
+// [TAG_HC_COMBINE_FUSED] Single-kernel hc_combine (qwen4exp build_hc_combine), v5
+// (GPT-5.6 review: direct dimensional indexing + 4 scalars/thread; vec4 SSBO path
+// dropped because graph tensor base offsets are only 4B-aligned on this driver —
+// it capped fusion at 2/96 chains):
+//   dst[i,j,k] = res[i,j,k] + b[i,k] * ((sig[j,k] * 2.0) * 2.0)
+// - grid: (ceil(n_embd/4/64), hc, nt), local_size 64, FOUR consecutive i per thread
+// - i = t*4 + {0..3} (contiguous f32 row), j = WG.y, k = WG.z:
+//   NO flat indexing, NO fastdiv/fastmod (t, j, k are in range by construction)
+// - the SIGMOID itself stays a normal unary kernel node (bit-exact by definition);
+//   recomputing 1/(1+exp(-x)) in a different shader broke byte-exactness (S2 test 05/09)
+// Bit-exactness rules (validated empirically by full-model checksum A/B):
+// - `precise` on every intermediate: separate rounded mul then rounded add,
+//   no FMA contraction, exactly like the original MUL/ADD kernel chain
+// - the two *2.0 multiplications (powers of two) are kept distinct, both exact
+
+#extension GL_EXT_control_flow_attributes : require // [[unroll]]
+
+layout (push_constant) uniform parameter
+{
+    uint n_i;             // threads per (j,k) row = n_embd/4 (4 scalars each)
+    uint r_j; uint r_k;  // res strides (f32 units)
+    uint b_k;             // b   stride  (f32 units)  — b has no j dimension
+    uint s_j; uint s_k;  // sig strides (f32 units)
+    uint d_j; uint d_k;  // dst strides (f32 units)
+} p;
+
+layout (binding = 0) readonly restrict buffer A { float data_a[]; }; // res
+layout (binding = 1) readonly restrict buffer B { float data_b[]; }; // b (via reshape of block_out)
+layout (binding = 2) readonly restrict buffer C { float data_c[]; }; // sig (unary SIGMOID output)
+layout (binding = 3) writeonly restrict buffer D { float data_d[]; }; // dst
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const uint t = gl_WorkGroupID.x * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
+    if (t >= p.n_i) {
+        return;
+    }
+    const uint j = gl_WorkGroupID.y; // < hc by grid construction
+    const uint k = gl_WorkGroupID.z; // < nt by grid construction
+
+    const uint x     = t * 4;             // first i of this thread
+    const uint rbase = x + j*p.r_j + k*p.r_k;
+    const uint bbase = x +         k*p.b_k;
+    const uint dbase = x + j*p.d_j + k*p.d_k;
+
+    const float s = data_c[j*p.s_j + k*p.s_k];
+
+    precise float w0 = s * 2.0f;  // SCALE(2.0): exact (power of two)
+    precise float w1 = w0 * 2.0f; // SCALE(2.0): exact (power of two)
+
+    [[unroll]] for (uint l = 0; l < 4; ++l) {
+        precise float r = data_a[rbase + l];
+        precise float b = data_b[bbase + l];
+        precise float m = b * w1; // no FMA contraction: mul is one rounded step
+        precise float o = r + m; // add is the next rounded step, as in the original chain
+        data_d[dbase + l] = o;
+    }
+}
