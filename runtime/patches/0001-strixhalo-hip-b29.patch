diff --git a/tools/server/uniform_ctl.h b/tools/server/uniform_ctl.h
new file mode 100644
index 0000000000000000000000000000000000000000..d941d785baabcac62b4c6cc609a603e595dfe9a8
--- /dev/null
+++ b/tools/server/uniform_ctl.h
@@ -0,0 +1,91 @@
+#pragma once
+// [V8MULTI] Cohort draft-width controller (MTPB step 2). Header-only, no dependencies.
+// Draft-pass drafted by DeepSeek V4.1 Flash, reviewed and corrected by Claude.
+// Concept: Gufo MtpBatchController::Choose (MIT) - no code copied; the cost model is ours (cd, env-tunable).
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+struct uniform_width_ctl {
+    double   p[8];        // EMA P(rank k+1 accepted | ranks <= k accepted)
+    double   cd    = 0.15; // relative cost of one extra draft position in the pass
+    double   alpha = 0.10;
+    uint64_t n_choose = 0;
+    uint64_t n_probe  = 0;
+    uint64_t hist[9]  = { 0 };
+    int      wmax_    = 1;
+    int      last_W   = 0;
+    uint64_t call_count = 0;
+
+    uniform_width_ctl() {
+        p[0] = 0.70;
+        p[1] = 0.60;
+        for (int k = 2; k < 8; ++k) p[k] = 0.50;
+    }
+
+    void init(int wmax) {
+        wmax_ = std::min(8, std::max(1, wmax));
+        const char * env = std::getenv("LLAMA_SPEC_UNIFORM_CD");
+        if (env && *env) {
+            char * endp = nullptr;
+            const double v = std::strtod(env, &endp);
+            if (endp && *endp == '\0' && v > 0.0 && v <= 2.0) {
+                cd = v;
+            }
+        }
+    }
+
+    // a slot verified n_draft draft tokens and n_accepted of them were accepted
+    void observe(int n_draft, int n_accepted) {
+        if (n_draft <= 0) return;
+        n_accepted = std::min(std::max(n_accepted, 0), n_draft);
+        const int kmax = std::min(n_accepted + 1, n_draft);
+        for (int k = 1; k <= kmax && k <= 8; ++k) {
+            const double obs = (k <= n_accepted) ? 1.0 : 0.0;
+            p[k - 1] += alpha * (obs - p[k - 1]);
+        }
+    }
+
+    double score(int W) const {
+        W = std::max(W, 0);
+        double E = 1.0, prod = 1.0;
+        for (int j = 1; j <= W; ++j) {
+            prod *= (j <= 8) ? p[j - 1] : 0.0;
+            E += prod;
+        }
+        return E / (1.0 + cd * (double) W);
+    }
+
+    int choose(int cap) {
+        call_count++;
+        n_choose++;
+        if (cap <= 0) {
+            last_W = 0;
+            hist[0]++;
+            return 0;
+        }
+        cap = std::min(cap, wmax_);
+        if (call_count % 16 == 0) { // optimistic probe: re-measure deep ranks
+            n_probe++;
+            last_W = cap;
+            hist[cap]++;
+            return cap;
+        }
+        int best = 0;
+        double best_score = score(0);
+        for (int W = 1; W <= cap; ++W) {
+            const double s = score(W);
+            if (s > best_score) { best_score = s; best = W; }
+        }
+        const int prev = std::min(std::max(last_W, 0), cap);
+        int chosen = prev;
+        if (best == prev || best_score > 1.01 * score(prev)) {
+            chosen = best;
+        }
+        last_W = chosen;
+        hist[chosen]++;
+        return chosen;
+    }
+};
