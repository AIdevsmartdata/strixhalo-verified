index 0000000000000000000000000000000000000000..7ad47189a8931ba3e3f310daab1e7941a697bf07
--- /dev/null
+++ b/src/llama-ple-prechauffe.h
@@ -0,0 +1,146 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <vector>
+
+#if defined(__linux__)
+#include <cerrno>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+// Immutable raw rows. The caller holds the PLE gather mutex during load and lookup.
+struct llama_ple_hot_rows {
+    struct file_closer { void operator()(FILE * f) const { fclose(f); } };
+    static constexpr uint64_t gib = 1ull << 30;
+    // Avenant pilote 26/10 22h40 : plancher de MemAvailable réglable (défaut 30 Gio, inchangé). La zone verrouillée ne fait
+    // qu'environ 100 Mio ; avec ~104 Go de GTT chargés, le plancher fixe de 30 Gio rendait le budget toujours nul.
+    static inline const uint64_t floor = [] {
+        const char * e = getenv("LLAMA_OPUS_PLE_PRECHAUFFE_PLANCHER_GO");
+        const long v = e ? atol(e) : 30;
+        return (uint64_t) (v >= 4 ? v : 30) * gib;
+    }();
+    uint8_t * map = nullptr;
+    size_t len = 0, count = 0, row_bytes = 0, ranges = 0, io_bytes = 0;
+    const int32_t * ids = nullptr;
+    const uint8_t * data = nullptr;
+    std::string status = "not started";
+
+    static uint64_t available() {
+#if defined(__linux__)
+        std::unique_ptr<FILE, file_closer> f(fopen("/proc/meminfo", "r"));
+        if (f) {
+            char line[256];
+            unsigned long long kb;
+            while (fgets(line, sizeof(line), f.get())) {
+                if (sscanf(line, "MemAvailable: %llu kB", &kb) == 1) { return kb * 1024; }
+            }
+        }
+#endif
+        return 0;
+    }
+
+    static size_t budget(uint64_t avail, uint64_t limit = 4 * gib) {
+        // Keep 30 GiB plus 2 GiB for later service allocations; use half the surplus.
+        return avail > floor + 2 * gib ? (size_t) std::min(limit, (avail - floor - 2 * gib) / 2) : 0;
+    }
+
+    void reset() {
+#if defined(__linux__)
+        if (map) { munmap(map, len); }
+#endif
+        map = nullptr; ids = nullptr; data = nullptr; len = count = row_bytes = ranges = io_bytes = 0;
+    }
+    ~llama_ple_hot_rows() { reset(); }
+    llama_ple_hot_rows() = default;
+    llama_ple_hot_rows(const llama_ple_hot_rows &) = delete;
+    llama_ple_hot_rows & operator=(const llama_ple_hot_rows &) = delete;
+
+    const uint8_t * find(int32_t row) const {
+        if (!map) { return nullptr; }
+        const auto p = std::lower_bound(ids, ids + count, row);
+        return p != ids + count && *p == row ? data + (p - ids) * row_bytes : nullptr;
+    }
+
+    bool load(const std::string & file, size_t offset, size_t rs, int64_t nrows,
+              const char * ranking, size_t bytes, uint64_t (*mem)() = available) {
+        reset();
+        auto fail = [&](const char * why) { reset(); status = why; return false; };
+#if defined(__linux__)
+        const long page = sysconf(_SC_PAGESIZE);
+        if (!ranking || !*ranking || !rs || nrows <= 0 || nrows > INT32_MAX || page <= 0) {
+            return fail("invalid parameters or missing ROWS file");
+        }
+        if (bytes < (size_t) page || bytes > budget(mem(), bytes)) { return fail("memory budget exhausted"); }
+        std::unique_ptr<FILE, file_closer> f(fopen(ranking, "rb"));
+        if (!f) { return fail("cannot open ROWS file"); }
+        // Budget covers both the final slab/index and this temporary rank vector.
+        struct stat st;
+        if (fstat(fileno(f.get()), &st) != 0 || st.st_size < 0 || st.st_size % 4) { return fail("invalid ROWS size"); }
+        const size_t cap = std::min<size_t>((bytes - page) / (rs + 2 * sizeof(int32_t)),
+                                           std::min<uint64_t>(nrows, (uint64_t) st.st_size / 4));
+        std::vector<int32_t> rows;
+        rows.reserve(cap);
+        uint8_t b[4];
+        while (rows.size() < cap) {
+            const size_t got = fread(b, 1, 4, f.get());
+            if (!got && !ferror(f.get())) { break; }
+            if (got != 4) { return fail("truncated ROWS file"); }
+            const uint32_t row = uint32_t(b[0]) | (uint32_t(b[1]) << 8) | (uint32_t(b[2]) << 16) | (uint32_t(b[3]) << 24);
+            if (row >= (uint64_t) nrows) { return fail("row out of range"); }
+            rows.push_back((int32_t) row);
+        }
+        if (rows.empty()) { return fail("empty ROWS selection"); }
+        std::sort(rows.begin(), rows.end());
+        rows.erase(std::unique(rows.begin(), rows.end()), rows.end());
+        count = rows.size(); row_bytes = rs;
+        const size_t index = count * sizeof(int32_t);
+        len = ((index + count * rs + page - 1) / page) * page;
+        void * p = mmap(nullptr, len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        if (p == MAP_FAILED) { return fail("mmap failed"); }
+        map = (uint8_t *) p;
+        // Lock in bounded chunks, checking memory between chunks. No unlocked fallback.
+        for (size_t pos = 0; pos < len; pos += 8u << 20) {
+            if (mem() < floor || mlock(map + pos, std::min<size_t>(8u << 20, len - pos)) != 0) {
+                return fail("memory guard or mlock failed");
+            }
+        }
+        memcpy(map, rows.data(), index);
+        ids = (const int32_t *) map; data = map + index;
+        const int fd = open(file.c_str(), O_RDONLY | O_CLOEXEC);
+        if (fd < 0) { return fail("cannot open PLE source"); }
+        posix_fadvise(fd, 0, 0, POSIX_FADV_RANDOM);
+        bool ok = true;
+        for (size_t i = 0; i < count && ok;) {
+            if (ranges % 256 == 0 && mem() < floor) { ok = false; break; }
+            size_t end = i + 1;
+            while (end < count && rows[end] == rows[end - 1] + 1 && (end - i + 1) * rs <= (8u << 20)) { ++end; }
+            const size_t n = (end - i) * rs;
+            const uint64_t off = (uint64_t) offset + (uint64_t) rows[i] * rs;
+            size_t got = 0;
+            while (got < n) {
+                const ssize_t r = pread(fd, map + index + i * rs + got, n - got, (off_t) (off + got));
+                if (r < 0 && errno == EINTR) { continue; }
+                if (r <= 0) { ok = false; break; }
+                got += (size_t) r;
+            }
+            io_bytes += got; ++ranges; i = end;
+        }
+        close(fd);
+        if (!ok || mem() < floor) { return fail("read failed or memory guard reached"); }
+        status = "locked";
+        return true;
+#else
+        (void) file; (void) offset; (void) rs; (void) nrows; (void) ranking; (void) bytes; (void) mem;
+        return fail("Linux only");
+#endif
+    }
+};
