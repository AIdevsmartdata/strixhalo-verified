+// OPUS-1010 V3HEADQ6 (code DeepSeek V4.1 Flash, relu par Claude) : requantification en place de output.weight Q8_0 -> Q6_K/Q5_K au chargement.
+// Interrupteurs : LLAMA_OPUS_HEAD_QTYPE (principal), LLAMA_OPUS_DRAFT_HEAD_QTYPE (brouillon MTP). Defaut OFF.
+static void opus_requant_head(ggml_tensor * t, ggml_type tgt, const char * who) {
+    if (t == nullptr) {
+        LLAMA_LOG_WARN("%s: opus_requant_head: tenseur nul\n", who);
+        return;
+    }
+    if (t->type != GGML_TYPE_Q8_0) {
+        LLAMA_LOG_WARN("%s: opus_requant_head: type source %s != Q8_0\n", who, ggml_type_name(t->type));
+        return;
+    }
+    if (t->ne[2] != 1 || t->ne[3] != 1) {
+        LLAMA_LOG_WARN("%s: opus_requant_head: tenseur non 2D (ne2=%lld ne3=%lld)\n",
+                       who, (long long) t->ne[2], (long long) t->ne[3]);
+        return;
+    }
+    if (t->ne[0] % 256 != 0) {
+        LLAMA_LOG_WARN("%s: opus_requant_head: ne0=%lld non multiple de 256\n",
+                       who, (long long) t->ne[0]);
+        return;
+    }
+    if (t->buffer == nullptr) {
+        LLAMA_LOG_WARN("%s: opus_requant_head: buffer nul\n", who);
+        return;
+    }
+    if (tgt != GGML_TYPE_Q6_K && tgt != GGML_TYPE_Q5_K) {
+        LLAMA_LOG_WARN("%s: opus_requant_head: cible %s non supportee\n", who, ggml_type_name(tgt));
+        return;
+    }
+    if (ggml_backend_buffer_is_host(t->buffer)) {
+        LLAMA_LOG_WARN("%s: opus_requant_head: buffer host, requantification ignoree\n", who);
+        return;
+    }
+
+    const int64_t ne0 = t->ne[0];
+    const int64_t ne1 = t->ne[1];
+
+    const size_t src_row_size = ggml_row_size(GGML_TYPE_Q8_0, ne0);
+    const size_t dst_row_size = ggml_row_size(tgt, ne0);
+
+    std::vector<uint8_t> src(ggml_nbytes(t));
+    ggml_backend_tensor_get(t, src.data(), 0, src.size());
+
+    std::vector<uint8_t> dst(dst_row_size * (size_t) ne1);
+
+    int nthr = 8;
+    if (const char * e = std::getenv("LLAMA_OPUS_HEAD_THREADS")) {
+        int v = std::atoi(e);
+        if (v >= 1 && v <= 32) nthr = v;
+    }
+    if ((int64_t) nthr > ne1) nthr = (int) ne1;
+
+    std::vector<double> thr_sum_x2(nthr, 0.0);
+    std::vector<double> thr_sum_e2(nthr, 0.0);
+
+    const auto t_start = std::chrono::steady_clock::now();
+
+    auto worker = [&](int tid, int64_t r_begin, int64_t r_end) {
+        const auto * tr_src = ggml_get_type_traits(GGML_TYPE_Q8_0);
+        const auto * tr_dst = ggml_get_type_traits(tgt);
+        std::vector<float> f32(ne0 * 16);
+        std::vector<float> f32q(ne0);
+        double sum_x2 = 0.0;
+        double sum_e2 = 0.0;
+        int64_t r = r_begin;
+        while (r < r_end) {
+            const int64_t nb = std::min<int64_t>(16, r_end - r);
+            for (int64_t i = 0; i < nb; ++i) {
+                const uint8_t * src_row = src.data() + (r + i) * src_row_size;
+                tr_src->to_float(src_row, f32.data() + i * ne0, ne0);
+            }
+            ggml_quantize_chunk(tgt, f32.data(),
+                                dst.data() + (size_t) r * dst_row_size,
+                                /*start*/ 0, /*nrows*/ nb,
+                                /*n_per_row*/ ne0, /*imatrix*/ nullptr);
+            for (int64_t i = 0; i < nb; ++i) {
+                const uint8_t * dst_row = dst.data() + (r + i) * dst_row_size;
+                tr_dst->to_float(dst_row, f32q.data(), ne0);
+                const float * x = f32.data() + i * ne0;
+                for (int64_t k = 0; k < ne0; ++k) {
+                    const double xv = (double) x[k];
+                    const double d  = xv - (double) f32q[k];
+                    sum_x2 += xv * xv;
+                    sum_e2 += d * d;
+                }
+            }
+            r += nb;
+        }
+        thr_sum_x2[tid] = sum_x2;
+        thr_sum_e2[tid] = sum_e2;
+    };
+
+    std::vector<std::thread> threads;
+    threads.reserve(nthr);
+    const int64_t chunk = (ne1 + nthr - 1) / nthr;
+    for (int i = 0; i < nthr; ++i) {
+        const int64_t r0 = (int64_t) i * chunk;
+        const int64_t r1 = std::min<int64_t>(ne1, r0 + chunk);
+        if (r0 >= r1) break;
+        threads.emplace_back(worker, i, r0, r1);
+    }
+    for (auto & th : threads) th.join();
+
+    double sum_x2 = 0.0;
+    double sum_e2 = 0.0;
+    for (int i = 0; i < nthr; ++i) {
+        sum_x2 += thr_sum_x2[i];
+        sum_e2 += thr_sum_e2[i];
+    }
+    const double rms_rel = (sum_x2 > 0.0) ? std::sqrt(sum_e2 / sum_x2) : 0.0;
+
+    const size_t src_bytes = src.size();
+    const size_t dst_bytes = dst.size();
+
+    ggml_backend_tensor_set(t, dst.data(), 0, dst.size());
+
+    t->type  = tgt;
+    t->nb[0] = ggml_type_size(tgt);
+    t->nb[1] = ggml_row_size(tgt, t->ne[0]);
+    t->nb[2] = t->nb[1] * t->ne[1];
+    t->nb[3] = t->nb[2] * t->ne[2];
+
+    const double dt = std::chrono::duration<double>(std::chrono::steady_clock::now() - t_start).count();
+
+    LLAMA_LOG_INFO("%s: %s requantifie %s -> %s, %.1f -> %.1f MiB, erreur RMS relative %.5f, %.2f s, %d threads\n",
+                   who, t->name, ggml_type_name(GGML_TYPE_Q8_0), ggml_type_name(tgt),
+                   (double) src_bytes / (1024.0 * 1024.0), (double) dst_bytes / (1024.0 * 1024.0),
+                   rms_rel, dt, nthr);
+}
+
+// OPUS-1011 V7RQ (code DeepSeek V4.1 Flash, relu par Claude) : requantification en place, au chargement, de tenseurs
+// choisis par motif de nom (Q8_0 -> Q4_0/Q4_1/Q5_0/Q5_1/Q4_K/Q5_K/Q6_K/IQ4_NL ; F32 -> BF16 exact).
+// Interrupteurs : LLAMA_OPUS_REQUANT="motif=type;motif=type" (principal), LLAMA_OPUS_DRAFT_REQUANT (brouillon MTP),
+// repli : LLAMA_OPUS_HEAD_QTYPE / LLAMA_OPUS_DRAFT_HEAD_QTYPE = regle output.weight=<type>. Defaut OFF.
+struct opus_rq_rule {
+    std::string pattern;
+    ggml_type   tgt;
+};
+
+static ggml_type opus_rq_type_from_name(const std::string & s) {
+    std::string t;
+    t.reserve(s.size());
+    for (char c : s) t.push_back((char) std::tolower((unsigned char) c));
+    if (t == "q4_0")   return GGML_TYPE_Q4_0;
+    if (t == "q4_1")   return GGML_TYPE_Q4_1;
+    if (t == "q5_0")   return GGML_TYPE_Q5_0;
+    if (t == "q5_1")   return GGML_TYPE_Q5_1;
+    if (t == "q8_0")   return GGML_TYPE_Q8_0;
+    if (t == "q4_k")   return GGML_TYPE_Q4_K;
+    if (t == "q5_k")   return GGML_TYPE_Q5_K;
+    if (t == "q6_k")   return GGML_TYPE_Q6_K;
+    if (t == "iq4_nl") return GGML_TYPE_IQ4_NL;
+    if (t == "bf16")   return GGML_TYPE_BF16;
+    return GGML_TYPE_COUNT;
+}
+
+static std::vector<opus_rq_rule> opus_rq_parse(const char * env, const char * who) {
+    std::vector<opus_rq_rule> rules;
+    if (env == nullptr || *env == '\0') return rules;
+    auto trim = [](std::string & x) {
+        size_t a = 0, b = x.size();
+        while (a < b && std::isspace((unsigned char) x[a])) a++;
+        while (b > a && std::isspace((unsigned char) x[b - 1])) b--;
+        x = x.substr(a, b - a);
+    };
+    std::string s(env);
+    size_t pos = 0;
+    while (pos <= s.size()) {
+        size_t semi = s.find(';', pos);
+        std::string tok = s.substr(pos, semi == std::string::npos ? std::string::npos : semi - pos);
+        pos = (semi == std::string::npos) ? s.size() + 1 : semi + 1;
+        trim(tok);
+        if (tok.empty()) continue;
+        size_t eq = tok.find('=');
+        if (eq == std::string::npos) {
+            LLAMA_LOG_WARN("%s: opus-rq: regle invalide (pas de '=') : '%s'\n", who, tok.c_str());
+            continue;
+        }
+        std::string pat = tok.substr(0, eq);
+        std::string typ = tok.substr(eq + 1);
+        trim(pat); trim(typ);
+        if (pat.empty() || typ.empty()) {
+            LLAMA_LOG_WARN("%s: opus-rq: regle invalide : '%s'\n", who, tok.c_str());
+            continue;
+        }
+        ggml_type tgt = opus_rq_type_from_name(typ);
+        if (tgt == GGML_TYPE_COUNT) {
+            LLAMA_LOG_WARN("%s: opus-rq: type inconnu '%s' dans la regle '%s'\n", who, typ.c_str(), tok.c_str());
+            continue;
+        }
+        rules.push_back({ pat, tgt });
+    }
+    return rules;
+}
+
+static bool opus_requant_tensor(ggml_tensor * t, ggml_type tgt, const char * who,
+                                size_t & bytes_saved, double & rms_rel_out) {
+    bytes_saved = 0;
+    rms_rel_out = 0.0;
+    if (t == nullptr || t->buffer == nullptr || ggml_backend_buffer_is_host(t->buffer)) return false;
+
+    const ggml_type src_type = t->type;
+    const bool src_is_q8   = (src_type == GGML_TYPE_Q8_0);
+    const bool src_is_f32  = (src_type == GGML_TYPE_F32);
+    const bool dst_is_bf16 = (tgt == GGML_TYPE_BF16);
+
+    if (!(src_is_q8 || (src_is_f32 && dst_is_bf16))) {
+        LLAMA_LOG_WARN("%s: opus-rq: conversion %s -> %s non supportee\n", who, ggml_type_name(src_type), ggml_type_name(tgt));
+        return false;
+    }
+
+    const int64_t ne0 = t->ne[0];
+    const int64_t nrows = t->ne[1] * t->ne[2] * t->ne[3];
+    const int64_t dst_blck = ggml_blck_size(tgt);
+    if (dst_blck <= 0 || (ne0 % dst_blck) != 0) {
+        LLAMA_LOG_WARN("%s: opus-rq: %s ne0=%lld non divisible par blck_size(%s)=%lld\n",
+                       who, t->name, (long long) ne0, ggml_type_name(tgt), (long long) dst_blck);
+        return false;
+    }
+
+    const size_t src_row_size = ggml_row_size(src_type, ne0);
+    const size_t dst_row_size = ggml_row_size(tgt, ne0);
+    const size_t src_total = src_row_size * (size_t) nrows;
+    const size_t dst_total = dst_row_size * (size_t) nrows;
+
+    if (t->nb[1] != src_row_size || ggml_nbytes(t) != src_total) {
+        LLAMA_LOG_WARN("%s: opus-rq: %s non contigu, abandon\n", who, t->name);
+        return false;
+    }
+    if (dst_total >= src_total) {
+        LLAMA_LOG_WARN("%s: opus-rq: %s taille cible (%zu) >= source (%zu), abandon\n", who, t->name, dst_total, src_total);
+        return false;
+    }
+
+    const ggml_type_traits * tr_src = ggml_get_type_traits(src_type);
+    const ggml_type_traits * tr_dst = ggml_get_type_traits(tgt);
+    if (tr_src == nullptr || tr_dst == nullptr || tr_src->to_float == nullptr || tr_dst->to_float == nullptr) {
+        LLAMA_LOG_WARN("%s: opus-rq: traits manquants pour %s -> %s\n", who, ggml_type_name(src_type), ggml_type_name(tgt));
+        return false;
+    }
+
+    int n_threads = 8;
+    if (const char * e = std::getenv("LLAMA_OPUS_RQ_THREADS")) {
+        char * endp = nullptr;
+        long v = strtol(e, &endp, 10);
+        if (endp != e && v >= 1 && v <= 32) n_threads = (int) v;
+    }
+    if ((int64_t) n_threads > nrows) n_threads = (int) std::max<int64_t>(1, nrows);
+
+    std::vector<uint8_t> src(src_total);
+    ggml_backend_tensor_get(t, src.data(), 0, src_total);
+    std::vector<uint8_t> dst(dst_total);
+
+    std::vector<double> th_sum_x2((size_t) n_threads, 0.0);
+    std::vector<double> th_sum_e2((size_t) n_threads, 0.0);
+    const int64_t BLOCK_ROWS = 16;
+
+    auto worker = [&](int tid) {
+        std::vector<float> f32((size_t) ne0);
+        std::vector<float> f32_dq((size_t) ne0);
+        double sum_x2 = 0.0, sum_e2 = 0.0;
+        for (int64_t r0 = (int64_t) tid * BLOCK_ROWS; r0 < nrows; r0 += (int64_t) n_threads * BLOCK_ROWS) {
+            const int64_t r1 = std::min<int64_t>(r0 + BLOCK_ROWS, nrows);
+            for (int64_t r = r0; r < r1; r++) {
+                const uint8_t * src_row = src.data() + (size_t) r * src_row_size;
+                uint8_t * dst_row = dst.data() + (size_t) r * dst_row_size;
+                tr_src->to_float(src_row, f32.data(), ne0);
+                if (dst_is_bf16) {
+                    ggml_fp32_to_bf16_row(f32.data(), (ggml_bf16_t *) dst_row, ne0);
+                } else {
+                    ggml_quantize_chunk(tgt, f32.data(), dst_row, 0, 1, ne0, nullptr);
+                }
+                tr_dst->to_float(dst_row, f32_dq.data(), ne0);
+                for (int64_t i = 0; i < ne0; i++) {
+                    const double x = (double) f32[i];
+                    const double e = (double) f32_dq[i] - x;
+                    sum_x2 += x * x;
+                    sum_e2 += e * e;
+                }
+            }
+        }
+        th_sum_x2[(size_t) tid] = sum_x2;
+        th_sum_e2[(size_t) tid] = sum_e2;
+    };
+
+    if (n_threads <= 1) {
+        worker(0);
+    } else {
+        std::vector<std::thread> threads;
+        threads.reserve((size_t) n_threads);
+        for (int i = 0; i < n_threads; i++) threads.emplace_back(worker, i);
+        for (auto & th : threads) th.join();
+    }
+
+    double sum_x2 = 0.0, sum_e2 = 0.0;
+    for (int i = 0; i < n_threads; i++) { sum_x2 += th_sum_x2[(size_t) i]; sum_e2 += th_sum_e2[(size_t) i]; }
+    rms_rel_out = (sum_x2 > 0.0) ? std::sqrt(sum_e2 / sum_x2) : 0.0;
+
+    ggml_backend_tensor_set(t, dst.data(), 0, dst_total);
+
+    t->type  = tgt;
+    t->nb[0] = ggml_type_size(tgt);
+    t->nb[1] = ggml_row_size(tgt, t->ne[0]);
+    t->nb[2] = t->nb[1] * t->ne[1];
+    t->nb[3] = t->nb[2] * t->ne[2];
+
+    bytes_saved = src_total - dst_total;
+    return true;
+}
+
+static void opus_requant_all(const std::vector<std::pair<std::string, struct ggml_tensor *>> & tensors_by_name,
+                             const ggml_tensor * tok_embd, const char * env_value, const char * who) {
+    if (env_value == nullptr || *env_value == '\0') return;
+    std::vector<opus_rq_rule> rules = opus_rq_parse(env_value, who);
+    if (rules.empty()) return;
+
+    const char * vb = std::getenv("LLAMA_OPUS_RQ_VERBOSE");
+    const bool verbose = vb != nullptr && *vb != '\0' && *vb != '0';
+
+    struct rule_stat { size_t n = 0; size_t saved = 0; double w_e2 = 0.0; double n_elem = 0.0; double sec = 0.0; };
+    std::vector<rule_stat> stats(rules.size());
+    size_t total_before = 0, total_after = 0;
+    double total_sec = 0.0;
+    std::vector<std::pair<std::string, std::string>> skipped;
+
+    for (const auto & kv : tensors_by_name) {
+        const std::string & name = kv.first;
+        ggml_tensor * t = kv.second;
+        if (t == nullptr) continue;
+
+        int matched = -1;
+        for (size_t i = 0; i < rules.size(); i++) {
+            if (fnmatch(rules[i].pattern.c_str(), name.c_str(), 0) == 0) { matched = (int) i; break; }
+        }
+        if (matched < 0) continue;
+
+        if (name == "token_embd.weight" || (tok_embd != nullptr && (t == tok_embd || (t->data != nullptr && t->data == tok_embd->data)))) {
+            skipped.push_back({ name, "token_embd ou donnees partagees avec token_embd" });
+            continue;
+        }
+        const ggml_type tgt = rules[(size_t) matched].tgt;
+        if (t->buffer == nullptr || ggml_backend_buffer_is_host(t->buffer)) {
+            skipped.push_back({ name, "buffer nul ou host" });
+            continue;
+        }
+
+        const size_t before = ggml_nbytes(t);
+        const ggml_type src_type = t->type;
+        size_t saved = 0;
+        double rms = 0.0;
+        const auto t0 = std::chrono::steady_clock::now();
+        const bool ok = opus_requant_tensor(t, tgt, who, saved, rms);
+        const double dt = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+        if (!ok) {
+            skipped.push_back({ name, "refusee (voir WARN)" });
+            continue;
+        }
+        const size_t after = ggml_nbytes(t);
+        rule_stat & st = stats[(size_t) matched];
+        const double n_elem = (double) (t->ne[0] * t->ne[1] * t->ne[2] * t->ne[3]);
+        st.n++; st.saved += saved; st.sec += dt; st.w_e2 += rms * rms * n_elem; st.n_elem += n_elem;
+        total_before += before; total_after += after; total_sec += dt;
+        if (verbose) {
+            LLAMA_LOG_INFO("%s: opus-rq: %s : %s -> %s, %.2f -> %.2f MiB, RMS rel %.5f, %.2f s\n", who, name.c_str(),
+                           ggml_type_name(src_type), ggml_type_name(tgt),
+                           (double) before / 1048576.0, (double) after / 1048576.0, rms, dt);
+        }
+    }
+
+    for (size_t i = 0; i < rules.size(); i++) {
+        const rule_stat & st = stats[i];
+        if (st.n == 0) continue;
+        const double rms_avg = st.n_elem > 0.0 ? std::sqrt(st.w_e2 / st.n_elem) : 0.0;
+        LLAMA_LOG_WARN("%s: opus-rq: regle '%s' -> %s : %d tenseurs, %.1f MiB economises, erreur RMS relative moyenne ponderee %.5f, %.2f s total\n",
+                       who, rules[i].pattern.c_str(), ggml_type_name(rules[i].tgt), (int) st.n,
+                       (double) st.saved / 1048576.0, rms_avg, st.sec);
+    }
+    if (total_before > 0) {
+        LLAMA_LOG_WARN("%s: opus-rq: total : %.1f -> %.1f MiB (%.1f MiB economises, %.2f%% de ces tenseurs), %.2f s\n", who,
+                       (double) total_before / 1048576.0, (double) total_after / 1048576.0,
+                       (double) (total_before - total_after) / 1048576.0,
+                       100.0 * (double) (total_before - total_after) / (double) total_before, total_sec);
+    } else {
+        LLAMA_LOG_WARN("%s: opus-rq: AUCUN tenseur requantifie (motifs sans correspondance ou refuses)\n", who);
+    }
+    for (size_t i = 0; i < skipped.size() && i < 10; i++) {
+        LLAMA_LOG_WARN("%s: opus-rq: ignore %s : %s\n", who, skipped[i].first.c_str(), skipped[i].second.c_str());
+    }
+    if (skipped.size() > 10) {
+        LLAMA_LOG_WARN("%s: opus-rq: ... et %zu autres tenseurs ignores\n", who, skipped.size() - 10);
+    }
+}
