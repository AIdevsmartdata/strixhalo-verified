+++ b/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_cm1.comp
@@ -23,6 +23,13 @@
 #endif
 
 // These need to be supported N,M values for a MatBc x MatBr x 16 coopmatmuladd
+// [TAG_FA_DIAG] Mode diagnostic (jamais deploye) : neutralise UNE phase pour mesurer son cout.
+// 0 = normal | 1 = sans exp (SFU) | 2 = sans les mma du PV | 3 = sans les mma du QK^T
+// 4 = sans le rescale de l'accumulateur O | 5 = sans les chargements K/V
+#ifndef FA_DIAG
+#define FA_DIAG 0
+#endif
+
 const uint32_t MatBr = 16;
 const uint32_t MatBc = 16;
 
@@ -50,6 +57,16 @@ shared FLOAT_TYPEV4 Qf[Br * qstride];
 const uint psh_stride = Bc / 4 + 2;
 shared FLOAT_TYPEV4 Psh[Br * psh_stride];
 
+// [TAG_FA_MR] Nombre de groupes de 16 lignes de requetes par workgroup.
+// MR=1 : comportement historique (Br=16). MR=2/4 : le workgroup couvre Br = 16*MR lignes
+// et surtout **les chargements K/V sont partages entre les groupes** (le banc FA_DIAG
+// montre que ces chargements pesent 55 % a kv=32k et 73 % a kv=131k, alors que la partie
+// mma tourne deja a ~23 TFLOPS, soit le niveau du GEMM). Offsets de groupe, selon la
+// semantique des buffers : Qf + m*16*qstride | sfsh + m*4 | Psh + m*16*psh_stride |
+// pvsh + m*16*osh_stride.
+#ifndef MR
+#define MR 1
+#endif
 // Avoid padding for hsk==256 to make it fit in 48KB shmem.
 const uint32_t sfshstride = (HSK <= 128) ? (Br / 4 + 2) : Br / 4;
 shared ACC_TYPEV4 sfsh[Bc * sfshstride];
@@ -61,7 +78,7 @@ const uint vsh_stride = v_cols;
 shared FLOAT_TYPEV4 kvsh[(kvsh_stride >= vsh_stride) ? (Bc * kvsh_stride) : (Bc * vsh_stride)];
 
 const uint32_t osh_stride = row_split * MatBr / 4;
-shared O_TYPEV4 pvsh[MatBc * osh_stride];
+shared O_TYPEV4 pvsh[Br * osh_stride];   // [TAG_FA_MR] Br = 16*MR lignes
 
 shared ACC_TYPE slope[Br];
 
@@ -257,7 +274,10 @@ void main() {
         // K * Q^T -> S^T: Bc x HSK_pad * HSK_pad x Br -> Bc x Br
         // Bc split across workgroup (four subgroups), loop over HSK in chunks of 16: 16 x 16 * 16 x 16 -> 16 x 16
         // This is written transposed in order to allow for N being 8 if implementations need it
-        coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> SfMat = coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
+        coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> SfMat[MR];
+        [[unroll]] for (uint32_t m = 0; m < MR; ++m) {
+            SfMat[m] = coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(ACC_TYPE(0));
+        }
         coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBc, 16, gl_MatrixUseA> KMat;
         coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, MatBr, gl_MatrixUseB> QMat;
 
@@ -302,20 +322,28 @@ void main() {
                 coopMatLoad(KMat, kvsh, coord, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
             } else {
                 const uint coord = k_offset / 4 + (j * Bc + gl_SubgroupID * MatBc) * k_stride / 4 + d * 16 / 4;
+#if FA_DIAG != 5
                 coopMatLoad(KMat, data_kv4, coord, k_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
+#endif
             }
             } else {
                 uint coord = (gl_SubgroupID * MatBc) * kvsh_stride + d * 16 / 4;
                 coopMatLoad(KMat, kvsh, coord, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
             }
 
-            coopMatLoad(QMat, Qf, d * 16 / 4, qstride, gl_CooperativeMatrixLayoutColumnMajor);
-
-            SfMat = coopMatMulAdd(KMat, QMat, SfMat);
+            // [TAG_FA_MR] KMat est charge UNE fois par d, puis reutilise par les MR groupes.
+            [[unroll]] for (uint32_t m = 0; m < MR; ++m) {
+                coopMatLoad(QMat, Qf, m * 16 * qstride + d * 16 / 4, qstride, gl_CooperativeMatrixLayoutColumnMajor);
+#if FA_DIAG != 3
+                SfMat[m] = coopMatMulAdd(KMat, QMat, SfMat[m]);
+#endif
+            }
         }
 
         uint coord = gl_SubgroupID * MatBc * sfshstride;
-        coopMatStore(SfMat, sfsh, coord, sfshstride, gl_CooperativeMatrixLayoutRowMajor);
+        [[unroll]] for (uint32_t m = 0; m < MR; ++m) {
+            coopMatStore(SfMat[m], sfsh, coord + m * 4, sfshstride, gl_CooperativeMatrixLayoutRowMajor);
+        }
         barrier();
 
         if (LOGIT_SOFTCAP) {
@@ -375,7 +403,9 @@ void main() {
         [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
             const uint d_local = d0 / threads_per_rowgroup;
             [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
+#if FA_DIAG != 4
                 Of[r][d_local] = O_TYPE(eMf[r]) * Of[r][d_local];
+#endif
             }
         }
 
@@ -393,7 +423,11 @@ void main() {
                     }
                 } else {
                     const vec4 mfvec = vec4(Mf[r], Mf[r + 1], Mf[r + 2], Mf[r + 3]);
+#if FA_DIAG == 1
+                    const FLOAT_TYPEV4 Pf = FLOAT_TYPEV4(vec4(sfsh[row / 4 + col * sfshstride]) - mfvec);
+#else
                     const FLOAT_TYPEV4 Pf = FLOAT_TYPEV4(exp(vec4(sfsh[row / 4 + col * sfshstride]) - mfvec));
+#endif
                     [[unroll]] for (uint32_t vec_idx = 0; vec_idx < 4; ++vec_idx) {
                         Lf[r + vec_idx] += Pf[vec_idx];
                         Psh[(row + vec_idx) * psh_stride + pcol_vec][pcol_comp] = Pf[vec_idx];
@@ -432,16 +466,21 @@ void main() {
 
         // Psh is not written again until the next KV block, so the P fragments are the same
         // for every hsv_tile. Load them once instead of re-reading LDS per tile.
-        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBc, 16, gl_MatrixUseA> PMat[Bc / MatBc];
-        [[unroll]] for (uint32_t bc_chunk = 0; bc_chunk < Bc / MatBc; ++bc_chunk) {
-            coopMatLoad(PMat[bc_chunk], Psh, bc_chunk * (MatBc / 4), psh_stride, gl_CooperativeMatrixLayoutRowMajor);
+        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBc, 16, gl_MatrixUseA> PMat[MR][Bc / MatBc];
+        [[unroll]] for (uint32_t m = 0; m < MR; ++m) {
+            [[unroll]] for (uint32_t bc_chunk = 0; bc_chunk < Bc / MatBc; ++bc_chunk) {
+                coopMatLoad(PMat[m][bc_chunk], Psh, m * 16 * psh_stride + bc_chunk * (MatBc / 4), psh_stride, gl_CooperativeMatrixLayoutRowMajor);
+            }
         }
 
         // Each subgroup handles HSV/4 columns
         [[unroll]] for (uint32_t hsv_tile = 0; hsv_tile < num_hsv_tiles; ++hsv_tile) {
             const uint hsv_offset = (hsv_tile * row_split + gl_SubgroupID) * 16;
 
-            coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> PVMat = coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
+            coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> PVMat[MR];
+            [[unroll]] for (uint32_t m = 0; m < MR; ++m) {
+                PVMat[m] = coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(O_TYPE(0));
+            }
 
             // Preload V tiles for [Bc, 16 * num subgroups]
             const uint v_rows = Bc;
@@ -495,7 +534,9 @@ void main() {
                         // F16/BF16 values can be loaded directly from global memory
                         const uint v_tile_row = j * Bc + bc_chunk * MatBc;
                         const uint v_tile_offset = v_offset / 4 + v_tile_row * v_stride / 4 + hsv_offset / 4;
+#if FA_DIAG != 5
                         coopMatLoad(QMat, data_vv4, v_tile_offset, v_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
+#endif
                     } else {
                         const uint v_tile_offset = bc_chunk * MatBr * v_cols + gl_SubgroupID * (MatBc / 4);
                         coopMatLoad(QMat, kvsh, v_tile_offset, vsh_stride, gl_CooperativeMatrixLayoutRowMajor);
@@ -505,11 +546,18 @@ void main() {
                         coopMatLoad(QMat, kvsh, v_tile_offset, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                     }
 
-                    PVMat = coopMatMulAdd(PMat[bc_chunk], QMat, PVMat);
+#if FA_DIAG != 2
+                    // [TAG_FA_MR] le fragment V vient d'etre charge : il sert les MR groupes.
+                    [[unroll]] for (uint32_t m = 0; m < MR; ++m) {
+                        PVMat[m] = coopMatMulAdd(PMat[m][bc_chunk], QMat, PVMat[m]);
