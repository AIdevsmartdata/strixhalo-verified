+// [TAG_FA_SLICEDQ] Sliced-Q flash-attention prototype.
+//
+// One subgroup owns 16 complete Q rows (all Bc KV columns), so the online
+// softmax is reduced with intra-subgroup clustered ops only. Q is preloaded
+// once into 16 cooperative-matrix A fragments and kept in registers; K and V
+// tiles are consumed by all four subgroups from the same global lines.
+//
+// Target: D256 (HSK == HSV == 256), f16 K/V, f16 contiguous per-head layout,
+//         causal prefill, Br = 64, Bc = 64, row_split = 4, SubGroupSize = 64.
+//
+// This file is opt-in (define SLICEDQ) and does not modify flash_attn_cm1.comp.
+//
+// Precision contract (identical to flash_attn_cm1.comp):
+//   S accumulator : ACC_TYPE   (f32 on the deployed f32acc path)
+//   P             : FLOAT_TYPE (f16)
+//   PV accumulator: O_TYPE     (f16)
+//   output        : D_TYPE     (f32), O * (1/L), clamped
+//
+// Not implemented here (host must gate these off): mask_opt block skipping,
+// split-K, attention sinks, and the unaligned (Clamp != 0) load path.
+
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_EXT_shader_16bit_storage : require
+
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
+
+#extension GL_KHR_shader_subgroup_basic : enable
+#extension GL_KHR_shader_subgroup_arithmetic : enable
+#extension GL_KHR_shader_subgroup_clustered : enable
+#extension GL_KHR_shader_subgroup_vote : enable
+#extension GL_KHR_memory_scope_semantics : enable
+#extension GL_KHR_cooperative_matrix : enable
+
+#include "types.glsl"
+#include "flash_attn_base.glsl"
+
+#if !defined(FLOAT16)
+#error "flash_attn_cm1_slicedq.comp is only defined for f16 K/V (FLOAT16)"
+#endif
+
+// Same bindings as flash_attn_cm1.comp (base.glsl declares 4..6 only).
+layout (binding = 0) readonly buffer Q {float data_q[];};
+layout (binding = 0) readonly buffer QV4 {vec4 data_qv4[];};
+layout (binding = 1) readonly buffer K {FLOAT_TYPE data_k[];};
+layout (binding = 1) readonly buffer KV4 {FLOAT_TYPEV4 data_kv4[];};
+layout (binding = 2) readonly buffer V {FLOAT_TYPE data_v[];};
+layout (binding = 2) readonly buffer VV4 {FLOAT_TYPEV4 data_vv4[];};
+layout (binding = 3) readonly buffer M {float16_t data_m[];};
+
+// ---------------------------------------------------------------------------
+// Geometry. All of these fold from the spec constants (see REPORT.md section 6).
+// ---------------------------------------------------------------------------
+const uint32_t SLICE_ROWS    = Br / row_split;              // 16 Q rows / subgroup
+const uint32_t LANES_PER_ROW = SubGroupSize / SLICE_ROWS;   // 4
+const uint32_t D_PER_LANE    = HSV / LANES_PER_ROW;         // 64 output dims / lane
+const uint32_t COLS_PER_LANE = Bc / LANES_PER_ROW;          // 16 KV cols / lane
+const uint32_t N_D           = HSK_pad / 16;                // 16 K-dim tiles
+const uint32_t N_CC          = Bc / 16;                     // 4 Bc tiles (== S accumulators)
+const uint32_t HSV_TILES     = HSV_pad / 16;                // 16 V-dim tiles
+const uint32_t VEC4_PER_TILE = 16 / 4;                      // vec4s per 16-wide tile
+
+// ---------------------------------------------------------------------------
+// Shared memory: ~28 KiB for the default prototype (see REPORT.md section 4.1).
+// ---------------------------------------------------------------------------
+// S is kept row-major, f32 (ACC_TYPE), Bc wide. Each subgroup writes its own
+// 16 rows; only the owning subgroup reads them back for the softmax.
+shared ACC_TYPEV4   Ssh[Br * (Bc / 4)];
+// P is row-major f16, written and read by the owning subgroup only.
+shared FLOAT_TYPEV4 Psh[Br * (Bc / 4)];
+// Per-subgroup 16x16 f16 PV partial, folded into the register accumulator.
+shared O_TYPEV4     pvsh[row_split * SLICE_ROWS * VEC4_PER_TILE];
+// Scratch for the one-off f32 -> f16 Q conversion (scale applied here).
+shared FLOAT_TYPEV4 Qstage[Br * VEC4_PER_TILE];
+
+void main() {
+#ifdef NEEDS_INIT_IQ_SHMEM
+    if (fa_type_needs_shmem(FaTypeK) || fa_type_needs_shmem(FaTypeV)) {
+        init_iq_shmem(gl_WorkGroupSize);
+    }
+#endif
+
+    init_indices();
+
+    const uint32_t sg   = gl_SubgroupID;
+    const uint32_t lane = gl_SubgroupInvocationID;
+
+    // Cluster layout: lanes [4r, 4r+3] share row r; lane sub owns 16 softmax
+    // columns and 64 output dims.
+    const uint32_t row_local = lane / LANES_PER_ROW;              // 0..15
+    const uint32_t sub       = lane % LANES_PER_ROW;              // 0..3
+    const uint32_t grow_local = sg * SLICE_ROWS + row_local;      // 0..Br-1
+    const uint32_t grow       = i * Br + grow_local;              // global Q row
+    const uint32_t col0       = sub * COLS_PER_LANE;              // softmax col base
+
+    // Use -FLT_MAX/2 rather than -inf to reduce the possibility of NaNs, e.g. when computing Mold-M.
+    const float NEG_FLT_MAX_OVER_2 = uintBitsToFloat(0xFEFFFFFF);
+
+    // ALiBi slope for this lane's row (constant over the KV loop).
+    float slope_l = 1.0f;
+    if (p.max_bias > 0.0f) {
+        slope_l = float(perElemOpComputeSlope(grow_local, 0u, ACC_TYPE(0), iq2));
+    }
+
+    // Per-row online-softmax state. Each of the 4 lanes in a cluster holds the
+    // same value because the reduction is clustered.
+    float Mrow = NEG_FLT_MAX_OVER_2;
+    float Lrow = 0.0f;
+
+    // Register accumulator: this lane's D_PER_LANE output dims for its one row.
+    O_TYPE Of[D_PER_LANE];
+    [[unroll]] for (uint32_t k = 0; k < D_PER_LANE; ++k) {
+        Of[k] = O_TYPE(0.0);
+    }
+
+    // -----------------------------------------------------------------------
+    // One-off Q preload: convert f32 Q (scaled) to f16 in a small scratch and
+    // keep the resulting A fragments in registers for the whole KV loop.
+    // -----------------------------------------------------------------------
+    coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> QMat[N_D];
+
+    const uint32_t q_offset = gqa_iq1*p.nb01 + (iq2*p.nb02+iq3*p.nb03) / 4;
+    const uint32_t q_row_slot = sg * SLICE_ROWS + row_local;      // row in Qstage
+    const uint32_t q_col4 = sub;                                  // 4 consecutive d columns
+
+    [[unroll]] for (uint32_t dc = 0; dc < N_D; ++dc) {
+        const uint32_t d = dc * 16 + q_col4 * 4;
+        vec4 qv = vec4(0.0);
+        if (grow < N && (HSK == HSK_pad || d < HSK)) {
+            qv = data_qv4[q_offset / 4 + grow * q_stride / 4 + d / 4] * p.scale;
+        }
+        Qstage[q_row_slot * VEC4_PER_TILE + q_col4] =
+            FLOAT_TYPEV4(FLOAT_TYPE(qv.x), FLOAT_TYPE(qv.y), FLOAT_TYPE(qv.z), FLOAT_TYPE(qv.w));
+        barrier();
+        coopMatLoad(QMat[dc], Qstage, (sg * SLICE_ROWS) * VEC4_PER_TILE, VEC4_PER_TILE,
+                    gl_CooperativeMatrixLayoutRowMajor);
+        barrier();
+    }
+
+    // -----------------------------------------------------------------------
+    // Mask bounds helper state (recomputed per block; constant here).
+    // -----------------------------------------------------------------------
+    // K/V base addresses (element/vec4 addressing handled at the load sites).
+    const uint32_t k_offset = (ik2 * p.nb12 + ik3 * p.nb13) / FaBlockBytesK;
+    const uint32_t v_offset = (iv2 * p.nb22 + iv3 * p.nb23) / FaBlockBytesV;
+
+    const bool mask_row_oob_check = !(p.gqa_ratio > 1) && (p.nem1 % Br) != 0;
+    uint32_t m_offset = gqa_iq1 * KV;
+    if (p.nem2 != 1 || p.nem3 != 1) {
+        m_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * p.nem1 * KV;
+    }
+
+    // -----------------------------------------------------------------------
+    // KV loop.
+    // -----------------------------------------------------------------------
+    [[dont_unroll]]
+    for (uint32_t j = start_j; j < end_j; ++j) {
+
+        // ---- QK^T : S(16 x Bc) = Q(16 x HSK) * K^T(HSK x Bc) --------------
+        coopmat<ACC_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> Sacc[N_CC];
+        [[unroll]] for (uint32_t cc = 0; cc < N_CC; ++cc) {
+            Sacc[cc] = coopmat<ACC_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(ACC_TYPE(0));
+        }
+
+        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> Bk;
+        [[unroll]] for (uint32_t dc = 0; dc < N_D; ++dc) {
+            [[unroll]] for (uint32_t cc = 0; cc < N_CC; ++cc) {
+                // K^T tile: B[i=d][j=c] = K[j*Bc + cc*16 + j][dc*16 + i].
+                // Row-major K read as a ColMajor B tile.
+                const uint32_t kbase = k_offset / 4
+                                     + (j * Bc + cc * 16) * (k_stride / 4)
+                                     + dc * 16 / 4;
+                coopMatLoad(Bk, data_kv4, kbase, k_stride / 4,
+                            gl_CooperativeMatrixLayoutColumnMajor);
+                Sacc[cc] = coopMatMulAdd(QMat[dc], Bk, Sacc[cc]);
+            }
+        }
+
+        [[unroll]] for (uint32_t cc = 0; cc < N_CC; ++cc) {
+            coopMatStore(Sacc[cc], Ssh, (sg * SLICE_ROWS) * (Bc / 4) + cc * 4, Bc / 4,
+                         gl_CooperativeMatrixLayoutRowMajor);
+        }
+        barrier();
+
+        // ---- Softmax: fully inside the subgroup's 16 rows -----------------
+        // Apply logit softcap and mask, and take the partial rowmax.
+        float svals[COLS_PER_LANE];
+        float pmax = NEG_FLT_MAX_OVER_2;
+        [[unroll]] for (uint32_t t = 0; t < COLS_PER_LANE; ++t) {
+            const uint32_t col = col0 + t;
+            float sv = float(Ssh[(sg * SLICE_ROWS + row_local) * (Bc / 4) + col / 4][col % 4]);
+
+            if (LOGIT_SOFTCAP) {
+                sv = p.logit_softcap * tanh(sv);
+            }
+            if (MASK_ENABLE && (!KV_bounds_check || j * Bc + col < KV)) {
+                if (!mask_row_oob_check || grow < p.nem1) {
+                    sv += slope_l * float(data_m[m_offset + grow * m_stride + (j * Bc + col)]);
+                }
+            }
+            if (KV_bounds_check && j * Bc + col >= KV) {
+                sv = NEG_FLT_MAX_OVER_2;
+            }
+            svals[t] = sv;
+            pmax = max(pmax, sv);
+        }
+        pmax += FATTN_KQ_MAX_OFFSET;
+
+        const float rowmax = subgroupClusteredMax(pmax, 4u);
+        const float Mold   = Mrow;
+        Mrow = max(rowmax, Mold);
+        const float eM = exp(Mold - Mrow);
+        Lrow *= eM;
+
+        // Rescale the register accumulator.
+        [[unroll]] for (uint32_t k = 0; k < D_PER_LANE; ++k) {
+            Of[k] = O_TYPE(eM) * Of[k];
+        }
+
+        // P = f16(exp(S - M)), and the partial row sum.
+        float psum = 0.0f;
+        [[unroll]] for (uint32_t t = 0; t < COLS_PER_LANE; ++t) {
+            const uint32_t col = col0 + t;
+            const FLOAT_TYPE pf = FLOAT_TYPE(exp(svals[t] - Mrow));
+            Psh[(sg * SLICE_ROWS + row_local) * (Bc / 4) + col / 4][col % 4] = pf;
+            psum += float(pf);
+        }
+        Lrow += subgroupClusteredAdd(psum, 4u);
+        barrier();
+
+        // ---- O += P * V ---------------------------------------------------
+        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> PMat[N_CC];
+        [[unroll]] for (uint32_t cc = 0; cc < N_CC; ++cc) {
+            coopMatLoad(PMat[cc], Psh,
+                        (sg * SLICE_ROWS) * (Bc / 4) + cc * 4, Bc / 4,
+                        gl_CooperativeMatrixLayoutRowMajor);
+        }
+
+        [[unroll]] for (uint32_t ht = 0; ht < HSV_TILES; ++ht) {
+            coopmat<O_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> PV =
+                coopmat<O_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(O_TYPE(0));
+
+            coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> Bv;
+            [[unroll]] for (uint32_t cc = 0; cc < N_CC; ++cc) {
+                const uint32_t vbase = v_offset / 4
+                                     + (j * Bc + cc * 16) * (v_stride / 4)
+                                     + ht * 16 / 4;
+                coopMatLoad(Bv, data_vv4, vbase, v_stride / 4,
+                            gl_CooperativeMatrixLayoutRowMajor);
+                PV = coopMatMulAdd(PMat[cc], Bv, PV);
+            }
+
+            coopMatStore(PV, pvsh, sg * SLICE_ROWS * VEC4_PER_TILE, VEC4_PER_TILE,
+                         gl_CooperativeMatrixLayoutRowMajor);
+            barrier();
+
+            // Exactly one sub per row owns this tile's 16 output dims.
+            const uint32_t tiles_per_sub = D_PER_LANE / 16;   // 4
+            if (sub == ht / tiles_per_sub) {
+                const uint32_t dk0 = (ht % tiles_per_sub) * 16;
+                [[unroll]] for (uint32_t t = 0; t < 16; ++t) {
+                    Of[dk0 + t] += O_TYPE(pvsh[(sg * SLICE_ROWS + row_local) * VEC4_PER_TILE + t / 4][t % 4]);
+                }
+            }
+            barrier();
+        }
+    }
+
+    // ---- Final scale and store -------------------------------------------
+    const float Lrcp = (Lrow == 0.0f) ? 0.0f : 1.0f / Lrow;
+    [[unroll]] for (uint32_t k = 0; k < D_PER_LANE; ++k) {
+        O_TYPE v = Of[k] * O_TYPE(Lrcp);
+#if defined(FLOAT_TYPE_MAX)
+        v = clamp(v, -FLOAT_TYPE_MAX, FLOAT_TYPE_MAX);
+#endif
+        Of[k] = v;
+    }
+
+    const uint32_t o_offset = (gqa_iq1 * p.ne1 * HSV + iq3 * p.ne2 * p.ne1 * HSV) / 4;
+    const uint32_t dv4 = sub * (D_PER_LANE / 4);
+
+    if (p.gqa_ratio > 1) {
+        if (grow_local < N) {
+            [[unroll]] for (uint32_t k4 = 0; k4 < D_PER_LANE / 4; ++k4) {
+                const O_TYPEV4 ov = O_TYPEV4(Of[k4 * 4 + 0], Of[k4 * 4 + 1],
+                                             Of[k4 * 4 + 2], Of[k4 * 4 + 3]);
+                gqaStore(grow_local, dv4 + k4, ov, o_offset, iq2, N);
+            }
+        }
+    } else {
+        if (grow < N) {
+            [[unroll]] for (uint32_t k4 = 0; k4 < D_PER_LANE / 4; ++k4) {
+                const O_TYPEV4 ov = O_TYPEV4(Of[k4 * 4 + 0], Of[k4 * 4 + 1],
+                                             Of[k4 * 4 + 2], Of[k4 * 4 + 3]);
+                data_ov4[o_offset + (iq2 * HSV + grow * p.ne1 * HSV) / 4 + dv4 + k4] =
+                    D_TYPEV4(ov);
+            }
+        }
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/moe_gate_up_101_q8_1.comp b/ggml/src/ggml-vulkan/vulkan-shaders/moe_gate_up_101_q8_1.comp
new file mode 100644
index 00000000000..f3ee1e5a82a
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/moe_gate_up_101_q8_1.comp
@@ -0,0 +1,125 @@
+#version 450
+
+#extension GL_EXT_shader_8bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_EXT_integer_dot_product : require
+
+#define DATA_A_ROCMFP4_FAST
+#define FLOAT_TYPE float
+#include "types.glsl"
+
+// Fixed Q4_0_ROCMFP4_FAST MoE shape: K=2560, M=640, top-10, n=1..8.
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+layout(binding = 0, std430) readonly buffer Gate { block_rocmfp4_fast gate_a[]; };
+layout(binding = 1, std430) readonly buffer Up   { block_rocmfp4_fast up_a[]; };
+layout(binding = 2, std430) readonly buffer B    { block_q8_1_x4 data_b[]; };
+layout(binding = 3, std430) readonly buffer Ids  { int ids[]; };
+layout(binding = 4, std430) writeonly buffer D   { float dst[]; };
+
+layout(push_constant) uniform Parameters {
+    uint n_tokens;
+    uint ids_nb1;
+    uint b_expert_stride_blocks;
+    uint b_token_stride_blocks;
+    uint gate_base_blocks;
+    uint up_base_blocks;
+    uint gate_expert_stride_blocks;
+    uint up_expert_stride_blocks;
+} p;
+
+const uint K_BLOCKS = 80;
+const uint M = 640;
+const uint TOP_K = 10;
+const uint ROWS = 2;
+shared vec2 partial[2][64];
+
+int pack_codes(uvec4 q) {
+    return int((uint(kvalues_rocmfp4[q.x]) & 255u) |
+              ((uint(kvalues_rocmfp4[q.y]) & 255u) << 8) |
+              ((uint(kvalues_rocmfp4[q.z]) & 255u) << 16) |
+              ((uint(kvalues_rocmfp4[q.w]) & 255u) << 24));
+}
+
+ivec2 pack_weight(const bool gate, const uint block, const uint part) {
+    const uint byte = part * 4;
+    uvec4 q;
+    if (gate) {
+        q = uvec4(gate_a[block].qs[byte], gate_a[block].qs[byte + 1],
+                  gate_a[block].qs[byte + 2], gate_a[block].qs[byte + 3]);
+    } else {
+        q = uvec4(up_a[block].qs[byte], up_a[block].qs[byte + 1],
+                  up_a[block].qs[byte + 2], up_a[block].qs[byte + 3]);
+    }
+    return ivec2(pack_codes(q & uvec4(15)), pack_codes(q >> 4));
+}
+
+vec2 dot_pair(const uint gate_block, const uint up_block, const int bqs[8], const float db) {
+    ivec2 low = ivec2(0);
+    ivec2 high = ivec2(0);
+    for (uint part = 0; part < 4; ++part) {
+        const ivec2 g = pack_weight(true, gate_block, part);
+        const ivec2 u = pack_weight(false, up_block, part);
+        low.x += dotPacked4x8EXT(g.x, bqs[part]);
+        low.y += dotPacked4x8EXT(u.x, bqs[part]);
+        high.x += dotPacked4x8EXT(g.y, bqs[part + 4]);
+        high.y += dotPacked4x8EXT(u.y, bqs[part + 4]);
+    }
+    const vec2 d = vec2(ue4m3_to_fp32(gate_a[gate_block].e),
+                        ue4m3_to_fp32(up_a[up_block].e));
+    precise vec2 low_scaled = vec2(low) * d;
+    precise vec2 high_scaled = vec2(high) * d;
+    precise vec2 weighted = low_scaled + high_scaled;
+    precise vec2 result = db * weighted;
+    return result;
+}
+
+void main() {
+    const uint tid = gl_LocalInvocationID.x;
+    const uint rank = gl_WorkGroupID.y % TOP_K;
+    const uint token = gl_WorkGroupID.y / TOP_K;
+    const uint row = ROWS * gl_WorkGroupID.x;
+    if (token >= p.n_tokens || row >= M) {
+        return;
+    }
+    init_iq_shmem(gl_WorkGroupSize);
+
+    const uint expert = uint(ids[token * p.ids_nb1 + rank]);
+    const uint gate_base = p.gate_base_blocks + expert * p.gate_expert_stride_blocks;
+    const uint up_base = p.up_base_blocks + expert * p.up_expert_stride_blocks;
+    const uint b_base = token * p.b_token_stride_blocks + rank * p.b_expert_stride_blocks;
+    vec2 acc[2];
+    acc[0] = vec2(0.0);
+    acc[1] = vec2(0.0);
+
+    for (uint block = tid; block < K_BLOCKS; block += 64) {
+        const uint b_block = b_base + block;
+        const uint outer = b_block / 4;
+        const uint inner = b_block % 4;
+        const float db = float(data_b[outer].ds[inner].x);
+        int bqs[8];
+        for (uint i = 0; i < 8; ++i) {
+            bqs[i] = data_b[outer].qs[inner * 8 + i];
+        }
+        for (uint r = 0; r < ROWS; ++r) {
+            const uint offset = (row + r) * K_BLOCKS + block;
+            acc[r] += dot_pair(gate_base + offset, up_base + offset, bqs, db);
+        }
+    }
+    partial[0][tid] = acc[0];
+    partial[1][tid] = acc[1];
+    barrier();
+    for (uint stride = 32; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            partial[0][tid] += partial[0][tid + stride];
+            partial[1][tid] += partial[1][tid + stride];
+        }
+        barrier();
+    }
+    if (tid == 0) {
+        const uint out_base = (token * TOP_K + rank) * M + row;
+        for (uint r = 0; r < ROWS; ++r) {
+            const vec2 gu = partial[r][0];
+            dst[out_base + r] = (gu.x / (1.0 + exp(-gu.x))) * gu.y;
+        }
+    }
+}
