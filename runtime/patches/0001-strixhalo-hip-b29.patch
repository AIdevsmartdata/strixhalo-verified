+// regroupement (1 bloc, un fil par paire p = jeton*n_used + rang) : chef = premiere occurrence de l'expert ; ses paires, par p croissant,
+// coupees en morceaux de <= OPUS_MOEVEC_C ; morceaux dans l'ordre des chefs (scan exclusif) ; deterministe, sans atomique.
+template <int max_pairs>
+__launch_bounds__(max_pairs, 1)
+static __global__ void opus_moevec_group(const int32_t * __restrict__ ids, const int ids_stride, const int n_used, const int ntok,
+        int32_t * __restrict__ desc) {
+    __shared__ int e_s[max_pairs];
+    __shared__ int scan_s[max_pairs];
+    const int npairs = n_used*ntok;
+    const int p = threadIdx.x;
+
+    ggml_cuda_pdl_sync();
+    int e = -1;
+    if (p < npairs) {
+        const int t = p / n_used;
+        e = ids[(p - t*n_used) + t*ids_stride];
+    }
+    e_s[p] = e;
+    __syncthreads();
+
+    int lead = 0;
+    int cnt  = 0;
+    if (e >= 0) {
+        lead = 1;
+        for (int q = 0; q < p; ++q) {
+            if (e_s[q] == e) {
+                lead = 0;
+                break;
+            }
+        }
+        if (lead) {
+            for (int q = p; q < npairs; ++q) {
+                cnt += e_s[q] == e ? 1 : 0;
+            }
+        }
+    }
+    const int nch = lead ? (cnt + OPUS_MOEVEC_C - 1)/OPUS_MOEVEC_C : 0;
+    // scan inclusif de (chef | morceaux << 16) : <= 512 chefs et <= 512 morceaux, aucune retenue d'une moitie sur l'autre
+    const int v = lead | (nch << 16);
+    scan_s[p] = v;
+    __syncthreads();
+    for (int off = 1; off < max_pairs; off <<= 1) {
+        const int add = p >= off ? scan_s[p - off] : 0;
+        __syncthreads();
+        scan_s[p] += add;
+        __syncthreads();
+    }
+    if (lead) {
+        int c = (scan_s[p] - v) >> 16;   // premier morceau de cet expert
+        int k = 0;
+        for (int q = p; q < npairs; ++q) {
+            if (e_s[q] != e) {
+                continue;
+            }
+            int32_t * d = desc + 2 + c*OPUS_MOEVEC_DSTRIDE;
+            if (k == 0) {
+                d[0] = e;
+            }
+            const int t = q / n_used;
+            d[2 + k] = t | ((q - t*n_used) << 16);
+            ++k;
+            if (k == OPUS_MOEVEC_C) {
+                d[1] = k;
+                ++c;
+                k = 0;
+            }
+        }
+        if (k > 0) {
+            desc[2 + c*OPUS_MOEVEC_DSTRIDE + 1] = k;
+        }
+    }
+    if (p == max_pairs - 1) {
+        desc[0] = scan_s[p] >> 16;      // morceaux
+        desc[1] = scan_s[p] & 0xFFFF;   // experts distincts
+    }
+}
